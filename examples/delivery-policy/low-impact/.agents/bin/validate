#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

# This repository owns these choices. Execute the trusted-base copy; see the example command table.
def git(*args)
  output, error, status = Open3.capture3("git", *args)
  raise(error.empty? ? "git command failed" : error) unless status.success?

  output
end

def candidate_state
  untracked = git("ls-files", "--others", "--exclude-standard", "-z").split("\0").map do |path|
    [path, File.lstat(path).mode, File.symlink?(path) ? File.readlink(path) : File.binread(path)]
  end
  [git("rev-parse", "HEAD"), git("status", "--porcelain", "--untracked-files=all"),
   git("diff", "--cached", "--binary", "--no-ext-diff", "--no-textconv", "--"),
   git("diff", "--binary", "--no-ext-diff", "--no-textconv", "--"), untracked]
end

phase = ARGV.shift || "integration"
abort "Unsupported example invocation" unless %w[integration promotion].include?(phase) && ARGV.empty?
head = git("rev-parse", "HEAD").strip
base = ENV.fetch("EXAMPLE_BASE_SHA", "")
initial_state = candidate_state
clean = initial_state[1].empty?
coverage = "full"
reason = "promotion requires complete checks"
if phase == "integration"
  reason = "unknown or broad change; complete checks required"
  begin
    raise "missing or invalid base" unless base.b.match?(/\A[0-9a-f]{40}\z/)

    git("cat-file", "-e", "#{base}^{commit}")
    raw = git("diff", "--raw", "-z", "--no-abbrev", "--no-renames", base, head, "--")
    ordinary = !raw.empty? && raw.end_with?("\0") && raw.split("\0").length.even? &&
               raw.split("\0").each_slice(2).all? do |header, path|
                 header.match?(/\A:100644 100644 [0-9a-f]{40} [0-9a-f]{40} M\z/) && path == "docs/overview.md"
               end
    if clean && ordinary
      # Only these reviewed sentences belong to this teaching example's envelope.
      # This is not a classifier for arbitrary English operational instructions.
      approved_overviews = [
        "# Overview\n\nA shared tool helps the team.\n",
        "# Overview\n\nA shared tool helps our team.\n"
      ]
      prose = [base, head].all? do |revision|
        approved_overviews.include?(git("show", "#{revision}:docs/overview.md"))
      end
      if prose
        coverage = "selected"
        reason = "reviewed sample overview text; limited audience and reversible tool changes"
      end
    end
  rescue RuntimeError => e
    reason = "#{e.message.lines.first.to_s.strip}; complete checks required"
  end
end

required = coverage == "selected" ? %w[lint docs] : %w[lint docs test]
puts "phase: #{phase}\nhead: #{head}\nbase: #{base.empty? ? 'UNKNOWN' : base}"
puts "working tree: #{clean ? 'clean' : 'dirty'}\ncoverage: #{coverage}\nreason: #{reason}"
puts "omitted: #{coverage == 'selected' ? 'test' : 'none'}"
passed = true
required.each do |check|
  success = system(".agents/bin/#{check}")
  puts "required #{check}: #{success ? 'PASS' : 'FAIL'}"
  passed = false unless success
end
if candidate_state != initial_state
  warn "Candidate changed during validation; rerun for the resulting tree"
  passed = false
end
if phase == "promotion" && !clean
  warn "Promotion blocked: candidate has uncommitted changes"
  passed = false
end
exit(passed ? 0 : 1)
