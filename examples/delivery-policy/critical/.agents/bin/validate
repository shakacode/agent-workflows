#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

# Customer and durable-data impact require every check, even for overview prose.
# Execute the trusted-base copy; see the delivery-policy example command table.
phase = ARGV.shift || "integration"
abort "Unsupported example invocation" unless %w[integration promotion].include?(phase) && ARGV.empty?
head, error, status = Open3.capture3("git", "rev-parse", "HEAD")
abort error unless status.success?
dirty, error, status = Open3.capture3("git", "status", "--porcelain")
abort error unless status.success?
base = ENV.fetch("EXAMPLE_BASE_SHA", "")
puts "phase: #{phase}\nhead: #{head.strip}\nbase: #{base.empty? ? 'UNKNOWN' : base}"
puts "working tree: #{dirty.empty? ? 'clean' : 'dirty'}\ncoverage: full"
puts "reason: critical service requires complete checks at integration and promotion\nomitted: none"
passed = true
%w[lint docs test].each do |check|
  success = system(".agents/bin/#{check}")
  puts "required #{check}: #{success ? 'PASS' : 'FAIL'}"
  passed = false unless success
end
current_head, _error, identity_status = Open3.capture3("git", "rev-parse", "HEAD")
current_dirty, _error, tree_status = Open3.capture3("git", "status", "--porcelain")
if !identity_status.success? || !tree_status.success? || current_head != head || (dirty.empty? && !current_dirty.empty?)
  warn "Candidate changed during validation; rerun for the resulting tree"
  passed = false
end
if phase == "promotion" && !dirty.empty?
  warn "Promotion blocked: candidate has uncommitted changes"
  passed = false
end
exit(passed ? 0 : 1)
