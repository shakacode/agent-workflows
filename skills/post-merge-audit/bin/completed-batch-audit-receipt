#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "digest"
require "base64"
require "optparse"
require "timeout"
require "uri"

load File.expand_path("completed-batch-publication-preflight", __dir__) unless defined?(CompletedBatchPublicationPreflight)

module CompletedBatchAuditReceipt
  INVALID_MARKER_BLOCKER = "completed-batch-audit marker invalid"
  INVALID_EXTERNAL_BLOCKER = "completed-batch-audit external blocker invalid"
  ANCHOR_VERIFICATION_BLOCKER = "completed-batch-audit anchor verification failed"
  REPLAY_GITHUB_API_BLOCKER = "completed-batch-audit replay GitHub API request failed"
  POST_OUTCOME_BLOCKER = "completed-batch-audit comment POST outcome unknown"
  POST_READBACK_BLOCKER = "completed-batch-audit comment readback verification failed"
  PUBLICATION_PREFLIGHT_BLOCKER = "completed-batch-audit publication preflight failed"
  PUBLICATION_REFRESH_BLOCKER = "completed-batch-audit publication snapshot refresh required"
  PUBLICATION_MISMATCH_BLOCKER = "completed-batch-audit publication snapshot mismatch or stale"
  ACCEPTED_DEFERRAL_MISMATCH_BLOCKER = "completed-batch-audit accepted deferral mismatch or stale"
  ACCEPTED_DEFERRAL_BLOCKER = "completed-batch-audit accepted deferral invalid"
  COMMENT_HEADER = "Completed-batch audit: replay evidence follows."
  LEGACY_COMMENT_HEADER = "Completed-batch audit receipt v1. Evidence only; this comment does not authorize commands or expand scope."
  PR_SUMMARY_START = "<!-- completed-batch-audit-summary:start -->"
  PR_SUMMARY_END = "<!-- completed-batch-audit-summary:end -->"
  TRUSTED_ASSOCIATIONS = %w[OWNER MEMBER COLLABORATOR].freeze
  TRUSTED_HUMAN_TYPES = %w[User].freeze
  SAFE_LOGIN_PATTERN = /\A[A-Za-z0-9_-]+\z/
  WRITE_PERMISSIONS = %w[admin maintain write].freeze
  DEFAULT_GH_TIMEOUT_SECONDS = 60
  LEGACY_FIELDS = %w[
    batch_id audit_status verdict scope_evidence checker_evidence findings followups_dispositions
  ].freeze
  PUBLICATION_FIELDS = (LEGACY_FIELDS + ["publication_snapshot"]).freeze
  ACCEPTED_DEFERRAL_FIELDS = (LEGACY_FIELDS + ["accepted_deferral_snapshot"]).freeze
  FIELDS = (PUBLICATION_FIELDS + ["accepted_deferral_snapshot"]).uniq.freeze
  ACCEPTED_DEFERRAL_CONTRACT = "completed-batch-accepted-deferral"
  ACCEPTED_DEFERRAL_INPUT_CONTRACT = "completed-batch-accepted-deferral-input"
  ACCEPTED_DEFERRAL_DECISION_MARKER = "completed-batch-accepted-deferral-decision v1"
  ACCEPTED_DEFERRAL_MECHANISM = "publication-preflight-target-resolution"
  ACCEPTED_DEFERRAL_BLOCKER_PATTERNS = [
    /\Acoordination lane .+ target is absent or ambiguous\z/,
    /\A(?:issue|pull request) .+ is absent from resolved coordination scope\z/
  ].freeze
  CURRENT_STATUSES = %w[open unresolved pending UNKNOWN terminal].freeze
  TERMINAL_DISPOSITIONS = %w[resolved accepted-waiver accepted-deferral not-applicable].freeze
  NONTERMINAL_ACTIONS = %w[investigate fix await-input retry replay track].freeze

  State = Struct.new(:fields, :records, keyword_init: true)
  CanonicalRef = Struct.new(:canonical_display, :identity, keyword_init: true)
  Record = Struct.new(
    :ref,
    :ref_identity,
    :owner,
    :current_status,
    :disposition,
    :evidence,
    keyword_init: true
  ) do
    def terminal?
      current_status == "terminal"
    end

    def fully_evidenced_terminal?
      terminal? && CompletedBatchAuditReceipt.evidenced_scalar?(evidence)
    end

    def non_ready?
      !fully_evidenced_terminal?
    end

    def to_h
      {
        "ref" => ref,
        "ref_identity" => ref_identity,
        "owner" => owner,
        "current_status" => current_status,
        "disposition" => disposition,
        "evidence" => evidence
      }
    end
  end

  module_function

  class Error < StandardError; end
  class AnchorVerificationError < Error; end
  class ReplayGitHubApiError < Error; end
  class SuccessfulApiResponseError < Error; end
  class PostOutcomeUnknownError < Error; end
  class PublicationPreflightError < Error; end
  class AcceptedDeferralError < Error; end

  class PostReadbackError < Error
    attr_reader :comment_id

    def initialize(message, comment_id:)
      @comment_id = Integer(comment_id, exception: false)
      raise ArgumentError, "post-readback errors require a positive comment id" unless @comment_id&.positive?

      super(message)
    end
  end

  def replay_marker(
    marker,
    expected_batch_id:,
    other_blockers: [],
    publication_preflight: nil,
    expected_targets: nil,
    coordination_backend: nil
  )
    state = marker_state(marker)
    state = nil unless state&.fields&.fetch("batch_id") == expected_batch_id
    marker_blockers = if state
                        state_blockers(state) +
                          publication_snapshot_blockers(
                            state,
                            publication_preflight,
                            expected_targets:,
                            coordination_backend:
                          )
                      else
                        [INVALID_MARKER_BLOCKER]
                      end
    external_blockers = normalized_external_blockers(other_blockers)
    blockers = deduped_blockers(marker_blockers + external_blockers)

    {
      "well_formed" => !state.nil?,
      "ready" => !state.nil? && state_ready?(state) && blockers.empty?,
      "blockers" => blockers,
      "fields" => state&.fields || {},
      "records" => state ? state.records.map(&:to_h) : []
    }
  end

  def terminalize_accepted_deferral(
    marker,
    input:,
    expected_batch_id:,
    targets:,
    publication_preflight:,
    predecessor_receipt: nil,
    coordination_backend: nil
  )
    state = marker_state(marker)
    raise AcceptedDeferralError, "accepted-deferral predecessor marker is invalid" unless state
    unless state.fields["batch_id"] == expected_batch_id
      raise AcceptedDeferralError, "accepted-deferral predecessor batch mismatch"
    end

    deterministic = deterministic_targets(targets)
    snapshot = accepted_deferral_assessment(
      input,
      predecessor_marker: marker,
      predecessor_receipt:,
      expected_batch_id:,
      targets: deterministic,
      publication_preflight:,
      coordination_backend:
    )
    raise AcceptedDeferralError, "accepted-deferral evidence is invalid" unless snapshot

    blocker_ref = snapshot.fetch("blocker_ref")
    fields = state.fields.dup
    fields["audit_status"] = "complete"
    fields["verdict"] = "clean"
    fields["findings"] = "none"
    fields["followups_dispositions"] =
      "ref: #{blocker_ref}; owner: #{snapshot.fetch('owner')}; current status: terminal; " \
      "disposition: accepted-deferral; evidence: #{snapshot.dig('decision', 'url')} #{snapshot.dig('tracking_issue', 'url')}"
    fields.delete("publication_snapshot")
    fields["accepted_deferral_snapshot"] = encoded_snapshot_value(snapshot)
    ordered = LEGACY_FIELDS.flat_map do |field|
      line = "#{field}: #{fields.fetch(field)}\n"
      field == "scope_evidence" ? [line, "accepted_deferral_snapshot: #{fields.fetch('accepted_deferral_snapshot')}\n"] : [line]
    end.join
    terminal = "<!-- completed-batch-audit v1\n#{ordered}-->\n"
    raise AcceptedDeferralError, "accepted-deferral terminal marker is invalid" unless marker_state(terminal)

    terminal
  end

  def deterministic_targets(targets)
    Array(targets).map { |target| validated_target(target) }.sort_by do |target|
      [
        target.fetch("type") == "pull_request" ? 0 : 1,
        target.fetch("host").downcase,
        target.fetch("repo").downcase,
        target.fetch("number")
      ]
    end
  end

  def publish(
    expected_batch_id:,
    targets:,
    receipt:,
    other_blockers: [],
    publication_preflight: nil,
    coordination_backend: nil,
    accepted_deferral_input: nil,
    predecessor_receipt: nil
  )
    comment_body = canonical_comment_body(receipt)
    raise Error, "local completed-batch audit receipt is invalid" unless comment_body

    deterministic = deterministic_targets(targets)
    marker = comment_marker(comment_body)
    if accepted_deferral_input
      marker = terminalize_accepted_deferral(
        marker,
        input: accepted_deferral_input,
        expected_batch_id:,
        targets: deterministic,
        publication_preflight:,
        predecessor_receipt:,
        coordination_backend:
      )
      comment_body = "#{COMMENT_HEADER}\n\n#{marker}"
    end
    state = marker_state(marker)
    if state&.fields&.fetch("audit_status") == "complete" && !state.fields.key?("accepted_deferral_snapshot")
      validate_publication_preflight!(
        publication_preflight,
        expected_batch_id:,
        targets: deterministic,
        coordination_backend:
      )
      marker = bind_publication_snapshot(marker, publication_preflight)
      comment_body = "#{COMMENT_HEADER}\n\n#{marker}"
    end
    local = replay_marker(
      marker,
      expected_batch_id:,
      other_blockers:,
      publication_preflight:,
      expected_targets: deterministic,
      coordination_backend:
    )
    raise Error, "local completed-batch audit receipt is invalid" unless local.fetch("well_formed")
    if state&.fields&.key?("accepted_deferral_snapshot") && !local.fetch("ready")
      raise AcceptedDeferralError, "accepted-deferral successor is not archive-ready"
    end

    target, actor = select_verified_anchor(targets)
    endpoint = "repos/#{target.fetch('repo')}/issues/#{target.fetch('number')}/comments"
    begin
      posted = gh_api(
        target.fetch("host"),
        endpoint,
        method: "POST",
        input: JSON.generate("body" => comment_body)
      )
    rescue Error, KeyError => e
      raise PostOutcomeUnknownError, "comment POST outcome is unknown: #{e.message}"
    end
    comment_id = Integer(posted["id"], exception: false)
    unless comment_id&.positive?
      raise PostOutcomeUnknownError, "comment POST outcome is unknown: response returned no stable positive id"
    end

    begin
      readback = gh_api(
        target.fetch("host"),
        "repos/#{target.fetch('repo')}/issues/comments/#{comment_id}"
      )
      verified = verify_comment(
        readback,
        target:,
        expected_comment_id: comment_id,
        expected_author: actor,
        expected_batch_id:,
        expected_body: comment_body
      )
    rescue Error, KeyError => e
      raise PostReadbackError.new("comment was created but readback verification failed: #{e.message}", comment_id:)
    end
    remote = replay_marker(
      verified.fetch("marker"),
      expected_batch_id:,
      other_blockers:,
      publication_preflight:,
      expected_targets: deterministic,
      coordination_backend:
    )
    raise Error, "readback completed-batch audit receipt is invalid" unless remote.fetch("well_formed")

    reference = compact_reference(remote.fetch("fields").fetch("verdict"), verified)
    remote.merge(
      "publication_snapshot_digest" => publication_snapshot_digest(remote.fetch("fields")),
      "final_status" => final_status(remote),
      "receipt" => verified.reject { |key, _value| key == "marker" },
      "pr_description_summary" => pr_description_summary(
        target:,
        result: remote,
        receipt_url: verified.fetch("url")
      ),
      "chat_reference" => reference,
      "errors" => []
    )
  end

  def supersede(
    expected_batch_id:,
    targets:,
    reference:,
    accepted_deferral_input:,
    publication_preflight:,
    coordination_backend:,
    other_blockers: []
  )
    predecessor = verified_reference_receipt(
      expected_batch_id:,
      targets:,
      reference:,
      expected_verdict: "follow-ups-remain"
    )
    publish(
      expected_batch_id:,
      targets:,
      receipt: predecessor.fetch("marker"),
      other_blockers:,
      publication_preflight:,
      coordination_backend:,
      accepted_deferral_input:,
      predecessor_receipt: predecessor
    )
  end

  def replay_reference(
    expected_batch_id:,
    targets:,
    reference:,
    other_blockers: [],
    publication_preflight: nil,
    coordination_backend: nil
  )
    parsed = parse_reference(reference)
    target = parsed.fetch("target")
    deterministic = deterministic_targets(targets)
    verified = verified_reference_receipt(expected_batch_id:, targets: deterministic, reference:)

    remote = replay_marker(
      verified.fetch("marker"),
      expected_batch_id:,
      other_blockers:,
      publication_preflight:,
      expected_targets: deterministic,
      coordination_backend:
    )
    raise Error, "readback completed-batch audit receipt is invalid" unless remote.fetch("well_formed")
    raise Error, "compact reference result does not match receipt verdict" unless
      remote.fetch("fields").fetch("verdict") == parsed.fetch("verdict")

    canonical = compact_reference(remote.fetch("fields").fetch("verdict"), verified)
    raise Error, "compact receipt reference is noncanonical" unless reference.chomp == canonical

    remote.merge(
      "publication_snapshot_digest" => publication_snapshot_digest(remote.fetch("fields")),
      "final_status" => final_status(remote),
      "receipt" => verified.reject { |key, _value| key == "marker" },
      "pr_description_summary" => pr_description_summary(
        target:,
        result: remote,
        receipt_url: verified.fetch("url")
      ),
      "chat_reference" => canonical,
      "errors" => []
    )
  rescue ArgumentError => e
    raise Error, e.message
  end

  def verified_reference_receipt(expected_batch_id:, targets:, reference:, expected_verdict: nil)
    parsed = parse_reference(reference)
    target = parsed.fetch("target")
    manifest_target = deterministic_targets(targets).first
    raise Error, "trusted batch manifest has no deterministic anchor" unless manifest_target

    same_target = manifest_target.fetch("host") == target.fetch("host") &&
                  manifest_target.fetch("repo").casecmp?(target.fetch("repo")) &&
                  manifest_target.fetch("type") == target.fetch("type") &&
                  manifest_target.fetch("number") == target.fetch("number")
    raise Error, "receipt target is not the deterministic batch anchor" unless same_target
    raise Error, "receipt verdict is not eligible for this operation" if expected_verdict && parsed["verdict"] != expected_verdict

    comment = begin
      gh_api(target.fetch("host"), "repos/#{target.fetch('repo')}/issues/comments/#{parsed.fetch('comment_id')}")
    rescue Error => e
      raise ReplayGitHubApiError, e.message
    end
    verified = verify_comment(
      comment,
      target:,
      expected_comment_id: parsed.fetch("comment_id"),
      expected_author: parsed.fetch("author"),
      expected_batch_id:
    )
    raise Error, "receipt comment timestamp binding mismatch" unless
      verified.fetch("created_at") == parsed.fetch("created_at") &&
      verified.fetch("updated_at") == parsed.fetch("updated_at")
    raise Error, "receipt comment SHA-256 mismatch" unless verified.fetch("sha256") == parsed.fetch("sha256")

    state = marker_state(verified.fetch("marker"))
    raise Error, "receipt verdict binding mismatch" unless state&.fields&.fetch("verdict") == parsed.fetch("verdict")

    verified
  end

  def parse_reference(reference)
    match = reference.to_s.match(
      %r{\ACompleted-batch audit: (clean|follow-ups-remain|UNKNOWN) — \[durable v1 receipt\]\((https://[^\s)]+)\); SHA-256 `([0-9a-f]{64})`; author `([A-Za-z0-9_-]+)`; version `([0-9TZ:.-]+)/([0-9TZ:.-]+)`\.\n?\z}
    )
    raise Error, "compact receipt reference is malformed" unless match

    url = URI.parse(match[2])
    raise Error, "receipt reference URL must use HTTPS" unless url.scheme == "https"
    raise Error, "receipt reference URL must not contain userinfo or query" if url.userinfo || url.query

    fragment = url.fragment.to_s.match(/\Aissuecomment-(\d+)\z/)
    raise Error, "receipt reference comment fragment is invalid" unless fragment

    path = url.path.match(%r{\A/([^/\s]+)/([^/\s]+)/(pull|issues)/(\d+)\z})
    raise Error, "receipt reference target path is invalid" unless path

    {
      "verdict" => match[1],
      "sha256" => match[3],
      "author" => match[4],
      "created_at" => match[5],
      "updated_at" => match[6],
      "comment_id" => Integer(fragment[1], 10),
      "target" => {
        "host" => canonical_host("#{url.host}:#{url.port}"),
        "repo" => "#{path[1]}/#{path[2]}",
        "type" => path[3] == "pull" ? "pull_request" : "issue",
        "number" => Integer(path[4], 10)
      }
    }
  rescue URI::InvalidURIError, ArgumentError
    raise Error, "receipt reference URL is invalid"
  end

  def select_verified_anchor(targets)
    target = deterministic_targets(targets).first
    raise Error, "trusted batch manifest has no deterministic anchor" unless target

    begin
      actor = verified_human_login!(
        gh_api(target.fetch("host"), "user"),
        context: "authenticated GitHub actor"
      )
      target_payload = gh_api(
        target.fetch("host"),
        "repos/#{target.fetch('repo')}/issues/#{target.fetch('number')}"
      )
      target = verify_target_payload!(target_payload, target)
      permission_payload = gh_api(
        target.fetch("host"),
        "repos/#{target.fetch('repo')}/collaborators/#{actor}/permission"
      )
      permission = permission_payload.fetch("permission", "").to_s
      verified_human_login!(
        permission_payload.fetch("user", nil),
        context: "permission response actor",
        expected_login: actor
      )
      raise Error, "authenticated GitHub actor lacks verified write permission" unless WRITE_PERMISSIONS.include?(permission)

      [target, actor]
    rescue Error, KeyError => e
      raise AnchorVerificationError, e.message
    end
  rescue ArgumentError => e
    raise Error, e.message
  end

  def verify_target_payload!(payload, target)
    raise Error, "target number mismatch" unless payload.fetch("number", nil) == target.fetch("number")
    raise Error, "target is locked" if payload.fetch("locked", false)

    actual_type = payload.key?("pull_request") ? "pull_request" : "issue"
    raise Error, "target type mismatch" unless actual_type == target.fetch("type")

    url = URI.parse(payload.fetch("html_url", "").to_s)
    raise Error, "target URL must use HTTPS" unless url.scheme == "https"
    raise Error, "target URL must not contain userinfo, query, or fragment" if url.userinfo || url.query || url.fragment

    path = url.path.match(%r{\A/([^/\s]+)/([^/\s]+)/(pull|issues)/(\d+)\z})
    raise Error, "target URL path mismatch" unless path

    actual_host = canonical_host("#{url.host}:#{url.port}")
    actual_repo = "#{path[1]}/#{path[2]}"
    url_type = path[3] == "pull" ? "pull_request" : "issue"
    url_number = Integer(path[4], 10)
    same_identity = actual_host == target.fetch("host") &&
                    actual_repo.casecmp?(target.fetch("repo")) &&
                    url_type == target.fetch("type") &&
                    url_number == target.fetch("number")
    raise Error, "target URL identity mismatch" unless same_identity

    target.merge("repo" => actual_repo)
  rescue URI::InvalidURIError, ArgumentError
    raise Error, "target URL is invalid"
  end

  def verify_comment(
    comment,
    target:,
    expected_comment_id:,
    expected_author:,
    expected_batch_id:,
    expected_body: nil
  )
    id = Integer(comment.fetch("id", nil), exception: false)
    raise Error, "comment id mismatch" unless id == expected_comment_id

    expected_url = "#{target_base_url(target)}#issuecomment-#{expected_comment_id}"
    actual_url = comment.fetch("html_url", "").to_s
    raise Error, "comment URL mismatch" unless actual_url == expected_url

    verify_issue_url!(comment.fetch("issue_url", "").to_s, target)

    user = comment.fetch("user", nil)
    author = verified_human_login!(
      user,
      context: "comment author",
      expected_login: expected_author
    )

    association = comment.fetch("author_association", "").to_s
    raise Error, "comment author association is not trusted" unless TRUSTED_ASSOCIATIONS.include?(association)

    created_at = comment.fetch("created_at", "").to_s
    updated_at = comment.fetch("updated_at", "").to_s
    raise Error, "comment timestamps are missing" if created_at.empty? || updated_at.empty?
    raise Error, "comment was edited before verification" unless created_at == updated_at

    body = comment.fetch("body", "").to_s
    raise Error, "comment body changed after POST" if expected_body && body != expected_body

    marker = comment_marker(body)
    raise Error, "comment body is not the canonical durable receipt" unless marker

    local = replay_marker(marker, expected_batch_id:)
    raise Error, "comment receipt batch or grammar mismatch" unless local.fetch("well_formed")

    {
      "host" => target.fetch("host"),
      "repo" => target.fetch("repo"),
      "target_type" => target.fetch("type"),
      "target_number" => target.fetch("number"),
      "comment_id" => expected_comment_id,
      "url" => actual_url,
      "author" => author,
      "author_association" => association,
      "created_at" => created_at,
      "updated_at" => updated_at,
      "sha256" => Digest::SHA256.hexdigest(body.encode(Encoding::UTF_8)),
      "marker" => marker
    }
  end

  def target_base_url(target)
    segment = target.fetch("type") == "pull_request" ? "pull" : "issues"
    "https://#{target.fetch('host')}/#{target.fetch('repo')}/#{segment}/#{target.fetch('number')}"
  end

  def verify_issue_url!(value, target)
    uri = URI.parse(value)
    expected_path = "/repos/#{target.fetch('repo')}/issues/#{target.fetch('number')}"
    actual_authority = canonical_host("#{uri.host}:#{uri.port}")
    allowed_authority = target.fetch("host") == "github.com" ? "api.github.com" : target.fetch("host")
    path_matches = [expected_path, "/api/v3#{expected_path}"].include?(uri.path)
    raise Error, "comment issue URL mismatch" unless
      uri.scheme == "https" && actual_authority == allowed_authority && path_matches
    raise Error, "comment issue URL must not include query or fragment" if uri.query || uri.fragment
  rescue URI::InvalidURIError, ArgumentError
    raise Error, "comment issue URL is invalid"
  end

  def pr_description_summary(target:, result:, receipt_url:)
    return unless target.fetch("type") == "pull_request"

    {
      "url" => target_base_url(target),
      "section" => canonical_pr_description_summary(result:, receipt_url:)
    }
  end

  def canonical_pr_description_summary(result:, receipt_url:)
    status = if result.fetch("ready") && result.fetch("blockers").empty?
               "Clean — no outstanding findings or follow-ups."
             elsif result.dig("fields", "verdict") == "UNKNOWN"
               "Unknown — see the durable receipt."
             else
               "Follow-ups remain — see the durable receipt."
             end

    <<~MARKDOWN.chomp
      #{PR_SUMMARY_START}
      #### Completed-batch audit

      **Status:** #{status} [Durable receipt](#{receipt_url}).
      #{PR_SUMMARY_END}
    MARKDOWN
  end

  def comment_marker(body)
    header = [COMMENT_HEADER, LEGACY_COMMENT_HEADER].find do |candidate|
      body.start_with?("#{candidate}\n\n")
    end
    return unless header

    marker = body.delete_prefix("#{header}\n\n")
    marker if marker_state(marker)
  end

  def canonical_comment_body(receipt)
    marker = comment_marker(receipt)
    marker ||= receipt if marker_state(receipt)
    return unless marker

    "#{COMMENT_HEADER}\n\n#{marker}"
  end

  def validate_publication_preflight!(preflight, expected_batch_id:, targets:, coordination_backend: nil)
    valid = publication_preflight_reassessed?(
      preflight,
      expected_batch_id:,
      expected_targets: targets,
      coordination_backend:
    )
    raise PublicationPreflightError, "completed-batch publication preflight is missing or invalid" unless valid
    raise PublicationPreflightError, "completed-batch publication preflight is blocked" unless preflight.fetch("eligible")
  end

  def bind_publication_snapshot(marker, preflight)
    value = publication_snapshot_value(preflight)
    body = marker.delete_prefix("<!-- completed-batch-audit v1\n").delete_suffix("-->\n").delete_suffix("-->")
    body = body.each_line.reject { |line| line.start_with?("publication_snapshot:") }.join
    line = "publication_snapshot: #{value}\n"
    raise Error, "completed-batch audit scope evidence is missing" unless body.match?(/^scope_evidence:.*\n/)

    body = body.sub(/^(scope_evidence:.*\n)/, "\\1#{line}")
    bound = "<!-- completed-batch-audit v1\n#{body.chomp}\n-->\n"
    raise Error, "bound completed-batch publication snapshot is invalid" unless marker_state(bound)

    bound
  end

  def publication_snapshot_value(preflight)
    snapshot = CompletedBatchPublicationPreflight.canonicalize(preflight.fetch("snapshot"))
    encoded_snapshot_value(snapshot, digest: preflight.fetch("snapshot_digest"))
  end

  def encoded_snapshot_value(snapshot, digest: CompletedBatchPublicationPreflight.digest(snapshot))
    canonical = CompletedBatchPublicationPreflight.canonicalize(snapshot)
    encoded = Base64.urlsafe_encode64(JSON.generate(canonical), padding: false)
    "#{digest}; encoding=base64url; data=#{encoded}"
  end

  def publication_snapshot(value)
    match = value.to_s.match(
      /\A(sha256:[0-9a-f]{64}); encoding=base64url; data=([A-Za-z0-9_-]+)\z/
    )
    return unless match

    padding = "=" * ((4 - (match[2].length % 4)) % 4)
    json = Base64.urlsafe_decode64("#{match[2]}#{padding}")
    parsed = JSON.parse(json)
    return unless parsed.is_a?(Hash)

    canonical = CompletedBatchPublicationPreflight.canonicalize(parsed)
    return unless json == JSON.generate(canonical)
    return unless match[1] == CompletedBatchPublicationPreflight.digest(canonical)

    canonical
  rescue ArgumentError, JSON::ParserError
    nil
  end

  def accepted_deferral_snapshot(value)
    snapshot = publication_snapshot(value)
    return unless snapshot.is_a?(Hash)
    return unless snapshot["contract"] == ACCEPTED_DEFERRAL_CONTRACT && snapshot["version"] == 1

    snapshot
  end

  def publication_snapshot_digest(fields)
    value = fields["publication_snapshot"] || fields["accepted_deferral_snapshot"]
    value&.split(";", 2)&.first
  end

  def publication_snapshot_blockers(state, preflight, expected_targets: nil, coordination_backend: nil)
    accepted_value = state.fields["accepted_deferral_snapshot"]
    if accepted_value
      return [ACCEPTED_DEFERRAL_MISMATCH_BLOCKER] unless preflight && expected_targets

      snapshot = accepted_deferral_snapshot(accepted_value)
      return [ACCEPTED_DEFERRAL_MISMATCH_BLOCKER] unless snapshot
      return [] if accepted_deferral_reassessed?(
        snapshot,
        expected_batch_id: state.fields.fetch("batch_id"),
        expected_targets:,
        publication_preflight: preflight,
        coordination_backend:
      )

      return [ACCEPTED_DEFERRAL_MISMATCH_BLOCKER]
    end

    value = state.fields["publication_snapshot"]
    return [PUBLICATION_REFRESH_BLOCKER] if state.fields["audit_status"] == "complete" && !value
    return [] unless value
    return [PUBLICATION_REFRESH_BLOCKER] unless preflight
    return [PUBLICATION_MISMATCH_BLOCKER] unless publication_preflight_reassessed?(
      preflight,
      expected_batch_id: state.fields.fetch("batch_id"),
      expected_targets:,
      coordination_backend:
    )
    return [PUBLICATION_MISMATCH_BLOCKER] unless preflight.fetch("eligible")

    bound = publication_snapshot(value)
    current = CompletedBatchPublicationPreflight.canonicalize(preflight.fetch("snapshot"))
    bound == current ? [] : [PUBLICATION_MISMATCH_BLOCKER]
  end

  def accepted_deferral_assessment(
    input,
    predecessor_marker:,
    predecessor_receipt:,
    expected_batch_id:,
    targets:,
    publication_preflight:,
    coordination_backend:,
    accepted_tracking_issue: nil
  )
    return unless input.is_a?(Hash) && input.keys.sort == %w[contract decision_url version]
    return unless input["contract"] == ACCEPTED_DEFERRAL_INPUT_CONTRACT && input["version"] == 1
    return unless accepted_deferral_predecessor?(predecessor_marker, expected_batch_id:)
    return unless accepted_deferral_product_evidence?(
      publication_preflight,
      expected_batch_id:,
      targets:,
      coordination_backend:
    )

    predecessor = accepted_deferral_predecessor_snapshot(predecessor_marker, predecessor_receipt)
    return unless predecessor

    decision = authenticated_accepted_deferral_decision(
      input.fetch("decision_url"),
      targets:,
      expected_batch_id:,
      predecessor:,
      product_evidence_receipt: publication_preflight.fetch("receipt_digest")
    )
    return unless decision

    blocker_ref = canonical_ref(decision.fetch("blocker_ref"))
    return unless safe_canonical_ref?(blocker_ref)
    return unless accepted_deferral_predecessor_blocker?(predecessor_marker, blocker_ref)

    tracking_issue = authenticated_tracking_issue(
      decision.fetch("tracking_issue"),
      allow_closed: !accepted_tracking_issue.nil?
    )
    return unless tracking_issue && tracking_issue.fetch("url") == blocker_ref.canonical_display

    if accepted_tracking_issue
      return unless accepted_tracking_issue == tracking_issue.merge("state" => "open")

      tracking_issue = accepted_tracking_issue
    end

    CompletedBatchPublicationPreflight.canonicalize(
      "contract" => ACCEPTED_DEFERRAL_CONTRACT,
      "version" => 1,
      "mode" => predecessor_receipt ? "post_publication" : "pre_publication",
      "batch_id" => expected_batch_id,
      "blocker_ref" => blocker_ref.canonical_display,
      "owner" => decision.fetch("owner"),
      "mechanism" => ACCEPTED_DEFERRAL_MECHANISM,
      "input" => input,
      "predecessor" => predecessor,
      "decision" => decision,
      "tracking_issue" => tracking_issue,
      "product_evidence" => {
        "receipt_digest" => publication_preflight.fetch("receipt_digest"),
        "snapshot_digest" => publication_preflight.fetch("snapshot_digest"),
        "blockers" => publication_preflight.fetch("blockers")
      }
    )
  rescue KeyError, TypeError
    nil
  end

  def accepted_deferral_reassessed?(
    snapshot,
    expected_batch_id:,
    expected_targets:,
    publication_preflight:,
    coordination_backend:
  )
    return false unless snapshot.is_a?(Hash)
    return false unless snapshot["batch_id"] == expected_batch_id
    return false unless snapshot["contract"] == ACCEPTED_DEFERRAL_CONTRACT && snapshot["version"] == 1

    predecessor = snapshot["predecessor"]
    return false unless predecessor.is_a?(Hash)

    predecessor_marker = predecessor["marker"]
    predecessor_receipt = if predecessor["url"]
                            reauthenticated_predecessor(predecessor, expected_batch_id:)
                          end
    return false if predecessor["url"] && !predecessor_receipt

    refreshed = accepted_deferral_assessment(
      snapshot.fetch("input"),
      predecessor_marker:,
      predecessor_receipt:,
      expected_batch_id:,
      targets: deterministic_targets(expected_targets),
      publication_preflight:,
      coordination_backend:,
      accepted_tracking_issue: snapshot["tracking_issue"]
    )
    refreshed == snapshot
  rescue Error, KeyError, TypeError, ArgumentError
    false
  end

  def reauthenticated_predecessor(predecessor, expected_batch_id:)
    reference = comment_reference(predecessor.fetch("url"))
    return unless reference

    target = reference.fetch("target")
    comment = gh_api(
      target.fetch("host"),
      "repos/#{target.fetch('repo')}/issues/comments/#{reference.fetch('comment_id')}"
    )
    verified = verify_comment(
      comment,
      target:,
      expected_comment_id: reference.fetch("comment_id"),
      expected_author: predecessor.fetch("author"),
      expected_batch_id:
    )
    comparable = {
      "url" => verified.fetch("url"),
      "comment_id" => verified.fetch("comment_id"),
      "sha256" => "sha256:#{verified.fetch('sha256')}",
      "author" => verified.fetch("author"),
      "created_at" => verified.fetch("created_at"),
      "updated_at" => verified.fetch("updated_at"),
      "marker" => verified.fetch("marker")
    }
    comparable == predecessor ? verified : nil
  rescue Error, KeyError, TypeError, ArgumentError
    nil
  end

  def accepted_deferral_predecessor?(marker, expected_batch_id:)
    state = marker_state(marker)
    return false unless state && state.fields["batch_id"] == expected_batch_id
    return false unless state.fields["audit_status"] == "blocked" && state.fields["verdict"] == "follow-ups-remain"
    return false unless state.records.one? && state.records.first.non_ready?
    return false if state.fields.values.any? { |value| unknown_value?(value) }

    accepted_deferral_predecessor_refs(state)&.one?
  end

  def accepted_deferral_predecessor_blocker?(marker, blocker_ref)
    state = marker_state(marker)
    return false unless state&.records&.one?

    record = state.records.first
    blocker_refs = accepted_deferral_predecessor_refs(state)
    record.ref_identity == blocker_ref.identity && blocker_refs&.one? &&
      blocker_refs.first.identity == blocker_ref.identity
  end

  def accepted_deferral_predecessor_refs(state)
    findings = state.fields.fetch("findings")
    return finding_refs(findings, records: state.records) unless findings == "none"

    state.records.select(&:non_ready?).map do |record|
      CanonicalRef.new(canonical_display: record.ref, identity: record.ref_identity)
    end
  end

  def accepted_deferral_predecessor_snapshot(marker, receipt)
    if receipt
      required = %w[url comment_id sha256 author created_at updated_at marker]
      return unless required.all? { |field| receipt.key?(field) }
      return unless receipt.fetch("marker") == marker

      {
        "url" => receipt.fetch("url"),
        "comment_id" => receipt.fetch("comment_id"),
        "sha256" => "sha256:#{receipt.fetch('sha256')}",
        "author" => receipt.fetch("author"),
        "created_at" => receipt.fetch("created_at"),
        "updated_at" => receipt.fetch("updated_at"),
        "marker" => marker
      }
    else
      body_sha = "sha256:#{Digest::SHA256.hexdigest(marker.encode(Encoding::UTF_8))}"
      {
        "url" => nil,
        "comment_id" => nil,
        "sha256" => body_sha,
        "author" => nil,
        "created_at" => nil,
        "updated_at" => nil,
        "marker" => marker
      }
    end
  end

  def accepted_deferral_product_evidence?(preflight, expected_batch_id:, targets:, coordination_backend:)
    return false unless accepted_deferral_preflight_integrity?(
      preflight,
      expected_batch_id:,
      targets:,
      coordination_backend:
    )
    return false unless publication_preflight_reassessed?(
      preflight,
      expected_batch_id:,
      expected_targets: targets,
      coordination_backend:
    )
    return false unless preflight["eligible"] == false && preflight["verdict"] == "BLOCKED"

    blockers = preflight["blockers"]
    return false unless blockers.is_a?(Array) && blockers.one?
    return false unless blockers.all? do |blocker|
      blocker.is_a?(String) && !unknown_value?(blocker) &&
      ACCEPTED_DEFERRAL_BLOCKER_PATTERNS.any? { |pattern| blocker.match?(pattern) }
    end
    return false if nested_unknown?(preflight)

    coordination = preflight.dig("snapshot", "coordination")
    return false unless coordination.is_a?(Hash) && coordination["status"] == "completed"
    return false unless coordination["verification_source"] == "authenticated agent-coord-bounded"
    return false unless CompletedBatchPublicationPreflight.valid_timestamp?(coordination["updated_at"])
    return false unless CompletedBatchPublicationPreflight.valid_timestamp?(coordination["completed_at"])

    live_coordination = authenticated_publication_coordination_status(
      backend: coordination_backend,
      batch_id: expected_batch_id
    )
    return false unless live_coordination == preflight.dig("source_input", "coordination_status")

    target_rows = preflight.dig("snapshot", "targets")
    qa_rows = preflight.dig("snapshot", "qa")
    return false unless target_rows.is_a?(Array) && qa_rows.is_a?(Array)
    return false unless target_rows.length == targets.length && qa_rows.length == targets.length
    return false unless target_rows.map { |row| validated_target(row["target"]) } == targets
    return false unless qa_rows.map { |row| validated_target(row["target"]) } == targets

    target_rows.all? { |row| accepted_deferral_target_evidence?(row) } &&
      qa_rows.each_with_index.all? do |row, index|
        row.is_a?(Hash) && row["verdict"] == "SATISFIED" && row["status"] == "satisfied" &&
          row["maintainer_waiver"].nil? && row["head_sha"].to_s.match?(/\A[0-9a-f]{40}\z/) &&
          row["head_sha"] == target_rows.fetch(index)["head_sha"] &&
          row["evidence_sha256"].to_s.match?(CompletedBatchPublicationPreflight::DIGEST_PATTERN)
      end
  rescue KeyError, TypeError
    false
  end

  def accepted_deferral_preflight_integrity?(preflight, expected_batch_id:, targets:, coordination_backend:)
    return false unless preflight.is_a?(Hash)
    return false unless preflight["contract"] == CompletedBatchPublicationPreflight::CONTRACT && preflight["version"] == 1
    return false unless preflight["batch_id"] == expected_batch_id
    return false unless preflight["targets"] == targets

    target_identities = targets.map do |target|
      [target.fetch("host").downcase, target.fetch("repo").downcase, target.fetch("type"), target.fetch("number")]
    end
    return false unless target_identities.uniq.length == targets.length

    trusted_backend = CompletedBatchPublicationPreflight.normalized_known_string(coordination_backend)
    return false unless trusted_backend && preflight["coordination_backend"] == trusted_backend

    source_input = preflight["source_input"]
    snapshot = preflight["snapshot"]
    return false unless source_input.is_a?(Hash) && snapshot.is_a?(Hash)
    return false unless source_input["contract"] == CompletedBatchPublicationPreflight::INPUT_CONTRACT
    return false unless source_input["version"] == CompletedBatchPublicationPreflight::VERSION
    return false unless source_input["batch_id"] == expected_batch_id && source_input["expected_targets"] == targets
    return false unless source_input["coordination_status"].is_a?(Hash)
    return false unless source_input["target_snapshots"].is_a?(Array) && source_input["qa_evidence"].is_a?(Array)
    return false unless snapshot["batch_id"] == expected_batch_id && snapshot["coordination_backend"] == trusted_backend
    return false unless preflight["source_input_digest"] == CompletedBatchPublicationPreflight.digest(source_input)
    return false unless preflight["snapshot_digest"] == CompletedBatchPublicationPreflight.digest(snapshot)

    unsigned = preflight.reject { |key, _value| key == "receipt_digest" }

    preflight["receipt_digest"] == CompletedBatchPublicationPreflight.digest(unsigned)
  rescue KeyError, NoMethodError, TypeError
    false
  end

  def accepted_deferral_target_evidence?(row)
    return false unless row.is_a?(Hash)

    target = validated_target(row["target"])
    return false unless target

    expected_state = target.fetch("type") == "pull_request" ? "merged" : "closed"
    return false unless row["state"] == expected_state

    head_sha = row["head_sha"].to_s.downcase
    return false unless head_sha.match?(/\A[0-9a-f]{40}\z/)

    source = parse_target_url(row["source"])
    return false unless source && source.fetch("type") == "pull_request"
    return false unless source.fetch("host") == target.fetch("host") && source.fetch("repo").casecmp?(target.fetch("repo"))
    return false if target.fetch("type") == "pull_request" && source != target

    live_target = gh_api(target.fetch("host"), "repos/#{target.fetch('repo')}/issues/#{target.fetch('number')}")
    return false unless live_target["state"] == "closed" && live_target["html_url"] == target_base_url(target)
    return false if target.fetch("type") == "issue" && live_target.key?("pull_request")
    return false if target.fetch("type") == "pull_request" && !live_target.key?("pull_request")

    live_pr = gh_api(source.fetch("host"), "repos/#{source.fetch('repo')}/pulls/#{source.fetch('number')}")
    live_pr["html_url"] == target_base_url(source) && live_pr["merged_at"].to_s != "" &&
      live_pr.dig("head", "sha").to_s.downcase == head_sha
  rescue Error, KeyError, TypeError, ArgumentError
    false
  end

  def nested_unknown?(value)
    case value
    when Hash
      value.any? { |key, nested| unknown_value?(key.to_s) || nested_unknown?(nested) }
    when Array
      value.any? { |nested| nested_unknown?(nested) }
    when String
      unknown_value?(value)
    else
      false
    end
  end

  def publication_waivers_authenticated?(preflight)
    CompletedBatchPublicationPreflight.authenticated_waivers_valid?(
      preflight,
      waiver_verifier: method(:authenticated_publication_waiver_comment)
    )
  end

  def publication_preflight_reassessed?(preflight, expected_batch_id:, expected_targets:, coordination_backend: nil)
    trusted_backend = CompletedBatchPublicationPreflight.normalized_known_string(coordination_backend)
    return false unless trusted_backend
    return false unless preflight.is_a?(Hash)

    snapshot = preflight["snapshot"]
    return false unless snapshot.is_a?(Hash)

    stored_backend = snapshot["coordination_backend"]
    return false unless stored_backend == trusted_backend
    return false unless CompletedBatchPublicationPreflight.valid_receipt?(
      preflight,
      expected_batch_id:,
      expected_targets:
    )

    CompletedBatchPublicationPreflight.reassessed_receipt_valid?(
      preflight,
      coordination_backend: trusted_backend,
      waiver_verifier: method(:authenticated_publication_waiver_comment),
      target_verifier: method(:authenticated_publication_target_snapshot),
      coordination_verifier: method(:authenticated_publication_coordination_status)
    )
  end

  def authenticated_publication_waiver_comment(host:, repo:, comment_id:)
    comment = gh_api(host, "repos/#{repo}/issues/comments/#{comment_id}")
    author = CompletedBatchPublicationPreflight.waiver_comment_author(comment)
    return unless author

    permission = gh_api(host, "repos/#{repo}/collaborators/#{author}/permission")
    comment if CompletedBatchPublicationPreflight.verified_waiver_author_permission?(comment, permission)
  rescue Error
    nil
  end

  def authenticated_publication_target_snapshot(target:)
    endpoint_type = target.fetch("type") == "pull_request" ? "pulls" : "issues"
    payload = gh_api(
      target.fetch("host"),
      "repos/#{target.fetch('repo')}/#{endpoint_type}/#{target.fetch('number')}"
    )
    CompletedBatchPublicationPreflight.verified_target_api_snapshot(payload, target)
  rescue Error, KeyError
    nil
  end

  def authenticated_publication_coordination_status(backend:, batch_id:)
    CompletedBatchPublicationPreflight.authenticated_coordination_status(backend:, batch_id:)
  end

  def authenticated_accepted_deferral_decision(
    decision_url,
    targets:,
    expected_batch_id:,
    predecessor:,
    product_evidence_receipt:
  )
    reference = comment_reference(decision_url)
    anchor = deterministic_targets(targets).first
    return unless reference && anchor
    return unless reference.fetch("target") == anchor

    comment = gh_api(
      reference.dig("target", "host"),
      "repos/#{reference.dig('target', 'repo')}/issues/comments/#{reference.fetch('comment_id')}"
    )
    return unless comment["id"] == reference.fetch("comment_id") && comment["html_url"] == decision_url

    verify_issue_url!(comment.fetch("issue_url", ""), anchor)
    author = verified_human_login!(comment["user"], context: "accepted-deferral decision author")
    return unless TRUSTED_ASSOCIATIONS.include?(comment["author_association"])
    return unless comment["created_at"].to_s != "" && comment["created_at"] == comment["updated_at"]
    return unless CompletedBatchPublicationPreflight.valid_timestamp?(comment["created_at"])

    permission = gh_api(
      anchor.fetch("host"),
      "repos/#{anchor.fetch('repo')}/collaborators/#{author}/permission"
    )
    verified_human_login!(permission["user"], context: "accepted-deferral permission actor", expected_login: author)
    return unless WRITE_PERMISSIONS.include?(permission["permission"])

    fields = exact_marker_fields(comment["body"], ACCEPTED_DEFERRAL_DECISION_MARKER)
    expected_fields = %w[
      batch_id blocker_ref blocker_category mechanism tracking_issue owner
      original_receipt_sha256 original_receipt_url original_receipt_author
      original_receipt_created_at original_receipt_updated_at product_evidence_receipt decision
    ]
    return unless fields&.keys&.sort == expected_fields.sort
    return unless fields["batch_id"] == expected_batch_id
    return unless fields["blocker_category"] == "workflow-process-mechanism-defect"
    return unless fields["mechanism"] == ACCEPTED_DEFERRAL_MECHANISM
    return unless fields["decision"] == "accepted-deferral"
    return unless fields["product_evidence_receipt"] == product_evidence_receipt
    return unless fields["original_receipt_sha256"] == predecessor.fetch("sha256")
    return unless fields["original_receipt_url"] == (predecessor["url"] || "not-published")
    return unless fields["original_receipt_author"] == (predecessor["author"] || "not-applicable")
    return unless fields["original_receipt_created_at"] == (predecessor["created_at"] || "not-applicable")
    return unless fields["original_receipt_updated_at"] == (predecessor["updated_at"] || "not-applicable")

    if predecessor["created_at"] && !CompletedBatchPublicationPreflight.timestamp_after?(comment["created_at"], predecessor["created_at"])
      return
    end
    return unless safe_owner?(fields["owner"])
    return unless fields["tracking_issue"] == fields["blocker_ref"]

    {
      "url" => decision_url,
      "comment_id" => reference.fetch("comment_id"),
      "body_sha256" => "sha256:#{Digest::SHA256.hexdigest(comment.fetch('body').encode(Encoding::UTF_8))}",
      "author" => author,
      "author_association" => comment.fetch("author_association"),
      "created_at" => comment.fetch("created_at"),
      "updated_at" => comment.fetch("updated_at"),
      "blocker_ref" => fields.fetch("blocker_ref"),
      "tracking_issue" => fields.fetch("tracking_issue"),
      "owner" => fields.fetch("owner")
    }
  rescue Error, KeyError, TypeError, ArgumentError
    nil
  end

  def authenticated_tracking_issue(value, allow_closed: false)
    target = parse_target_url(value)
    return unless target && target.fetch("type") == "issue"

    payload = gh_api(
      target.fetch("host"),
      "repos/#{target.fetch('repo')}/issues/#{target.fetch('number')}"
    )
    return if payload.key?("pull_request")
    return unless payload["number"] == target.fetch("number") && payload["html_url"] == value

    allowed_states = allow_closed ? %w[open closed] : ["open"]
    return unless allowed_states.include?(payload["state"])

    target.merge("url" => value, "state" => payload.fetch("state"))
  rescue Error, KeyError, TypeError, ArgumentError
    nil
  end

  def exact_marker_fields(body, marker_name)
    match = body.to_s.match(/\A<!-- #{Regexp.escape(marker_name)}\n(?<body>.*)\n-->\n?\z/m)
    return unless match

    match[:body].each_line.each_with_object({}) do |line, fields|
      parsed = line.delete_suffix("\n").match(/\A([a-z0-9_]+):[ \t]*(.*)\z/)
      break unless parsed
      break if fields.key?(parsed[1]) || !single_physical_line?(parsed[2])

      value = parsed[2].strip
      break unless evidenced_scalar?(value)

      fields[parsed[1]] = value
    end
  end

  def comment_reference(value)
    uri = URI.parse(value.to_s)
    return unless uri.is_a?(URI::HTTPS) && uri.host && !uri.userinfo && !uri.query

    target = parse_target_url(value)
    fragment = uri.fragment.to_s.match(/\Aissuecomment-(\d+)\z/)
    return unless target && fragment

    { "target" => target, "comment_id" => Integer(fragment[1], 10) }
  rescue URI::InvalidURIError, ArgumentError
    nil
  end

  def parse_target_url(value)
    uri = URI.parse(value.to_s)
    return unless uri.is_a?(URI::HTTPS) && uri.host && !uri.userinfo && !uri.query

    path = uri.path.match(%r{\A/([^/\s]+)/([^/\s]+)/(pull|issues)/(\d+)\z})
    return unless path

    {
      "host" => canonical_host("#{uri.host}:#{uri.port}"),
      "repo" => "#{path[1]}/#{path[2]}",
      "type" => path[3] == "pull" ? "pull_request" : "issue",
      "number" => Integer(path[4], 10)
    }
  rescue URI::InvalidURIError, ArgumentError
    nil
  end

  def safe_owner?(value)
    evidenced_scalar?(value) && value.match?(/\A[A-Za-z0-9_.-]+\z/)
  end

  def trusted_coordination_backend(workflow_config)
    config = YAML.safe_load(File.read(workflow_config, encoding: "UTF-8"), aliases: false)
    raise Error, "workflow config must be a mapping" unless config.is_a?(Hash)

    backend = CompletedBatchPublicationPreflight.normalized_known_string(config["coordination_backend"])
    raise Error, "workflow config coordination_backend is missing or invalid" unless backend

    backend
  rescue Psych::Exception, SystemCallError => e
    raise Error, "workflow config could not be read: #{e.message}"
  end

  def bot_login?(login)
    login.to_s.downcase.end_with?("[bot]")
  end

  def verified_human_login!(user, context:, expected_login: nil)
    raise Error, "#{context} is not a JSON object" unless user.is_a?(Hash)

    login = user.fetch("login", "").to_s
    raise Error, "#{context} login is missing" if login.empty?
    raise Error, "#{context} must not be a bot" if bot_login?(login)
    raise Error, "#{context} login contains unsafe characters" unless login.match?(SAFE_LOGIN_PATTERN)

    type = user.fetch("type", "").to_s
    raise Error, "#{context} type is not a trusted human type" unless TRUSTED_HUMAN_TYPES.include?(type)
    if expected_login && !login.casecmp?(expected_login)
      raise Error, "#{context} login does not match the expected actor"
    end

    login
  end

  def compact_reference(verdict, receipt)
    "Completed-batch audit: #{verdict} — [durable v1 receipt](#{receipt.fetch('url')}); " \
      "SHA-256 `#{receipt.fetch('sha256')}`; author `#{receipt.fetch('author')}`; " \
      "version `#{receipt.fetch('created_at')}/#{receipt.fetch('updated_at')}`."
  end

  def final_status(result)
    return "Conversation status: Ready for archiving." if result.fetch("ready") && result.fetch("blockers").empty?

    "Conversation status: Follow-ups remain — #{result.fetch('blockers').join('; ')}."
  end

  def gh_api(host, endpoint, method: "GET", input: nil)
    command = ["gh", "api", "--hostname", host, endpoint]
    command.concat(["--method", method, "--input", "-"]) unless method == "GET"
    status = nil
    stdout, _stderr, status = capture_process(command, input: input.to_s, timeout: gh_timeout_seconds)
    raise Error, "GitHub API request failed" unless status.success?

    payload = JSON.parse(stdout.force_encoding("UTF-8").scrub)
    raise SuccessfulApiResponseError, "GitHub API response must be a JSON object" unless payload.is_a?(Hash)

    payload
  rescue Timeout::Error
    raise Error, "GitHub API request timed out"
  rescue JSON::ParserError
    error_class = status&.success? ? SuccessfulApiResponseError : Error
    raise error_class, "GitHub API returned invalid JSON"
  rescue SystemCallError
    raise Error, "GitHub API request could not be started"
  end

  def capture_process(command, input:, timeout:)
    CompletedBatchPublicationPreflight.capture_process(command, input:, timeout:)
  end

  def configure_gh_timeout!
    timeout = Integer(
      ENV.fetch("COMPLETED_BATCH_AUDIT_GH_TIMEOUT_SECONDS", DEFAULT_GH_TIMEOUT_SECONDS.to_s),
      exception: false
    )
    unless timeout&.positive?
      raise Error, "COMPLETED_BATCH_AUDIT_GH_TIMEOUT_SECONDS must be a positive integer"
    end

    @gh_timeout_seconds = timeout
  end

  def gh_timeout_seconds
    @gh_timeout_seconds || DEFAULT_GH_TIMEOUT_SECONDS
  end

  def validated_target(target)
    raise ArgumentError, "target must be a JSON object" unless target.is_a?(Hash)

    host = canonical_host(target.fetch("host"))
    repo = target.fetch("repo").to_s
    type = target.fetch("type").to_s
    number = Integer(target.fetch("number"), exception: false)
    raise ArgumentError, "target repo is invalid" unless repo.match?(%r{\A[^/\s]+/[^/\s]+\z})
    raise ArgumentError, "target type is invalid" unless %w[pull_request issue].include?(type)
    raise ArgumentError, "target number is invalid" unless number&.positive?

    { "host" => host, "repo" => repo, "type" => type, "number" => number }
  end

  def canonical_host(value)
    match = value.to_s.match(/\A(?<name>[A-Za-z0-9.-]+)(?::(?<port>\d+))?\z/)
    raise ArgumentError, "target host is invalid" unless match

    name = match[:name].downcase
    labels = name.split(".", -1)
    valid_name = name.length <= 253 && labels.all? do |label|
      label.match?(/\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/)
    end
    raise ArgumentError, "target host is invalid" unless valid_name

    port = match[:port] && Integer(match[:port], 10)
    raise ArgumentError, "target host port is invalid" if port && !(1..65_535).cover?(port)

    port && port != 443 ? "#{name}:#{port}" : name
  end

  def marker_fields(marker)
    envelope = marker.match(/\A<!-- completed-batch-audit v1\n(?<body>.*)\n-->\n?\z/m)
    return unless envelope

    fields = envelope[:body].each_line.each_with_object({}) do |line, parsed|
      raw_line = line.delete_suffix("\n")
      match = raw_line.match(/\A([a-z_]+):[ \t]*(.*)\z/)
      break unless match

      key = match[1]
      break unless FIELDS.include?(key)
      break if parsed.key?(key)
      break unless single_physical_line?(match[2])
      break if match[2].include?("<!--") || match[2].include?("-->")

      parsed[key] = match[2].strip
    end

    accepted = [LEGACY_FIELDS.sort, PUBLICATION_FIELDS.sort, ACCEPTED_DEFERRAL_FIELDS.sort]
    fields if fields && accepted.include?(fields.keys.sort)
  end

  def marker_state(marker)
    fields = marker_fields(marker)
    return unless fields

    records = disposition_records(fields["followups_dispositions"])
    return unless records && scalars_well_formed?(fields, records:) && fields_consistent?(fields, records)
    return if fields.key?("publication_snapshot") && !publication_snapshot(fields["publication_snapshot"])
    return if fields.key?("accepted_deferral_snapshot") &&
              !accepted_deferral_snapshot(fields["accepted_deferral_snapshot"])
    return if fields.key?("publication_snapshot") && fields.key?("accepted_deferral_snapshot")

    State.new(fields:, records:)
  end

  def state_ready?(state)
    fields = state.fields
    return false unless fields["audit_status"] == "complete" && fields["verdict"] == "clean"
    return false unless fields["findings"] == "none"
    return false unless evidenced_scalar?(fields["batch_id"])
    return false unless evidenced_scalar?(fields["scope_evidence"]) && evidenced_scalar?(fields["checker_evidence"])

    state.records.all?(&:fully_evidenced_terminal?)
  end

  def state_blockers(state)
    fields = state.fields
    records = state.records
    scalar_blockers = %w[batch_id audit_status verdict scope_evidence checker_evidence findings].filter_map do |field|
      "#{field}: UNKNOWN" if fields.fetch(field) == "UNKNOWN"
    end
    record_blockers_by_ref = records.filter_map do |record|
      next unless record.non_ready?

      blocker = if record.terminal?
                  "#{record.ref} (terminal): evidence #{record.evidence == 'UNKNOWN' ? 'UNKNOWN' : 'missing'}"
                else
                  "#{record.ref} (#{record.current_status}): #{record.disposition}"
                end
      [record.ref_identity, blocker]
    end.to_h
    record_blockers = record_blockers_by_ref.values
    finding_blockers = finding_refs(fields.fetch("findings"), records:).to_a.map do |ref|
      record_blockers_by_ref.fetch(ref.identity, ref.canonical_display)
    end
    unlisted_record_blockers = record_blockers.reject do |blocker|
      finding_blockers.any? { |finding| finding.casecmp?(blocker) }
    end

    deduped_blockers(scalar_blockers + finding_blockers + unlisted_record_blockers)
  end

  def scalars_well_formed?(fields, records: [])
    well_formed_batch_identity?(fields["batch_id"], fields["scope_evidence"]) &&
      %w[complete blocked UNKNOWN].include?(fields["audit_status"]) &&
      %w[clean follow-ups-remain UNKNOWN].include?(fields["verdict"]) &&
      structurally_valid_scalar?(fields["scope_evidence"]) &&
      structurally_valid_scalar?(fields["checker_evidence"]) &&
      (!fields.key?("publication_snapshot") || structurally_valid_scalar?(fields["publication_snapshot"])) &&
      (!fields.key?("accepted_deferral_snapshot") || structurally_valid_scalar?(fields["accepted_deferral_snapshot"])) &&
      structurally_valid_dispositions?(fields["followups_dispositions"]) &&
      well_formed_findings?(fields["findings"], records:)
  end

  def well_formed_batch_identity?(value, scope_evidence)
    return true if exact_unknown?(value)
    return false unless structurally_valid_scalar?(value) && evidenced_scalar?(value)

    if value.start_with?("non-backend:")
      return value.match?(/\Anon-backend:\s*[^;\s](?:[^;]*[^;\s])?;\s*rationale:\s*[^;\s](?:[^;]*[^;\s])?\z/) &&
             exact_target_scope_evidence?(scope_evidence)
    end
    if value.start_with?("not-applicable:")
      return value.match?(/\Anot-applicable:\s*[^;\s](?:[^;]*[^;\s])?\z/) &&
             exact_target_scope_evidence?(scope_evidence)
    end

    true
  end

  def well_formed_findings?(value, records: [])
    return true if %w[none UNKNOWN].include?(value)

    refs = finding_refs(value, records:)
    structurally_valid_scalar?(value) && value.match?(/\AOUTSTANDING\s+\S(?:.*\S)?\z/) &&
      !unknown_value?(value) && refs && !refs.empty? && refs.all? { |ref| safe_canonical_ref?(ref) } &&
      refs.map(&:identity).uniq.length == refs.length
  end

  def fields_consistent?(fields, records)
    findings = fields.fetch("findings")
    verdict = fields.fetch("verdict")
    non_ready_records = records.select(&:non_ready?)
    outstanding = findings.start_with?("OUTSTANDING ")
    unknown_marker = fields.fetch("audit_status") == "UNKNOWN" && verdict == "UNKNOWN" && findings == "UNKNOWN"
    clean_marker = fields.fetch("audit_status") == "complete" && verdict == "clean" && findings == "none"

    return true if clean_marker && non_ready_records.empty?
    return true if unknown_marker
    return false unless %w[complete blocked].include?(fields.fetch("audit_status"))
    return false unless verdict == "follow-ups-remain"
    return false unless findings == "none" || outstanding
    return false if non_ready_records.empty? && !outstanding

    true
  end

  def exact_target_scope_evidence?(value)
    value.match?(/\Atargets=[^;\s](?:[^;]*[^;\s])?; source=[^;\s](?:[^;]*[^;\s])?\z/) && !unknown_value?(value)
  end

  def evidenced_scalar?(value)
    structurally_valid_scalar?(value) && !unknown_value?(value)
  end

  def structurally_valid_scalar?(value)
    !value.nil? && !value.empty? && single_physical_line?(value) &&
      !value.include?("<!--") && !value.include?("-->") && (exact_unknown?(value) || !unknown_value?(value))
  end

  def structurally_valid_dispositions?(value)
    !value.nil? && !value.empty? && single_physical_line?(value) &&
      !value.include?("<!--") && !value.include?("-->")
  end

  def single_physical_line?(value)
    !value.match?(/[\r\n\0\v\f\u0085\u2028\u2029]/)
  end

  def exact_unknown?(value)
    value == "UNKNOWN"
  end

  def unknown_value?(value)
    value.unicode_normalize(:nfkc).match?(/UNKNOWN/i)
  end

  def disposition_records(value)
    return [] if value == "none"
    return if value.nil? || value.empty?

    records = value.split(/\s+\|\s+/, -1)
    return if records.empty? || records.any? { |record| record.empty? || record.include?("|") }

    seen_refs = {}
    records.each_with_object([]) do |record, parsed_records|
      fields = record.split(/\s*;\s*/, -1).each_with_object({}) do |entry, parsed|
        match = entry.match(/\A(ref|owner|current status|disposition|evidence):\s*(.*)\z/i)
        break unless match

        key = match[1].downcase
        raw_value = match[2]
        break unless single_physical_line?(raw_value)

        field_value = raw_value.strip
        break if parsed.key?(key)
        break unless field_value.empty? ? key == "evidence" : structurally_valid_scalar?(field_value)

        parsed[key] = field_value
      end
      break unless fields&.keys&.sort == ["current status", "disposition", "evidence", "owner", "ref"]

      canonical_ref = canonical_ref(fields.fetch("ref"))
      break unless safe_canonical_ref?(canonical_ref)
      break if seen_refs.key?(canonical_ref.identity)

      seen_refs[canonical_ref.identity] = true
      status = fields.fetch("current status")
      break unless CURRENT_STATUSES.include?(status)

      disposition = fields.fetch("disposition")
      valid_disposition = status == "terminal" ? TERMINAL_DISPOSITIONS.include?(disposition) : NONTERMINAL_ACTIONS.include?(disposition)
      break unless valid_disposition
      break unless evidenced_scalar?(canonical_ref.canonical_display) && evidenced_scalar?(fields.fetch("owner"))
      break unless status == "terminal" || evidenced_scalar?(fields.fetch("evidence"))

      parsed_records << Record.new(
        ref: canonical_ref.canonical_display,
        ref_identity: canonical_ref.identity,
        owner: fields.fetch("owner"),
        current_status: status,
        disposition:,
        evidence: fields.fetch("evidence")
      )
    end
  end

  def canonical_ref(value)
    canonical_display = value.to_s.unicode_normalize(:nfkc).gsub(/[[:space:]]+/, " ").strip
    return if canonical_display.empty?

    CanonicalRef.new(canonical_display:, identity: canonical_display.downcase(:fold))
  end

  def safe_canonical_ref?(reference)
    reference && single_physical_line?(reference.canonical_display) &&
      !reference.canonical_display.include?("<!--") &&
      !reference.canonical_display.include?("-->") && !unknown_value?(reference.canonical_display)
  end

  def safe_external_blocker?(reference)
    reference && single_physical_line?(reference.canonical_display) &&
      !reference.canonical_display.include?("<!--") && !reference.canonical_display.include?("-->")
  end

  def well_formed_other_blocker?(value)
    value.is_a?(String) && single_physical_line?(value) &&
      !value.include?("<!--") && !value.include?("-->") && safe_external_blocker?(canonical_ref(value))
  end

  def normalized_external_blockers(values)
    items = values.is_a?(Array) ? values : [values]
    blockers = items.map do |value|
      if well_formed_other_blocker?(value)
        canonical_ref(value).canonical_display
      else
        INVALID_EXTERNAL_BLOCKER
      end
    end
    deduped_blockers(blockers)
  end

  def failure_blocker(error)
    case error
    when PostOutcomeUnknownError
      POST_OUTCOME_BLOCKER
    when PostReadbackError
      POST_READBACK_BLOCKER
    when AnchorVerificationError
      ANCHOR_VERIFICATION_BLOCKER
    when ReplayGitHubApiError
      REPLAY_GITHUB_API_BLOCKER
    when PublicationPreflightError
      PUBLICATION_PREFLIGHT_BLOCKER
    when AcceptedDeferralError
      ACCEPTED_DEFERRAL_BLOCKER
    else
      INVALID_MARKER_BLOCKER
    end
  end

  def deduped_blockers(blockers)
    blockers.each_with_object([]) do |blocker, deduped|
      canonical = canonical_ref(blocker)
      next unless canonical

      deduped << canonical.canonical_display unless deduped.any? do |known|
        canonical_ref(known).identity == canonical.identity
      end
    end
  end

  def finding_refs(value, records: [])
    return [] unless value.start_with?("OUTSTANDING ")

    raw_refs = value.delete_prefix("OUTSTANDING ")
    known_refs = records.map { |record| CanonicalRef.new(canonical_display: record.ref, identity: record.ref_identity) }
    known_refs.sort_by! { |reference| -reference.canonical_display.length }
    canonical_payload = canonical_ref(raw_refs)
    return unless canonical_payload

    whole_record_ref = known_refs.find { |reference| reference.identity == canonical_payload.identity }
    return [whole_record_ref] if whole_record_ref

    refs = raw_refs.split(/\s*,\s*/, -1).flat_map do |group|
      finding_group_refs(group, known_refs)
    end
    return unless refs && !refs.empty? && refs.none?(&:nil?)

    refs
  end

  def finding_group_refs(group, known_refs)
    canonical_group = canonical_ref(group)
    return unless canonical_group

    tokens = canonical_group.canonical_display.split(" ")
    refs = []
    index = 0
    while index < tokens.length
      remaining_identity = tokens[index..].join(" ").downcase(:fold)
      record_ref = known_refs.find do |known_ref|
        remaining_identity == known_ref.identity || remaining_identity.start_with?("#{known_ref.identity} ")
      end
      if record_ref
        refs << record_ref
        index += record_ref.canonical_display.split(" ").length
      else
        reference = canonical_ref(tokens[index])
        return unless reference

        refs << reference
        index += 1
      end
    end

    refs
  end

  def run(argv)
    command = argv.shift
    unless %w[publish replay supersede].include?(command)
      warn usage
      return 64
    end

    options = { "other_blockers" => [] }
    parser = OptionParser.new do |opts|
      opts.banner = usage
      opts.on("--expected-batch-id ID") { |value| options["expected_batch_id"] = value }
      opts.on("--targets-json PATH") { |value| options["targets_json"] = value }
      opts.on("--receipt PATH") { |value| options["receipt"] = value }
      opts.on("--reference-file PATH") { |value| options["reference_file"] = value }
      opts.on("--publication-preflight PATH") { |value| options["publication_preflight"] = value }
      opts.on("--accepted-deferral PATH") { |value| options["accepted_deferral"] = value }
      opts.on("--workflow-config PATH") { |value| options["workflow_config"] = value }
      opts.on("--other-blocker TEXT") { |value| options.fetch("other_blockers") << value }
      opts.on("-h", "--help") do
        puts opts
        return 0
      end
    end
    parser.parse!(argv)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{argv.join(' ')}" unless argv.empty?

    %w[expected_batch_id targets_json workflow_config].each do |field|
      raise OptionParser::MissingArgument, "--#{field.tr('_', '-')}" if options[field].to_s.empty?
    end

    if command == "publish"
      raise OptionParser::MissingArgument, "--receipt" if options["receipt"].to_s.empty?
      unless options["reference_file"].to_s.empty?
        raise OptionParser::InvalidArgument, "--reference-file is valid only with replay"
      end
    elsif command == "replay"
      raise OptionParser::MissingArgument, "--reference-file" if options["reference_file"].to_s.empty?
      unless options["receipt"].to_s.empty?
        raise OptionParser::InvalidArgument, "--receipt is valid only with publish"
      end
    else
      raise OptionParser::MissingArgument, "--reference-file" if options["reference_file"].to_s.empty?
      raise OptionParser::MissingArgument, "--accepted-deferral" if options["accepted_deferral"].to_s.empty?
      unless options["receipt"].to_s.empty?
        raise OptionParser::InvalidArgument, "--receipt is invalid with supersede"
      end
    end

    coordination_backend = trusted_coordination_backend(options.fetch("workflow_config"))
    configure_gh_timeout!
    targets = JSON.parse(File.read(options.fetch("targets_json"), encoding: "UTF-8"))
    preflight_path = options["publication_preflight"].to_s
    preflight_path = ENV.fetch("COMPLETED_BATCH_AUDIT_PUBLICATION_PREFLIGHT", "") if preflight_path.empty?
    publication_preflight = if preflight_path.empty?
                              nil
                            else
                              JSON.parse(File.read(preflight_path, encoding: "UTF-8"))
                            end
    accepted_deferral_input = if options["accepted_deferral"].to_s.empty?
                                nil
                              else
                                JSON.parse(File.read(options.fetch("accepted_deferral"), encoding: "UTF-8"))
                              end
    result = if command == "publish"
               publish(
                 expected_batch_id: options.fetch("expected_batch_id"),
                 targets:,
                 receipt: File.read(options.fetch("receipt"), encoding: "UTF-8"),
                 other_blockers: options.fetch("other_blockers"),
                 publication_preflight:,
                 coordination_backend:,
                 accepted_deferral_input:
               )
             elsif command == "replay"
               reference_path = options.fetch("reference_file")
               reference = reference_path == "-" ? $stdin.read : File.read(reference_path, encoding: "UTF-8")
               replay_reference(
                 expected_batch_id: options.fetch("expected_batch_id"),
                 targets:,
                 reference:,
                 other_blockers: options.fetch("other_blockers"),
                 publication_preflight:,
                 coordination_backend:
               )
             else
               reference_path = options.fetch("reference_file")
               reference = reference_path == "-" ? $stdin.read : File.read(reference_path, encoding: "UTF-8")
               supersede(
                 expected_batch_id: options.fetch("expected_batch_id"),
                 targets:,
                 reference:,
                 accepted_deferral_input:,
                 publication_preflight:,
                 coordination_backend:,
                 other_blockers: options.fetch("other_blockers")
               )
             end
    puts JSON.pretty_generate(result)
    0
  rescue OptionParser::ParseError => e
    warn "Error: #{e.message}"
    64
  rescue Error, ArgumentError, KeyError, SystemCallError, JSON::ParserError => e
    external_blockers = normalized_external_blockers(options ? options["other_blockers"] : [])
    blockers = deduped_blockers([failure_blocker(e)] + external_blockers)
    result = {
      "well_formed" => false,
      "ready" => false,
      "blockers" => blockers,
      "final_status" => "Conversation status: Follow-ups remain — #{blockers.join('; ')}.",
      "chat_reference" => nil,
      "errors" => [e.message]
    }
    case e
    when PostOutcomeUnknownError
      result["mutation_state"] = "comment-post-outcome-unknown"
    when PostReadbackError
      result["mutation_state"] = "comment-created-readback-unknown"
      result["comment_id"] = e.comment_id
    end
    puts JSON.pretty_generate(result)
    1
  end

  def usage
    "Usage: completed-batch-audit-receipt <publish|replay|supersede> --expected-batch-id ID " \
      "--targets-json PATH --workflow-config PATH (--receipt PATH | --reference-file PATH|-) " \
      "[--publication-preflight PATH] [--accepted-deferral PATH] [--other-blocker TEXT ...]"
  end
end

exit(CompletedBatchAuditReceipt.run(ARGV)) if $PROGRAM_NAME == __FILE__
