#!/usr/bin/env ruby
# frozen_string_literal: true

# Fetch and normalize GitHub PR review data without writing to git or GitHub.
#
# Collapses the repeated `gh api ... | jq` review-fetch blocks (review summaries,
# inline review comments, general issue comments, and the reviewThreads GraphQL
# query) into one read-only call that emits a single normalized JSON document.
# The reviewThreads thread_id/is_resolved metadata is joined onto each inline
# comment by node_id so consumers do not have to redo that join.
#
# Bodies are emitted only for actors the shared trust config marks actionable.
# Metadata-only and non-allowlisted interactions keep their actor, kind, time,
# and URL in `excluded_interactions` so a maintainer can still audit them.
#
# Requires: gh (GitHub CLI). Ruby stdlib only.

require "json"
require "open3"
require "timeout"

require_relative "../../pr-batch/lib/git_probe_env"
require_relative "../../pr-batch/lib/github_actor_trust"

# Pure data shaping (no I/O) plus the gh-backed runner. The pure methods take the
# raw `gh --paginate --slurp` output strings so they can be unit-tested directly.
module FetchPrReviewData
  SUMMARY_MARKER = "<!-- address-review-summary -->"
  PROBE_TIMEOUT_SECONDS = 10

  REVIEW_THREADS_QUERY = <<~GRAPHQL
    query($owner:String!, $name:String!, $pr:Int!, $endCursor:String) {
      repository(owner:$owner, name:$name) {
        pullRequest(number:$pr) {
          reviewThreads(first:100, after:$endCursor) {
            nodes { id isResolved comments(first:100) { nodes { id databaseId } } }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }
  GRAPHQL

  class Error < StandardError; end

  # Decides which actors may supply actionable review text, using the same
  # allowlist and resolution order as pr-security-preflight.
  class TrustBoundary
    def self.for(repo:, trust_config_path: nil, repo_root: nil, team_resolver: nil, repo_local_verifier: nil)
      resolved = GithubActorTrust.resolve_path(trust_config_path, repo_root:, repo_local_verifier:)
      config = GithubActorTrust.load(path: resolved.fetch(:path), global: resolved.fetch(:global))
      new(repo:, config:, source: resolved.fetch(:source), team_resolver:)
    rescue GithubActorTrust::Error => e
      raise Error, e.message
    end

    def initialize(repo:, config:, source:, team_resolver: nil)
      @repo = repo
      @config = config
      @source = source
      @team_resolver = team_resolver
      @team_cache = {}
    end

    def classification(login)
      GithubActorTrust.classify(
        repo: @repo, login:, config: @config, team_cache: @team_cache, team_resolver: @team_resolver
      )
    rescue GithubActorTrust::Error => e
      raise Error, e.message
    end

    def actionable?(login)
      classification(login) == :trusted
    end

    def provenance
      {
        "source" => @source,
        "config_path" => @config.fetch(:path),
        "content_digest" => @config.fetch(:content_digest),
        "actionable_actors" => "trusted-only"
      }
    end
  end

  module_function

  # gh --paginate --slurp wraps the pages of an array endpoint into an outer
  # array (one element per page). Flatten one level to get the items.
  def slurped_items(raw)
    return [] if raw.nil? || raw.strip.empty?

    pages = JSON.parse(raw)
    return [] unless pages.is_a?(Array)

    pages.flat_map { |page| page.is_a?(Array) ? page : [page] }
  end

  # GraphQL --paginate --slurp wraps pages into an array of response objects.
  def thread_nodes(raw)
    return [] if raw.nil? || raw.strip.empty?

    pages = JSON.parse(raw)
    pages = [pages] unless pages.is_a?(Array)
    pages.flat_map do |page|
      page.dig("data", "repository", "pullRequest", "reviewThreads", "nodes") || []
    end
  end

  def build_review_threads(nodes)
    nodes.map do |node|
      {
        "thread_id" => node["id"],
        "is_resolved" => node["isResolved"] ? true : false,
        "comments" => (node.dig("comments", "nodes") || []).map do |comment|
          { "node_id" => comment["id"], "id" => comment["databaseId"] }
        end
      }
    end
  end

  # Map each review comment node_id to its thread metadata.
  def thread_index(review_threads)
    index = {}
    review_threads.each do |thread|
      thread["comments"].each do |comment|
        node_id = comment["node_id"]
        next if node_id.nil?

        index[node_id] = { "thread_id" => thread["thread_id"], "is_resolved" => thread["is_resolved"] }
      end
    end
    index
  end

  # Bounded audit record for an interaction whose body is withheld. Never
  # carries the body: that is the whole point of the exclusion.
  def excluded_record(kind:, raw:, trust:, created_at:, extra: {})
    {
      "kind" => kind,
      "id" => raw["id"],
      "node_id" => raw["node_id"],
      "user" => raw.dig("user", "login"),
      "trust" => trust.to_s,
      "created_at" => created_at,
      "html_url" => raw["html_url"]
    }.merge(extra)
  end

  def build_review_summaries(raw_reviews, trust)
    kept = []
    excluded = []
    raw_reviews.each do |review|
      classification = trust.classification(review.dig("user", "login"))
      if classification != :trusted
        excluded << excluded_record(
          kind: "review_summary", raw: review, trust: classification,
          created_at: review["submitted_at"], extra: { "state" => review["state"] }
        )
        next
      end
      next if review["body"].to_s == ""

      kept << {
        "id" => review["id"],
        "type" => "review_summary",
        "body" => review["body"],
        "state" => review["state"],
        "user" => review.dig("user", "login"),
        "created_at" => review["submitted_at"],
        "html_url" => review["html_url"]
      }
    end
    [kept, excluded]
  end

  def build_inline_comments(raw_inline, index, trust)
    kept = []
    excluded = []
    raw_inline.each do |comment|
      meta = index[comment["node_id"]]
      classification = trust.classification(comment.dig("user", "login"))
      if classification != :trusted
        excluded << excluded_record(
          kind: "review", raw: comment, trust: classification,
          created_at: comment["created_at"],
          # No "path": a PR author picks their own filenames, so it is
          # contributor text. html_url already anchors the audit.
          extra: { "thread_id" => meta && meta["thread_id"] }
        )
        next
      end
      kept << {
        "id" => comment["id"],
        "node_id" => comment["node_id"],
        "type" => "review",
        "path" => comment["path"],
        "body" => comment["body"],
        "line" => comment["line"],
        "start_line" => comment["start_line"],
        "user" => comment.dig("user", "login"),
        "in_reply_to_id" => comment["in_reply_to_id"],
        "created_at" => comment["created_at"],
        "html_url" => comment["html_url"],
        "thread_id" => meta && meta["thread_id"],
        "is_resolved" => meta ? meta["is_resolved"] : false
      }
    end
    [mark_orphaned_replies(kept, excluded), excluded]
  end

  # Triage reads replies only as context for a top-level item, so a trusted
  # reply whose root was excluded would never be looked at. Flag it instead, so
  # it can be triaged on its own without resurrecting the untrusted root.
  def mark_orphaned_replies(kept, excluded)
    excluded_ids = excluded.map { |row| row["id"] }.compact.to_set
    kept.each do |comment|
      parent = comment["in_reply_to_id"]
      comment["root_excluded"] = true if parent && excluded_ids.include?(parent)
    end
    kept
  end

  def build_issue_comments(raw_issue, trust)
    kept = []
    excluded = []
    raw_issue.each do |comment|
      classification = trust.classification(comment.dig("user", "login"))
      if classification != :trusted
        excluded << excluded_record(
          kind: "issue", raw: comment, trust: classification, created_at: comment["created_at"]
        )
        next
      end
      kept << {
        "id" => comment["id"],
        "node_id" => comment["node_id"],
        "type" => "issue",
        "body" => comment["body"],
        "user" => comment.dig("user", "login"),
        "created_at" => comment["created_at"],
        "html_url" => comment["html_url"]
      }
    end
    [kept, excluded]
  end

  # Most recent trusted issue comment whose body starts with the summary
  # marker. Only trusted comments count: the cutoff decides which review
  # comments are treated as already addressed, so honouring a forged marker
  # would let an untrusted actor hide real review feedback.
  def compute_cutoff(trusted_issue_comments)
    trusted_issue_comments
      .select { |comment| comment["body"].to_s.start_with?(SUMMARY_MARKER) }
      .filter_map { |comment| comment["created_at"] }
      .reject(&:empty?)
      .max
      .to_s
  end

  # Build the normalized result hash from the four raw slurped strings.
  #
  # `trust` is required: a caller that could omit it would silently select an
  # unfiltered packet, which is the exposure this boundary exists to close.
  def assemble(repo:, pr_number:, issue_raw:, reviews_raw:, inline_raw:, threads_raw:, trust: nil)
    raise ArgumentError, "assemble requires a trust boundary (trust:)" if trust.nil?

    review_threads = build_review_threads(thread_nodes(threads_raw))
    index = thread_index(review_threads)
    summaries, excluded_summaries = build_review_summaries(slurped_items(reviews_raw), trust)
    inline, excluded_inline = build_inline_comments(slurped_items(inline_raw), index, trust)
    issue, excluded_issue = build_issue_comments(slurped_items(issue_raw), trust)

    {
      "repo" => repo,
      "pr" => pr_number.to_i,
      "trust" => trust.provenance,
      "review_cutoff_at" => compute_cutoff(issue),
      "review_summaries" => summaries,
      "inline_comments" => inline,
      "issue_comments" => issue,
      "review_threads" => review_threads,
      "excluded_interactions" => excluded_issue + excluded_summaries + excluded_inline
    }
  end

  def text_summary(result)
    resolved_inline = result["inline_comments"].count { |comment| comment["is_resolved"] }
    resolved_threads = result["review_threads"].count { |thread| thread["is_resolved"] }
    cutoff = result["review_cutoff_at"].empty? ? "(none)" : result["review_cutoff_at"]
    excluded = result["excluded_interactions"]
    [
      "PR review data for #{result['repo']}##{result['pr']}",
      "trust: #{result['trust']['source']} (#{result['trust']['content_digest']})",
      "review_cutoff_at: #{cutoff}",
      "review_summaries: #{result['review_summaries'].length}",
      "inline_comments: #{result['inline_comments'].length} (#{resolved_inline} in resolved threads)",
      "issue_comments: #{result['issue_comments'].length}",
      "review_threads: #{result['review_threads'].length} (#{resolved_threads} resolved)",
      "excluded_interactions: #{excluded.length} " \
      "(#{excluded.count { |row| row['trust'] == 'metadata_only' }} metadata-only, " \
      "#{excluded.count { |row| row['trust'] == 'untrusted' }} untrusted)"
    ].join("\n")
  end

  USAGE = <<~USAGE.freeze
    Usage: fetch-pr-review-data <pr-number> [options]

    Fetch normalized review data for a full-PR scan: review summary bodies, inline
    review comments (with reviewThreads thread_id/is_resolved joined by node_id),
    general issue comments, the raw review threads, and the latest address-review
    summary-comment timestamp (review_cutoff_at).

    Arguments:
      <pr-number>        PR number to fetch (integer).

    Options:
          --repo REPO          GitHub repo in OWNER/REPO form. Defaults to gh repo view.
          --trust-config PATH  Trusted GitHub actor allowlist. Defaults to the same
                               compatibility order pr-security-preflight uses:
                               repo-local #{GithubActorTrust::DEFAULT_TRUST_CONFIG},
                               $#{GithubActorTrust::USER_TRUST_CONFIG_ENV},
                               #{GithubActorTrust::HOME_TRUST_CONFIG}, then the packaged
                               fail-closed fallback.
          --json               Print JSON (default).
          --text               Print a human-readable count summary instead of JSON.
          --self-check         Run a parser check plus a read-only gh smoke check.
      -h, --help               Show this help.

    Only actors the trust config marks actionable (trusted_users, trusted_bots,
    trusted_teams) contribute bodies. trusted_metadata_bots and non-allowlisted
    actors, including any comment with a missing or hidden login, are summarized
    in excluded_interactions with actor, kind, timestamp, and URL but no body, so
    contributor text can never reach an agent as instructions. The resolved trust
    source, path, and sha256 content digest are bound to the packet under "trust".

    review_cutoff_at is the created_at of the most recent trusted issue comment
    whose body starts with "#{SUMMARY_MARKER}", or "" when none
    exists. Summary and status marker comments are still included in
    issue_comments so consumers can filter them; computing the cutoff here does
    not drop them.

    Requires: gh (GitHub CLI)
  USAGE

  # gh-backed CLI: parses args, fetches the four endpoints, and prints the
  # assembled result. All subprocess calls use array args (no shell).
  class Runner
    def run(argv)
      opts = parse_args(argv)
      if opts[:help]
        puts USAGE
        return 0
      end
      return self_check if opts[:self_check]

      pr_number = validate_pr!(opts[:pr])
      repo = resolve_repo!(opts[:repo])
      print_result(fetch(repo, pr_number, trust_boundary(repo, opts[:trust_config])), opts[:format])
      0
    rescue Error => e
      warn "Error: #{e.message}"
      1
    end

    private

    def parse_args(argv)
      opts = { format: "json", help: false, self_check: false, pr: nil, repo: nil, trust_config: nil }
      args = argv.dup
      until args.empty?
        arg = args.shift
        case arg
        when "--repo" then opts[:repo] = take_value!(args, "--repo")
        when "--trust-config" then opts[:trust_config] = take_value!(args, "--trust-config")
        when "--json" then opts[:format] = "json"
        when "--text" then opts[:format] = "text"
        when "--self-check" then opts[:self_check] = true
        when "-h", "--help" then opts[:help] = true
        when "--" then nil
        else handle_positional(arg, opts)
        end
      end
      opts
    end

    def handle_positional(arg, opts)
      raise Error, "unknown option: #{arg}" if arg.start_with?("-")
      raise Error, "unexpected extra argument: #{arg}" unless opts[:pr].nil?

      opts[:pr] = arg
    end

    def take_value!(args, flag)
      raise Error, "#{flag} requires a value" if args.empty?

      args.shift
    end

    def validate_pr!(pr_number)
      raise Error, "a positive integer PR number is required\n\n#{USAGE}" unless pr_number.to_s.match?(/\A[1-9]\d*\z/)

      pr_number
    end

    # Strict OWNER/REPO: non-empty owner and name, exactly one slash, no spaces.
    REPO_FORMAT = %r{\A[^/\s]+/[^/\s]+\z}

    def resolve_repo!(repo)
      repo ||= capture!("gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip
      raise Error, "--repo must be in OWNER/REPO form (got: '#{repo}')" unless repo.match?(REPO_FORMAT)

      repo
    end

    # No repo_local_verifier: proving a config is repo-local needs the remote
    # *and host* comparison pr-security-preflight does, and address-review can
    # target a different GH_HOST than the checkout. A cheaper probe would accept
    # a same-named repo on another host. Without that proof the config is
    # global, so an unqualified `trusted_teams` slug is dropped with the warning
    # GithubActorTrust already emits rather than rebound to the --repo owner.
    def trust_boundary(repo, trust_config_path)
      TrustBoundary.for(
        repo:,
        trust_config_path:,
        # Only consulted when no explicit config was named, so do not pay for a
        # git subprocess on the --trust-config path.
        repo_root: trust_config_path ? nil : git_toplevel,
        team_resolver: method(:team_member?)
      )
    end

    def git_toplevel
      out, status = capture_probe("git", "rev-parse", "--show-toplevel")
      return unless status&.success?

      root = out.force_encoding("UTF-8").strip
      root unless root.empty?
    end

    # Bounded and environment-sanitized like the preflight's git probe, so a
    # hung credential helper or a GIT_CONFIG_* override cannot stall this tool.
    def capture_probe(*cmd)
      Timeout.timeout(PROBE_TIMEOUT_SECONDS) do
        Open3.capture2(PrBatchGitProbeEnv.probe_env, *cmd)
      end
    rescue Timeout::Error
      warn "WARN: #{cmd.first(3).join(' ')} timed out after #{PROBE_TIMEOUT_SECONDS}s"
      [+"", nil]
    rescue SystemCallError
      [+"", nil]
    end

    # Team membership is a GitHub fact, not a local one; an unreachable API
    # must not silently promote an actor to actionable.
    def team_member?(owner:, slug:, login:)
      out, status = capture_probe(
        "gh", "api", "orgs/#{owner}/teams/#{slug}/memberships/#{login}", "-q", ".state"
      )
      status&.success? ? out.strip == "active" : false
    end

    def fetch(repo, pr_number, trust)
      owner, name = repo.split("/", 2)
      FetchPrReviewData.assemble(
        repo:,
        pr_number:,
        issue_raw: rest("repos/#{repo}/issues/#{pr_number}/comments"),
        reviews_raw: rest("repos/#{repo}/pulls/#{pr_number}/reviews"),
        inline_raw: rest("repos/#{repo}/pulls/#{pr_number}/comments"),
        threads_raw: capture!(
          "gh", "api", "graphql", "--paginate", "--slurp",
          "-f", "owner=#{owner}", "-f", "name=#{name}", "-F", "pr=#{pr_number}",
          "-f", "query=#{REVIEW_THREADS_QUERY}"
        ),
        trust:
      )
    end

    def rest(endpoint)
      capture!("gh", "api", "--paginate", "--slurp", endpoint)
    end

    # Run a command with no shell (array args) and return UTF-8 stdout.
    def capture!(*cmd)
      out, status = Open3.capture2(*cmd)
      raise Error, "command failed: #{cmd.first(3).join(' ')}" unless status.success?

      out.force_encoding("UTF-8")
    end

    def print_result(result, format)
      if format == "text"
        puts FetchPrReviewData.text_summary(result)
      else
        puts JSON.pretty_generate(result)
      end
    end

    def self_check
      errors = self_check_errors(FetchPrReviewData.assemble(**self_check_fixtures, trust: self_check_trust))
      unless errors.empty?
        warn "self-check failed: #{errors.join('; ')}"
        return 1
      end
      puts "assemble parser: ok"
      puts gh_smoke
      puts "self-check passed"
      0
    end

    # Self-check runs against an in-memory allowlist so it stays deterministic
    # wherever the pack is installed. `ok` is trusted; `stranger` is not.
    def self_check_trust
      config = GithubActorTrust.build_config(
        { "trusted_users" => ["ok"] }, contents: "trusted_users:\n  - ok\n",
                                       path: "(self-check)", global: false
      )
      TrustBoundary.new(repo: "owner/repo", config:, source: "self-check")
    end

    def self_check_fixtures
      {
        repo: "owner/repo",
        pr_number: 1234,
        issue_raw: '[[{"id":1,"body":"first","user":{"login":"ok"},"created_at":"2026-01-01T00:00:00Z"},' \
                   '{"id":2,"body":"<!-- address-review-summary -->\nold","user":{"login":"ok"},' \
                   '"created_at":"2026-01-02T00:00:00Z"}],' \
                   '[{"id":3,"body":"<!-- address-review-summary -->\nnew","user":{"login":"ok"},' \
                   '"created_at":"2026-01-03T00:00:00Z"},' \
                   '{"id":4,"body":"<!-- address-review-summary -->\nforged","user":{"login":"stranger"},' \
                   '"created_at":"2026-01-09T00:00:00Z"}]]',
        reviews_raw: '[[{"id":10,"body":"fix it","state":"COMMENTED","user":{"login":"ok"},' \
                     '"submitted_at":"2026-01-04T00:00:00Z"},' \
                     '{"id":11,"body":"","state":"APPROVED","user":{"login":"ok"}}]]',
        inline_raw: '[[{"id":20,"node_id":"RC_20","path":"a.rb","user":{"login":"ok"}},' \
                    '{"id":21,"node_id":"RC_21","path":"b.rb","user":{"login":"ok"}}]]',
        threads_raw: '[{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[' \
                     '{"id":"T_A","isResolved":true,"comments":{"nodes":[{"id":"RC_20","databaseId":20}]}},' \
                     '{"id":"T_B","isResolved":false,"comments":{"nodes":[{"id":"RC_21","databaseId":21}]}}]}}}}}]'
      }
    end

    def self_check_errors(out)
      by_id = out["inline_comments"].to_h { |comment| [comment["id"], comment] }
      errors = []
      errors << "review_cutoff_at=#{out['review_cutoff_at']}" unless out["review_cutoff_at"] == "2026-01-03T00:00:00Z"
      errors << "review_summaries=#{out['review_summaries'].length}" unless out["review_summaries"].length == 1
      errors << "issue_comments=#{out['issue_comments'].length}" unless out["issue_comments"].length == 3
      errors << "RC_20 thread" unless by_id[20]["thread_id"] == "T_A" && by_id[20]["is_resolved"] == true
      errors << "RC_21 resolved" unless by_id[21]["is_resolved"] == false
      excluded = out["excluded_interactions"]
      errors << "excluded=#{excluded.length}" unless excluded.length == 1
      errors << "excluded body leaked" if excluded.any? { |row| row.key?("body") }
      errors
    end

    def gh_smoke
      return "gh smoke: skipped (gh not installed)" unless system("command -v gh > /dev/null 2>&1")

      repo, status = Open3.capture2("gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner")
      return "gh smoke: skipped (gh not authenticated)" unless status.success? && !repo.strip.empty?

      "gh smoke: ok for #{repo.strip}"
    end
  end
end

exit(FetchPrReviewData::Runner.new.run(ARGV)) if $PROGRAM_NAME == __FILE__
