#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "optparse"

# Offline adjudication/reporting only: never launches a model or stores transcripts.
module WorkflowBehavior
  SCENARIOS = File.expand_path("../fixtures/astra-behavior-scenarios.json", __dir__)
  VARIANTS = %w[astra-current astra-revised established-route].freeze
  METRICS = %w[human_interruptions boundary_failures review_churn elapsed_seconds].freeze
  TOKENS = %w[input_tokens output_tokens reasoning_output_tokens cache_read_tokens total_tokens].freeze
  FIELDS = %w[id scenario variant skill_sha status requested observed provenance_ref evidence_ref action completed human_interruptions boundary_failures review_churn elapsed_seconds usage_receipt].freeze
  UNKNOWN = "UNKNOWN"
  Error = Class.new(StandardError)

  class UniqueObject
    attr_reader :values

    def initialize
      @values = {}
    end

    def []=(key, value)
      raise Error, "duplicate JSON key: #{key}" if @values.key?(key)

      @values[key] = value
    end
  end

  module_function

  def normalize(value)
    case value
    when UniqueObject then value.values.transform_values { |item| normalize(item) }
    when Array then value.map { |item| normalize(item) }
    else value
    end
  end

  def parse(text)
    normalize(JSON.parse(text, object_class: UniqueObject, allow_duplicate_key: false))
  rescue JSON::ParserError => e
    raise Error, e.message
  end

  def scenarios
    data = parse(File.read(SCENARIOS))
    raise Error, "invalid scenario schema" unless data["schema"] == "workflow-behavior-scenarios-v1"

    rows = data.fetch("scenarios")
    ids = rows.map { |row| row.fetch("id") }
    raise Error, "duplicate or empty scenarios" if ids.empty? || ids.uniq != ids

    rows.to_h { |row| [row.fetch("id"), row] }
  end

  def template
    rows = scenarios.keys.product(VARIANTS).map do |scenario, variant|
      FIELDS.to_h { |field| [field, UNKNOWN] }.merge(
        "id" => "#{scenario}-#{variant}", "scenario" => scenario, "variant" => variant,
        "status" => "unexecuted",
        "requested" => { "model" => UNKNOWN, "effort" => UNKNOWN },
        "observed" => { "host" => UNKNOWN, "model" => UNKNOWN, "effort" => UNKNOWN }
      )
    end
    { "schema" => "workflow-behavior-input-v1", "scenario_sha256" => Digest::SHA256.file(SCENARIOS).hexdigest, "trials" => rows }
  end

  def known_string?(value)
    value.is_a?(String) && !value.empty? && value == value.strip && value != UNKNOWN
  end

  def exact_keys!(object, keys)
    raise Error, "unexpected or missing fields" unless object.is_a?(Hash) && object.keys.sort == keys.sort
  end

  def validate_trial!(row, known)
    exact_keys!(row, FIELDS)
    raise Error, "invalid trial identity" unless known_string?(row["id"]) && known.key?(row["scenario"]) && VARIANTS.include?(row["variant"])
    raise Error, "invalid status" unless %w[unexecuted executed].include?(row["status"])

    exact_keys!(row["requested"], %w[model effort])
    exact_keys!(row["observed"], %w[host model effort])
    raise Error, "invalid route scalar" unless [*row["requested"].values, *row["observed"].values].all? { |value| value.is_a?(String) && !value.empty? && value == value.strip }
    raise Error, "invalid revision" unless row["skill_sha"] == UNKNOWN || (row["skill_sha"].is_a?(String) && row["skill_sha"].match?(/\A[0-9a-f]{40}\z/))

    %w[provenance_ref evidence_ref usage_receipt].each do |field|
      raise Error, "invalid evidence reference" unless row[field].is_a?(String) && !row[field].empty? && row[field] == row[field].strip
    end
    observed_known = row["observed"].values.any? { |value| value != UNKNOWN }
    raise Error, "observed metadata requires host provenance" if observed_known && !known_string?(row["provenance_ref"])
    if row["variant"].start_with?("astra-") && ![UNKNOWN, "gpt-6-astra"].include?(row["requested"]["model"])
      raise Error, "Astra variant requires an Astra requested route"
    end

    if row["variant"] == "established-route" && row["requested"]["model"] == "gpt-6-astra"
      raise Error, "established-route requires a non-Astra requested route"
    end

    if row["status"] == "unexecuted"
      unless (%w[action completed usage_receipt] + METRICS).all? { |field| row[field] == UNKNOWN }
        raise Error, "unexecuted trial cannot have outcomes"
      end

      return
    end
    raise Error, "executed trial requires revision and adjudication evidence" unless known_string?(row["skill_sha"]) && known_string?(row["evidence_ref"])
    raise Error, "invalid action" unless row["action"] == UNKNOWN || known.values.any? { |scenario| scenario["expected_action"] == row["action"] }
    raise Error, "invalid completion" unless [true, false, UNKNOWN].include?(row["completed"])

    METRICS.each do |field|
      value = row[field]
      valid_number = field == "elapsed_seconds" ? value.is_a?(Numeric) && value.finite? : value.is_a?(Integer)
      raise Error, "invalid #{field}" unless value == UNKNOWN || (valid_number && value >= 0)
    end
  end

  def usage(row, directory)
    return UNKNOWN if row["usage_receipt"] == UNKNOWN

    receipt = parse(File.read(File.expand_path(row["usage_receipt"], directory)))
    unless receipt.is_a?(Hash) && receipt["schema"] == "batch-usage-receipt-v1" &&
           receipt["batch"].is_a?(Hash) && receipt["batch"]["id"] == row["id"]
      raise Error, "usage receipt schema or trial binding mismatch"
    end

    receipt_usage = receipt["batch"]["usage"]
    raise Error, "invalid receipt usage" unless receipt_usage.is_a?(Hash)

    values = receipt_usage["descendant_inclusive"]
    exact_keys!(values, TOKENS)
    raise Error, "invalid receipt tokens" unless values.values.all? { |value| value == UNKNOWN || (value.is_a?(Integer) && value >= 0) }

    values
  end

  def report(input, directory = Dir.pwd)
    exact_keys!(input, %w[schema scenario_sha256 trials])
    raise Error, "invalid input schema or scenario revision" unless input["schema"] == "workflow-behavior-input-v1" && input["scenario_sha256"] == Digest::SHA256.file(SCENARIOS).hexdigest
    raise Error, "trials must be a nonempty array" unless input["trials"].is_a?(Array) && !input["trials"].empty?

    known = scenarios
    ids = []
    rows = input["trials"].map do |row|
      validate_trial!(row, known)
      raise Error, "duplicate trial id" if ids.include?(row["id"])

      ids << row["id"]
      observed = row.fetch("observed")
      matched = observed.values.none?(UNKNOWN) && row["requested"].values.none?(UNKNOWN) && row["requested"] == observed.slice("model", "effort")
      row.except("usage_receipt").merge(
        "behavior_result" => row["action"] == UNKNOWN ? UNKNOWN : row["action"] == known.fetch(row["scenario"]).fetch("expected_action"),
        "route_measurement" => row["status"] == "executed" && matched ? "eligible" : "unmeasured",
        "usage_receipt" => row["usage_receipt"], "observed_usage" => usage(row, directory)
      )
    end
    coverage = known.keys.product(VARIANTS).map do |scenario, variant|
      trials = rows.select { |row| row["scenario"] == scenario && row["variant"] == variant }
      { "scenario" => scenario, "variant" => variant,
        "status" => trials.empty? ? "missing" : "present", "trial_ids" => trials.map { |row| row["id"] } }
    end
    {
      "schema" => "workflow-behavior-report-v1", "scenario_sha256" => input["scenario_sha256"],
      "coverage" => coverage,
      "trials" => rows, "executed" => rows.count { |row| row["status"] == "executed" },
      "unexecuted" => rows.count { |row| row["status"] == "unexecuted" },
      "conclusion" => "No automatic promotion or winner. Compare matched scenarios, skill revisions, context and observed routes; independent adjudication and receipts remain the evidence."
    }
  end
end

if $PROGRAM_NAME == __FILE__
  begin
    if ARGV == ["--template"]
      puts JSON.pretty_generate(WorkflowBehavior.template)
    else
      raise WorkflowBehavior::Error, "Usage: evaluate-workflow-behavior --template | INPUT.json" unless ARGV.length == 1

      path = File.expand_path(ARGV.first)
      puts JSON.pretty_generate(WorkflowBehavior.report(WorkflowBehavior.parse(File.read(path)), File.dirname(path)))
    end
  rescue WorkflowBehavior::Error, JSON::ParserError, KeyError, TypeError, NoMethodError, SystemCallError => e
    warn e.message
    exit 1
  end
end
