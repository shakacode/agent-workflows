#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "date"
require "digest"
require "uri"

module BatchPlanPreflight
  BACKENDS = %w[codex claude generic].freeze
  PURPOSES = %w[implementation investigation].freeze
  RISK_SURFACES = %w[
    ci_workflow
    developer_tooling
    security_boundary
    generated_output
    release_behavior
    broad_runtime
  ].freeze
  QA_DISPOSITIONS = %w[required not-required].freeze
  GITHUB_TARGET_TYPES = %w[github-issue github-pull-request].freeze
  GITHUB_TARGET_KEYS = %w[
    number
    repository
    stable_coordination_identity
    type
    version
  ].freeze
  DURABLE_AD_HOC_TARGET_KEYS = %w[
    durable_authorization_ref
    original_task_identity
    override_name
    repository
    stable_coordination_identity
    target
    trusted_authorizer
    type
    version
  ].freeze
  OVERRIDE_NAME_PATTERN = /\A[a-z0-9][a-z0-9_.-]*\z/
  GENERIC_INTENT_VALUES = %w[fix-it pr-batch publish-pr].freeze
  AD_HOC_TARGET_PATTERN = /\Aadhoc:(\d{8})-([a-z0-9][a-z0-9_.-]*)\z/
  REPOSITORY_SEGMENT_PATTERN = /\A[A-Za-z0-9][A-Za-z0-9._-]*\z/
  REPOSITORY_NAME_PATTERN = /\A[A-Za-z0-9._-]{1,100}\z/
  PROVENANCE_IDENTITY_PATTERN = %r{\A[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:@/-]*\z}
  EXTERNAL_SUPPORT = %w[supported unsupported UNKNOWN].freeze
  APPLICABILITY = %w[applicable not-applicable].freeze
  EDGE_TYPES = %w[edit validation_open merge_order].freeze
  PLANNED_PATH_SOURCE_KINDS = %w[issue design durable-plan].freeze
  PLANNED_PATH_REF_SCHEMES = {
    "issue" => %w[issue],
    "design" => %w[design],
    "durable-plan" => %w[plan-state batch comment]
  }.freeze
  INLINE_LIFECYCLE_FIELDS = %w[
    completed
    completed_at
    completion
    completion_source
    completion_source_kind
    lifecycle
    lifecycle_state
    state
    status
  ].freeze
  LIFECYCLE_STATE_KEYS = %w[
    batch_plan_id
    lane_id
    stage_dependency_plan_id
    state
    state_ref
    type
    version
    wave
  ].freeze
  LIFECYCLE_STATES = %w[planned claimed active blocked completed].freeze
  EXPANSION_PATH_RESERVATION_KEYS = %w[
    batch_plan_id
    evidence_ref
    lane_id
    path
    reason
    stage_dependency_plan_id
    type
    version
    wave
  ].freeze
  EXPANSION_RENAME_RESERVATION_KEYS = %w[
    batch_plan_id
    evidence_ref
    lane_id
    reason
    rename
    stage_dependency_plan_id
    type
    version
    wave
  ].freeze
  GATE_PERMISSIONS = %w[
    read_only_discovery
    branch_worktree_create
    patch_edit
    commit
    push
    pr_open
    final_validation
    merge
  ].freeze
  CAPACITY_ENVELOPE_KEYS = %w[hosts type version].freeze
  CAPACITY_HOST_KEYS = %w[external_quota heavy_root id source worker].freeze
  CAPACITY_SLOT_KEYS = %w[limit occupied].freeze
  HEAVY_ROOT_BUDGET_KEYS = %w[admission limit].freeze
  CAPACITY_SOURCES = %w[verified fallback].freeze
  HEAVY_ROOT_ADMISSION = "heavy-root-admission/v1"
  HOST_ID_PATTERN = /\A[a-z0-9][a-z0-9_.-]*\z/

  module_function

  def violation(code, path, message, lane_ids: nil)
    item = { "code" => code, "path" => path, "message" => message }
    item["lane_ids"] = lane_ids if lane_ids
    item
  end

  def result(status, eligible_lane_ids, held_lane_ids, violations, completed_lane_ids: [], advisories: [],
             held_reasons: {}, capacity: nil)
    {
      "type" => "batch-plan-preflight",
      "version" => 1,
      "status" => status,
      "launch" => {
        "eligible_lane_ids" => status == "accepted" ? eligible_lane_ids : [],
        "held_lane_ids" => status == "accepted" ? held_lane_ids : [],
        "completed_lane_ids" => status == "accepted" ? completed_lane_ids : [],
        "held_reasons" => status == "accepted" ? held_reasons : {}
      },
      "capacity" => capacity || empty_capacity_decision,
      "violations" => violations,
      "advisories" => advisories
    }
  end

  def empty_capacity_decision
    {
      "type" => "per-host-capacity-decision",
      "version" => 1,
      "admitted_worker_slots" => 0,
      "hosts" => []
    }
  end

  def evaluate(input)
    unless input.is_a?(Hash) && input["type"] == "batch-plan-preflight" && input["version"] == 1
      return result(
        "rejected", [], [],
        [violation("unsupported-contract-version", "$",
                   "Expected type batch-plan-preflight with version 1.")]
      )
    end

    lanes = input.fetch("plan").fetch("lanes")
    lane_ids = lanes.map { |lane| lane["id"] }
    plan_violations = validate_plan(input["plan"])
    violations = plan_violations.dup
    advisories = []
    violations.concat(validate_unknown_decisions(input["plan"]))
    infer_missing_lane_host = input["host_capacity"].nil?
    host_capacity, capacity_violations = resolve_host_capacity(
      input["host_capacity"],
      lanes,
      input.dig("plan", "backend")
    )
    violations.concat(capacity_violations)
    plan_violation_codes = plan_violations.map { |item| item["code"] }
    lane_ids_valid = !plan_violation_codes.include?("lane-id-invalid-or-duplicate")
    stage_dependency_plan = input["stage_dependency_plan"]
    stage_dependency_plan_id = stage_dependency_plan["id"] if stage_dependency_plan.is_a?(Hash)
    completed_lane_ids = []
    active_lane_ids = []
    blocked_lane_ids = []
    if lane_ids_valid
      lifecycle_violations, completed_lane_ids, active_lane_ids, blocked_lane_ids = validate_lane_lifecycle_states(
        input["lane_lifecycle_states"],
        input["plan"],
        stage_dependency_plan_id
      )
      violations.concat(lifecycle_violations)
    end
    if host_capacity && lane_ids_valid
      violations.concat(validate_host_capacity_occupancy(
                          host_capacity,
                          lanes,
                          active_lane_ids,
                          blocked_lane_ids,
                          infer_missing_lane_host
                        ))
    end
    file_touch_violations = validate_file_touch_maps(input["file_touch_map"], lane_ids)
    violations.concat(file_touch_violations)
    if file_touch_violations.empty? && lane_ids_valid
      violations.concat(validate_launch_target_file_touch_provenance(
                          lanes,
                          input["file_touch_map"]
                        ))
    end
    reservation_violations, expansion_path_reservations =
      if lane_ids_valid
        validate_expansion_path_reservations(
          input["expansion_path_reservations"],
          input["plan"],
          stage_dependency_plan_id,
          input["file_touch_map"],
          completed_lane_ids
        )
      else
        [[], []]
      end
    violations.concat(reservation_violations)
    violations.concat(validate_stage_dependencies(
                        input["stage_dependency_plan"],
                        input["stage_dependency_gate"],
                        lane_ids
                      ))
    if file_touch_violations.empty? && reservation_violations.empty? && lane_ids_valid
      effective_maps = effective_file_touch_maps(input["file_touch_map"], expansion_path_reservations)
      collision_violations, collision_advisories =
        validate_collisions(
          lanes,
          input["plan"]["serialization_groups"],
          effective_maps,
          input["stage_dependency_plan"],
          input["stage_dependency_gate"],
          completed_lane_ids,
          expansion_path_reservations
        )
      violations.concat(collision_violations)
      advisories = collision_advisories
    end
    violations.concat(validate_external_premises(input["plan"]["external_api_premises"], lane_ids))
    if lane_ids_valid
      violations.concat(validate_external_support(input["plan"]["external_api_premises"], lanes))
    end
    status = violations.empty? ? "accepted" : "rejected"
    eligible_lane_ids, held_lane_ids, held_reasons, capacity_decision =
      if status == "accepted"
        ready_lane_ids, gate_held_lane_ids = launch_partition(
          lanes,
          input["stage_dependency_gate"],
          input["plan"]["active_wave"],
          input["plan"]["serialization_groups"],
          completed_lane_ids,
          active_lane_ids,
          blocked_lane_ids
        )
        apply_host_capacity(
          lanes,
          host_capacity,
          ready_lane_ids,
          gate_held_lane_ids,
          active_lane_ids,
          blocked_lane_ids,
          input["plan"]["active_wave"],
          infer_missing_lane_host
        )
      else
        [[], [], {}, host_capacity ? capacity_decision_for_rejection(host_capacity) : empty_capacity_decision]
      end
    result(
      status,
      eligible_lane_ids,
      held_lane_ids,
      violations,
      completed_lane_ids: completed_lane_ids.sort,
      advisories: advisories,
      held_reasons: held_reasons,
      capacity: capacity_decision
    )
  end

  def resolve_host_capacity(raw_capacity, lanes, backend)
    capacity_supplied = !raw_capacity.nil?
    if raw_capacity.nil?
      host_ids = lanes.filter_map { |lane| lane["host_id"] if nonempty_identity?(lane["host_id"]) }.uniq
      fallback_host_id = host_ids.length == 1 ? host_ids.first : "#{backend || 'generic'}-fallback"
      raw_capacity = {
        "type" => "per-host-capacity-envelope",
        "version" => 1,
        "hosts" => [{
          "id" => fallback_host_id,
          "source" => "fallback",
          "worker" => { "limit" => 1, "occupied" => 0 },
          "heavy_root" => { "limit" => 1, "admission" => HEAVY_ROOT_ADMISSION },
          "external_quota" => { "limit" => 1, "occupied" => 0 }
        }]
      }
    end

    unless valid_host_capacity_envelope_shape?(raw_capacity)
      return [nil, [violation(
        "host-capacity-envelope-invalid",
        "$.host_capacity",
        "Provide per-host-capacity-envelope v1 with unique known hosts and valid independent " \
        "worker, heavy-root, and external-quota budgets."
      )]]
    end

    host_ids = raw_capacity.fetch("hosts").map { |host| host.fetch("id") }
    lane_violations = lanes.filter_map.with_index do |lane, index|
      host_id = effective_lane_host_id(lane, raw_capacity, infer_missing: !capacity_supplied)
      unless host_ids.include?(host_id)
        next violation(
          "lane-host-capacity-unknown",
          "$.plan.lanes[#{index}].host_id",
          "Every lane must select one host declared by the capacity envelope.",
          lane_ids: [lane["id"]].compact
        )
      end
      next if !lane.key?("uses_external_quota") || [true, false].include?(lane["uses_external_quota"])

      violation(
        "lane-external-quota-invalid",
        "$.plan.lanes[#{index}].uses_external_quota",
        "uses_external_quota must be true or false when present.",
        lane_ids: [lane["id"]].compact
      )
    end
    [raw_capacity, lane_violations]
  end

  def valid_host_capacity_envelope_shape?(capacity)
    return false unless capacity.is_a?(Hash) && capacity.keys.sort == CAPACITY_ENVELOPE_KEYS
    return false unless capacity["type"] == "per-host-capacity-envelope" && capacity["version"] == 1

    hosts = capacity["hosts"]
    return false unless hosts.is_a?(Array) && !hosts.empty?
    return false unless hosts.all? { |host| valid_capacity_host?(host) }

    host_ids = hosts.map { |host| host.fetch("id") }
    host_ids.uniq.length == host_ids.length
  end

  def valid_capacity_host?(host)
    return false unless host.is_a?(Hash) && host.keys.sort == CAPACITY_HOST_KEYS
    return false unless host["id"].is_a?(String) && host["id"].match?(HOST_ID_PATTERN) &&
                        !host["id"].casecmp?("UNKNOWN") && CAPACITY_SOURCES.include?(host["source"])
    return false unless valid_capacity_slot_budget?(host["worker"])
    return false unless valid_capacity_slot_budget?(host["external_quota"])

    heavy_root = host["heavy_root"]
    return false unless heavy_root.is_a?(Hash) && heavy_root.keys.sort == HEAVY_ROOT_BUDGET_KEYS &&
                        nonnegative_integer?(heavy_root["limit"]) &&
                        heavy_root["admission"] == HEAVY_ROOT_ADMISSION
    return true unless host["source"] == "fallback"

    host.dig("worker", "limit") <= 1 && heavy_root["limit"] <= 1 &&
      host.dig("external_quota", "limit") <= 1
  end

  def valid_capacity_slot_budget?(budget)
    budget.is_a?(Hash) && budget.keys.sort == CAPACITY_SLOT_KEYS &&
      nonnegative_integer?(budget["limit"]) && nonnegative_integer?(budget["occupied"]) &&
      budget["occupied"] <= budget["limit"]
  end

  def nonnegative_integer?(value)
    value.is_a?(Integer) && value >= 0
  end

  def effective_lane_host_id(lane, capacity, infer_missing:)
    return lane["host_id"] if nonempty_identity?(lane["host_id"])
    return nil unless infer_missing

    hosts = capacity.fetch("hosts")
    hosts.one? ? hosts.first.fetch("id") : nil
  end

  def validate_host_capacity_occupancy(capacity, lanes, active_lane_ids, blocked_lane_ids,
                                       infer_missing_lane_host)
    occupied_lane_ids = active_lane_ids + blocked_lane_ids
    lanes_by_id = lanes.to_h { |lane| [lane["id"], lane] }
    capacity.fetch("hosts").flat_map do |host|
      host_id = host.fetch("id")
      lifecycle_lanes = occupied_lane_ids.filter_map do |lane_id|
        lane = lanes_by_id[lane_id]
        lane_id if lane && effective_lane_host_id(
          lane, capacity, infer_missing: infer_missing_lane_host
        ) == host_id
      end
      quota_lifecycle_lanes = lifecycle_lanes.select do |lane_id|
        lanes_by_id.fetch(lane_id)["uses_external_quota"] == true
      end
      worker_total = host.dig("worker", "occupied") + lifecycle_lanes.length
      quota_total = host.dig("external_quota", "occupied") + quota_lifecycle_lanes.length
      violations = []
      if worker_total > host.dig("worker", "limit")
        violations << violation(
          "host-worker-capacity-overcommitted",
          "$.host_capacity.hosts",
          "Host #{host_id} has more occupied or lifecycle-held worker slots than its declared budget.",
          lane_ids: lifecycle_lanes.sort
        )
      end
      if quota_total > host.dig("external_quota", "limit")
        violations << violation(
          "host-external-quota-overcommitted",
          "$.host_capacity.hosts",
          "Host #{host_id} has more occupied external-quota slots than its declared budget.",
          lane_ids: quota_lifecycle_lanes.sort
        )
      end
      violations
    end
  end

  def validate_plan(plan)
    violations = []
    unless nonempty_identity?(plan["id"])
      violations << violation("batch-plan-id-invalid", "$.plan.id",
                              "Batch plan id must be a nonempty known identity.")
    end
    unless BACKENDS.include?(plan["backend"])
      violations << violation("backend-invalid", "$.plan.backend",
                              "Backend must be exactly codex, claude, or generic.")
    end
    lane_ids = plan.fetch("lanes").map { |lane| lane["id"] }
    if lane_ids.any? { |lane_id| !nonempty_identity?(lane_id) } || lane_ids.uniq.length != lane_ids.length
      violations << violation("lane-id-invalid-or-duplicate", "$.plan.lanes",
                              "Lane ids must be nonempty, known, and unique.")
    end
    lane_waves = plan.fetch("lanes").filter_map { |lane| lane["wave"] }
    unless nonempty_identity?(plan["active_wave"]) && lane_waves.include?(plan["active_wave"])
      violations << violation("active-wave-invalid", "$.plan.active_wave",
                              "Active wave must be a nonempty known wave declared by at least one lane.")
    end
    plan.fetch("lanes").each_with_index do |lane, index|
      path = "$.plan.lanes[#{index}]"
      if (lane.keys & INLINE_LIFECYCLE_FIELDS).any?
        violations << violation(
          "inline-lane-lifecycle-forbidden",
          path,
          "Lane lifecycle cannot be declared inline; provide separate durable lane lifecycle state.",
          lane_ids: [lane["id"]].compact
        )
      end
      unless nonempty_identity?(lane["id"]) && nonempty_identity?(lane["wave"]) &&
             PURPOSES.include?(lane["purpose"])
        violations << violation("lane-record-invalid", path,
                                "Lane requires id, wave, and purpose implementation or investigation.")
      end
      target = lane["target"]
      if target.nil?
        violations << violation(
          "canonical-launch-target-required",
          "#{path}.target",
          "Ordinary launch requires a typed canonical GitHub issue or existing pull request target; " \
          "only a complete trusted task-specific durable ad-hoc override may use an ad-hoc target.",
          lane_ids: [lane["id"]].compact
        )
      elsif !target.is_a?(Hash)
        violations << violation(
          "canonical-launch-target-invalid",
          "#{path}.target",
          "Synthetic or bare target values are not launch identities; provide a typed canonical target record.",
          lane_ids: [lane["id"]].compact
        )
      elsif GITHUB_TARGET_TYPES.include?(target["type"])
        unless valid_github_launch_target?(target)
          violations << violation(
            "canonical-launch-target-invalid",
            "#{path}.target",
            "Canonical GitHub targets require the exact v1 issue or pull-request shape and matching " \
            "repository-qualified stable coordination identity.",
            lane_ids: [lane["id"]].compact
          )
        end
      elsif target["type"] == "trusted-ad-hoc-override"
        unless valid_durable_ad_hoc_launch_target?(target)
          violations << violation(
            "durable-ad-hoc-override-invalid",
            "#{path}.target",
            "Ad-hoc launch requires the exact v1 trusted task-specific durable override shape, durable " \
            "authorization provenance, and matching repository-qualified stable coordination identity.",
            lane_ids: [lane["id"]].compact
          )
        end
      else
        violations << violation(
          "canonical-launch-target-invalid",
          "#{path}.target",
          "Target type must be github-issue, github-pull-request, or trusted-ad-hoc-override.",
          lane_ids: [lane["id"]].compact
        )
      end
      surfaces = lane["changed_surfaces"]
      unless surfaces.is_a?(Array) && surfaces.uniq.length == surfaces.length &&
             surfaces.all? { |surface| RISK_SURFACES.include?(surface) }
        violations << violation("changed-surfaces-invalid", "#{path}.changed_surfaces",
                                "Use only the six pinned changed-surface enums without duplicates.")
        next
      end

      qa = lane["qa"]
      unless qa.is_a?(Hash) && QA_DISPOSITIONS.include?(qa["disposition"])
        violations << violation("qa-disposition-invalid", "#{path}.qa",
                                "QA disposition must be exactly required or not-required.")
        next
      end
      if !surfaces.empty? && qa["disposition"] != "required"
        violations << violation("qa-required-for-risky-surface", "#{path}.qa.disposition",
                                "Every declared risky changed surface requires QA.",
                                lane_ids: [lane["id"]])
      elsif qa["disposition"] == "not-required" &&
            (!qa["rationale"].is_a?(String) || qa["rationale"].strip.empty?)
        violations << violation("qa-not-required-rationale-missing", "#{path}.qa.rationale",
                                "A no-QA disposition requires a nonempty rationale.",
                                lane_ids: [lane["id"]])
      end
    end
    valid_target_identities = plan.fetch("lanes").filter_map do |lane|
      target = lane["target"]
      launch_target_identity_key(target) if valid_launch_target?(target)
    end
    if valid_target_identities.uniq.length != valid_target_identities.length
      violations << violation(
        "canonical-launch-target-duplicate",
        "$.plan.lanes",
        "Each repository-qualified canonical launch identity may appear in at most one lane."
      )
    end
    violations
  end

  def valid_launch_target?(target)
    return false unless target.is_a?(Hash)

    if GITHUB_TARGET_TYPES.include?(target["type"])
      valid_github_launch_target?(target)
    elsif target["type"] == "trusted-ad-hoc-override"
      valid_durable_ad_hoc_launch_target?(target)
    else
      false
    end
  end

  def launch_target_identity_key(target)
    if GITHUB_TARGET_TYPES.include?(target["type"])
      [target.fetch("repository").downcase, target.fetch("number")]
    else
      [target.fetch("repository").downcase, target.fetch("target")]
    end
  end

  def valid_github_launch_target?(target)
    return false unless target.keys.sort == GITHUB_TARGET_KEYS && target["version"] == 1
    return false unless GITHUB_TARGET_TYPES.include?(target["type"])
    return false unless canonical_repository?(target["repository"])
    return false unless target["number"].is_a?(Integer) && target["number"].positive?

    kind = target["type"] == "github-issue" ? "issue" : "pull-request"
    target["stable_coordination_identity"] ==
      "#{target.fetch('repository')}:#{kind}:#{target.fetch('number')}"
  end

  def valid_durable_ad_hoc_launch_target?(target)
    return false unless target.keys.sort == DURABLE_AD_HOC_TARGET_KEYS && target["version"] == 1
    return false unless target["type"] == "trusted-ad-hoc-override"
    return false unless canonical_repository?(target["repository"])
    return false unless valid_ad_hoc_target_identity?(target["target"])
    return false unless target["stable_coordination_identity"] ==
                        "#{target.fetch('repository')}:#{target.fetch('target')}"
    return false unless target["override_name"].is_a?(String) &&
                        target["override_name"].match?(OVERRIDE_NAME_PATTERN)
    return false if target["override_name"].casecmp?("UNKNOWN") ||
                    GENERIC_INTENT_VALUES.include?(target["override_name"].downcase)
    return false unless %w[trusted_authorizer original_task_identity].all? do |field|
      valid_provenance_identity?(target[field])
    end

    durable_authorization_ref?(target["durable_authorization_ref"], target["repository"])
  end

  def valid_provenance_identity?(value)
    return false unless value.is_a?(String) && value.match?(PROVENANCE_IDENTITY_PATTERN)

    component = value.split(":", 2).last
    !component.casecmp?("UNKNOWN") && !GENERIC_INTENT_VALUES.include?(component.downcase)
  end

  def valid_ad_hoc_target_identity?(value)
    match = AD_HOC_TARGET_PATTERN.match(value.to_s)
    return false unless match
    return false if match[2].casecmp?("UNKNOWN")

    Date.strptime(match[1], "%Y%m%d").strftime("%Y%m%d") == match[1]
  rescue Date::Error
    false
  end

  def durable_authorization_ref?(value, repository)
    return false unless durable_state_ref?(value)

    parsed = URI.parse(value)
    return false unless parsed.userinfo.nil? && parsed.query.nil?

    parts = parsed.path.split("/").reject(&:empty?)

    case parsed.scheme
    when "https"
      parsed.host == "github.com" && parsed.port == 443 &&
        parsed.path == "/#{parts.join('/')}" && parts.length == 4 &&
        %w[issues pull].include?(parts[2]) && parts[3].match?(/\A[1-9]\d*\z/) &&
        "#{parts[0]}/#{parts[1]}".casecmp?(repository)
    when "issue"
      issue_target = issue_evidence_target(value)
      issue_target&.first&.casecmp?(repository)
    when "plan-state"
      parsed.port.nil? && canonical_durable_ref_id?(parsed.host) &&
        canonical_plan_state_path?(parsed.path)
    when "batch"
      parsed.port.nil? && canonical_durable_ref_id?(parsed.host) && parsed.path.to_s.empty?
    else
      false
    end
  rescue URI::InvalidURIError
    false
  end

  def canonical_durable_ref_id?(value)
    value.is_a?(String) && value.match?(/\A[a-zA-Z0-9][a-zA-Z0-9._-]*\z/) &&
      !value.casecmp?("UNKNOWN")
  end

  def canonical_plan_state_path?(value)
    return false unless value.match?(%r{\A/[^/\s]+(?:/[^/\s]+)*\z}) && !value.include?("%")

    value.split("/").reject(&:empty?).none? do |part|
      %w[. ..].include?(part) || part.casecmp?("UNKNOWN")
    end
  end

  def canonical_repository?(value)
    return false unless nonempty_identity?(value)

    owner, repository, extra = value.split("/", -1)
    return false unless owner && repository && !extra

    owner.match?(REPOSITORY_SEGMENT_PATTERN) &&
      repository.match?(REPOSITORY_NAME_PATTERN) &&
      !%w[. ..].include?(repository) &&
      !owner.casecmp?("UNKNOWN") &&
      !repository.casecmp?("UNKNOWN")
  end

  def validate_lane_lifecycle_states(states, plan, stage_dependency_plan_id)
    unless states.is_a?(Array)
      return [
        [violation(
          "lane-lifecycle-states-array-required",
          "$.lane_lifecycle_states",
          "Provide the separate durable lane lifecycle state collection, even when empty."
        )],
        [],
        [],
        []
      ]
    end

    lanes_by_id = plan.fetch("lanes").to_h { |lane| [lane.fetch("id"), lane] }
    completed_lane_ids = []
    active_lane_ids = []
    blocked_lane_ids = []
    violations = []
    seen_lane_ids = []
    states.each_with_index do |state, index|
      path = "$.lane_lifecycle_states[#{index}]"
      unless valid_lane_lifecycle_state?(
        state,
        plan["id"],
        stage_dependency_plan_id,
        lanes_by_id
      )
        violations << violation(
          "lane-lifecycle-state-invalid",
          path,
          "Require an ordinary durable lane state with matching plan, dependency-plan, lane, and wave identities."
        )
        next
      end

      seen_lane_ids << state["lane_id"]
      completed_lane_ids << state["lane_id"] if state["state"] == "completed"
      active_lane_ids << state["lane_id"] if state["state"] == "active"
      blocked_lane_ids << state["lane_id"] if state["state"] == "blocked"
    end
    if seen_lane_ids.uniq.length != seen_lane_ids.length
      violations << violation(
        "lane-lifecycle-state-duplicate",
        "$.lane_lifecycle_states",
        "Provide at most one durable lifecycle state per lane."
      )
    end
    [violations, completed_lane_ids.uniq, active_lane_ids.uniq, blocked_lane_ids.uniq]
  end

  def valid_lane_lifecycle_state?(state, batch_plan_id, stage_dependency_plan_id, lanes_by_id)
    return false unless state.is_a?(Hash) && state.keys.sort == LIFECYCLE_STATE_KEYS
    return false unless state["type"] == "lane-lifecycle-state" && state["version"] == 1
    return false unless state["batch_plan_id"] == batch_plan_id &&
                        state["stage_dependency_plan_id"] == stage_dependency_plan_id

    lane = lanes_by_id[state["lane_id"]]
    return false unless lane && state["wave"] == lane["wave"] && LIFECYCLE_STATES.include?(state["state"])

    durable_state_ref?(state["state_ref"])
  end

  def durable_state_ref?(value)
    return false unless nonempty_identity?(value)

    parsed = URI.parse(value)
    !parsed.scheme.to_s.empty? && !parsed.host.to_s.empty?
  rescue URI::InvalidURIError
    false
  end

  def validate_expansion_path_reservations(reservations, plan, stage_dependency_plan_id, maps,
                                           completed_lane_ids)
    return [[], []] if reservations.nil?
    unless reservations.is_a?(Array)
      return [[violation(
        "expansion-path-reservations-invalid",
        "$.expansion_path_reservations",
        "When present, expansion path reservations must be an array of typed durable records."
      )], []]
    end

    lanes_by_id = plan.fetch("lanes").to_h { |lane| [lane["id"], lane] }
    valid_reservations = []
    violations = []
    reservations.each_with_index do |reservation, index|
      path = "$.expansion_path_reservations[#{index}]"
      unless valid_expansion_path_reservation?(
        reservation,
        plan["id"],
        stage_dependency_plan_id,
        lanes_by_id
      )
        violations << violation(
          "expansion-path-reservations-invalid",
          path,
          "Require the exact v1 shape with matching batch, dependency-plan, lane, and wave identities; " \
          "one canonical path or a distinct canonical old/new rename pair; a known reason; and a durable " \
          "evidence reference."
        )
        next
      end

      lane_id = reservation.fetch("lane_id")
      reflected_map = maps.is_a?(Hash) && maps[lane_id].is_a?(Hash) ? maps[lane_id] : {}
      if completed_lane_ids.include?(lane_id) || reservation_reflected?(reservation, reflected_map)
        violations << violation(
          "expansion-path-reservation-stale",
          path,
          "Remove a reservation when its lane completes or its verified file-touch map reflects the path or rename.",
          lane_ids: [lane_id]
        )
        next
      end
      valid_reservations << reservation
    end

    reservation_keys = valid_reservations.map { |reservation| expansion_reservation_identity(reservation) }
    if reservation_keys.uniq.length != reservation_keys.length
      violations << violation(
        "expansion-path-reservation-duplicate",
        "$.expansion_path_reservations",
        "Provide at most one active reservation for each lane and canonical path or rename pair."
      )
    end
    [violations, valid_reservations]
  end

  def valid_expansion_path_reservation?(reservation, batch_plan_id, stage_dependency_plan_id, lanes_by_id)
    return false unless reservation.is_a?(Hash) && reservation["version"] == 1

    shape_valid = case reservation["type"]
                  when "expansion-path-reservation"
                    valid_expansion_path_reservation_shape?(reservation)
                  when "expansion-rename-reservation"
                    valid_expansion_rename_reservation_shape?(reservation)
                  else
                    false
                  end
    return false unless shape_valid
    return false unless reservation["batch_plan_id"] == batch_plan_id &&
                        reservation["stage_dependency_plan_id"] == stage_dependency_plan_id

    lane = lanes_by_id[reservation["lane_id"]]
    return false unless lane && reservation["wave"] == lane["wave"]
    return false unless known_single_line_text?(reservation["reason"])

    durable_state_ref?(reservation["evidence_ref"])
  end

  def valid_expansion_path_reservation_shape?(reservation)
    reservation.keys.sort == EXPANSION_PATH_RESERVATION_KEYS &&
      canonical_repository_relative_path?(reservation["path"])
  end

  def valid_expansion_rename_reservation_shape?(reservation)
    rename = reservation["rename"]
    reservation.keys.sort == EXPANSION_RENAME_RESERVATION_KEYS &&
      rename.is_a?(Hash) && rename.keys.sort == %w[new old] &&
      canonical_repository_relative_path?(rename["old"]) &&
      canonical_repository_relative_path?(rename["new"]) &&
      rename["old"] != rename["new"]
  end

  def expansion_reservation_identity(reservation)
    if reservation["type"] == "expansion-rename-reservation"
      [reservation["lane_id"], reservation["type"], reservation.dig("rename", "old"),
       reservation.dig("rename", "new")]
    else
      [reservation["lane_id"], reservation["type"], reservation["path"]]
    end
  end

  def reservation_reflected?(reservation, map)
    return false unless valid_file_touch_map_shape?(map) && map["source"] == "verified"

    if reservation["type"] == "expansion-rename-reservation"
      Array(map["renames"]).include?(reservation["rename"])
    else
      Array(map["paths"]).include?(reservation["path"])
    end
  end

  def effective_file_touch_maps(maps, reservations)
    effective = maps.to_h do |lane_id, map|
      [lane_id, map.merge("paths" => map.fetch("paths").dup, "renames" => map.fetch("renames").map(&:dup))]
    end
    reservations.each do |reservation|
      map = effective.fetch(reservation.fetch("lane_id"))
      if reservation["type"] == "expansion-rename-reservation"
        rename = reservation.fetch("rename")
        map.fetch("paths").concat(rename.values)
        map.fetch("renames") << rename.dup
      else
        map.fetch("paths") << reservation.fetch("path")
      end
    end
    effective
  end

  def canonicalize(value)
    case value
    when Hash
      value.keys.sort.each_with_object({}) do |key, canonical|
        canonical[key] = canonicalize(value[key])
      end
    when Array
      value.map { |entry| canonicalize(entry) }
    else
      value
    end
  end

  def validate_unknown_decisions(value, path = "$.plan")
    if value.is_a?(Hash)
      return value.flat_map do |key, nested|
        validate_unknown_decisions(nested, "#{path}.#{key}")
      end
    end
    if value.is_a?(Array)
      return value.each_with_index.flat_map do |nested, index|
        validate_unknown_decisions(nested, "#{path}[#{index}]")
      end
    end
    return [] unless value == "UNKNOWN"
    return [] if path.match?(/\.external_api_premises\[\d+\]\.support\z/)
    return [] if path.match?(/\.version_chronology\[\d+\]\.release_date\z/)

    [violation("unknown-decision", path,
               "Literal UNKNOWN is not permitted where the preflight requires a decision.")]
  end

  def validate_file_touch_maps(maps, lane_ids)
    unless maps.is_a?(Hash)
      return [violation("file-touch-map-object-required", "$.file_touch_map",
                        "Provide one unchanged pr-file-touch-map result per lane.")]
    end

    violations = []
    unless maps.keys.tally == lane_ids.tally
      violations << violation("file-touch-map-lanes-mismatch", "$.file_touch_map",
                              "File-touch map keys must exactly match planned lane ids.")
    end
    maps.each do |lane_id, map|
      path = "$.file_touch_map.#{lane_id}"
      if map.is_a?(Hash) && map["type"] == "planned-path-evidence"
        unless valid_planned_path_evidence_shape?(map)
          violations << violation("planned-path-evidence-invalid", path,
                                  "Preserve the exact planned-path-evidence v1 shape and durable provenance.",
                                  lane_ids: [lane_id])
        end
        next
      end
      unless valid_file_touch_map_shape?(map)
        violations << violation("file-touch-map-shape-invalid", path,
                                "Preserve the exact pr-file-touch-map result shape.",
                                lane_ids: [lane_id])
        next
      end
      next if map["source"] == "verified"

      violations << violation("file-touch-map-unverified", "#{path}.source",
                              "Run pr-file-touch-map through both sources; only source verified is launch-safe.",
                              lane_ids: [lane_id])
    end
    violations
  end

  def valid_file_touch_map_shape?(map)
    expected_keys = %w[changed_files paths pr renames repo source]
    return false unless map.is_a?(Hash) && map.keys.sort == expected_keys
    return false unless map["pr"].is_a?(Integer) && map["pr"].positive?
    return false unless nonempty_identity?(map["repo"]) && map["repo"].match?(%r{\A[^/]+/[^/]+\z})
    return false unless map["changed_files"].is_a?(Integer) && map["changed_files"] >= 0
    return false unless map["paths"].is_a?(Array) && map["paths"].uniq.length == map["paths"].length &&
                        map["paths"].all? { |path| canonical_repository_relative_path?(path) }
    return false unless map["renames"].is_a?(Array) && map["renames"].all? do |rename|
      rename.is_a?(Hash) && rename.keys.sort == %w[new old] &&
      canonical_repository_relative_path?(rename["old"]) &&
      canonical_repository_relative_path?(rename["new"])
    end

    map["source"].is_a?(String) && !map["source"].strip.empty?
  end

  def validate_launch_target_file_touch_provenance(lanes, maps)
    lanes.filter_map do |lane|
      target = lane["target"]
      next unless valid_launch_target?(target)

      map = maps[lane["id"]]
      matches =
        if map.is_a?(Hash) && map["source"] == "verified"
          verified_pr_map_matches_target?(map, target)
        elsif target["type"] == "github-pull-request"
          false
        else
          planned_path_evidence_matches_target?(map, target)
        end
      next if matches

      violation(
        "launch-target-file-touch-provenance-mismatch",
        "$.file_touch_map.#{lane['id']}",
        "Verified PR maps require the target repository and, for PR-origin targets, exact target PR; " \
        "issue and trusted ad-hoc targets without an implementation PR require durable planned-path evidence.",
        lane_ids: [lane["id"]].compact
      )
    end
  end

  def verified_pr_map_matches_target?(map, target)
    return false unless valid_file_touch_map_shape?(map) && map["source"] == "verified"
    return false unless map["repo"].casecmp?(target["repository"])

    target["type"] != "github-pull-request" || map["pr"] == target["number"]
  end

  def planned_path_evidence_matches_target?(map, target)
    return false unless valid_planned_path_evidence_shape?(map)
    return true unless map["source_kind"] == "issue"
    return false unless target["type"] == "github-issue"

    issue_evidence_target(map["evidence_ref"]) ==
      [target.fetch("repository").downcase, target.fetch("number")]
  end

  def issue_evidence_target(value)
    parsed = URI.parse(value)
    return nil unless parsed.userinfo.nil? && parsed.query.nil?

    parts = parsed.path.split("/").reject(&:empty?)
    if parsed.scheme == "issue" && parsed.port.nil? &&
       parsed.path == "/#{parts.join('/')}" && parts.length == 2 &&
       parts[1].match?(/\A[1-9]\d*\z/) && canonical_repository?("#{parsed.host}/#{parts[0]}")
      ["#{parsed.host}/#{parts[0]}".downcase, Integer(parts[1], 10)]
    elsif parsed.scheme == "https" && parsed.host == "github.com" && parsed.port == 443 &&
          parsed.path == "/#{parts.join('/')}" && parts.length == 4 &&
          parts[2] == "issues" && parts[3].match?(/\A[1-9]\d*\z/) &&
          canonical_repository?("#{parts[0]}/#{parts[1]}")
      ["#{parts[0]}/#{parts[1]}".downcase, Integer(parts[3], 10)]
    end
  rescue URI::InvalidURIError
    nil
  end

  def valid_planned_path_evidence_shape?(map)
    expected_keys = %w[evidence_ref paths renames source_kind type version]
    return false unless map.is_a?(Hash) && map.keys.sort == expected_keys
    return false unless map["type"] == "planned-path-evidence" && map["version"] == 1
    return false unless PLANNED_PATH_SOURCE_KINDS.include?(map["source_kind"])
    return false unless durable_evidence_ref?(map["evidence_ref"], map["source_kind"])
    return false unless map["paths"].is_a?(Array) && !map["paths"].empty? &&
                        map["paths"].uniq.length == map["paths"].length &&
                        map["paths"].all? { |path| canonical_repository_relative_path?(path) }
    return false unless map["renames"].is_a?(Array) && map["renames"].all? do |rename|
      rename.is_a?(Hash) && rename.keys.sort == %w[new old] &&
      canonical_repository_relative_path?(rename["old"]) &&
      canonical_repository_relative_path?(rename["new"]) &&
      map["paths"].include?(rename["old"]) && map["paths"].include?(rename["new"])
    end

    true
  end

  def canonical_repository_relative_path?(value)
    return false unless nonempty_identity?(value)
    return false if value.include?("\0") || value.include?("\\")
    return false if value.start_with?("/") || value.end_with?("/") || value.include?("//")
    return false if value.match?(/\A[A-Za-z]:/)

    value.split("/").none? { |component| %w[. ..].include?(component) }
  end

  def durable_evidence_ref?(value, source_kind)
    return false unless nonempty_identity?(value)
    return !issue_evidence_target(value).nil? if source_kind == "issue"

    parsed = URI.parse(value)
    return false if parsed.host.to_s.empty?

    PLANNED_PATH_REF_SCHEMES.fetch(source_kind, []).include?(parsed.scheme)
  rescue URI::InvalidURIError
    false
  end

  def validate_stage_dependencies(plan, gate, lane_ids)
    unless plan.is_a?(Hash) && plan["contract"] == "stage-dependency-plan" &&
           plan["version"] == 1 && nonempty_identity?(plan["id"]) &&
           plan["edges"].is_a?(Array)
      return [violation("stage-dependency-plan-invalid", "$.stage_dependency_plan",
                        "Provide the trusted stage-dependency-plan v1 object.")]
    end
    unless gate.is_a?(Hash) && gate["contract"] == "stage-dependency-gate" &&
           gate["version"] == 1 && %w[eligible gated].include?(gate["status"]) &&
           nonempty_identity?(gate["trusted_plan_id"]) &&
           gate["lanes"].is_a?(Array)
      return [violation("stage-dependency-gate-incomplete", "$.stage_dependency_gate",
                        "Provide a completed stage-dependency-gate v1 result, not raw live input.")]
    end

    violations = []
    edge_ids = plan.fetch("edges").filter_map { |edge| edge["id"] if edge.is_a?(Hash) }
    edges_valid = edge_ids.length == plan.fetch("edges").length &&
                  edge_ids.uniq.length == edge_ids.length &&
                  plan.fetch("edges").all? do |edge|
                    nonempty_identity?(edge["id"]) &&
                      lane_ids.include?(edge["from"]) && lane_ids.include?(edge["to"]) &&
                      edge["from"] != edge["to"] && EDGE_TYPES.include?(edge["type"])
                  end
    unless edges_valid
      violations << violation("stage-dependency-plan-edge-invalid", "$.stage_dependency_plan.edges",
                              "Edges need unique ids, known distinct endpoints, and a pinned edge type.")
    end
    if gate["trusted_plan_id"] != plan["id"]
      violations << violation("stage-dependency-gate-plan-mismatch", "$.stage_dependency_gate.trusted_plan_id",
                              "Gate trusted_plan_id must equal the supplied trusted plan id.")
    end
    binding = gate["trusted_plan_binding"]
    if !binding.is_a?(String) || binding.strip.empty?
      violations << violation(
        "stage-dependency-gate-plan-binding-missing",
        "$.stage_dependency_gate.trusted_plan_binding",
        "Gate trusted_plan_binding is required."
      )
    elsif binding.strip.casecmp?("UNKNOWN")
      violations << violation(
        "stage-dependency-gate-plan-binding-unknown",
        "$.stage_dependency_gate.trusted_plan_binding",
        "Gate trusted_plan_binding must be known."
      )
    elsif !binding.match?(/\Asha256:[0-9a-f]{64}\z/)
      violations << violation(
        "stage-dependency-gate-plan-binding-malformed",
        "$.stage_dependency_gate.trusted_plan_binding",
        "Gate trusted_plan_binding must be sha256 followed by 64 lowercase hex characters."
      )
    elsif edges_valid && binding != stage_dependency_plan_binding(plan)
      violations << violation(
        "stage-dependency-gate-plan-binding-mismatch",
        "$.stage_dependency_gate.trusted_plan_binding",
        "Gate trusted_plan_binding must match the supplied trusted dependency graph."
      )
    end
    gate_lane_ids = gate.fetch("lanes").filter_map { |lane| lane["id"] if lane.is_a?(Hash) }
    if gate_lane_ids.tally != lane_ids.tally
      violations << violation("stage-dependency-gate-lanes-mismatch", "$.stage_dependency_gate.lanes",
                              "Completed gate lane ids must exactly match planned lane ids.")
    end
    unless gate.fetch("lanes").all? { |lane| valid_gate_lane?(lane) }
      violations << violation("stage-dependency-gate-lane-invalid", "$.stage_dependency_gate.lanes",
                              "Preserve each completed gate lane and all boolean permission decisions.")
    end
    violations
  end

  def stage_dependency_plan_binding(plan)
    immutable_edges = plan.fetch("edges").map do |edge|
      edge.slice("id", "from", "to", "type")
    end
    immutable_edges.sort_by! { |edge| edge.values_at("id", "from", "to", "type") }
    payload = {
      "contract" => plan.fetch("contract"),
      "id" => plan.fetch("id"),
      "edges" => immutable_edges
    }

    "sha256:#{Digest::SHA256.hexdigest(JSON.generate(canonicalize(payload)))}"
  end

  def valid_gate_lane?(lane)
    expected_keys = %w[base_refresh blockers hosted_ci id permissions]
    return false unless lane.is_a?(Hash) && lane.keys.sort == expected_keys
    return false unless nonempty_identity?(lane["id"])
    return false unless %w[eligible-via-repo-seam not-yet-eligible].include?(lane["hosted_ci"])
    return false unless lane["blockers"].is_a?(Array) && lane["base_refresh"].is_a?(Array)

    permissions = lane["permissions"]
    permissions.is_a?(Hash) && permissions.keys.sort == GATE_PERMISSIONS.sort &&
      permissions.values.all? { |value| [true, false].include?(value) }
  end

  def validate_collisions(lanes, groups, maps, _dependency_plan, _gate, _completed_lane_ids, reservations)
    lanes_by_id = lanes.to_h { |lane| [lane.fetch("id"), lane] }
    lane_ids = lanes_by_id.keys.sort
    violations = []
    advisories = []
    lane_ids.combination(2) do |left_id, right_id|
      collision_paths = colliding_paths(maps.fetch(left_id), maps.fetch(right_id))
      next if collision_paths.empty?
      next if lanes_by_id.fetch(left_id)["wave"] != lanes_by_id.fetch(right_id)["wave"]

      reservation_collision = collision_paths.any? do |path|
        reservations.any? do |reservation|
          [left_id, right_id].include?(reservation["lane_id"]) && reservation_collides_with_path?(reservation, path)
        end
      end
      advisories << violation(
        "file-overlap-advisory",
        "$.file_touch_map",
        "Same-wave lanes share changed path(s); treat this as integration care, not a launch dependency: " \
        "#{collision_paths.sort.join(', ')}.",
        lane_ids: [left_id, right_id]
      )
      if reservation_collision
        next if serialized_by_group?(lanes_by_id.fetch(left_id), lanes_by_id.fetch(right_id), groups)

        violations << violation(
          "unsafe-concurrent-edit",
          "$.file_touch_map",
          "Same-wave lanes share active expansion reservation path(s) without max-1 serialization: " \
          "#{collision_paths.sort.join(', ')}.",
          lane_ids: [left_id, right_id]
        )
      end
    end
    [violations, advisories]
  end

  def colliding_paths(left_map, right_map)
    left_paths = left_map.fetch("paths")
    right_paths = right_map.fetch("paths")
    paths = left_paths & right_paths
    left_map.fetch("renames").each do |rename|
      paths.concat(right_paths.select { |path| rename.values.any? { |endpoint| path.start_with?("#{endpoint}/") } })
    end
    right_map.fetch("renames").each do |rename|
      paths.concat(left_paths.select { |path| rename.values.any? { |endpoint| path.start_with?("#{endpoint}/") } })
    end
    paths.uniq
  end

  def reservation_collides_with_path?(reservation, path)
    return reservation["path"] == path unless reservation["type"] == "expansion-rename-reservation"

    reservation.fetch("rename").values.any? do |endpoint|
      path == endpoint || path.start_with?("#{endpoint}/")
    end
  end

  def serialized_by_group?(left, right, groups)
    group_id = left["serialization_group"]
    return false unless group_id.is_a?(String) && group_id == right["serialization_group"]

    groups.is_a?(Array) && groups.any? do |group|
      group.is_a?(Hash) && group["id"] == group_id && group["max_concurrency"] == 1
    end
  end

  def launch_partition(lanes, gate, active_wave, serialization_groups, completed_lane_ids, active_lane_ids,
                       blocked_lane_ids)
    gate_lanes = gate.fetch("lanes").to_h { |lane| [lane.fetch("id"), lane] }
    eligible = []
    held = []
    lanes.each do |lane|
      lane_id = lane.fetch("id")
      next if completed_lane_ids.include?(lane_id) || active_lane_ids.include?(lane_id)

      if blocked_lane_ids.include?(lane_id)
        held << lane_id
        next
      end

      gate_lane = gate_lanes.fetch(lane_id)
      if lane["wave"] != active_wave
        held << lane_id
        next
      end
      allowed = if lane["purpose"] == "investigation"
                  gate_lane.dig("permissions", "read_only_discovery") == true
                else
                  gate_lane.dig("permissions", "patch_edit") == true
                end
      if allowed
        eligible << lane_id
      else
        held << lane_id
      end
    end
    lanes_by_id = lanes.to_h { |lane| [lane.fetch("id"), lane] }
    serialized_group_ids = Array(serialization_groups).filter_map do |group|
      group["id"] if group.is_a?(Hash) && group["max_concurrency"] == 1
    end
    serialized_group_ids.uniq.sort.each do |group_id|
      group_lane_ids = eligible.select do |lane_id|
        lanes_by_id.fetch(lane_id)["serialization_group"] == group_id
      end.sort
      group_occupied = (active_lane_ids + blocked_lane_ids).any? do |lane_id|
        lanes_by_id.fetch(lane_id)["serialization_group"] == group_id
      end
      held_group_lane_ids = group_occupied ? group_lane_ids : group_lane_ids.drop(1)
      held.concat(held_group_lane_ids)
      eligible -= held_group_lane_ids
    end
    [eligible.sort, held.sort]
  end

  def apply_host_capacity(lanes, capacity, ready_lane_ids, gate_held_lane_ids, active_lane_ids,
                          blocked_lane_ids, active_wave, infer_missing_lane_host)
    lanes_by_id = lanes.to_h { |lane| [lane.fetch("id"), lane] }
    lifecycle_occupied_ids = active_lane_ids + blocked_lane_ids
    admitted = []
    capacity_held = []
    held_reasons = {}
    host_decisions = capacity.fetch("hosts").sort_by { |host| host.fetch("id") }.map do |host|
      host_id = host.fetch("id")
      lifecycle_host_lane_ids = lifecycle_occupied_ids.select do |lane_id|
        effective_lane_host_id(
          lanes_by_id.fetch(lane_id), capacity, infer_missing: infer_missing_lane_host
        ) == host_id
      end
      available_worker_slots = host.dig("worker", "limit") - host.dig("worker", "occupied") -
                               lifecycle_host_lane_ids.length
      available_external_quota = host.dig("external_quota", "limit") -
                                 host.dig("external_quota", "occupied") -
                                 lifecycle_host_lane_ids.count do |lane_id|
                                   lanes_by_id.fetch(lane_id)["uses_external_quota"] == true
                                 end
      admitted_for_host = []
      admitted_quota_count = 0
      ready_for_host = ready_lane_ids.select do |lane_id|
        effective_lane_host_id(
          lanes_by_id.fetch(lane_id), capacity, infer_missing: infer_missing_lane_host
        ) == host_id
      end.sort
      ready_for_host.each do |lane_id|
        lane = lanes_by_id.fetch(lane_id)
        if admitted_for_host.length >= available_worker_slots
          capacity_held << lane_id
          held_reasons[lane_id] = "worker-budget-full"
        elsif lane["uses_external_quota"] == true && admitted_quota_count >= available_external_quota
          capacity_held << lane_id
          held_reasons[lane_id] = "external-quota-full"
        else
          admitted_for_host << lane_id
          admitted_quota_count += 1 if lane["uses_external_quota"] == true
        end
      end
      admitted.concat(admitted_for_host)

      gate_held_for_host = gate_held_lane_ids.select do |lane_id|
        lane = lanes_by_id[lane_id]
        lane && lane["wave"] == active_wave && effective_lane_host_id(
          lane, capacity, infer_missing: infer_missing_lane_host
        ) == host_id
      end
      next_lane_reason = if admitted_for_host.length >= available_worker_slots
                           "worker-budget-full"
                         elsif ready_for_host.any? { |lane_id| held_reasons[lane_id] == "external-quota-full" }
                           "external-quota-full"
                         elsif gate_held_for_host.any? { |lane_id| blocked_lane_ids.include?(lane_id) }
                           "ownership-or-lifecycle-blocked"
                         elsif gate_held_for_host.any?
                           "dependency-or-protected-gate"
                         else
                           "no-ready-work"
                         end
      {
        "id" => host_id,
        "source" => host.fetch("source"),
        "worker" => host.fetch("worker").merge(
          "lifecycle_occupied" => lifecycle_host_lane_ids.length,
          "available" => available_worker_slots,
          "admitted" => admitted_for_host.length
        ),
        "heavy_root" => host.fetch("heavy_root"),
        "external_quota" => host.fetch("external_quota").merge(
          "lifecycle_occupied" => lifecycle_host_lane_ids.count do |lane_id|
            lanes_by_id.fetch(lane_id)["uses_external_quota"] == true
          end,
          "available" => available_external_quota,
          "admitted" => admitted_quota_count
        ),
        "next_lane_reason" => next_lane_reason
      }
    end

    gate_held_lane_ids.each do |lane_id|
      lane = lanes_by_id.fetch(lane_id)
      held_reasons[lane_id] ||= if lane["wave"] != active_wave
                                  "inactive-wave"
                                elsif blocked_lane_ids.include?(lane_id)
                                  "ownership-or-lifecycle-blocked"
                                else
                                  "dependency-or-protected-gate"
                                end
    end
    decision = {
      "type" => "per-host-capacity-decision",
      "version" => 1,
      "admitted_worker_slots" => admitted.length,
      "hosts" => host_decisions
    }
    [admitted.sort, (gate_held_lane_ids + capacity_held).uniq.sort, held_reasons.sort.to_h, decision]
  end

  def capacity_decision_for_rejection(capacity)
    {
      "type" => "per-host-capacity-decision",
      "version" => 1,
      "admitted_worker_slots" => 0,
      "hosts" => capacity.fetch("hosts").sort_by { |host| host.fetch("id") }.map do |host|
        {
          "id" => host.fetch("id"),
          "source" => host.fetch("source"),
          "worker" => host.fetch("worker").merge(
            "lifecycle_occupied" => 0,
            "available" => 0,
            "admitted" => 0
          ),
          "heavy_root" => host.fetch("heavy_root"),
          "external_quota" => host.fetch("external_quota").merge(
            "lifecycle_occupied" => 0,
            "available" => 0,
            "admitted" => 0
          ),
          "next_lane_reason" => "preflight-rejected"
        }
      end
    }
  end

  def validate_external_support(premises, lanes)
    lanes_by_id = lanes.to_h { |lane| [lane.fetch("id"), lane] }
    Array(premises).filter_map.with_index do |premise, index|
      next unless premise.is_a?(Hash) && %w[unsupported UNKNOWN].include?(premise["support"])

      implementation_lane_ids = Array(premise["lane_ids"]).select do |lane_id|
        lanes_by_id[lane_id]&.fetch("purpose", nil) == "implementation"
      end
      next if implementation_lane_ids.empty?

      violation(
        "external-api-support-blocks-implementation",
        "$.plan.external_api_premises[#{index}].support",
        "#{premise['support']} external API support permits investigation only.",
        lane_ids: implementation_lane_ids.sort
      )
    end
  end

  def validate_external_premises(premises, lane_ids)
    unless premises.is_a?(Array)
      return [violation("external-api-premises-array-required", "$.plan.external_api_premises",
                        "External API premises must be an array.")]
    end

    violations = []
    premises.each_with_index do |premise, index|
      path = "$.plan.external_api_premises[#{index}]"
      unless premise.is_a?(Hash)
        violations << violation("external-api-premise-invalid", path, "Premise must be an object.")
        next
      end
      unless nonempty_identity?(premise["id"]) && premise["lane_ids"].is_a?(Array) &&
             !premise["lane_ids"].empty? && premise["lane_ids"].uniq.length == premise["lane_ids"].length &&
             premise["lane_ids"].all? { |lane_id| lane_ids.include?(lane_id) }
        violations << violation("external-api-premise-identity-invalid", path,
                                "Premise id and unique known lane_ids are required.")
      end
      unless EXTERNAL_SUPPORT.include?(premise["support"])
        violations << violation("external-api-support-invalid", "#{path}.support",
                                "Support must be exactly supported, unsupported, or UNKNOWN.")
      end
      sources = premise["primary_sources"]
      unless sources.is_a?(Array) && !sources.empty? && sources.all? { |url| primary_url?(url) }
        violations << violation("external-api-primary-sources-invalid", "#{path}.primary_sources",
                                "Provide one or more nonempty HTTP(S) primary-source URLs.")
      end
      unless iso_date?(premise["retrieved_date"])
        violations << violation("external-api-retrieved-date-invalid", "#{path}.retrieved_date",
                                "Retrieved date must be a real ISO YYYY-MM-DD date.")
      end
      chronology = premise["version_chronology"]
      next if chronology.is_a?(Array) && !chronology.empty? &&
              chronology.all? { |row| valid_chronology_row?(row) }

      violations << violation("external-api-chronology-row-invalid", "#{path}.version_chronology",
                              "Each chronology row needs version, pinned applicability, source_url, " \
                              "and an ISO release_date or literal UNKNOWN.")
    end
    violations
  end

  def valid_chronology_row?(row)
    row.is_a?(Hash) &&
      nonempty_identity?(row["version"]) &&
      APPLICABILITY.include?(row["applicability"]) &&
      primary_url?(row["source_url"]) &&
      (row["release_date"] == "UNKNOWN" || iso_date?(row["release_date"]))
  end

  def nonempty_identity?(value)
    value.is_a?(String) && !value.strip.empty? && value != "UNKNOWN"
  end

  def known_single_line_text?(value)
    nonempty_identity?(value) && !value.match?(/[\r\n\0]/)
  end

  def iso_date?(value)
    value.is_a?(String) && value.match?(/\A\d{4}-\d{2}-\d{2}\z/) &&
      Date.iso8601(value).iso8601 == value
  rescue Date::Error
    false
  end

  def primary_url?(value)
    return false unless value.is_a?(String) && !value.strip.empty?

    parsed = URI.parse(value)
    %w[http https].include?(parsed.scheme) && !parsed.host.to_s.empty?
  rescue URI::InvalidURIError
    false
  end
end

begin
  parsed_input = JSON.parse($stdin.read)
rescue JSON::ParserError
  parsed_input = nil
  output = BatchPlanPreflight.result(
    "rejected", [], [],
    [BatchPlanPreflight.violation("malformed-json", "$", "Input must be valid JSON.")]
  )
end
begin
  output ||= BatchPlanPreflight.evaluate(parsed_input)
rescue KeyError, NoMethodError, TypeError, ArgumentError
  output = BatchPlanPreflight.result(
    "rejected", [], [],
    [BatchPlanPreflight.violation(
      "invalid-envelope",
      "$",
      "The v1 envelope is incomplete or contains malformed structured fields."
    )]
  )
end
puts JSON.generate(output)
exit(output["status"] == "accepted" ? 0 : 1)
