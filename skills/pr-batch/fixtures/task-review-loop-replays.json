      "expected": {
        "status": "blocked",
        "dependent_task_permitted": false,
        "reasons": ["cap-piercing-finding-open"]
      }
    },
    {
      "name": "load-bearing-blocker",
      "expected": {
        "status": "blocked",
        "dependent_task_permitted": false,
        "reasons": ["load-bearing-finding-open"]
      }
    },
    {
      "name": "reviewer-independence",
      "expected": {
        "status": "blocked",
        "dependent_task_permitted": false,
        "reasons": ["reviewer-not-independent"]
      }
