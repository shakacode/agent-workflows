#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "digest"
require "json"
require "optparse"
require_relative "../lib/autonomous_merge_calibration"

PORTABLE_MAXIMA = {
  "changed_files" => 29,
  "changed_lines" => 999,
  "commits" => 9,
  "reviewed_heads" => 3
}.freeze
PR_COUNT_FIELDS = %w[
  changed_files
  changed_lines
  commits
  reviewed_heads
  automation_reviewed_heads
].freeze
COMPLETE_SCOPE_REQUIRED_PR_COUNTS = %w[
  changed_files
  changed_lines
  commits
].freeze

options = {
  repositories: [],
  sample: 5,
  format: "report",
  maxima: PORTABLE_MAXIMA.dup
}
OptionParser.new do |parser|
  parser.on("--input PATH", "Cached/checkpointed calibration dataset") { |value| options[:input] = value }
  parser.on("--collect PATH", "Collect or resume a GitHub dataset at this explicit checkpoint") do |value|
    options[:collect] = value
  end
  parser.on("--repo OWNER/REPO") { |value| options[:repositories] << value }
  parser.on("--since YYYY-MM-DD") { |value| options[:since] = Date.iso8601(value) }
  parser.on("--pr-count NUMBER", Integer) { |value| options[:pr_count] = value }
  parser.on("--sample NUMBER", Integer) { |value| options[:sample] = value }
  parser.on("--format FORMAT", %w[report decision]) { |value| options[:format] = value }
  parser.on("--max-changed-files NUMBER", Integer) { |value| options[:maxima]["changed_files"] = value }
  parser.on("--max-changed-lines NUMBER", Integer) { |value| options[:maxima]["changed_lines"] = value }
  parser.on("--max-commits NUMBER", Integer) { |value| options[:maxima]["commits"] = value }
  parser.on("--max-reviewed-heads NUMBER", Integer) { |value| options[:maxima]["reviewed_heads"] = value }
end.parse!

if options[:collect]
  abort "--input and --collect are mutually exclusive" if options[:input]
  abort "--collect requires at least one --repo OWNER/REPO" if options[:repositories].empty?
  abort "--collect requires exactly one of --since or --pr-count" if options[:since].nil? == options[:pr_count].nil?

  begin
    dataset = AutonomousMergeCalibration.collect(
      checkpoint_path: options.fetch(:collect),
      repositories: options.fetch(:repositories),
      since: options[:since],
      pr_count: options[:pr_count]
    )
    puts JSON.pretty_generate(dataset)
    exit
  rescue AutonomousMergeCalibration::CollectionError => e
    warn "calibration collection stopped (#{e.kind}): #{e.message}"
    exit 1
  end
end

abort "--input is required; use a cached/checkpointed dataset" unless options[:input]
abort "--sample must be positive" unless options[:sample].positive?
abort "--pr-count must be positive" if options[:pr_count] && !options[:pr_count].positive?
abort "threshold maxima must be nonnegative" unless options[:maxima].values.all? { |value| value >= 0 }

def parse_calibration_pr_merged_at!(pull_request)
  DateTime.iso8601(pull_request.fetch("merged_at"))
rescue Date::Error, KeyError, TypeError
  abort "calibration PR merged_at must be an ISO 8601 timestamp"
end

def validate_calibration_pr_repository!(pull_request)
  abort "calibration PR must be a mapping" unless pull_request.is_a?(Hash)

  repository = pull_request["repository"]
  unless repository.is_a?(String) && repository.match?(%r{\A[^/\s]+/[^/\s]+\z})
    abort "calibration PR repository must use OWNER/REPO form"
  end
  repository
end

def validate_calibration_pr_identity!(pull_request)
  repository = validate_calibration_pr_repository!(pull_request)
  unless pull_request["number"].is_a?(Integer) && pull_request["number"].positive?
    abort "calibration PR number must be a positive integer"
  end
  [repository, pull_request.fetch("number")]
end

def validate_calibration_pr!(pull_request, scope_complete:)
  identity = validate_calibration_pr_identity!(pull_request)
  merged_at = parse_calibration_pr_merged_at!(pull_request)
  PR_COUNT_FIELDS.each do |field|
    value = pull_request[field]
    unless value.nil? || (value.is_a?(Integer) && value >= 0)
      abort "calibration PR #{field} must be a nonnegative integer or null"
    end
  end
  if scope_complete
    COMPLETE_SCOPE_REQUIRED_PR_COUNTS.each do |field|
      unless pull_request[field].is_a?(Integer)
        abort "calibration PR #{field} must be a nonnegative integer when dataset scope is complete"
      end
    end
  end
  categories = pull_request["path_categories"]
  unless categories.is_a?(Array) &&
         categories.all? { |category| category.is_a?(String) && !category.strip.empty? }
    abort "calibration PR path_categories must be a list of nonempty strings"
  end
  [identity, merged_at]
end

def requested_window_covered?(scope, options)
  return true unless options[:since] || options[:pr_count]

  request = scope["request"]
  return false unless request.is_a?(Hash)

  if options[:since]
    return false unless request["mode"] == "since" && request["value"].is_a?(String)

    begin
      return false if options.fetch(:since) < Date.iso8601(request.fetch("value"))
    rescue Date::Error
      return false
    end
  end
  if options[:pr_count]
    return false unless request["mode"] == "pr-count" &&
                        request["value"].is_a?(Integer) &&
                        request["value"].positive?
    return false if options.fetch(:pr_count) > request.fetch("value")
  end
  true
end

raw = File.read(options[:input], encoding: "UTF-8")
dataset = JSON.parse(raw)
unless dataset["contract"] == "autonomous-merge-calibration-dataset" && dataset["version"] == 1
  abort "invalid autonomous-merge-calibration-dataset contract or version"
end
scope = dataset.fetch("scope")
prs = dataset.fetch("prs")
abort "calibration PRs must be a list" unless prs.is_a?(Array)
declared_scope_complete = scope["complete"] == true
window_covered = requested_window_covered?(scope, options)
effective_scope_complete = declared_scope_complete && window_covered

raw_identities = {}
merged_at_instants = {}.compare_by_identity
prs.each do |pr|
  identity, merged_at = validate_calibration_pr!(pr, scope_complete: declared_scope_complete)
  abort "calibration PR identities must be unique" if raw_identities.key?(identity)

  raw_identities[identity] = true
  merged_at_instants[pr] = merged_at
end
repositories = options[:repositories].empty? ? scope.fetch("repositories") : options[:repositories]
prs = prs.select { |pr| repositories.include?(pr.fetch("repository")) }
if options[:since]
  prs = prs.select do |pr|
    merged_at_instants.fetch(pr).to_date >= options[:since]
  end
end
if options[:pr_count]
  prs = prs.group_by { |pr| pr.fetch("repository") }.flat_map do |_repo, repo_prs|
    repo_prs.sort_by { |pr| merged_at_instants.fetch(pr) }.reverse.first(options[:pr_count])
  end
end
prs.sort_by! { |pr| [pr.fetch("repository"), pr.fetch("number")] }

def threshold_triggered?(pull_request, maxima)
  maxima.any? do |metric, maximum|
    pull_request[metric].is_a?(Integer) && pull_request.fetch(metric) > maximum
  end
end

maxima = options[:maxima]
metrics = maxima.keys
triggered = prs.select { |pr| threshold_triggered?(pr, maxima) }
proposed_threshold_classification_changes = prs.filter_map do |pr|
  portable_default_triggered = threshold_triggered?(pr, PORTABLE_MAXIMA)
  proposed_threshold_triggered = threshold_triggered?(pr, maxima)
  next if portable_default_triggered == proposed_threshold_triggered

  {
    "repository" => pr.fetch("repository"),
    "number" => pr.fetch("number"),
    "portable_default_triggered" => portable_default_triggered,
    "proposed_threshold_triggered" => proposed_threshold_triggered
  }
end
path_categories = prs.flat_map do |pr|
  pr.fetch("path_categories").uniq
end
path_category_distribution = path_categories.tally.sort.to_h
near_misses = prs.reject { |pr| triggered.include?(pr) }.select do |pr|
  metrics.any? { |metric| pr[metric] == maxima.fetch(metric) }
end
reviewed_known = prs.count { |pr| pr["reviewed_heads"].is_a?(Integer) }
graduation_blockers = []
graduation_blockers << "dataset has no repositories" if repositories.empty?
graduation_blockers << "dataset has no PRs" if prs.empty?
graduation_blockers << "dataset scope is incomplete" unless effective_scope_complete
if scope["complete"] == true && !window_covered
  graduation_blockers << "requested analysis window exceeds checkpoint scope"
end
graduation_blockers << "reviewed-head history is incomplete" unless reviewed_known == prs.length
graduation_blockers << "requested repositories are missing" unless repositories.all? do |repo|
  prs.any? { |pr| pr["repository"] == repo }
end
sampled = (triggered.first(options[:sample]) + near_misses.first(options[:sample])).uniq
unless sampled.all? { |pr| pr["semantic_inspection"].is_a?(String) && !pr["semantic_inspection"].strip.empty? }
  graduation_blockers << "semantic trigger and near-miss samples are incomplete"
end
decision = scope["reviewed_heads_decision"]
unless decision.is_a?(Hash) && decision["disposition"] == "enforced" &&
       decision["rationale"].is_a?(String) && !decision["rationale"].strip.empty?
  graduation_blockers << "no explicit reviewed-head graduation decision"
end
disposition = graduation_blockers.empty? ? "enforced" : "shadow"

def distribution(values)
  sorted = values.sort
  return { "count" => 0, "p50" => nil, "p90" => nil, "max" => nil } if sorted.empty?

  percentile = lambda do |fraction|
    sorted[((sorted.length - 1) * fraction).ceil]
  end
  {
    "count" => sorted.length,
    "p50" => percentile.call(0.50),
    "p90" => percentile.call(0.90),
    "max" => sorted.last
  }
end

report = {
  "contract" => "autonomous-merge-calibration-report",
  "version" => 1,
  "dataset_sha256" => Digest::SHA256.hexdigest(raw),
  "window" => scope.fetch("window"),
  "repositories" => repositories.sort,
  "thresholds" => maxima,
  "coverage" => {
    "pr_count" => prs.length,
    "reviewed_heads_known" => reviewed_known,
    "scope_complete" => effective_scope_complete
  },
  "distributions" => metrics.to_h do |metric|
    [metric, distribution(prs.filter_map { |pr| pr[metric] if pr[metric].is_a?(Integer) })]
  end,
  "path_category_distribution" => path_category_distribution,
  "proposed_threshold_classification_changes" => proposed_threshold_classification_changes,
  "triggered_count" => triggered.length,
  "triggered_sample" => triggered.first(options[:sample]),
  "near_miss_sample" => near_misses.first(options[:sample]),
  "reviewed_heads" => {
    "disposition" => disposition,
    "max" => maxima.fetch("reviewed_heads"),
    "graduation_blockers" => graduation_blockers
  },
  "merge_decisions_emitted" => false
}

output = if options[:format] == "decision"
           {
             "contract" => "autonomous-merge-calibration-decision",
             "version" => 1,
             "reviewed_heads" => {
               "disposition" => disposition,
               "max" => maxima.fetch("reviewed_heads"),
               "evidence" => "dataset-sha256:#{report.fetch('dataset_sha256')}; " \
                             "prs=#{prs.length}; blockers=#{graduation_blockers.join(' | ')}"
             }
           }
         else
           report
         end
puts JSON.pretty_generate(output)
