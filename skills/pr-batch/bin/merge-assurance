#!/usr/bin/env ruby
# frozen_string_literal: true

# Compose exact-head CI evidence, the trusted autonomous eligibility result,
# merge authority, and follow-up accounting into one integrity-bound receipt.
# The digest detects accidental or post-generation edits; it is not an
# authentication mechanism. Trust comes from invoking this helper from a
# trusted runtime.

require "digest"
require "etc"
require "fileutils"
require "find"
require "json"
require "open3"
require "optparse"
require "rbconfig"
require "tempfile"
require "time"
require "uri"
require "yaml"
require_relative "../lib/current_integration_evidence"

module MergeAssurance
  class Error < StandardError; end

  CONTEXT_KEYS = %w[
    contract version host repo pr base head_sha authority diff_identity
    human_merge_decision walkthrough semantic_github_actions_change
    selected_hosted_runs operations
  ].freeze
  SELECTED_HOSTED_RUN_KEYS = %w[provider run_id].freeze
  SELECTED_HOSTED_RECEIPT_KEYS = %w[
    head_sha pr provider repository run_id selected_at terminal_result
  ].freeze
  SELECTED_HOSTED_TERMINAL_RESULTS = %w[
    cancelled failed nonterminal success
  ].freeze
  SCOPE_NAMES = %w[
    required_status_check_rollup github_actions dependabot other
  ].freeze
  SCOPE_STATES = %w[READY NOT_READY NOT_APPLICABLE UNKNOWN].freeze
  REQUESTED_HOSTED_KEYS = %w[
    completed failing pending run_ids stale unknown
  ].freeze
  REQUESTED_HOSTED_COMPLETED_KEYS = %w[
    conclusion head_sha name run_id status url
  ].freeze
  REQUESTED_HOSTED_COMPLETED_METADATA_KEYS = %w[name url].freeze
  CI_BUCKET_READY_VALUES = %w[pass skipping].freeze
  CI_BUCKET_NOT_READY_VALUES = %w[cancel fail pending].freeze
  CI_STATE_READY_VALUES = %w[neutral skipped success].freeze
  CI_STATE_NOT_READY_VALUES = %w[
    action_required cancelled error expected failure in_progress pending queued
    requested stale timed_out waiting
  ].freeze
  CI_STATUS_NOT_READY_VALUES = %w[
    in_progress pending queued requested waiting
  ].freeze
  CI_CONCLUSION_READY_VALUES = %w[neutral skipped success].freeze
  CI_CONCLUSION_NOT_READY_VALUES = %w[
    action_required cancelled failure stale startup_failure timed_out
  ].freeze
  AUTHORITIES = %w[auto_merge_when_gates_pass ask explicit_approval none].freeze
  AUTONOMOUS_VERDICTS = %w[
    autonomous-merge-eligible human-approval-required human-approved-for-current-head
  ].freeze
  AUTONOMOUS_RESULT_KEYS = %w[
    verdict head_sha policy_provenance helper_provenance helper_trust metrics
    path_matches safe_class triggered_gates shadow_triggered_gates
    shadow_evidence_unknown rollback_assessment human_decision_evidence
    current_integration evidence_failures
  ].freeze
  AUTONOMOUS_METRIC_KEYS = %w[
    changed_files changed_lines commits reviewed_heads
  ].freeze
  AUTONOMOUS_RUNTIME_MANIFEST_KEYS = %w[
    helper
    closeout-helper
    decision-library
    evidence-library
    integration-evidence-library
    policy-library
    policy-glob-library
    policy-yaml-library
    runtime-trust-library
    calibration-decision
  ].freeze
  AUTONOMOUS_PORTABLE_GATE_IDS = %w[
    architectural-product-judgment
    autonomous-merge-policy-change
    changed-files-limit
    changed-lines-limit
    commit-count-limit
    infrastructure-delivery
    irreversible-external-effect
    persistent-data-storage
    public-compatibility
    reviewed-heads-limit
    security-auth-privacy
  ].freeze
  AUTONOMOUS_SHADOW_GATE_SHAPES = [
    [],
    ["reviewed-heads-limit"]
  ].freeze
  AUTONOMOUS_SHADOW_EVIDENCE_SHAPES = [
    [],
    ["submitted-review-head-missing"],
    ["review-pagination-incomplete"],
    %w[submitted-review-head-missing review-pagination-incomplete]
  ].freeze
  AUTONOMOUS_SAFE_CLASSES = %w[
    none documentation tests formatting-comments
  ].freeze
  AUTONOMOUS_PATH_REASONS = %w[
    migration infrastructure release security hot-path policy other
  ].freeze
  AUTONOMOUS_ROLLBACK_ASSESSMENTS = %w[
    code-only-rollback-established forward-recovery-established not-applicable
  ].freeze
  AUTONOMOUS_ACCEPTED_DECISION_KEYS = %w[
    status comment_id url approved_by source
  ].freeze
  AUTONOMOUS_DECISION_SOURCES = %w[
    direct-user-task human-pr-review human-pr-comment
  ].freeze
  MAX_EVIDENCE_AGE_SECONDS = 300
  MAX_FUTURE_SKEW_SECONDS = 30
  TRACKER_GH_TIMEOUT_SECONDS = 60
  TRACKER_GH_TERMINATION_GRACE_SECONDS = 0.25
  TRACKER_GH_POLL_SECONDS = 0.01
  SELECTED_HOSTED_CI_TIMEOUT_SECONDS = 60
  SELECTED_HOSTED_CI_TERMINATION_GRACE_SECONDS = 0.25
  SELECTED_HOSTED_CI_POLL_SECONDS = 0.01
  SELECTED_HOSTED_CI_STDOUT_MAX_BYTES = 1_048_576
  SELECTED_HOSTED_CI_STDERR_MAX_BYTES = 1_048_576
  SELECTED_HOSTED_CI_MATERIALIZATION_TIMEOUT_SECONDS = 60
  SELECTED_HOSTED_CI_MATERIALIZATION_DIAGNOSTIC_MAX_BYTES = 4096
  SELECTED_HOSTED_CI_TREE_ENTRY_MAX_BYTES = 65_536
  SELECTED_HOSTED_CI_SYMLINK_MAX_BYTES = 4096
  POLICY_CONFIG = ".agents/agent-workflow.yml"
  SELECTED_HOSTED_CI_POLICY_KEY = "selected_hosted_ci_receipts"
  SELECTED_HOSTED_CI_EXECUTABLE = %r{\A\.agents/bin/[A-Za-z0-9_.-]+\z}
  SELECTED_HOSTED_CI_ENV_NAME = /\A[A-Z][A-Z0-9_]*\z/
  SELECTED_HOSTED_CI_CREDENTIAL_ENV = /
    \A[A-Z][A-Z0-9_]*(?:
      _TOKEN|_API_KEY|_SECRET|_PASSWORD|_CREDENTIALS|_ACCESS_KEY_ID|
      _SECRET_ACCESS_KEY|_PRIVATE_KEY
    )\z
  /x
  # Defense in depth if the accepted credential suffix grammar broadens.
  SELECTED_HOSTED_CI_RESERVED_ENV = %w[
    GH_HOST GH_REPO SELECTED_HOSTED_CI_PR SELECTED_HOSTED_CI_HEAD_SHA
    HOME USER LOGNAME PATH
    GIT_CONFIG_NOSYSTEM GIT_CONFIG_GLOBAL GIT_NO_REPLACE_OBJECTS
    GIT_OPTIONAL_LOCKS GIT_TERMINAL_PROMPT
  ].freeze
  SYSTEM_TOOL_DIRS = %w[
    /opt/homebrew/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin
  ].freeze
  TRUSTED_INTERPRETER_DIRS = ([File.dirname(RbConfig.ruby)] + SYSTEM_TOOL_DIRS).uniq.freeze

  module_function

  def assess(
    ci_result:, autonomous_result:, context:, selected_hosted_ci_receipts: nil,
    now: Time.now.utc
  )
    failures = []
    selected_hosted_ci_receipts ||= empty_selected_hosted_ci_receipts
    safe_context, follow_up_accounting, semantic_tracker = validate_evidence(
      ci_result:, autonomous_result:, context:, selected_hosted_ci_receipts:,
      now:, failures:
    )
    authenticated_tracker_reads = []
    if failures.empty? && semantic_tracker
      tracker_read = authenticate_semantic_tracker(semantic_tracker, safe_context, now, failures)
      authenticated_tracker_reads << tracker_read if tracker_read
    end

    return blocked_result(failures) unless failures.empty?

    evidence = {
      "ci_result" => ci_result,
      "selected_hosted_ci_receipts" => selected_hosted_ci_receipts,
      "autonomous_result" => autonomous_result,
      "context" => context,
      "authenticated_tracker_reads" => authenticated_tracker_reads
    }
    receipt = {
      "contract" => "merge-assurance-receipt",
      "version" => 2,
      "eligible" => true,
      "verdict" => "ELIGIBLE",
      "issued_at" => now.utc.iso8601,
      "bindings" => {
        "host" => safe_context["host"],
        "repo" => safe_context["repo"],
        "pr" => safe_context["pr"],
        "base" => safe_context["base"],
        "head_sha" => safe_context["head_sha"],
        "authority" => safe_context["authority"],
        "diff_identity" => safe_context["diff_identity"],
        "current_integration" => autonomous_result["current_integration"]
      },
      "freshness" => {
        "ci_checked_at" => ci_result["checked_at"],
        "receipt_max_age_seconds" => MAX_EVIDENCE_AGE_SECONDS,
        "future_clock_skew_seconds" => MAX_FUTURE_SKEW_SECONDS
      },
      "follow_up_accounting" => follow_up_accounting,
      "evidence" => evidence
    }
    receipt["evidence_digest"] = evidence_digest(evidence)
    receipt
  end

  def local_evidence_failures(ci_result:, autonomous_result:, context:, now: Time.now.utc)
    failures = []
    validate_evidence(
      ci_result:, autonomous_result:, context:, now:, failures:,
      preflight_selected_hosted_runs: true
    )
    failures.uniq
  end

  def validate_evidence(
    ci_result:, autonomous_result:, context:, now:, failures:,
    selected_hosted_ci_receipts: nil, preflight_selected_hosted_runs: false
  )
    safe_context = context.is_a?(Hash) ? context : {}
    validate_context(context, failures)
    validate_ci(ci_result, safe_context, now, failures)
    if selected_hosted_ci_receipts
      validate_selected_hosted_ci(
        selected_hosted_ci_receipts, safe_context, now, failures
      )
    elsif preflight_selected_hosted_runs
      validate_selected_hosted_run_duplicates(safe_context, failures)
    end
    validate_autonomous(autonomous_result, safe_context, failures)
    failures << "ci_result contains UNKNOWN" if ci_result_contains_unknown?(ci_result)
    failures << "autonomous_result contains UNKNOWN" if contains_unknown?(autonomous_result)
    failures << "context contains UNKNOWN" if contains_unknown?(context)
    failures << "selected_hosted_ci_receipts contains UNKNOWN" if
      selected_hosted_ci_receipts && contains_unknown?(selected_hosted_ci_receipts)
    validate_authority(safe_context, autonomous_result, now, failures)
    follow_up_accounting, semantic_tracker = validate_operations(safe_context, now, failures)
    [safe_context, follow_up_accounting, semantic_tracker]
  end

  def blocked_result(failures)
    {
      "contract" => "merge-assurance-result",
      "version" => 1,
      "eligible" => false,
      "verdict" => "BLOCKED",
      "failures" => failures.uniq
    }
  end

  def contains_unknown?(value)
    case value
    when Hash
      value.any? { |key, nested| contains_unknown?(key) || contains_unknown?(nested) }
    when Array
      value.any? { |nested| contains_unknown?(nested) }
    when String
      value.include?("UNKNOWN")
    else
      false
    end
  end

  def ci_result_contains_unknown?(ci_result)
    return contains_unknown?(ci_result) unless ci_result.is_a?(Hash)

    ci_result.any? do |key, value|
      if key == "scopes" && value.is_a?(Hash)
        value.any? do |scope_name, scope|
          contains_unknown?(scope_name) || ci_scope_contains_unknown?(scope)
        end
      elsif key == "requested_hosted"
        requested_hosted_contains_unknown?(value)
      else
        contains_unknown?(key) || contains_unknown?(value)
      end
    end
  end

  def requested_hosted_contains_unknown?(requested_hosted)
    return contains_unknown?(requested_hosted) unless requested_hosted.is_a?(Hash)

    requested_hosted.any? do |key, value|
      if key == "completed" && value.is_a?(Array)
        value.any? do |run|
          next contains_unknown?(run) unless run.is_a?(Hash)

          run.any? do |run_key, run_value|
            next false if REQUESTED_HOSTED_COMPLETED_METADATA_KEYS.include?(run_key)

            contains_unknown?(run_key) || contains_unknown?(run_value)
          end
        end
      else
        contains_unknown?(key) || contains_unknown?(value)
      end
    end
  end

  def ci_scope_contains_unknown?(scope)
    return contains_unknown?(scope) unless scope.is_a?(Hash)

    scope.any? do |key, value|
      next false if scope["gates_verdict"] == false && %w[error informational_rows].include?(key)
      next contains_unknown_in_ci_rows?(value) if key == "rows"

      contains_unknown?(key) || contains_unknown?(value)
    end
  end

  def contains_unknown_in_ci_rows?(rows)
    return contains_unknown?(rows) unless rows.is_a?(Array)

    rows.any? do |row|
      next contains_unknown?(row) unless row.is_a?(Hash)

      row.any? do |key, value|
        check_name = key == "name" && value.is_a?(String) && value.strip != "UNKNOWN"
        contains_unknown?(key) || (!check_name && contains_unknown?(value))
      end
    end
  end

  def validate_context(context, failures)
    unless context.is_a?(Hash)
      failures << "context must be an object"
      return
    end
    failures << "invalid merge-assurance-context contract or version" unless
      context["contract"] == "merge-assurance-context" && context["version"] == 1
    unknown_keys = context.keys - CONTEXT_KEYS
    failures << "context has unknown keys: #{unknown_keys.sort.join(', ')}" unless unknown_keys.empty?
    failures << "context host is invalid" unless valid_host?(context["host"])
    failures << "context repo is invalid" unless valid_repo?(context["repo"])
    failures << "context PR is invalid" unless context["pr"].is_a?(Integer) && context["pr"].positive?
    base = context["base"]
    unless base.is_a?(Hash) && base.keys.sort == %w[ref sha] &&
           valid_ref?(base["ref"]) && full_sha?(base["sha"])
      failures << "context base binding is invalid"
    end
    failures << "context head_sha is invalid" unless full_sha?(context["head_sha"])
    failures << "context authority is invalid" unless AUTHORITIES.include?(context["authority"])
    failures << "context diff_identity must be a lowercase SHA-256" unless
      context["diff_identity"].to_s.match?(/\A[0-9a-f]{64}\z/)
    failures << "context operations must be an array" unless context["operations"].is_a?(Array)
    failures << "context semantic_github_actions_change must be boolean" unless
      [true, false].include?(context["semantic_github_actions_change"])
    selections = context["selected_hosted_runs"]
    unless selections.nil? || (selections.is_a?(Array) &&
      selections.all? do |selection|
        exact_keys?(selection, SELECTED_HOSTED_RUN_KEYS) &&
          valid_selected_hosted_identity?(selection["provider"], selection["run_id"])
      end)
      failures << "context selected_hosted_runs are invalid"
    end
  end

  def validate_ci(ci_result, context, now, failures)
    unless ci_result.is_a?(Hash)
      failures << "ci_result must be an object"
      return
    end
    failures << "invalid pr-ci-readiness contract or version" unless
      ci_result["contract"] == "pr-ci-readiness" && ci_result["version"] == 2
    failures << "ci_result is not READY" unless ci_result["verdict"] == "READY"
    failures << "ci_result host binding mismatch" unless ci_result.dig("context", "host") == context["host"]
    failures << "ci_result repo binding mismatch" unless ci_result["repo"] == context["repo"]
    failures << "ci_result PR binding mismatch" unless ci_result["pr"] == context["pr"]
    failures << "ci_result head binding mismatch" unless ci_result["head_sha"] == context["head_sha"]
    scopes = ci_result["scopes"]
    unless scopes.is_a?(Hash) && scopes.keys.sort == SCOPE_NAMES.sort
      failures << "ci_result scopes are missing or unknown"
      return
    end
    scopes.each do |name, scope|
      unless scope.is_a?(Hash) && SCOPE_STATES.include?(scope["state"])
        failures << "ci_result scope #{name} has invalid state"
        next
      end
      gates_verdict = scope.fetch("gates_verdict", true)
      failures << "ci_result scope #{name} has invalid gates_verdict" unless [true, false].include?(gates_verdict)
      if gates_verdict == false && name == "required_status_check_rollup"
        failures << "ci_result scope #{name} cannot be non-gating"
      end
      if gates_verdict == false && scope["rows"] != []
        failures << "ci_result scope #{name} non-gating rows must be empty"
      end
      failures << "ci_result scope #{name} is not complete" if gates_verdict != false && scope["complete"] != true
      failures << "ci_result scope #{name} is not ready" unless %w[READY NOT_APPLICABLE].include?(scope["state"])
      failures << "ci_result scope #{name} head mismatch" unless scope["head_sha"] == context["head_sha"]
      failures << "ci_result scope #{name} rows are invalid" unless scope["rows"].is_a?(Array)
      if scope.key?("informational_rows") && !scope["informational_rows"].is_a?(Array)
        failures << "ci_result scope #{name} informational_rows are invalid"
      end
      recomputed_state = recompute_ci_scope_state(scope)
      unless scope["state"] == recomputed_state
        failures << "ci_result scope #{name} declared #{scope['state']} but recomputed #{recomputed_state}"
      end
      validate_timestamp(scope["checked_at"], now, "ci_result scope #{name}", failures)
    end
    validate_non_gating_requested_hosted_binding(ci_result, context, failures) if
      scopes.any? { |_name, scope| scope.is_a?(Hash) && scope["gates_verdict"] == false }
    validate_timestamp(ci_result["checked_at"], now, "ci_result", failures)
  end

  def validate_non_gating_requested_hosted_binding(ci_result, context, failures)
    requested = ci_result["requested_hosted"]
    valid = requested.is_a?(Hash) && requested.keys.sort == REQUESTED_HOSTED_KEYS
    if valid
      run_ids = requested["run_ids"]
      completed = requested["completed"]
      disposition_lists = %w[pending failing stale unknown].map { |key| requested[key] }
      valid = run_ids.is_a?(Array) && !run_ids.empty? &&
              run_ids.all? { |run_id| run_id.is_a?(String) && run_id.match?(/\A[1-9][0-9]*\z/) } &&
              run_ids.uniq.length == run_ids.length && completed.is_a?(Array) &&
              disposition_lists.all? { |rows| rows.is_a?(Array) && rows.empty? }
    end
    if valid
      completed_run_ids = completed.filter_map do |row|
        next unless row.is_a?(Hash) && row.keys.sort == REQUESTED_HOSTED_COMPLETED_KEYS
        next unless row["run_id"].is_a?(String) && run_ids.include?(row["run_id"])
        next unless row["status"] == "completed" && CI_CONCLUSION_READY_VALUES.include?(row["conclusion"])
        next unless row["head_sha"] == context["head_sha"]
        next unless row["name"].is_a?(String) && !row["name"].empty? && row["url"].is_a?(String)

        row["run_id"]
      end
      valid = completed.length == run_ids.length && completed_run_ids.sort == run_ids.sort
    end
    failures << "ci_result non-gating scopes require completed exact-head requested hosted runs" unless valid
  end

  def empty_selected_hosted_ci_receipts
    {
      "contract" => "selected-hosted-ci-receipts",
      "version" => 1,
      "complete" => true,
      "records" => []
    }
  end

  def validate_selected_hosted_ci(receipts, context, now, failures)
    selections = context["selected_hosted_runs"]
    selections = [] if selections.nil?
    unless selections.is_a?(Array) &&
           selections.all? { |selection| exact_keys?(selection, SELECTED_HOSTED_RUN_KEYS) }
      failures << "context selected_hosted_runs are invalid"
      return
    end
    invalid_selections = selections.reject do |selection|
      valid_selected_hosted_identity?(selection["provider"], selection["run_id"])
    end
    failures << "context selected_hosted_runs contain invalid identities" if invalid_selections.any?
    selection_ids = validate_selected_hosted_run_duplicates(context, failures)

    unless exact_keys?(receipts, %w[complete contract records version]) &&
           receipts["contract"] == "selected-hosted-ci-receipts" &&
           receipts["version"] == 1 && receipts["complete"] == true &&
           receipts["records"].is_a?(Array)
      failures << "selected hosted CI receipts are incomplete or malformed"
      return
    end

    records = receipts["records"]
    records.each do |record|
      unless exact_keys?(record, SELECTED_HOSTED_RECEIPT_KEYS)
        failures << "selected hosted CI receipt is malformed"
        next
      end
      identity = selected_hosted_identity(record)
      unless valid_selected_hosted_identity?(record["provider"], record["run_id"])
        failures << "selected hosted CI receipt identity is invalid"
        next
      end
      failures << "selected hosted run #{identity} repository mismatch" unless
        record["repository"] == context["repo"]
      failures << "selected hosted run #{identity} PR mismatch" unless
        record["pr"] == context["pr"]
      failures << "selected hosted run #{identity} head mismatch" unless
        record["head_sha"] == context["head_sha"]
      validate_selected_at(record["selected_at"], now, identity, failures)
      result = record["terminal_result"]
      unless SELECTED_HOSTED_TERMINAL_RESULTS.include?(result)
        failures << "selected hosted run #{identity} terminal result is invalid"
        next
      end
      failures << "selected hosted run #{identity} is #{result}" unless result == "success"
    end

    record_ids = records.filter_map do |record|
      next unless exact_keys?(record, SELECTED_HOSTED_RECEIPT_KEYS)
      next unless valid_selected_hosted_identity?(record["provider"], record["run_id"])

      selected_hosted_identity(record)
    end
    failures << "selected hosted CI receipts contain duplicates" unless
      record_ids.length == record_ids.uniq.length
    (selection_ids - record_ids).each do |identity|
      failures << "selected hosted run #{identity} is missing"
    end
    (record_ids - selection_ids).each do |identity|
      failures << "hosted run #{identity} was not explicitly selected"
    end
  end

  def validate_selected_hosted_run_duplicates(context, failures)
    return unless context.is_a?(Hash)

    selections = context["selected_hosted_runs"]
    selections = [] if selections.nil?
    return unless selections.is_a?(Array) &&
                  selections.all? { |selection| exact_keys?(selection, SELECTED_HOSTED_RUN_KEYS) }

    selection_ids = selections.map { |selection| selected_hosted_identity(selection) }
    failures << "context selected_hosted_runs contain duplicates" unless
      selection_ids.length == selection_ids.uniq.length
    selection_ids
  end

  def valid_selected_hosted_identity?(provider, run_id)
    provider.is_a?(String) &&
      provider.match?(/\A[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\z/) &&
      run_id.is_a?(String) &&
      run_id.match?(/\A[^\s[:cntrl:]]+\z/)
  end

  def selected_hosted_identity(record)
    "#{record['provider']}/#{record['run_id']}"
  end

  def validate_selected_at(raw, now, identity, failures)
    selected_at = Time.iso8601(raw.to_s)
    failures << "selected hosted run #{identity} selection time is too far in the future" if
      selected_at - now > MAX_FUTURE_SKEW_SECONDS
  rescue ArgumentError
    failures << "selected hosted run #{identity} selection time is invalid"
  end

  def recompute_ci_scope_state(scope)
    rows = scope["rows"]
    normalized_rows = rows.is_a?(Array) ? rows : []
    row_states = normalized_rows.map { |row| ci_evidence_row_state(row) }
    if scope["gates_verdict"] == false
      "NOT_APPLICABLE"
    elsif scope["complete"] != true
      "UNKNOWN"
    elsif !rows.is_a?(Array) || row_states.include?("UNKNOWN")
      "UNKNOWN"
    elsif normalized_rows.empty?
      "NOT_APPLICABLE"
    elsif row_states.include?("NOT_READY")
      "NOT_READY"
    else
      "READY"
    end
  end

  def ci_evidence_row_state(row)
    return "UNKNOWN" unless row.is_a?(Hash)

    outcomes = []
    bucket_presence, bucket = ci_row_representation(row["bucket"], downcase: false)
    return "UNKNOWN" unless append_ci_outcome(
      outcomes, bucket_presence, bucket,
      ready_values: CI_BUCKET_READY_VALUES,
      not_ready_values: CI_BUCKET_NOT_READY_VALUES
    )

    state_presence, state = ci_row_representation(row["state"])
    return "UNKNOWN" unless append_ci_outcome(
      outcomes, state_presence, state,
      ready_values: CI_STATE_READY_VALUES,
      not_ready_values: CI_STATE_NOT_READY_VALUES
    )

    status_presence, status = ci_row_representation(row["status"])
    conclusion_presence, conclusion = ci_row_representation(row["conclusion"])
    case status_presence
    when "absent"
      return "UNKNOWN" unless conclusion_presence == "absent"
    when "present"
      if status == "completed"
        return "UNKNOWN" unless conclusion_presence == "present"
      elsif CI_STATUS_NOT_READY_VALUES.include?(status)
        return "UNKNOWN" unless conclusion_presence == "absent"

        outcomes << "NOT_READY"
      else
        return "UNKNOWN"
      end
    else
      return "UNKNOWN"
    end
    return "UNKNOWN" unless append_ci_outcome(
      outcomes, conclusion_presence, conclusion,
      ready_values: CI_CONCLUSION_READY_VALUES,
      not_ready_values: CI_CONCLUSION_NOT_READY_VALUES
    )
    return "UNKNOWN" if outcomes.empty? || outcomes.uniq.length != 1

    outcomes.first
  end

  def ci_row_representation(value, downcase: true)
    return ["absent", nil] if value.nil? || value == ""
    return ["unrecognized", nil] unless value.is_a?(String)

    ["present", downcase ? value.downcase : value]
  end

  def append_ci_outcome(outcomes, presence, value, ready_values:, not_ready_values:)
    return true if presence == "absent"
    return false unless presence == "present"

    if ready_values.include?(value)
      outcomes << "READY"
    elsif not_ready_values.include?(value)
      outcomes << "NOT_READY"
    else
      return false
    end
    true
  end

  def validate_autonomous(result, context, failures)
    unless result.is_a?(Hash)
      failures << "autonomous_result must be an object"
      return
    end
    unless exact_keys?(result, AUTONOMOUS_RESULT_KEYS)
      failures << "autonomous_result has unknown or missing fields"
    end
    failures << "autonomous_result head binding mismatch" unless result["head_sha"] == context["head_sha"]
    failures << "autonomous_result verdict is unrecognized" unless AUTONOMOUS_VERDICTS.include?(result["verdict"])
    helper_trust = result["helper_trust"]
    unless exact_keys?(helper_trust, %w[manifest status]) &&
           helper_trust["status"] == "mechanically-verified" &&
           valid_autonomous_runtime_manifest?(helper_trust["manifest"])
      failures << "autonomous_result helper trust is unavailable"
    end
    metrics = result["metrics"]
    unless exact_keys?(metrics, AUTONOMOUS_METRIC_KEYS) &&
           metrics.values.all? { |value| value.is_a?(Integer) && value >= 0 }
      failures << "autonomous_result metrics shape is invalid"
    end
    path_matches_valid = result["path_matches"].is_a?(Array) &&
                         result["path_matches"].all? { |match| valid_autonomous_path_match?(match) }
    unless path_matches_valid
      failures << "autonomous_result path matches shape is invalid"
    end
    triggered_gates_valid = valid_autonomous_gates?(result["triggered_gates"])
    unless triggered_gates_valid
      failures << "autonomous_result triggered gates must be canonical, unique, and sorted"
    end
    if path_matches_valid && triggered_gates_valid
      path_match_gates = result.fetch("path_matches").filter_map { |match| match["gate"] }
      unless (path_match_gates - result.fetch("triggered_gates")).empty?
        failures << "autonomous_result path match gates are absent from triggered gates"
      end
    end
    unless AUTONOMOUS_SHADOW_GATE_SHAPES.include?(result["shadow_triggered_gates"])
      failures << "autonomous_result shadow triggered gates shape is invalid"
    end
    unless AUTONOMOUS_SHADOW_EVIDENCE_SHAPES.include?(result["shadow_evidence_unknown"])
      failures << "autonomous_result shadow evidence unknown shape is invalid"
    end
    failures << "autonomous_result safe class is invalid" unless
      AUTONOMOUS_SAFE_CLASSES.include?(result["safe_class"])
    failures << "autonomous_result rollback assessment is invalid" unless
      AUTONOMOUS_ROLLBACK_ASSESSMENTS.include?(result["rollback_assessment"])
    if result["safe_class"] == "none" && result["rollback_assessment"] == "not-applicable"
      failures << "autonomous_result rollback assessment requires a verified safe class"
    end
    unless valid_autonomous_decision_evidence?(result["human_decision_evidence"], context)
      failures << "autonomous_result human decision evidence shape is invalid"
    end
    failures << "autonomous_result policy provenance binding mismatch" unless
      valid_policy_provenance?(result["policy_provenance"], context.dig("base", "sha"))
    failures << "autonomous_result helper provenance binding mismatch" unless
      valid_helper_provenance?(result["helper_provenance"], context.dig("base", "sha"))
    validate_current_integration(result["current_integration"], context, failures)
    if !result["evidence_failures"].is_a?(Array)
      failures << "autonomous_result evidence failures are unavailable"
    elsif !result["evidence_failures"].empty?
      failures << "autonomous_result evidence failures must be empty"
    end
    expected_verdict = expected_autonomous_verdict(
      result["triggered_gates"],
      result["human_decision_evidence"]
    )
    return if expected_verdict == result["verdict"]

    failures << "autonomous_result verdict contradicts gates and decision evidence"
  end

  def validate_current_integration(integration, context, failures)
    expected_keys = %w[
      base_delta candidate contract current_base head_sha patch_identity pr
      recorded_base_sha repository reuse telemetry version
    ]
    unless exact_keys?(integration, expected_keys) &&
           integration["contract"] == "current-integration-evidence" &&
           integration["version"] == 1
      failures << "autonomous_result current integration contract is invalid"
      return
    end
    return unless valid_current_integration_context?(context)

    failures << "autonomous_result current integration repository mismatch" unless
      integration["repository"] == context["repo"]
    failures << "autonomous_result current integration PR mismatch" unless
      integration["pr"] == context["pr"]
    failures << "autonomous_result current integration head mismatch" unless
      integration["head_sha"] == context["head_sha"]
    failures << "autonomous_result current integration base mismatch" unless
      integration["current_base"] == context["base"]

    reuse = integration["reuse"]
    telemetry = integration["telemetry"]
    unless exact_keys?(reuse, %w[decision reasons]) && reuse["reasons"].is_a?(Array) &&
           reuse["reasons"] == reuse["reasons"].uniq.sort
      failures << "autonomous_result current integration reuse decision is invalid"
      return
    end
    unless exact_keys?(telemetry, %w[elapsed_seconds_saved review_replays_avoided validator_replays_avoided]) &&
           [telemetry["validator_replays_avoided"], telemetry["review_replays_avoided"]].all? do |value|
             value.is_a?(Integer) && value >= 0
           end &&
           (telemetry["elapsed_seconds_saved"].nil? ||
            (telemetry["elapsed_seconds_saved"].is_a?(Numeric) && telemetry["elapsed_seconds_saved"] >= 0))
      failures << "autonomous_result current integration telemetry is invalid"
      return
    end

    case reuse["decision"]
    when "base-unchanged"
      valid = reuse["reasons"] == ["base-unchanged"] &&
              integration["recorded_base_sha"] == context.dig("base", "sha") &&
              integration["patch_identity"].nil? && integration["candidate"].nil? &&
              integration["base_delta"] == { "paths" => [] } &&
              telemetry["validator_replays_avoided"].zero? && telemetry["review_replays_avoided"].zero?
      failures << "autonomous_result base-unchanged integration evidence is invalid" unless valid
    when "reuse-exact-head"
      validate_reused_current_integration(integration, context, failures)
    else
      failures << "autonomous_result current integration is not reusable"
    end
  end

  def valid_current_integration_context?(context)
    return false unless context.is_a?(Hash) && valid_repo?(context["repo"])
    return false unless context["pr"].is_a?(Integer) && context["pr"].positive?
    return false unless full_sha?(context["head_sha"])

    base = context["base"]
    base.is_a?(Hash) && base.keys.sort == %w[ref sha] &&
      valid_ref?(base["ref"]) && full_sha?(base["sha"])
  end

  def validate_reused_current_integration(integration, context, failures)
    recorded_base = integration["recorded_base_sha"]
    paths = integration.dig("base_delta", "paths")
    reasons = integration.dig("reuse", "reasons")
    candidate = integration["candidate"]
    valid_paths = exact_keys?(integration["base_delta"], ["paths"]) &&
                  paths.is_a?(Array) && paths == paths.uniq.sort &&
                  paths.all? { |path| valid_repository_path?(path) }
    valid_reasons = reasons.is_a?(Array) && !reasons.empty? &&
                    (reasons - %w[base-delta-reuse-safe pr-delta-reuse-safe]).empty?
    path_reason_consistent = !paths.empty? || reasons == ["pr-delta-reuse-safe"]
    valid = full_sha?(recorded_base) && recorded_base != context.dig("base", "sha") &&
            integration["patch_identity"].to_s.match?(/\A[0-9a-f]{64}\z/) &&
            valid_paths && valid_reasons && path_reason_consistent &&
            valid_current_integration_candidate?(candidate, context)
    telemetry = integration["telemetry"]
    valid &&= telemetry["validator_replays_avoided"] == 1 && telemetry["review_replays_avoided"] == 1
    failures << "autonomous_result reused current integration evidence is invalid" unless valid
  end

  def valid_current_integration_candidate?(candidate, context)
    return false unless exact_keys?(candidate, %w[oid parents source tree_oid])
    return false unless %w[github-potential-merge-commit git-merge-tree].include?(candidate["source"])
    return false unless full_sha?(candidate["tree_oid"])
    return false unless candidate["parents"] == [context.dig("base", "sha"), context["head_sha"]]

    if candidate["source"] == "github-potential-merge-commit"
      full_sha?(candidate["oid"])
    else
      candidate["oid"].nil?
    end
  end

  def valid_repository_path?(path)
    path.is_a?(String) && !path.empty? && !path.start_with?("/") && !path.include?("\\") &&
      path.split("/", -1).none? { |part| part.empty? || %w[. ..].include?(part) }
  end

  def expected_autonomous_verdict(triggered_gates, human_decision_evidence)
    return unless triggered_gates.is_a?(Array) && human_decision_evidence.is_a?(Hash)

    decision_status = human_decision_evidence["status"]
    if triggered_gates.empty? && decision_status == "none"
      "autonomous-merge-eligible"
    elsif !triggered_gates.empty? && decision_status == "accepted"
      "human-approved-for-current-head"
    elsif !triggered_gates.empty? && decision_status == "none"
      "human-approval-required"
    end
  end

  def exact_keys?(value, expected_keys)
    value.is_a?(Hash) &&
      value.keys.length == expected_keys.length &&
      (value.keys - expected_keys).empty?
  end

  def valid_autonomous_runtime_manifest?(manifest)
    exact_keys?(manifest, AUTONOMOUS_RUNTIME_MANIFEST_KEYS) &&
      manifest.values.all? { |path| path.is_a?(String) && !path.strip.empty? }
  end

  def valid_autonomous_gates?(gates)
    gates.is_a?(Array) &&
      gates.all? { |gate| canonical_autonomous_gate?(gate) } &&
      gates == gates.uniq.sort
  end

  def canonical_autonomous_gate?(gate)
    gate.is_a?(String) &&
      (AUTONOMOUS_PORTABLE_GATE_IDS.include?(gate) ||
       gate.match?(/\Arepo-path:[a-z0-9]+(?:-[a-z0-9]+)*\z/))
  end

  def valid_autonomous_path_match?(match)
    return false unless match.is_a?(Hash)

    path = match["path"]
    return false unless path.is_a?(String) && !path.strip.empty?

    if match.key?("gate")
      gate = match["gate"]
      reason = match["reason"]
      expected_keys = reason == "other" ? %w[detail gate path reason] : %w[gate path reason]
      return false unless exact_keys?(match, expected_keys)
      return false unless AUTONOMOUS_PATH_REASONS.include?(reason)
      return false if gate == "autonomous-merge-policy-change" && reason != "policy"
      return false unless gate == "autonomous-merge-policy-change" ||
                          gate.to_s.match?(/\Arepo-path:[a-z0-9]+(?:-[a-z0-9]+)*\z/)

      reason != "other" || (match["detail"].is_a?(String) && !match["detail"].strip.empty?)
    elsif exact_keys?(match, %w[classification path])
      match["classification"] == "generated"
    else
      false
    end
  end

  def valid_autonomous_decision_evidence?(decision, context)
    return false unless decision.is_a?(Hash)
    return true if decision == { "status" => "none" }
    return false unless exact_keys?(decision, AUTONOMOUS_ACCEPTED_DECISION_KEYS)
    return false unless decision["status"] == "accepted"
    return false unless decision["comment_id"].is_a?(String) &&
                        decision["comment_id"].match?(/\A[1-9]\d*\z/)
    return false unless %w[url approved_by].all? do |key|
      value = decision[key]
      value.is_a?(String) && !value.strip.empty?
    end
    return false unless AUTONOMOUS_DECISION_SOURCES.include?(decision["source"])

    valid_autonomous_decision_url?(decision, context)
  end

  def valid_autonomous_decision_url?(decision, context)
    return false unless context.is_a?(Hash)

    context_authority = URI.parse("https://#{context['host']}")
    evidence_url = URI.parse(decision.fetch("url"))
    return false unless evidence_url.scheme&.casecmp?("https")
    return false unless evidence_url.userinfo.nil? && evidence_url.query.nil?
    return false unless context_authority.host
    return false unless evidence_url.host&.casecmp?(context_authority.host)
    return false unless evidence_url.port == context_authority.port

    repo_parts = context["repo"].to_s.split("/", -1)
    url_parts = evidence_url.path.split("/", -1)
    return false unless repo_parts.length == 2 && url_parts.length == 5

    owner, repo = repo_parts
    empty, url_owner, url_repo, kind, pr = url_parts
    return false unless empty == "" && %w[pull issues].include?(kind)
    return false unless url_owner&.casecmp?(owner) && url_repo&.casecmp?(repo)
    return false unless pr&.match?(/\A[1-9]\d*\z/) && pr == context["pr"].to_s

    evidence_url.fragment == "issuecomment-#{decision.fetch('comment_id')}"
  rescue KeyError, URI::Error
    false
  end

  def valid_policy_provenance?(provenance, base_sha)
    return false unless full_sha?(base_sha)

    escaped_base = Regexp.escape(base_sha)
    provenance.to_s.match?(
      %r{\Agit:#{escaped_base}(?:
        :\.agents/agent-workflow\.yml@[0-9a-f]{40,64}|
        :\.agents/agent-workflow\.yml\(absent;\ portable-defaults\)
      )?\z}x
    )
  end

  def valid_helper_provenance?(provenance, base_sha)
    provenance == "trusted-base:#{base_sha}" ||
      provenance.to_s.match?(/\Averified-installed-pack:[0-9a-f]{64}\z/)
  end

  def validate_authority(context, autonomous_result, now, failures)
    autonomous_verdict = autonomous_result["verdict"] if autonomous_result.is_a?(Hash)
    case context["authority"]
    when "auto_merge_when_gates_pass"
      unless %w[autonomous-merge-eligible human-approved-for-current-head].include?(autonomous_verdict)
        failures << "auto merge authority lacks a qualifying exact-head autonomous verdict"
      end
    when "ask"
      unless valid_human_merge_decision?(context["human_merge_decision"], context, now)
        failures << "ask authority requires a proven exact-current-head human merge decision"
      end
      unless valid_walkthrough?(context["walkthrough"], context)
        failures << "ask authority requires a same-diff walkthrough or explicit user skip"
      end
    when "explicit_approval"
      unless valid_human_merge_decision?(context["human_merge_decision"], context, now)
        failures << "explicit approval requires a proven exact-current-head human merge decision"
      end
    when "none"
      failures << "merge authority none can never produce an eligible receipt"
    end
  end

  def valid_human_merge_decision?(decision, context, now)
    return false unless decision.is_a?(Hash)
    return false unless decision.keys.sort == %w[
      base_ref contract decided_at decision diff_identity head_sha host merge_authority
      pr provenance repo version
    ].sort
    return false unless decision["contract"] == "human-merge-decision" && decision["version"] == 1
    return false unless decision["decision"] == "approved" && decision["merge_authority"] == true
    return false unless %w[direct-user human-maintainer].include?(decision["provenance"])
    return false unless valid_target_bindings?(decision, context)

    valid_human_timestamp?(decision["decided_at"], now)
  end

  def valid_walkthrough?(walkthrough, context)
    return false unless walkthrough.is_a?(Hash)
    return false unless walkthrough.keys.sort == %w[
      base_ref contract diff_identity disposition head_sha host pr provenance repo version
    ].sort
    return false unless walkthrough["contract"] == "pr-walkthrough" && walkthrough["version"] == 1
    return false unless valid_target_bindings?(walkthrough, context)

    case walkthrough["disposition"]
    when "completed"
      walkthrough["provenance"] == "pr-walkthrough"
    when "user-skipped"
      %w[direct-user human-maintainer].include?(walkthrough["provenance"])
    else
      false
    end
  end

  def valid_target_bindings?(receipt, context)
    receipt["host"] == context["host"] &&
      receipt["repo"] == context["repo"] &&
      receipt["pr"] == context["pr"] &&
      receipt["base_ref"] == context.dig("base", "ref") &&
      receipt["head_sha"] == context["head_sha"] &&
      receipt["diff_identity"] == context["diff_identity"]
  end

  def validate_operations(context, now, failures)
    operations = context["operations"].is_a?(Array) ? context["operations"] : []
    ordinary = operations.select do |operation|
      operation.is_a?(Hash) && operation["type"] == "ordinary-follow-up-bundle"
    end
    semantic_trackers = operations.select do |operation|
      operation.is_a?(Hash) && operation["type"] == "semantic-github-actions-tracker"
    end
    report_only_operations = operations.select do |operation|
      operation.is_a?(Hash) && operation["type"] == "post-merge-audit-report-only"
    end
    unknown_types = operations.filter_map do |operation|
      operation["type"] if operation.is_a?(Hash) &&
                           !%w[
                             ordinary-follow-up-bundle
                             semantic-github-actions-tracker
                             post-merge-audit-report-only
                           ].include?(operation["type"])
    end
    failures << "operations contain unknown types: #{unknown_types.join(', ')}" unless unknown_types.empty?
    failures << "operations must contain objects" if operations.any? { |operation| !operation.is_a?(Hash) }

    bundle_ids = []
    approval_ids = []
    ordinary.each_with_index do |bundle, index|
      unless bundle.keys.sort == %w[approval bundle_id items type]
        failures << "ordinary follow-up bundle has unknown or missing fields"
        next
      end
      bundle_id = bundle["bundle_id"].to_s
      if bundle_id.empty?
        failures << "ordinary follow-up bundle_id is required"
        next
      end
      failures << "ordinary follow-up bundle #{bundle_id} is duplicated" if bundle_ids.include?(bundle_id)
      bundle_ids << bundle_id
      unless bundle["items"].is_a?(Array) && !bundle["items"].empty? &&
             bundle["items"].all? { |item| item.is_a?(String) && !item.strip.empty? }
        failures << "ordinary follow-up bundle #{bundle_id} items are invalid"
      end
      approval_id = bundle.dig("approval", "approval_id")
      if approval_id.is_a?(String) && !approval_id.strip.empty?
        if approval_ids.include?(approval_id)
          failures << "ordinary follow-up approval #{approval_id} is duplicated"
        end
        approval_ids << approval_id
      end
      expected_scope = index.zero? ? "first-bundle" : "additional-bundle"
      next if valid_follow_up_approval?(
        bundle["approval"],
        bundle:,
        context:,
        scope: expected_scope,
        now:
      )

      qualifier = index.zero? ? "explicit human approval" : "additional explicit approval"
      failures << "ordinary follow-up bundle #{bundle_id} lacks #{qualifier}"
    end

    if context["semantic_github_actions_change"] == true
      unless semantic_trackers.length == 1
        failures << "semantic GitHub Actions change requires exactly one exercise tracker"
      end
    elsif semantic_trackers.any?
      failures << "semantic GitHub Actions tracker is invalid for a non-semantic change"
    end
    semantic_trackers.each { |tracker| validate_semantic_tracker(tracker, context, failures) }
    failures << "post-merge audit permits at most one report-only operation" if report_only_operations.length > 1
    report_only_operations.each do |operation|
      next if operation.keys.sort == %w[disposition provenance reason type] &&
              operation["disposition"] == "report-only" &&
              %w[direct-user human-maintainer].include?(operation["provenance"]) &&
              operation["reason"].is_a?(String) && !operation["reason"].strip.empty?

      failures << "post-merge audit report-only operation is invalid"
    end
    post_merge_audit = if report_only_operations.one?
                         report_only_operations.first.reject { |key, _value| key == "type" }
                       else
                         {
                           "disposition" => "accounted",
                           "children" => "create-per-independent-action-after-dedupe",
                           "parent" => "create-for-two-or-more-related-children"
                         }
                       end

    accounting = {
      "ordinary_follow_up_bundles" => ordinary.map do |bundle|
        {
          "bundle_id" => bundle["bundle_id"],
          "items" => bundle["items"]
        }
      end,
      "semantic_github_actions_tracker" => semantic_trackers.one? ? semantic_trackers.first : nil,
      "post_merge_audit" => post_merge_audit
    }
    semantic_tracker = if context["semantic_github_actions_change"] == true && semantic_trackers.one?
                         semantic_trackers.first
                       end
    [accounting, semantic_tracker]
  end

  def semantic_tracker_workflow_path?(path)
    # Tracker paths are untrusted, so reject URL/drive-like prefixes here while
    # canonical Git paths may contain colon-bearing directory names.
    return false if path.is_a?(String) && path.match?(/\A[A-Za-z][A-Za-z0-9+.-]*:/)

    CurrentIntegrationEvidence.github_actions_path?(path)
  end

  def validate_semantic_tracker(tracker, context, failures)
    required_keys = %w[
      changed_files cleanup_instructions exercise expected_evidence source_pr tracker type
    ]
    allowed_keys = required_keys + ["owner"]
    unless (tracker.keys - allowed_keys).empty? && (required_keys - tracker.keys).empty?
      failures << "semantic GitHub Actions tracker has unknown or missing exercise fields"
      return
    end
    %w[tracker source_pr exercise expected_evidence cleanup_instructions].each do |key|
      unless tracker[key].is_a?(String) && !tracker[key].strip.empty?
        failures << "semantic GitHub Actions tracker #{key} is required"
      end
    end
    tracker_pattern = %r{
      \Ahttps://#{Regexp.escape(context['host'].to_s)}/
      #{Regexp.escape(context['repo'].to_s)}/issues/([1-9]\d*)\z
    }x
    tracker_match = tracker["tracker"].to_s.match(tracker_pattern)
    failures << "semantic GitHub Actions tracker URL is not a same-repository issue" unless tracker_match
    expected_source_pr = "https://#{context['host']}/#{context['repo']}/pull/#{context['pr']}"
    failures << "semantic GitHub Actions source PR binding mismatch" unless
      tracker["source_pr"] == expected_source_pr
    changed_files = tracker["changed_files"]
    unless changed_files.is_a?(Array) && !changed_files.empty? &&
           changed_files.all? { |path| semantic_tracker_workflow_path?(path) }
      failures << "semantic GitHub Actions tracker changed_files are invalid"
    end
    if tracker.key?("owner") &&
       !(tracker["owner"].is_a?(String) && !tracker["owner"].strip.empty?)
      failures << "semantic GitHub Actions tracker owner is invalid"
    end
  end

  def authenticate_semantic_tracker(tracker, context, now, failures)
    issue_number = tracker["tracker"].match(%r{/issues/([1-9]\d*)\z})&.captures&.first&.to_i
    issue = read_authenticated_issue(
      host: context["host"],
      repo: context["repo"],
      issue: issue_number
    )
    return failures << "semantic GitHub Actions tracker authenticated read failed" unless issue

    validate_authenticated_issue(
      issue,
      tracker:,
      issue_number:,
      context:,
      now:,
      failures:
    )
  end

  def read_authenticated_issue(host:, repo:, issue:)
    stdout_file = Tempfile.new("merge-assurance-tracker-stdout")
    stderr_file = Tempfile.new("merge-assurance-tracker-stderr")
    pid = Process.spawn(
      "gh", "api", "--hostname", host, "repos/#{repo}/issues/#{issue}",
      out: stdout_file.path, err: stderr_file.path, pgroup: true
    )
    deadline = monotonic_time + tracker_gh_timeout_seconds
    status = nil
    timed_out = false
    cleanup_complete = true
    loop do
      waited = Process.waitpid2(pid, Process::WNOHANG)
      if waited
        status = waited[1]
        break
      end
      if monotonic_time >= deadline
        timed_out = true
        status, cleanup_complete = terminate_tracker_process_group(pid)
        break
      end

      sleep TRACKER_GH_POLL_SECONDS
    end
    unless timed_out
      group_deadline = monotonic_time + TRACKER_GH_TERMINATION_GRACE_SECONDS
      unless wait_for_tracker_process_group_exit(pid, group_deadline)
        _ignored_status, cleanup_complete = terminate_tracker_process_group(pid)
        status = nil
      end
    end
    return unless cleanup_complete && !timed_out && status&.success?

    stdout_file.rewind
    parsed = JSON.parse(stdout_file.read)
    parsed if parsed.is_a?(Hash)
  rescue Error, JSON::ParserError, SystemCallError
    nil
  ensure
    terminate_tracker_process_group(pid) if pid && tracker_process_group_alive?(pid)
    stdout_file&.close!
    stderr_file&.close!
  end

  def tracker_gh_timeout_seconds
    value = Float(ENV.fetch("MERGE_ASSURANCE_GH_TIMEOUT_SECONDS", TRACKER_GH_TIMEOUT_SECONDS.to_s))
    raise Error, "tracker gh timeout must be a positive finite number" unless value.positive? && value.finite?

    value
  rescue ArgumentError
    raise Error, "tracker gh timeout must be a positive finite number"
  end

  def terminate_tracker_process_group(pid)
    signal_tracker_process_group("TERM", pid)
    deadline = monotonic_time + TRACKER_GH_TERMINATION_GRACE_SECONDS
    status = wait_for_tracker_child(pid, deadline)
    return [status, true] if wait_for_tracker_process_group_exit(pid, deadline)

    signal_tracker_process_group("KILL", pid)
    deadline = monotonic_time + TRACKER_GH_TERMINATION_GRACE_SECONDS
    status ||= wait_for_tracker_child(pid, deadline)
    [status, wait_for_tracker_process_group_exit(pid, deadline)]
  end

  def signal_tracker_process_group(signal, pid)
    Process.kill(signal, -pid)
  rescue Errno::ESRCH
    nil
  end

  def wait_for_tracker_child(pid, deadline)
    while monotonic_time < deadline
      waited = Process.waitpid2(pid, Process::WNOHANG)
      return waited[1] if waited

      sleep TRACKER_GH_POLL_SECONDS
    end
    nil
  rescue Errno::ECHILD
    nil
  end

  def tracker_process_group_alive?(pid)
    Process.kill(0, -pid)
    true
  rescue Errno::ESRCH
    false
  rescue Errno::EPERM
    true
  end

  def wait_for_tracker_process_group_exit(pid, deadline)
    while monotonic_time < deadline
      return true unless tracker_process_group_alive?(pid)

      sleep TRACKER_GH_POLL_SECONDS
    end
    !tracker_process_group_alive?(pid)
  end

  def monotonic_time
    Process.clock_gettime(Process::CLOCK_MONOTONIC)
  end

  def validate_authenticated_issue(issue, tracker:, issue_number:, context:, now:, failures:)
    expected_html_url = tracker["tracker"]
    expected_api_url = if context["host"] == "github.com"
                         "https://api.github.com/repos/#{context['repo']}/issues/#{issue_number}"
                       else
                         "https://#{context['host']}/api/v3/repos/#{context['repo']}/issues/#{issue_number}"
                       end
    metadata_valid = issue["id"].is_a?(Integer) && issue["id"].positive? &&
                     issue["node_id"].is_a?(String) && !issue["node_id"].empty? &&
                     issue["number"] == issue_number &&
                     issue["url"] == expected_api_url &&
                     issue["html_url"] == expected_html_url &&
                     %w[open closed].include?(issue["state"]) &&
                     issue["title"].is_a?(String) && !issue["title"].strip.empty? &&
                     issue["body"].is_a?(String) &&
                     !issue.key?("pull_request")
    begin
      Time.iso8601(issue["updated_at"].to_s)
    rescue ArgumentError
      metadata_valid = false
    end
    unless metadata_valid
      failures << "semantic GitHub Actions tracker authenticated issue metadata is malformed or mismatched"
      return
    end

    operation_digest = semantic_tracker_operation_digest(tracker)
    expected_bindings = {
      "semantic-tracker-source-pr" => tracker["source_pr"],
      "semantic-tracker-head-sha" => context["head_sha"],
      "semantic-tracker-diff-identity" => context["diff_identity"],
      "semantic-tracker-operation-digest" => operation_digest
    }
    unless valid_semantic_tracker_body_bindings?(issue["body"], expected_bindings)
      failures << "semantic GitHub Actions tracker issue body binding mismatch"
      return
    end

    {
      "contract" => "authenticated-semantic-tracker-read",
      "version" => 1,
      "provenance" => "gh-api",
      "checked_at" => now.utc.iso8601,
      "host" => context["host"],
      "repo" => context["repo"],
      "issue" => issue_number,
      "tracker" => tracker["tracker"],
      "source_pr" => tracker["source_pr"],
      "head_sha" => context["head_sha"],
      "diff_identity" => context["diff_identity"],
      "operation_digest" => operation_digest,
      "issue_metadata" => {
        "id" => issue["id"],
        "node_id" => issue["node_id"],
        "url" => issue["url"],
        "html_url" => issue["html_url"],
        "state" => issue["state"],
        "title" => issue["title"],
        "updated_at" => issue["updated_at"],
        "body_digest" => "sha256:#{Digest::SHA256.hexdigest(issue['body'])}"
      }
    }
  end

  def valid_semantic_tracker_body_bindings?(body, expected_bindings)
    parsed_bindings = Hash.new { |bindings, key| bindings[key] = [] }
    malformed = body.lines(chomp: true).any? do |raw_line|
      line = raw_line.strip
      next false unless line.start_with?("semantic-tracker-")

      key, separator, value = line.partition(": ")
      if separator.empty? || !expected_bindings.key?(key)
        true
      else
        parsed_bindings[key] << value
        false
      end
    end
    !malformed && expected_bindings.all? do |key, expected_value|
      parsed_bindings[key] == [expected_value]
    end
  end

  def semantic_tracker_operation_digest(tracker)
    keys = %w[
      changed_files cleanup_instructions exercise expected_evidence owner source_pr tracker type
    ]
    operation = keys.each_with_object({}) do |key, selected|
      selected[key] = tracker[key] if tracker.key?(key)
    end
    "sha256:#{Digest::SHA256.hexdigest(canonical_json(operation))}"
  end

  def valid_follow_up_approval?(approval, bundle:, context:, scope:, now: Time.now.utc)
    return false unless approval.is_a?(Hash)
    return false unless approval.keys.sort == %w[
      approval_id approved_at bundle_id contract decision diff_identity head_sha
      host items_digest pr provenance repo scope version
    ].sort
    return false unless approval["contract"] == "follow-up-approval" && approval["version"] == 1
    return false unless approval["decision"] == "approved" && approval["scope"] == scope
    return false unless %w[direct-user human-maintainer].include?(approval["provenance"])
    return false unless approval["approval_id"].is_a?(String) && !approval["approval_id"].strip.empty?
    return false unless approval["items_digest"] == canonical_items_digest(bundle["items"])
    return false unless approval["bundle_id"] == bundle["bundle_id"]
    return false unless approval["host"] == context["host"] &&
                        approval["repo"] == context["repo"] &&
                        approval["pr"] == context["pr"] &&
                        approval["head_sha"] == context["head_sha"] &&
                        approval["diff_identity"] == context["diff_identity"]

    valid_human_timestamp?(approval["approved_at"], now)
  end

  def valid_human_timestamp?(raw, now)
    Time.iso8601(raw.to_s) - now <= MAX_FUTURE_SKEW_SECONDS
  rescue ArgumentError
    false
  end

  def validate_timestamp(raw, now, label, failures)
    timestamp = Time.iso8601(raw.to_s)
    age = now - timestamp
    failures << "#{label} evidence is stale" if age > MAX_EVIDENCE_AGE_SECONDS
    failures << "#{label} evidence is too far in the future" if age < -MAX_FUTURE_SKEW_SECONDS
  rescue ArgumentError
    failures << "#{label} checked_at is invalid"
  end

  def canonical_json(value)
    case value
    when Hash
      "{#{value.keys.sort.map { |key| "#{JSON.generate(key)}:#{canonical_json(value.fetch(key))}" }.join(',')}}"
    when Array
      "[#{value.map { |item| canonical_json(item) }.join(',')}]"
    else
      JSON.generate(value)
    end
  end

  def evidence_digest(evidence)
    "sha256:#{Digest::SHA256.hexdigest(canonical_json(evidence))}"
  end

  def canonical_items_digest(items)
    "sha256:#{Digest::SHA256.hexdigest(canonical_json(items))}"
  end

  def valid_evidence_digest?(receipt)
    receipt.is_a?(Hash) && receipt["evidence"].is_a?(Hash) &&
      receipt["evidence_digest"] == evidence_digest(receipt["evidence"])
  end

  def full_sha?(value)
    value.to_s.match?(/\A[0-9a-f]{40}\z/i)
  end

  def valid_ref?(value)
    value.to_s.match?(/\A[^\s~^:?*\[\\]+\z/) && !value.to_s.include?("..")
  end

  def valid_host?(value)
    value.is_a?(String) &&
      value.match?(/\A[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::\d{1,5})?\z/i)
  end

  def valid_repo?(value)
    value.is_a?(String) &&
      value.match?(%r{\A[^/\s\x00-\x1F\x7F]+/[^/\s\x00-\x1F\x7F]+\z})
  end

  class Runner
    def run(argv)
      options = parse_options(argv)
      return help if options[:help]

      ci_result = read_json(options[:ci_result], "--ci-result")
      autonomous_result = read_json(options[:autonomous_result], "--autonomous-result")
      context = read_json(options[:context], "--context")
      preflight_now = Time.now.utc
      local_failures = MergeAssurance.local_evidence_failures(
        ci_result:, autonomous_result:, context:, now: preflight_now
      )
      unless local_failures.empty?
        puts JSON.pretty_generate(MergeAssurance.blocked_result(local_failures))
        return 1
      end

      selected_hosted_ci_receipts = load_selected_hosted_ci_receipts!(context)
      assessment_now = Time.now.utc
      result = MergeAssurance.assess(
        ci_result:,
        autonomous_result:,
        context:,
        selected_hosted_ci_receipts:,
        now: assessment_now
      )
      puts JSON.pretty_generate(result)
      result["eligible"] ? 0 : 1
    rescue Error => e
      puts JSON.pretty_generate(MergeAssurance.blocked_result([e.message]))
      1
    end

    private

    def load_selected_hosted_ci_receipts!(context)
      context_failures = []
      MergeAssurance.validate_context(context, context_failures)
      context_failures << "context contains UNKNOWN" if MergeAssurance.contains_unknown?(context)
      raise Error, context_failures.uniq.join("; ") unless context_failures.empty?

      selections = context["selected_hosted_runs"]
      return MergeAssurance.empty_selected_hosted_ci_receipts if selections.nil? || selections.empty?
      raise Error, "context selected_hosted_runs must be an array" unless selections.is_a?(Array)

      base_sha = context.dig("base", "sha").to_s
      raise Error, "context base SHA is invalid for selected hosted CI" unless
        MergeAssurance.full_sha?(base_sha)

      repo_root = trusted_repo_root!
      config = load_trusted_policy!(repo_root, base_sha)
      executable, credential_env = selected_hosted_ci_policy!(config)
      trusted_bytes = trusted_executable!(repo_root, base_sha, executable)
      request = {
        "contract" => "selected-hosted-ci-receipt-request",
        "version" => 1,
        "host" => context["host"],
        "repository" => context["repo"],
        "pr" => context["pr"],
        "head_sha" => context["head_sha"],
        "selected_runs" => selections
      }
      run_selected_hosted_ci_seam!(
        repo_root:, base_sha:, executable:, trusted_bytes:, request:, credential_env:
      )
    end

    def trusted_repo_root!
      stdout, stderr, status = git_capture("rev-parse", "--show-toplevel", chdir: Dir.pwd)
      raise Error, "could not resolve consumer repository root: #{failure_output(stdout, stderr)}" unless
        status.success?

      root = File.realpath(stdout.strip)
      raise Error, "consumer repository root is invalid" unless File.directory?(root)

      root
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not resolve consumer repository root: #{e.message}"
    end

    def load_trusted_policy!(repo_root, base_sha)
      raw = trusted_blob!(
        repo_root, base_sha, POLICY_CONFIG, "trusted-base selected hosted CI policy"
      )
      config = YAML.safe_load(
        raw, permitted_classes: [], permitted_symbols: [], aliases: false
      )
      raise Error, "trusted-base selected hosted CI policy must be a mapping" unless config.is_a?(Hash)

      config
    rescue Psych::Exception => e
      raise Error, "trusted-base selected hosted CI policy is invalid YAML: #{e.message.lines.first.to_s.strip}"
    end

    def selected_hosted_ci_policy!(config)
      seam = config[SELECTED_HOSTED_CI_POLICY_KEY]
      unless MergeAssurance.exact_keys?(seam, %w[credential_env executable])
        raise Error, "selected hosted runs require an exact trusted-base " \
                     "#{SELECTED_HOSTED_CI_POLICY_KEY} executable and credential_env seam"
      end
      executable = seam["executable"]
      unless executable.is_a?(String) && executable.match?(SELECTED_HOSTED_CI_EXECUTABLE)
        raise Error, "trusted-base selected hosted CI executable must name one file under .agents/bin"
      end

      credential_env = seam["credential_env"]
      unless credential_env.is_a?(Array) && credential_env.all? do |name|
        name.is_a?(String) && name.match?(SELECTED_HOSTED_CI_ENV_NAME)
      end
        raise Error, "trusted-base selected hosted CI credential_env must contain uppercase environment names"
      end
      if credential_env.uniq.length != credential_env.length
        raise Error, "trusted-base selected hosted CI credential_env must not contain duplicates"
      end

      reserved = credential_env & SELECTED_HOSTED_CI_RESERVED_ENV
      unless reserved.empty?
        raise Error, "trusted-base selected hosted CI credential_env contains reserved names: " \
                     "#{reserved.sort.join(', ')}"
      end
      noncredentials = credential_env.reject do |name|
        name.match?(SELECTED_HOSTED_CI_CREDENTIAL_ENV)
      end
      unless noncredentials.empty?
        raise Error, "trusted-base selected hosted CI credential_env contains non-credential names: " \
                     "#{noncredentials.sort.join(', ')}"
      end

      [executable, credential_env]
    end

    def trusted_executable!(repo_root, base_sha, executable)
      trusted_bytes = trusted_blob!(
        repo_root, base_sha, executable, "trusted-base selected hosted CI executable"
      )
      stdout, stderr, status = git_capture(
        "-C", repo_root, "ls-tree", base_sha, "--", executable, chdir: repo_root
      )
      unless status.success?
        raise Error, "trusted-base selected hosted CI executable metadata is unavailable: " \
                     "#{failure_output(stdout, stderr)}"
      end

      match = stdout.match(/\A(?<mode>\d{6}) blob [0-9a-f]+\t(?<path>[^\r\n]+)\n?\z/)
      unless match && match[:mode] == "100755" && match[:path] == executable
        raise Error, "trusted-base selected hosted CI executable must be one executable regular file"
      end

      trusted_bytes.b
    end

    def trusted_blob!(repo_root, base_sha, relative_path, label)
      stdout, stderr, status = git_capture(
        "-C", repo_root, "cat-file", "blob", "#{base_sha}:#{relative_path}", chdir: repo_root
      )
      raise Error, "#{label} is unavailable: #{failure_output(stdout, stderr)}" unless status.success?

      stdout
    end

    def run_selected_hosted_ci_seam!(
      repo_root:, base_sha:, executable:, trusted_bytes:, request:, credential_env:
    )
      directory = Dir.mktmpdir("merge-assurance-selected-hosted-ci")
      File.chmod(0o700, directory)
      snapshot_root = File.join(directory, "trusted-base")
      seam_home = File.join(directory, "home")
      FileUtils.mkdir_p(snapshot_root, mode: 0o700)
      FileUtils.mkdir_p(seam_home, mode: 0o700)
      File.chmod(0o700, seam_home)
      materialize_trusted_base!(repo_root, base_sha, snapshot_root)

      validate_snapshot_symlinks!(snapshot_root)
      materialized = File.join(snapshot_root, executable)
      validate_materialized_executable!(snapshot_root, materialized, trusted_bytes)
      launch = selected_hosted_ci_launch_command!(trusted_bytes, materialized, repo_root)
      stdout, stderr, status = run_selected_hosted_ci_process!(
        selected_hosted_ci_environment(request, credential_env, home: seam_home),
        launch,
        request,
        chdir: snapshot_root
      )
      unless status.success?
        raise Error, "trusted-base selected hosted CI seam failed: " \
                     "#{selected_hosted_ci_diagnostic(stdout, stderr, credential_env)}"
      end

      parsed = JSON.parse(stdout)
      raise Error, "trusted-base selected hosted CI seam returned non-object JSON" unless parsed.is_a?(Hash)

      parsed
    rescue JSON::ParserError
      raise Error, "trusted-base selected hosted CI seam returned invalid JSON"
    ensure
      FileUtils.remove_entry(directory) if directory && File.exist?(directory)
    end

    def materialize_trusted_base!(repo_root, base_sha, snapshot_root)
      timeout_seconds = selected_hosted_ci_materialization_timeout_seconds
      deadline = selected_hosted_ci_monotonic_time + timeout_seconds
      tree_file = Tempfile.new("merge-assurance-selected-hosted-ci-tree")
      tree_file.binmode
      run_trusted_git_to_io!(
        repo_root,
        ["-C", repo_root, "ls-tree", "-rz", "--full-tree", base_sha],
        tree_file,
        "could not materialize trusted-base selected hosted CI seam",
        deadline:,
        timeout_seconds:
      )
      tree_file.rewind
      with_trusted_blob_batch(repo_root, deadline:, timeout_seconds:) do |blob_reader|
        tree_file.each_line("\0", SELECTED_HOSTED_CI_TREE_ENTRY_MAX_BYTES + 1) do |entry|
          materialize_trusted_tree_entry!(snapshot_root, entry, blob_reader)
        end
      end
    ensure
      tree_file&.close!
    end

    def materialize_trusted_tree_entry!(snapshot_root, entry, blob_reader)
      if !entry.end_with?("\0") || entry.bytesize > SELECTED_HOSTED_CI_TREE_ENTRY_MAX_BYTES
        raise Error, "trusted-base selected hosted CI snapshot contains malformed tree metadata"
      end

      metadata, relative_path = entry.delete_suffix("\0").split("\t", 2)
      mode, type, object_id = metadata.to_s.split(" ", 3)
      expected_type = mode == "160000" ? "commit" : "blob"
      unless %w[100644 100755 120000 160000].include?(mode) &&
             type == expected_type && object_id&.match?(/\A[0-9a-f]{40}\z/) &&
             relative_path
        raise Error, "trusted-base selected hosted CI snapshot contains malformed tree metadata"
      end
      return if mode == "160000"

      components = trusted_tree_path_components!(relative_path)
      ensure_trusted_tree_parent_directories!(snapshot_root, components[0...-1])
      destination = File.join(snapshot_root, *components)
      if File.exist?(destination) || File.symlink?(destination)
        raise Error, "trusted-base selected hosted CI snapshot contains a duplicate path"
      end

      if mode == "120000"
        materialize_trusted_symlink!(blob_reader, object_id, destination)
      else
        File.open(destination, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
          blob_reader.call(object_id, file)
        end
        File.chmod(mode == "100755" ? 0o755 : 0o644, destination)
      end
    rescue SystemCallError => e
      raise Error, "could not extract trusted-base selected hosted CI seam: #{e.message}"
    end

    def trusted_tree_path_components!(relative_path)
      components = relative_path.b.split("/", -1)
      unless !components.empty? && components.none? { |component| component.empty? || %w[. ..].include?(component) }
        raise Error, "trusted-base selected hosted CI snapshot contains an unsafe path"
      end

      components
    end

    def ensure_trusted_tree_parent_directories!(snapshot_root, components)
      parent = snapshot_root
      components.each do |component|
        directory = File.join(parent, component)
        if File.exist?(directory) || File.symlink?(directory)
          unless File.directory?(directory) && !File.symlink?(directory)
            raise Error, "trusted-base selected hosted CI snapshot contains an unsafe parent path"
          end
        else
          Dir.mkdir(directory, 0o700)
        end
        parent = directory
      end
    end

    def materialize_trusted_symlink!(blob_reader, object_id, destination)
      target_file = Tempfile.new("merge-assurance-selected-hosted-ci-symlink")
      target_file.binmode
      blob_reader.call(
        object_id, target_file, max_bytes: SELECTED_HOSTED_CI_SYMLINK_MAX_BYTES
      )

      target_file.rewind
      target = target_file.read
      if target.empty? || target.include?("\0")
        raise Error, "trusted-base selected hosted CI snapshot contains an unsafe symlink"
      end

      File.symlink(target, destination)
    rescue SystemCallError => e
      raise Error, "could not extract trusted-base selected hosted CI seam: #{e.message}"
    ensure
      target_file&.close!
    end

    def with_trusted_blob_batch(repo_root, deadline:, timeout_seconds:)
      input_reader, input_writer = IO.pipe
      output_reader, output_writer = IO.pipe
      error_file = Tempfile.new("merge-assurance-selected-hosted-ci-git-error")
      [input_reader, input_writer, output_reader, output_writer, error_file].each(&:binmode)
      git = resolve_system_tool!("git", outside_root: repo_root)
      pid = Process.spawn(
        system_tool_environment, git, "-C", repo_root, "cat-file", "--batch",
        in: input_reader, out: output_writer, err: error_file, pgroup: true,
        chdir: repo_root, unsetenv_others: true
      )
      input_reader.close
      output_writer.close
      blob_reader = lambda do |object_id, destination, max_bytes: nil|
        stream_trusted_blob_from_batch!(
          input_writer, output_reader, object_id, destination,
          max_bytes:, deadline:, timeout_seconds:
        )
      end
      yield blob_reader
      input_writer.close
      status = wait_for_selected_hosted_ci_child(pid, deadline)
      unless status
        raise Error, selected_hosted_ci_materialization_timeout_message(timeout_seconds)
      end

      if selected_hosted_ci_process_group_alive?(pid)
        _ignored_status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
        pid = nil
        unless cleanup_complete
          raise Error, "trusted-base selected hosted CI materialization process group " \
                       "did not exit after forced termination"
        end
        raise Error, "trusted-base selected hosted CI materialization left a running " \
                     "process group, which was terminated"
      end
      pid = nil
      return if status.success?

      raise Error, "could not extract trusted-base selected hosted CI seam: " \
                   "#{failure_output('', bounded_materialization_diagnostic(error_file))}"
    rescue SystemCallError => e
      raise Error, "could not extract trusted-base selected hosted CI seam: #{e.message}"
    ensure
      [input_reader, input_writer, output_reader, output_writer].compact.each do |stream|
        stream.close unless stream.closed?
      end
      if pid
        _status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
        unless cleanup_complete
          cleanup_error = "could not extract trusted-base selected hosted CI seam: " \
                          "git process group did not exit after forced termination"
        end
      end
      error_file&.close!
      raise Error, cleanup_error if cleanup_error
    end

    def stream_trusted_blob_from_batch!(
      input, output, object_id, destination, max_bytes:, deadline:, timeout_seconds:
    )
      write_materialization_bytes!(
        input, "#{object_id}\n", deadline:, timeout_seconds:
      )
      header = read_materialization_line!(output, deadline:, timeout_seconds:)
      match = header.match(
        /\A#{Regexp.escape(object_id)} blob (?<size>0|[1-9]\d*)\n\z/
      )
      unless match
        raise Error, "could not extract trusted-base selected hosted CI seam: " \
                     "git returned malformed blob metadata"
      end

      size = Integer(match[:size], 10)
      if max_bytes && size > max_bytes
        raise Error, "trusted-base selected hosted CI snapshot contains an unsafe symlink"
      end

      copy_materialization_bytes!(
        output, destination, size, deadline:, timeout_seconds:
      )
      separator = read_materialization_bytes!(
        output, 1, deadline:, timeout_seconds:
      )
      return if separator == "\n"

      raise Error, "could not extract trusted-base selected hosted CI seam: " \
                   "git returned malformed blob content"
    end

    def read_materialization_line!(input, deadline:, timeout_seconds:)
      line = +"".b
      loop do
        byte = read_materialization_bytes!(
          input, 1, deadline:, timeout_seconds:
        )
        line << byte
        if line.bytesize > 256
          raise Error, "could not extract trusted-base selected hosted CI seam: " \
                       "git returned malformed blob metadata"
        end
        return line if byte == "\n"
      end
    end

    def copy_materialization_bytes!(
      input, destination, byte_count, deadline:, timeout_seconds:
    )
      remaining = byte_count
      while remaining.positive?
        chunk = read_materialization_bytes!(
          input, [remaining, 16_384].min, deadline:, timeout_seconds:
        )
        destination.write(chunk)
        remaining -= chunk.bytesize
      end
    end

    def read_materialization_bytes!(input, byte_count, deadline:, timeout_seconds:)
      bytes = +"".b
      while bytes.bytesize < byte_count
        begin
          wait_for_materialization_io!(input, :read, deadline:, timeout_seconds:)
          bytes << input.read_nonblock(byte_count - bytes.bytesize)
        rescue IO::WaitReadable
          next
        rescue EOFError
          raise Error, "could not extract trusted-base selected hosted CI seam: " \
                       "git ended before returning the requested blob"
        end
      end
      bytes
    end

    def write_materialization_bytes!(output, bytes, deadline:, timeout_seconds:)
      offset = 0
      while offset < bytes.bytesize
        begin
          wait_for_materialization_io!(output, :write, deadline:, timeout_seconds:)
          offset += output.write_nonblock(bytes.byteslice(offset..))
        rescue IO::WaitWritable
          next
        end
      end
    end

    def wait_for_materialization_io!(stream, operation, deadline:, timeout_seconds:)
      remaining = deadline - selected_hosted_ci_monotonic_time
      if remaining <= 0
        raise Error, selected_hosted_ci_materialization_timeout_message(timeout_seconds)
      end

      ready = if operation == :read
                IO.select([stream], nil, nil, remaining)
              else
                IO.select(nil, [stream], nil, remaining)
              end
      return if ready

      raise Error, selected_hosted_ci_materialization_timeout_message(timeout_seconds)
    end

    def selected_hosted_ci_materialization_timeout_message(timeout_seconds)
      "trusted-base selected hosted CI materialization timed out after #{timeout_seconds} seconds " \
        "and its process group was terminated"
    end

    def run_trusted_git_to_io!(
      repo_root, arguments, output, label, deadline:, timeout_seconds:
    )
      error_file = Tempfile.new("merge-assurance-selected-hosted-ci-git-error")
      error_file.binmode
      git = resolve_system_tool!("git", outside_root: repo_root)
      pid = Process.spawn(
        system_tool_environment, git, *arguments,
        out: output, err: error_file, pgroup: true,
        chdir: repo_root, unsetenv_others: true
      )
      status = nil
      loop do
        waited = Process.waitpid2(pid, Process::WNOHANG)
        if waited
          status = waited[1]
          break
        end
        if selected_hosted_ci_monotonic_time >= deadline
          _status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
          pid = nil
          unless cleanup_complete
            raise Error, "trusted-base selected hosted CI materialization process group " \
                         "did not exit after forced termination"
          end
          raise Error, "trusted-base selected hosted CI materialization timed out after " \
                       "#{timeout_seconds} seconds and its process group was terminated"
        end

        sleep SELECTED_HOSTED_CI_POLL_SECONDS
      end
      if selected_hosted_ci_process_group_alive?(pid)
        _ignored_status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
        pid = nil
        unless cleanup_complete
          raise Error, "trusted-base selected hosted CI materialization process group " \
                       "did not exit after forced termination"
        end
        raise Error, "trusted-base selected hosted CI materialization left a running " \
                     "process group, which was terminated"
      end
      pid = nil
      return if status.success?

      raise Error, "#{label}: #{failure_output('', bounded_materialization_diagnostic(error_file))}"
    rescue SystemCallError => e
      raise Error, "#{label}: #{e.message}"
    ensure
      if pid
        _status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
        cleanup_error = "#{label}: git process group did not exit after forced termination" unless
          cleanup_complete
      end
      error_file&.close!
      raise Error, cleanup_error if cleanup_error
    end

    def bounded_materialization_diagnostic(file)
      file.rewind
      file.read(SELECTED_HOSTED_CI_MATERIALIZATION_DIAGNOSTIC_MAX_BYTES).to_s
    end

    def selected_hosted_ci_materialization_timeout_seconds
      value = Float(
        ENV.fetch(
          "MERGE_ASSURANCE_SELECTED_HOSTED_CI_MATERIALIZATION_TIMEOUT_SECONDS",
          SELECTED_HOSTED_CI_MATERIALIZATION_TIMEOUT_SECONDS.to_s
        )
      )
      unless value.positive? && value.finite?
        raise Error, "selected hosted CI materialization timeout must be a positive finite number"
      end

      value
    rescue ArgumentError
      raise Error, "selected hosted CI materialization timeout must be a positive finite number"
    end

    def run_selected_hosted_ci_process!(environment, launch, request, chdir:)
      stdin_file = Tempfile.new("merge-assurance-selected-hosted-ci-stdin")
      stdout_reader, stdout_writer = IO.pipe
      stderr_reader, stderr_writer = IO.pipe
      [stdout_reader, stdout_writer, stderr_reader, stderr_writer].each(&:binmode)
      stdin_file.write(JSON.generate(request))
      stdin_file.rewind
      timeout_seconds = selected_hosted_ci_timeout_seconds
      pid = Process.spawn(
        environment, *launch,
        in: stdin_file.path, out: stdout_writer, err: stderr_writer,
        pgroup: true, chdir:, unsetenv_others: true
      )
      stdout_writer.close
      stderr_writer.close
      deadline = selected_hosted_ci_monotonic_time + timeout_seconds
      stdout = +"".b
      stderr = +"".b
      streams = {
        stdout_reader => [stdout, SELECTED_HOSTED_CI_STDOUT_MAX_BYTES],
        stderr_reader => [stderr, SELECTED_HOSTED_CI_STDERR_MAX_BYTES]
      }
      status = nil
      timed_out = false
      lingering_group = false
      output_overflow = false
      cleanup_complete = true
      group_deadline = nil
      loop do
        output_overflow = drain_selected_hosted_ci_output!(streams) || output_overflow
        if output_overflow
          status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
          pid = nil
          break
        end

        waited = Process.waitpid2(pid, Process::WNOHANG) unless status
        status = waited[1] if waited
        now = selected_hosted_ci_monotonic_time
        if now >= deadline
          timed_out = true
          terminated_status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
          pid = nil
          status ||= terminated_status
          break
        end

        next unless status

        group_deadline ||= now + SELECTED_HOSTED_CI_TERMINATION_GRACE_SECONDS
        group_alive = selected_hosted_ci_process_group_alive?(pid)
        break if !group_alive && streams.empty?
        next unless group_alive && now >= group_deadline

        lingering_group = true
        _ignored_status, cleanup_complete = terminate_selected_hosted_ci_process_group(pid)
        pid = nil
        break
      end
      unless cleanup_complete
        raise Error, "trusted-base selected hosted CI seam process group did not exit after forced termination"
      end
      if output_overflow
        raise Error, "trusted-base selected hosted CI seam output exceeded its byte limit " \
                     "and its process group was terminated"
      end
      if timed_out
        raise Error, "trusted-base selected hosted CI seam timed out after #{timeout_seconds} seconds " \
                     "and its process group was terminated"
      end
      if lingering_group
        raise Error, "trusted-base selected hosted CI seam left a running process group, which was terminated"
      end

      [stdout, stderr, status]
    rescue Errno::EACCES, Errno::ENOENT => e
      raise Error, "trusted-base selected hosted CI seam could not be launched: #{e.message}"
    ensure
      terminate_selected_hosted_ci_process_group(pid) if
        pid && selected_hosted_ci_process_group_alive?(pid)
      stdin_file&.close!
      [stdout_reader, stdout_writer, stderr_reader, stderr_writer].compact.each do |stream|
        stream.close unless stream.closed?
      end
    end

    def drain_selected_hosted_ci_output!(streams)
      if streams.empty?
        sleep SELECTED_HOSTED_CI_POLL_SECONDS
        return false
      end

      ready = IO.select(
        streams.keys, nil, nil, SELECTED_HOSTED_CI_POLL_SECONDS
      )&.first.to_a
      ready.any? do |stream|
        buffer, limit = streams.fetch(stream)
        remaining = limit - buffer.bytesize
        read_size = [16_384, remaining + 1].min
        chunk = stream.read_nonblock([read_size, 1].max)
        if chunk.bytesize > remaining
          buffer << chunk.byteslice(0, remaining) if remaining.positive?
          true
        else
          buffer << chunk
          false
        end
      rescue IO::WaitReadable
        false
      rescue EOFError
        streams.delete(stream)
        stream.close
        false
      end
    end

    def selected_hosted_ci_timeout_seconds
      value = Float(
        ENV.fetch(
          "MERGE_ASSURANCE_SELECTED_HOSTED_CI_TIMEOUT_SECONDS",
          SELECTED_HOSTED_CI_TIMEOUT_SECONDS.to_s
        )
      )
      unless value.positive? && value.finite?
        raise Error, "selected hosted CI seam timeout must be a positive finite number"
      end

      value
    rescue ArgumentError
      raise Error, "selected hosted CI seam timeout must be a positive finite number"
    end

    def terminate_selected_hosted_ci_process_group(pid)
      term_result = signal_selected_hosted_ci_process_group("TERM", pid)
      status = nil
      unless term_result == :permission_denied
        deadline = selected_hosted_ci_monotonic_time + SELECTED_HOSTED_CI_TERMINATION_GRACE_SECONDS
        status = wait_for_selected_hosted_ci_child(pid, deadline)
        return [status, true] if term_result == :gone ||
                                 wait_for_selected_hosted_ci_process_group_exit(pid, deadline)
      end

      kill_result = signal_selected_hosted_ci_process_group("KILL", pid)
      if kill_result == :permission_denied
        return [status, !selected_hosted_ci_process_group_alive?(pid)]
      end

      deadline = selected_hosted_ci_monotonic_time + SELECTED_HOSTED_CI_TERMINATION_GRACE_SECONDS
      status ||= wait_for_selected_hosted_ci_child(pid, deadline)
      [status, kill_result == :gone || wait_for_selected_hosted_ci_process_group_exit(pid, deadline)]
    end

    def signal_selected_hosted_ci_process_group(signal, pid)
      Process.kill(signal, -pid)
      :sent
    rescue Errno::ESRCH
      :gone
    rescue Errno::EPERM
      :permission_denied
    end

    def wait_for_selected_hosted_ci_child(pid, deadline)
      while selected_hosted_ci_monotonic_time < deadline
        waited = Process.waitpid2(pid, Process::WNOHANG)
        return waited[1] if waited

        sleep SELECTED_HOSTED_CI_POLL_SECONDS
      end
      nil
    rescue Errno::ECHILD
      nil
    end

    def selected_hosted_ci_process_group_alive?(pid)
      Process.kill(0, -pid)
      selected_hosted_ci_process_group_has_executing_member?(pid)
    rescue Errno::ESRCH
      false
    rescue Errno::EPERM
      selected_hosted_ci_process_group_has_executing_member?(pid)
    end

    def selected_hosted_ci_process_group_has_executing_member?(pid)
      ps = resolve_system_tool!("ps", outside_root: __dir__)
      stdout, _stderr, status = Open3.capture3(
        system_tool_environment, ps, *selected_hosted_ci_ps_arguments,
        unsetenv_others: true
      )
      return true unless status.success?

      states = stdout.each_line.filter_map do |line|
        fields = line.split
        next if fields.empty?
        return true unless fields.length == 2 && fields.first.match?(/\A\d+\z/)

        fields.last if fields.first.to_i == pid
      end
      return true if states.empty?

      states.any? { |state| !state.start_with?("Z") }
    rescue Error, SystemCallError
      true
    end

    def selected_hosted_ci_ps_arguments(platform = RUBY_PLATFORM)
      arguments = ["-A"]
      arguments << "-L" if platform.match?(/linux/)
      arguments.concat(["-o", "pgid=", "-o", "state="])
    end

    def wait_for_selected_hosted_ci_process_group_exit(pid, deadline)
      while selected_hosted_ci_monotonic_time < deadline
        return true unless selected_hosted_ci_process_group_alive?(pid)

        sleep SELECTED_HOSTED_CI_POLL_SECONDS
      end
      !selected_hosted_ci_process_group_alive?(pid)
    end

    def selected_hosted_ci_monotonic_time
      Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end

    def validate_materialized_executable!(snapshot_root, executable, trusted_bytes)
      realpath = File.realpath(executable)
      prefix = "#{File.realpath(snapshot_root)}#{File::SEPARATOR}"
      stat = File.lstat(executable)
      unless realpath.start_with?(prefix) && !stat.symlink? && stat.file? &&
             File.executable?(realpath) && File.binread(realpath) == trusted_bytes
        raise Error, "materialized selected hosted CI executable is unsafe or mismatched"
      end
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "materialized selected hosted CI executable is unavailable: #{e.message}"
    end

    def validate_snapshot_symlinks!(snapshot_root)
      root = File.realpath(snapshot_root)
      prefix = "#{root}#{File::SEPARATOR}"
      Find.find(root) do |path|
        next unless File.lstat(path).symlink?

        resolved = File.realpath(path)
        next if resolved == root || resolved.start_with?(prefix)

        raise Error, "trusted-base selected hosted CI snapshot contains an escaping symlink"
      rescue Errno::ENOENT, Errno::EACCES, Errno::ELOOP
        raise Error, "trusted-base selected hosted CI snapshot contains an unsafe symlink"
      end
    end

    def selected_hosted_ci_launch_command!(trusted_bytes, executable, repo_root)
      shebang = trusted_bytes.lines.first
      match = shebang&.match(%r{\A#!(?<interpreter>/\S+?)(?:[ \t]+(?<argument>\S+))?\r?\n?\z})
      raise Error, "trusted-base selected hosted CI executable needs a supported explicit shebang" unless match

      interpreter = match[:interpreter]
      argument = match[:argument]
      if interpreter == "/usr/bin/env"
        unless argument&.match?(/\A[A-Za-z0-9][A-Za-z0-9_.+-]*\z/)
          raise Error, "trusted-base selected hosted CI /usr/bin/env shebang must name one fixed program"
        end

        interpreter = resolve_env_interpreter!(argument, repo_root)
        [interpreter, executable]
      else
        # Trusted bytes pin this interpreter; resolution still rejects repo-local or non-executable paths.
        [resolve_absolute_interpreter!(interpreter, repo_root), *[argument].compact, executable]
      end
    end

    def resolve_env_interpreter!(program, repo_root)
      candidate = if program == "ruby" || program == File.basename(RbConfig.ruby)
                    RbConfig.ruby
                  else
                    TRUSTED_INTERPRETER_DIRS
                      .map { |directory| File.join(directory, program) }
                      .find { |path| File.file?(path) && File.executable?(path) }
                  end
      raise Error, "trusted-base selected hosted CI interpreter is unavailable: #{program}" unless candidate

      resolve_absolute_interpreter!(candidate, repo_root)
    end

    def resolve_absolute_interpreter!(path, repo_root)
      realpath = File.realpath(path)
      repo_prefix = "#{File.realpath(repo_root)}#{File::SEPARATOR}"
      stat = File.stat(realpath)
      unless !realpath.start_with?(repo_prefix) && stat.file? && File.executable?(realpath)
        raise Error, "trusted-base selected hosted CI interpreter is unsafe: #{path}"
      end

      realpath
    rescue Errno::ENOENT, Errno::EACCES
      raise Error, "trusted-base selected hosted CI interpreter is unavailable: #{path}"
    end

    def selected_hosted_ci_environment(request, credential_env, home:)
      environment = system_tool_environment.merge(
        "HOME" => home,
        "GH_HOST" => request.fetch("host"),
        "GH_REPO" => request.fetch("repository"),
        "SELECTED_HOSTED_CI_PR" => request.fetch("pr").to_s,
        "SELECTED_HOSTED_CI_HEAD_SHA" => request.fetch("head_sha").to_s
      )
      credential_env.each do |name|
        value = ENV[name]
        if value.nil? || value.empty?
          raise Error, "declared selected hosted CI credential is missing or empty: #{name}"
        end

        environment[name] = value
      end
      environment
    end

    def selected_hosted_ci_diagnostic(stdout, stderr, credential_env)
      return "diagnostic output suppressed because credentials were forwarded" unless credential_env.empty?

      failure_output(stdout, stderr)
    end

    def system_tool_environment
      account = Etc.getpwuid(Process.uid)
      {
        "HOME" => account.dir,
        "USER" => account.name,
        "LOGNAME" => account.name,
        "PATH" => SYSTEM_TOOL_DIRS.join(File::PATH_SEPARATOR),
        "GIT_CONFIG_NOSYSTEM" => "1",
        "GIT_CONFIG_GLOBAL" => File::NULL,
        "GIT_NO_REPLACE_OBJECTS" => "1",
        "GIT_OPTIONAL_LOCKS" => "0",
        "GIT_TERMINAL_PROMPT" => "0"
      }
    rescue ArgumentError
      raise Error, "local account identity is unavailable"
    end

    def git_capture(*args, chdir:)
      git = resolve_system_tool!("git", outside_root: chdir)
      Open3.capture3(
        system_tool_environment, git, *args, chdir:, unsetenv_others: true
      )
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "git could not be launched after trusted resolution: #{e.message}"
    end

    def resolve_system_tool!(name, outside_root:)
      candidate = SYSTEM_TOOL_DIRS
                  .map { |directory| File.join(directory, name) }
                  .find { |path| File.file?(path) && File.executable?(path) }
      raise Error, "#{name} is unavailable in approved system tool directories" unless candidate

      realpath = File.realpath(candidate)
      root = File.realpath(outside_root)
      prefix = "#{root}#{File::SEPARATOR}"
      raise Error, "#{name} must resolve outside the consumer repository" if
        realpath == root || realpath.start_with?(prefix)

      realpath
    rescue Errno::ENOENT, Errno::EACCES
      raise Error, "#{name} is unavailable in approved system tool directories"
    end

    def failure_output(stdout, stderr)
      text = [stderr, stdout].map(&:to_s).map(&:strip).reject(&:empty?).join(" | ")
      text.empty? ? "no diagnostic output" : text.lines.first.to_s.strip
    end

    def parse_options(argv)
      options = {}
      parser = OptionParser.new do |opts|
        opts.banner = "Usage: merge-assurance --ci-result FILE --autonomous-result FILE --context FILE"
        opts.on("--ci-result FILE") { |value| options[:ci_result] = value }
        opts.on("--autonomous-result FILE") { |value| options[:autonomous_result] = value }
        opts.on("--context FILE") { |value| options[:context] = value }
        opts.on("-h", "--help") { options[:help] = true }
      end
      remaining = parser.parse(argv)
      raise Error, "unexpected arguments: #{remaining.join(' ')}" unless remaining.empty?

      unless options[:help]
        %i[ci_result autonomous_result context].each do |key|
          raise Error, "--#{key.to_s.tr('_', '-')} is required" if options[key].to_s.empty?
        end
      end
      options
    rescue OptionParser::ParseError => e
      raise Error, e.message
    end

    def read_json(path, flag)
      raw = File.read(path, encoding: "UTF-8")
      parsed = JSON.parse(raw)
      raise Error, "#{flag} must contain a JSON object" unless parsed.is_a?(Hash)

      parsed
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "#{flag} is unavailable: #{e.message}"
    rescue JSON::ParserError => e
      raise Error, "#{flag} is invalid JSON: #{e.message}"
    end

    def help
      puts "Usage: merge-assurance --ci-result FILE --autonomous-result FILE --context FILE"
      0
    end
  end
end

exit MergeAssurance::Runner.new.run(ARGV) if $PROGRAM_NAME == __FILE__
