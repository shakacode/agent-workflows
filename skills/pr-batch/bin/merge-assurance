#!/usr/bin/env ruby
# frozen_string_literal: true

# Compose exact-head CI evidence, the trusted autonomous eligibility result,
# merge authority, and follow-up accounting into one integrity-bound receipt.
# The digest detects accidental or post-generation edits; it is not an
# authentication mechanism. Trust comes from invoking this helper from a
# trusted runtime.

require "digest"
require "json"
require "optparse"
require "tempfile"
require "time"

module MergeAssurance
  class Error < StandardError; end

  CONTEXT_KEYS = %w[
    contract version host repo pr base head_sha authority diff_identity
    human_merge_decision walkthrough semantic_github_actions_change operations
  ].freeze
  SCOPE_NAMES = %w[
    required_status_check_rollup github_actions dependabot other
  ].freeze
  SCOPE_STATES = %w[READY NOT_READY NOT_APPLICABLE UNKNOWN].freeze
  AUTHORITIES = %w[auto_merge_when_gates_pass ask explicit_approval none].freeze
  AUTONOMOUS_VERDICTS = %w[
    autonomous-merge-eligible human-approval-required human-approved-for-current-head
  ].freeze
  MAX_EVIDENCE_AGE_SECONDS = 300
  MAX_FUTURE_SKEW_SECONDS = 30
  TRACKER_GH_TIMEOUT_SECONDS = 60
  TRACKER_GH_TERMINATION_GRACE_SECONDS = 0.25
  TRACKER_GH_POLL_SECONDS = 0.01

  module_function

  def assess(ci_result:, autonomous_result:, context:, now: Time.now.utc)
    failures = []
    safe_context = context.is_a?(Hash) ? context : {}
    validate_context(context, failures)
    validate_ci(ci_result, safe_context, now, failures)
    validate_autonomous(autonomous_result, safe_context, failures)
    failures << "ci_result contains UNKNOWN" if contains_unknown?(ci_result)
    failures << "autonomous_result contains UNKNOWN" if contains_unknown?(autonomous_result)
    failures << "context contains UNKNOWN" if contains_unknown?(context)
    validate_authority(safe_context, autonomous_result, now, failures)
    follow_up_accounting, semantic_tracker = validate_operations(safe_context, now, failures)
    authenticated_tracker_reads = []
    if failures.empty? && semantic_tracker
      tracker_read = authenticate_semantic_tracker(semantic_tracker, safe_context, now, failures)
      authenticated_tracker_reads << tracker_read if tracker_read
    end

    return blocked_result(failures) unless failures.empty?

    evidence = {
      "ci_result" => ci_result,
      "autonomous_result" => autonomous_result,
      "context" => context,
      "authenticated_tracker_reads" => authenticated_tracker_reads
    }
    receipt = {
      "contract" => "merge-assurance-receipt",
      "version" => 1,
      "eligible" => true,
      "verdict" => "ELIGIBLE",
      "issued_at" => now.utc.iso8601,
      "bindings" => {
        "host" => safe_context["host"],
        "repo" => safe_context["repo"],
        "pr" => safe_context["pr"],
        "base" => safe_context["base"],
        "head_sha" => safe_context["head_sha"],
        "authority" => safe_context["authority"],
        "diff_identity" => safe_context["diff_identity"]
      },
      "freshness" => {
        "ci_checked_at" => ci_result["checked_at"],
        "receipt_max_age_seconds" => MAX_EVIDENCE_AGE_SECONDS,
        "future_clock_skew_seconds" => MAX_FUTURE_SKEW_SECONDS
      },
      "follow_up_accounting" => follow_up_accounting,
      "evidence" => evidence
    }
    receipt["evidence_digest"] = evidence_digest(evidence)
    receipt
  end

  def blocked_result(failures)
    {
      "contract" => "merge-assurance-result",
      "version" => 1,
      "eligible" => false,
      "verdict" => "BLOCKED",
      "failures" => failures.uniq
    }
  end

  def contains_unknown?(value)
    case value
    when Hash
      value.any? { |key, nested| contains_unknown?(key) || contains_unknown?(nested) }
    when Array
      value.any? { |nested| contains_unknown?(nested) }
    when String
      value.include?("UNKNOWN")
    else
      false
    end
  end

  def validate_context(context, failures)
    unless context.is_a?(Hash)
      failures << "context must be an object"
      return
    end
    failures << "invalid merge-assurance-context contract or version" unless
      context["contract"] == "merge-assurance-context" && context["version"] == 1
    unknown_keys = context.keys - CONTEXT_KEYS
    failures << "context has unknown keys: #{unknown_keys.sort.join(', ')}" unless unknown_keys.empty?
    failures << "context host is invalid" unless valid_host?(context["host"])
    failures << "context repo is invalid" unless context["repo"].to_s.match?(%r{\A[^/\s]+/[^/\s]+\z})
    failures << "context PR is invalid" unless context["pr"].is_a?(Integer) && context["pr"].positive?
    base = context["base"]
    unless base.is_a?(Hash) && base.keys.sort == %w[ref sha] &&
           valid_ref?(base["ref"]) && full_sha?(base["sha"])
      failures << "context base binding is invalid"
    end
    failures << "context head_sha is invalid" unless full_sha?(context["head_sha"])
    failures << "context authority is invalid" unless AUTHORITIES.include?(context["authority"])
    failures << "context diff_identity must be a lowercase SHA-256" unless
      context["diff_identity"].to_s.match?(/\A[0-9a-f]{64}\z/)
    failures << "context operations must be an array" unless context["operations"].is_a?(Array)
    failures << "context semantic_github_actions_change must be boolean" unless
      [true, false].include?(context["semantic_github_actions_change"])
  end

  def validate_ci(ci_result, context, now, failures)
    unless ci_result.is_a?(Hash)
      failures << "ci_result must be an object"
      return
    end
    failures << "invalid pr-ci-readiness contract or version" unless
      ci_result["contract"] == "pr-ci-readiness" && ci_result["version"] == 2
    failures << "ci_result is not READY" unless ci_result["verdict"] == "READY"
    failures << "ci_result host binding mismatch" unless ci_result.dig("context", "host") == context["host"]
    failures << "ci_result repo binding mismatch" unless ci_result["repo"] == context["repo"]
    failures << "ci_result PR binding mismatch" unless ci_result["pr"] == context["pr"]
    failures << "ci_result head binding mismatch" unless ci_result["head_sha"] == context["head_sha"]
    scopes = ci_result["scopes"]
    unless scopes.is_a?(Hash) && scopes.keys.sort == SCOPE_NAMES.sort
      failures << "ci_result scopes are missing or unknown"
      return
    end
    scopes.each do |name, scope|
      unless scope.is_a?(Hash) && SCOPE_STATES.include?(scope["state"])
        failures << "ci_result scope #{name} has invalid state"
        next
      end
      failures << "ci_result scope #{name} is not complete" unless scope["complete"] == true
      failures << "ci_result scope #{name} is not ready" unless %w[READY NOT_APPLICABLE].include?(scope["state"])
      failures << "ci_result scope #{name} head mismatch" unless scope["head_sha"] == context["head_sha"]
      failures << "ci_result scope #{name} rows are invalid" unless scope["rows"].is_a?(Array)
      recomputed_state = recompute_ci_scope_state(scope)
      unless scope["state"] == recomputed_state
        failures << "ci_result scope #{name} declared #{scope['state']} but recomputed #{recomputed_state}"
      end
      validate_timestamp(scope["checked_at"], now, "ci_result scope #{name}", failures)
    end
    validate_timestamp(ci_result["checked_at"], now, "ci_result", failures)
  end

  def recompute_ci_scope_state(scope)
    rows = scope["rows"]
    normalized_rows = rows.is_a?(Array) ? rows : []
    row_states = normalized_rows.map { |row| ci_evidence_row_state(row) }
    if scope["complete"] != true
      "UNKNOWN"
    elsif !rows.is_a?(Array) || row_states.include?("UNKNOWN")
      "UNKNOWN"
    elsif normalized_rows.empty?
      "NOT_APPLICABLE"
    elsif row_states.include?("NOT_READY")
      "NOT_READY"
    else
      "READY"
    end
  end

  def ci_evidence_row_state(row)
    return "UNKNOWN" unless row.is_a?(Hash)

    bucket = row["bucket"].to_s
    return "READY" if %w[pass skipping].include?(bucket)
    return "NOT_READY" if %w[cancel fail pending].include?(bucket)

    state = row["state"].to_s.downcase
    return "READY" if state == "success"
    return "NOT_READY" if %w[error failure pending].include?(state)

    status = row["status"].to_s.downcase
    return "NOT_READY" unless status.empty? || status == "completed"
    return "UNKNOWN" if status.empty?

    conclusion = row["conclusion"].to_s.downcase
    return "READY" if %w[success neutral skipped].include?(conclusion)
    return "NOT_READY" unless conclusion.empty?

    "UNKNOWN"
  end

  def validate_autonomous(result, context, failures)
    unless result.is_a?(Hash)
      failures << "autonomous_result must be an object"
      return
    end
    failures << "autonomous_result head binding mismatch" unless result["head_sha"] == context["head_sha"]
    failures << "autonomous_result verdict is unrecognized" unless AUTONOMOUS_VERDICTS.include?(result["verdict"])
    unless result.dig("helper_trust", "status") == "mechanically-verified" &&
           result.dig("helper_trust", "manifest").is_a?(Hash)
      failures << "autonomous_result helper trust is unavailable"
    end
    failures << "autonomous_result policy provenance binding mismatch" unless
      valid_policy_provenance?(result["policy_provenance"], context.dig("base", "sha"))
    failures << "autonomous_result helper provenance binding mismatch" unless
      valid_helper_provenance?(result["helper_provenance"], context.dig("base", "sha"))
    if !result["evidence_failures"].is_a?(Array)
      failures << "autonomous_result evidence failures are unavailable"
    elsif !result["evidence_failures"].empty?
      failures << "autonomous_result evidence failures must be empty"
    end
  end

  def valid_policy_provenance?(provenance, base_sha)
    return false unless full_sha?(base_sha)

    escaped_base = Regexp.escape(base_sha)
    provenance.to_s.match?(
      %r{\Agit:#{escaped_base}(?:
        :\.agents/agent-workflow\.yml@[0-9a-f]{40,64}|
        :\.agents/agent-workflow\.yml\(absent;\ portable-defaults\)
      )?\z}x
    )
  end

  def valid_helper_provenance?(provenance, base_sha)
    provenance == "trusted-base:#{base_sha}" ||
      provenance.to_s.match?(/\Averified-installed-pack:[0-9a-f]{64}\z/)
  end

  def validate_authority(context, autonomous_result, now, failures)
    autonomous_verdict = autonomous_result["verdict"] if autonomous_result.is_a?(Hash)
    case context["authority"]
    when "auto_merge_when_gates_pass"
      unless %w[autonomous-merge-eligible human-approved-for-current-head].include?(autonomous_verdict)
        failures << "auto merge authority lacks a qualifying exact-head autonomous verdict"
      end
    when "ask"
      unless valid_human_merge_decision?(context["human_merge_decision"], context, now)
        failures << "ask authority requires a proven exact-current-head human merge decision"
      end
      unless valid_walkthrough?(context["walkthrough"], context)
        failures << "ask authority requires a same-diff walkthrough or explicit user skip"
      end
    when "explicit_approval"
      unless valid_human_merge_decision?(context["human_merge_decision"], context, now)
        failures << "explicit approval requires a proven exact-current-head human merge decision"
      end
    when "none"
      failures << "merge authority none can never produce an eligible receipt"
    end
  end

  def valid_human_merge_decision?(decision, context, now)
    return false unless decision.is_a?(Hash)
    return false unless decision.keys.sort == %w[
      base_ref contract decided_at decision diff_identity head_sha host merge_authority
      pr provenance repo version
    ].sort
    return false unless decision["contract"] == "human-merge-decision" && decision["version"] == 1
    return false unless decision["decision"] == "approved" && decision["merge_authority"] == true
    return false unless %w[direct-user human-maintainer].include?(decision["provenance"])
    return false unless valid_target_bindings?(decision, context)

    valid_human_timestamp?(decision["decided_at"], now)
  end

  def valid_walkthrough?(walkthrough, context)
    return false unless walkthrough.is_a?(Hash)
    return false unless walkthrough.keys.sort == %w[
      base_ref contract diff_identity disposition head_sha host pr provenance repo version
    ].sort
    return false unless walkthrough["contract"] == "pr-walkthrough" && walkthrough["version"] == 1
    return false unless valid_target_bindings?(walkthrough, context)

    case walkthrough["disposition"]
    when "completed"
      walkthrough["provenance"] == "pr-walkthrough"
    when "user-skipped"
      %w[direct-user human-maintainer].include?(walkthrough["provenance"])
    else
      false
    end
  end

  def valid_target_bindings?(receipt, context)
    receipt["host"] == context["host"] &&
      receipt["repo"] == context["repo"] &&
      receipt["pr"] == context["pr"] &&
      receipt["base_ref"] == context.dig("base", "ref") &&
      receipt["head_sha"] == context["head_sha"] &&
      receipt["diff_identity"] == context["diff_identity"]
  end

  def validate_operations(context, now, failures)
    operations = context["operations"].is_a?(Array) ? context["operations"] : []
    ordinary = operations.select do |operation|
      operation.is_a?(Hash) && operation["type"] == "ordinary-follow-up-bundle"
    end
    semantic_trackers = operations.select do |operation|
      operation.is_a?(Hash) && operation["type"] == "semantic-github-actions-tracker"
    end
    report_only_operations = operations.select do |operation|
      operation.is_a?(Hash) && operation["type"] == "post-merge-audit-report-only"
    end
    unknown_types = operations.filter_map do |operation|
      operation["type"] if operation.is_a?(Hash) &&
                           !%w[
                             ordinary-follow-up-bundle
                             semantic-github-actions-tracker
                             post-merge-audit-report-only
                           ].include?(operation["type"])
    end
    failures << "operations contain unknown types: #{unknown_types.join(', ')}" unless unknown_types.empty?
    failures << "operations must contain objects" if operations.any? { |operation| !operation.is_a?(Hash) }

    bundle_ids = []
    approval_ids = []
    ordinary.each_with_index do |bundle, index|
      unless bundle.keys.sort == %w[approval bundle_id items type]
        failures << "ordinary follow-up bundle has unknown or missing fields"
        next
      end
      bundle_id = bundle["bundle_id"].to_s
      if bundle_id.empty?
        failures << "ordinary follow-up bundle_id is required"
        next
      end
      failures << "ordinary follow-up bundle #{bundle_id} is duplicated" if bundle_ids.include?(bundle_id)
      bundle_ids << bundle_id
      unless bundle["items"].is_a?(Array) && !bundle["items"].empty? &&
             bundle["items"].all? { |item| item.is_a?(String) && !item.strip.empty? }
        failures << "ordinary follow-up bundle #{bundle_id} items are invalid"
      end
      approval_id = bundle.dig("approval", "approval_id")
      if approval_id.is_a?(String) && !approval_id.strip.empty?
        if approval_ids.include?(approval_id)
          failures << "ordinary follow-up approval #{approval_id} is duplicated"
        end
        approval_ids << approval_id
      end
      expected_scope = index.zero? ? "first-bundle" : "additional-bundle"
      next if valid_follow_up_approval?(
        bundle["approval"],
        bundle:,
        context:,
        scope: expected_scope,
        now:
      )

      qualifier = index.zero? ? "explicit human approval" : "additional explicit approval"
      failures << "ordinary follow-up bundle #{bundle_id} lacks #{qualifier}"
    end

    if context["semantic_github_actions_change"] == true
      unless semantic_trackers.length == 1
        failures << "semantic GitHub Actions change requires exactly one exercise tracker"
      end
    elsif semantic_trackers.any?
      failures << "semantic GitHub Actions tracker is invalid for a non-semantic change"
    end
    semantic_trackers.each { |tracker| validate_semantic_tracker(tracker, context, failures) }
    failures << "post-merge audit permits at most one report-only operation" if report_only_operations.length > 1
    report_only_operations.each do |operation|
      next if operation.keys.sort == %w[disposition provenance reason type] &&
              operation["disposition"] == "report-only" &&
              %w[direct-user human-maintainer].include?(operation["provenance"]) &&
              operation["reason"].is_a?(String) && !operation["reason"].strip.empty?

      failures << "post-merge audit report-only operation is invalid"
    end
    post_merge_audit = if report_only_operations.one?
                         report_only_operations.first.reject { |key, _value| key == "type" }
                       else
                         {
                           "disposition" => "accounted",
                           "children" => "create-per-independent-action-after-dedupe",
                           "parent" => "create-for-two-or-more-related-children"
                         }
                       end

    accounting = {
      "ordinary_follow_up_bundles" => ordinary.map do |bundle|
        {
          "bundle_id" => bundle["bundle_id"],
          "items" => bundle["items"]
        }
      end,
      "semantic_github_actions_tracker" => semantic_trackers.one? ? semantic_trackers.first : nil,
      "post_merge_audit" => post_merge_audit
    }
    semantic_tracker = if context["semantic_github_actions_change"] == true && semantic_trackers.one?
                         semantic_trackers.first
                       end
    [accounting, semantic_tracker]
  end

  def validate_semantic_tracker(tracker, context, failures)
    required_keys = %w[
      changed_files cleanup_instructions exercise expected_evidence source_pr tracker type
    ]
    allowed_keys = required_keys + ["owner"]
    unless (tracker.keys - allowed_keys).empty? && (required_keys - tracker.keys).empty?
      failures << "semantic GitHub Actions tracker has unknown or missing exercise fields"
      return
    end
    %w[tracker source_pr exercise expected_evidence cleanup_instructions].each do |key|
      unless tracker[key].is_a?(String) && !tracker[key].strip.empty?
        failures << "semantic GitHub Actions tracker #{key} is required"
      end
    end
    tracker_pattern = %r{
      \Ahttps://#{Regexp.escape(context['host'].to_s)}/
      #{Regexp.escape(context['repo'].to_s)}/issues/([1-9]\d*)\z
    }x
    tracker_match = tracker["tracker"].to_s.match(tracker_pattern)
    failures << "semantic GitHub Actions tracker URL is not a same-repository issue" unless tracker_match
    expected_source_pr = "https://#{context['host']}/#{context['repo']}/pull/#{context['pr']}"
    failures << "semantic GitHub Actions source PR binding mismatch" unless
      tracker["source_pr"] == expected_source_pr
    changed_files = tracker["changed_files"]
    unless changed_files.is_a?(Array) && !changed_files.empty? &&
           changed_files.all? do |path|
             path.is_a?(String) &&
             (path.start_with?(".github/workflows/") || path.start_with?(".github/actions/"))
           end
      failures << "semantic GitHub Actions tracker changed_files are invalid"
    end
    if tracker.key?("owner") &&
       !(tracker["owner"].is_a?(String) && !tracker["owner"].strip.empty?)
      failures << "semantic GitHub Actions tracker owner is invalid"
    end
  end

  def authenticate_semantic_tracker(tracker, context, now, failures)
    issue_number = tracker["tracker"].match(%r{/issues/([1-9]\d*)\z})&.captures&.first&.to_i
    issue = read_authenticated_issue(
      host: context["host"],
      repo: context["repo"],
      issue: issue_number
    )
    return failures << "semantic GitHub Actions tracker authenticated read failed" unless issue

    validate_authenticated_issue(
      issue,
      tracker:,
      issue_number:,
      context:,
      now:,
      failures:
    )
  end

  def read_authenticated_issue(host:, repo:, issue:)
    stdout_file = Tempfile.new("merge-assurance-tracker-stdout")
    stderr_file = Tempfile.new("merge-assurance-tracker-stderr")
    pid = Process.spawn(
      "gh", "api", "--hostname", host, "repos/#{repo}/issues/#{issue}",
      out: stdout_file.path, err: stderr_file.path, pgroup: true
    )
    deadline = monotonic_time + tracker_gh_timeout_seconds
    status = nil
    timed_out = false
    cleanup_complete = true
    loop do
      waited = Process.waitpid2(pid, Process::WNOHANG)
      if waited
        status = waited[1]
        break
      end
      if monotonic_time >= deadline
        timed_out = true
        status, cleanup_complete = terminate_tracker_process_group(pid)
        break
      end

      sleep TRACKER_GH_POLL_SECONDS
    end
    unless timed_out
      group_deadline = monotonic_time + TRACKER_GH_TERMINATION_GRACE_SECONDS
      unless wait_for_tracker_process_group_exit(pid, group_deadline)
        _ignored_status, cleanup_complete = terminate_tracker_process_group(pid)
        status = nil
      end
    end
    return unless cleanup_complete && !timed_out && status&.success?

    stdout_file.rewind
    parsed = JSON.parse(stdout_file.read)
    parsed if parsed.is_a?(Hash)
  rescue Error, JSON::ParserError, SystemCallError
    nil
  ensure
    terminate_tracker_process_group(pid) if pid && tracker_process_group_alive?(pid)
    stdout_file&.close!
    stderr_file&.close!
  end

  def tracker_gh_timeout_seconds
    value = Float(ENV.fetch("MERGE_ASSURANCE_GH_TIMEOUT_SECONDS", TRACKER_GH_TIMEOUT_SECONDS.to_s))
    raise Error, "tracker gh timeout must be a positive finite number" unless value.positive? && value.finite?

    value
  rescue ArgumentError
    raise Error, "tracker gh timeout must be a positive finite number"
  end

  def terminate_tracker_process_group(pid)
    signal_tracker_process_group("TERM", pid)
    deadline = monotonic_time + TRACKER_GH_TERMINATION_GRACE_SECONDS
    status = wait_for_tracker_child(pid, deadline)
    return [status, true] if wait_for_tracker_process_group_exit(pid, deadline)

    signal_tracker_process_group("KILL", pid)
    deadline = monotonic_time + TRACKER_GH_TERMINATION_GRACE_SECONDS
    status ||= wait_for_tracker_child(pid, deadline)
    [status, wait_for_tracker_process_group_exit(pid, deadline)]
  end

  def signal_tracker_process_group(signal, pid)
    Process.kill(signal, -pid)
  rescue Errno::ESRCH
    nil
  end

  def wait_for_tracker_child(pid, deadline)
    while monotonic_time < deadline
      waited = Process.waitpid2(pid, Process::WNOHANG)
      return waited[1] if waited

      sleep TRACKER_GH_POLL_SECONDS
    end
    nil
  rescue Errno::ECHILD
    nil
  end

  def tracker_process_group_alive?(pid)
    Process.kill(0, -pid)
    true
  rescue Errno::ESRCH
    false
  rescue Errno::EPERM
    true
  end

  def wait_for_tracker_process_group_exit(pid, deadline)
    while monotonic_time < deadline
      return true unless tracker_process_group_alive?(pid)

      sleep TRACKER_GH_POLL_SECONDS
    end
    !tracker_process_group_alive?(pid)
  end

  def monotonic_time
    Process.clock_gettime(Process::CLOCK_MONOTONIC)
  end

  def validate_authenticated_issue(issue, tracker:, issue_number:, context:, now:, failures:)
    expected_html_url = tracker["tracker"]
    expected_api_url = if context["host"] == "github.com"
                         "https://api.github.com/repos/#{context['repo']}/issues/#{issue_number}"
                       else
                         "https://#{context['host']}/api/v3/repos/#{context['repo']}/issues/#{issue_number}"
                       end
    metadata_valid = issue["id"].is_a?(Integer) && issue["id"].positive? &&
                     issue["node_id"].is_a?(String) && !issue["node_id"].empty? &&
                     issue["number"] == issue_number &&
                     issue["url"] == expected_api_url &&
                     issue["html_url"] == expected_html_url &&
                     %w[open closed].include?(issue["state"]) &&
                     issue["title"].is_a?(String) && !issue["title"].strip.empty? &&
                     issue["body"].is_a?(String) &&
                     !issue.key?("pull_request")
    begin
      Time.iso8601(issue["updated_at"].to_s)
    rescue ArgumentError
      metadata_valid = false
    end
    unless metadata_valid
      failures << "semantic GitHub Actions tracker authenticated issue metadata is malformed or mismatched"
      return
    end

    operation_digest = semantic_tracker_operation_digest(tracker)
    expected_bindings = {
      "semantic-tracker-source-pr" => tracker["source_pr"],
      "semantic-tracker-head-sha" => context["head_sha"],
      "semantic-tracker-diff-identity" => context["diff_identity"],
      "semantic-tracker-operation-digest" => operation_digest
    }
    unless valid_semantic_tracker_body_bindings?(issue["body"], expected_bindings)
      failures << "semantic GitHub Actions tracker issue body binding mismatch"
      return
    end

    {
      "contract" => "authenticated-semantic-tracker-read",
      "version" => 1,
      "provenance" => "gh-api",
      "checked_at" => now.utc.iso8601,
      "host" => context["host"],
      "repo" => context["repo"],
      "issue" => issue_number,
      "tracker" => tracker["tracker"],
      "source_pr" => tracker["source_pr"],
      "head_sha" => context["head_sha"],
      "diff_identity" => context["diff_identity"],
      "operation_digest" => operation_digest,
      "issue_metadata" => {
        "id" => issue["id"],
        "node_id" => issue["node_id"],
        "url" => issue["url"],
        "html_url" => issue["html_url"],
        "state" => issue["state"],
        "title" => issue["title"],
        "updated_at" => issue["updated_at"],
        "body_digest" => "sha256:#{Digest::SHA256.hexdigest(issue['body'])}"
      }
    }
  end

  def valid_semantic_tracker_body_bindings?(body, expected_bindings)
    parsed_bindings = Hash.new { |bindings, key| bindings[key] = [] }
    malformed = body.lines(chomp: true).any? do |raw_line|
      line = raw_line.strip
      next false unless line.start_with?("semantic-tracker-")

      key, separator, value = line.partition(": ")
      if separator.empty? || !expected_bindings.key?(key)
        true
      else
        parsed_bindings[key] << value
        false
      end
    end
    !malformed && expected_bindings.all? do |key, expected_value|
      parsed_bindings[key] == [expected_value]
    end
  end

  def semantic_tracker_operation_digest(tracker)
    keys = %w[
      changed_files cleanup_instructions exercise expected_evidence owner source_pr tracker type
    ]
    operation = keys.each_with_object({}) do |key, selected|
      selected[key] = tracker[key] if tracker.key?(key)
    end
    "sha256:#{Digest::SHA256.hexdigest(canonical_json(operation))}"
  end

  def valid_follow_up_approval?(approval, bundle:, context:, scope:, now: Time.now.utc)
    return false unless approval.is_a?(Hash)
    return false unless approval.keys.sort == %w[
      approval_id approved_at bundle_id contract decision diff_identity head_sha
      host items_digest pr provenance repo scope version
    ].sort
    return false unless approval["contract"] == "follow-up-approval" && approval["version"] == 1
    return false unless approval["decision"] == "approved" && approval["scope"] == scope
    return false unless %w[direct-user human-maintainer].include?(approval["provenance"])
    return false unless approval["approval_id"].is_a?(String) && !approval["approval_id"].strip.empty?
    return false unless approval["items_digest"] == canonical_items_digest(bundle["items"])
    return false unless approval["bundle_id"] == bundle["bundle_id"]
    return false unless approval["host"] == context["host"] &&
                        approval["repo"] == context["repo"] &&
                        approval["pr"] == context["pr"] &&
                        approval["head_sha"] == context["head_sha"] &&
                        approval["diff_identity"] == context["diff_identity"]

    valid_human_timestamp?(approval["approved_at"], now)
  end

  def valid_human_timestamp?(raw, now)
    Time.iso8601(raw.to_s) - now <= MAX_FUTURE_SKEW_SECONDS
  rescue ArgumentError
    false
  end

  def validate_timestamp(raw, now, label, failures)
    timestamp = Time.iso8601(raw.to_s)
    age = now - timestamp
    failures << "#{label} evidence is stale" if age > MAX_EVIDENCE_AGE_SECONDS
    failures << "#{label} evidence is too far in the future" if age < -MAX_FUTURE_SKEW_SECONDS
  rescue ArgumentError
    failures << "#{label} checked_at is invalid"
  end

  def canonical_json(value)
    case value
    when Hash
      "{#{value.keys.sort.map { |key| "#{JSON.generate(key)}:#{canonical_json(value.fetch(key))}" }.join(',')}}"
    when Array
      "[#{value.map { |item| canonical_json(item) }.join(',')}]"
    else
      JSON.generate(value)
    end
  end

  def evidence_digest(evidence)
    "sha256:#{Digest::SHA256.hexdigest(canonical_json(evidence))}"
  end

  def canonical_items_digest(items)
    "sha256:#{Digest::SHA256.hexdigest(canonical_json(items))}"
  end

  def valid_evidence_digest?(receipt)
    receipt.is_a?(Hash) && receipt["evidence"].is_a?(Hash) &&
      receipt["evidence_digest"] == evidence_digest(receipt["evidence"])
  end

  def full_sha?(value)
    value.to_s.match?(/\A[0-9a-f]{40}\z/i)
  end

  def valid_ref?(value)
    value.to_s.match?(/\A[^\s~^:?*\[\\]+\z/) && !value.to_s.include?("..")
  end

  def valid_host?(value)
    value.to_s.match?(/\A[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::\d{1,5})?\z/i)
  end

  class Runner
    def run(argv)
      options = parse_options(argv)
      return help if options[:help]

      result = MergeAssurance.assess(
        ci_result: read_json(options[:ci_result], "--ci-result"),
        autonomous_result: read_json(options[:autonomous_result], "--autonomous-result"),
        context: read_json(options[:context], "--context")
      )
      puts JSON.pretty_generate(result)
      result["eligible"] ? 0 : 1
    rescue Error => e
      puts JSON.pretty_generate(MergeAssurance.blocked_result([e.message]))
      1
    end

    private

    def parse_options(argv)
      options = {}
      parser = OptionParser.new do |opts|
        opts.banner = "Usage: merge-assurance --ci-result FILE --autonomous-result FILE --context FILE"
        opts.on("--ci-result FILE") { |value| options[:ci_result] = value }
        opts.on("--autonomous-result FILE") { |value| options[:autonomous_result] = value }
        opts.on("--context FILE") { |value| options[:context] = value }
        opts.on("-h", "--help") { options[:help] = true }
      end
      remaining = parser.parse(argv)
      raise Error, "unexpected arguments: #{remaining.join(' ')}" unless remaining.empty?

      unless options[:help]
        %i[ci_result autonomous_result context].each do |key|
          raise Error, "--#{key.to_s.tr('_', '-')} is required" if options[key].to_s.empty?
        end
      end
      options
    rescue OptionParser::ParseError => e
      raise Error, e.message
    end

    def read_json(path, flag)
      raw = File.read(path, encoding: "UTF-8")
      parsed = JSON.parse(raw)
      raise Error, "#{flag} must contain a JSON object" unless parsed.is_a?(Hash)

      parsed
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "#{flag} is unavailable: #{e.message}"
    rescue JSON::ParserError => e
      raise Error, "#{flag} is invalid JSON: #{e.message}"
    end

    def help
      puts "Usage: merge-assurance --ci-result FILE --autonomous-result FILE --context FILE"
      0
    end
  end
end

exit MergeAssurance::Runner.new.run(ARGV) if $PROGRAM_NAME == __FILE__
