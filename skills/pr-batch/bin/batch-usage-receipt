#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds a deterministic, metadata-only usage receipt from Codex rollout JSONL
# and state_5.sqlite. Rollout records are consumed one line at a time; only
# whitelisted session, route, timestamp, and cumulative usage metadata survives
# each iteration.

require "date"
require "digest"
require "json"
require "open3"
require "optparse"
# rubocop:disable Lint/RedundantRequireStatement -- required on Ruby 3.1 and earlier
require "set"
# rubocop:enable Lint/RedundantRequireStatement
require "time"

module BatchUsageReceipt
  SCHEMA = "batch-usage-receipt-v2"
  MANIFEST_SCHEMA = "batch-usage-manifest-v1"
  RATE_CARD_SCHEMA = "batch-usage-rate-card-v1"
  EXPLICIT_UTC_OFFSET = /(?:Z|[+-]\d{2}(?::?\d{2})?)\z/i
  FOUR_DIGIT_YEAR = /\A\d{4}-/
  RFC3339_DATE_TIME = /
    \A
    (?<year>\d{4})-(?<month>0[1-9]|1[0-2])-(?<day>0[1-9]|[12]\d|3[01])
    T(?:[01]\d|2[0-3]):[0-5]\d:(?<second>[0-5]\d|60)
    (?:\.\d{1,9})?
    (?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)
    \z
  /ix
  TOKEN_FIELDS = %w[input_tokens output_tokens reasoning_output_tokens cache_read_tokens total_tokens].freeze
  ACCOUNTING_FIELDS = %w[
    usage_samples duplicate_samples_omitted replay_records_omitted counter_resets
    inherited_seeds_omitted compactions session_rebind_attempts_ignored
  ].freeze
  UNKNOWN = "UNKNOWN"

  InputError = Class.new(StandardError)

  module_function

  def blank_usage(value = 0)
    TOKEN_FIELDS.to_h { |field| [field, value] }
  end

  def unknown_usage
    blank_usage(UNKNOWN)
  end

  def known_usage?(usage)
    TOKEN_FIELDS.all? { |field| usage[field].is_a?(Integer) }
  end

  def known_priced_usage?(usage)
    usage.values_at("input_tokens", "output_tokens").all? { |value| value.is_a?(Integer) }
  end

  def add_usage(left, right)
    TOKEN_FIELDS.to_h do |field|
      values = [left[field], right[field]]
      [field, values.all? { |value| value.is_a?(Integer) } ? values.sum : UNKNOWN]
    end
  end

  def canonical_usage(raw)
    return unless raw.is_a?(Hash)

    {
      "input_tokens" => nonnegative_integer(raw["input_tokens"]),
      "output_tokens" => nonnegative_integer(raw["output_tokens"]),
      "reasoning_output_tokens" => nonnegative_integer(raw["reasoning_output_tokens"]),
      "cache_read_tokens" => nonnegative_integer(raw["cached_input_tokens"] || raw["cache_read_tokens"]),
      "total_tokens" => nonnegative_integer(raw["total_tokens"])
    }
  end

  def invalid_known_usage_vector?(usage)
    input, output, total = usage.values_at("input_tokens", "output_tokens", "total_tokens")
    [input, output, total].all? { |value| value.is_a?(Integer) } && total < input + output
  end

  def nonnegative_integer(value)
    value if value.is_a?(Integer) && value >= 0
  end

  def same_known_vector?(left, right)
    left && right && TOKEN_FIELDS.all? { |field| left[field] == right[field] }
  end

  def decreased_fields(current, previous)
    TOKEN_FIELDS.select do |field|
      current[field].is_a?(Integer) && previous[field].is_a?(Integer) && current[field] < previous[field]
    end
  end

  def vector_difference(current, previous)
    TOKEN_FIELDS.to_h do |field|
      values = [current[field], previous[field]]
      [field, values.all? { |value| value.is_a?(Integer) } ? current[field] - previous[field] : UNKNOWN]
    end
  end

  def vector_after_decrease(current, previous, reset:)
    TOKEN_FIELDS.to_h do |field|
      values = [current[field], previous[field]]
      value = if !values.all? { |item| item.is_a?(Integer) }
                UNKNOWN
              elsif reset
                current[field]
              elsif current[field] < previous[field]
                UNKNOWN
              else
                current[field] - previous[field]
              end
      [field, value]
    end
  end

  def vector_for_first_sample(total, last)
    missing_fields = TOKEN_FIELDS.reject { |field| last&.dig(field).is_a?(Integer) }
    delta = TOKEN_FIELDS.to_h do |field|
      [field, last&.dig(field).is_a?(Integer) ? last[field] : UNKNOWN]
    end
    inherited_seed = TOKEN_FIELDS.any? do |field|
      total[field].is_a?(Integer) && last&.dig(field).is_a?(Integer) && total[field] != last[field]
    end
    [delta, inherited_seed, missing_fields]
  end

  def in_window?(timestamp, from_time, to_time)
    parsed = Time.iso8601(timestamp)
    parsed >= from_time && parsed < to_time
  rescue ArgumentError, TypeError
    false
  end

  class RolloutReader
    include BatchUsageReceipt

    attr_reader :accounting, :first_session_id, :physical_id, :unknown_reasons, :route_usage

    def initialize(path:, state_thread:, identity_thread_ids:, from_time:, to_time:)
      @path = path
      @state_thread = state_thread
      @identity_thread_ids = identity_thread_ids
      @from_time = from_time
      @to_time = to_time
      @accounting = ACCOUNTING_FIELDS.to_h { |field| [field, 0] }
      @unknown_reasons = []
      @unknown_reason_keys = Set.new
      @global_unknown_usage_fields = []
      @route_usage = {}
      @current_turn_segment = nil
      @current_turn_started_at = nil
      @next_turn_segment = 0
      @contributing_turn_segments = Set.new
      @turn_evidence_unknown = false
      @first_session_id = nil
      @first_session_seen = false
      @forked_physical_session = false
      @fork_started_at = nil
      @copy_boundary_seen = false
    end

    def read
      unless File.file?(@path)
        unknown("rollout_missing")
        finalize_identity
        return self
      end

      previous = nil
      replay_prefix = false
      first_usage = true
      compaction_since_usage = false
      current_route = state_route
      replay_prefix_deferred_reasons = []

      File.foreach(@path, encoding: "UTF-8").with_index(1) do |line, line_number|
        unless line.valid_encoding?
          unknown(
            "rollout_read_error", line: line_number, detail: Encoding::InvalidByteSequenceError.name
          )
          next
        end

        begin
          record = JSON.parse(line)
        rescue JSON::ParserError
          if replay_prefix
            replay_prefix_deferred_reasons << ["malformed_jsonl", { line: line_number }]
          else
            unknown("malformed_jsonl", line: line_number)
          end
          next
        end
        unless record.is_a?(Hash)
          unknown("non_object_rollout_record", line: line_number)
          next
        end

        payload = record["payload"]
        case record["type"]
        when "session_meta"
          next unless payload.is_a?(Hash)

          candidate = payload["id"]
          if @first_session_seen
            next unless candidate.is_a?(String) && candidate != @first_session_id

            @accounting["session_rebind_attempts_ignored"] += 1
          else
            @first_session_seen = true
            @first_session_id = candidate if candidate.is_a?(String) && !candidate.empty?
            unknown("missing_first_session_id") unless @first_session_id
            @forked_physical_session = @first_session_id &&
                                       payload["session_id"].is_a?(String) &&
                                       payload["session_id"] != @first_session_id &&
                                       payload["parent_thread_id"].is_a?(String) &&
                                       !payload["parent_thread_id"].empty?
            if @forked_physical_session
              @fork_started_at = parsed_timestamp(record["timestamp"])
              replay_prefix = true
            end
            if @first_session_id && @first_session_id != @state_thread.fetch("id")
              unknown("state_thread_first_session_mismatch")
            end
          end
        when "inter_agent_communication_metadata"
          boundary_at = parsed_timestamp(record["timestamp"])
          unknown("invalid_boundary_timestamp", line: line_number) if replay_prefix && !boundary_at
          # A nested fork's copied prefix can contain older ancestor boundaries.
          # Only a marker from this physical session can end its replay prefix.
          if replay_prefix && @fork_started_at && boundary_at && boundary_at >= @fork_started_at
            flush_replay_prefix_reasons(replay_prefix_deferred_reasons)
            @copy_boundary_seen = true
            replay_prefix = false
            compaction_since_usage = false
          end
        when "compacted"
          @accounting["compactions"] += 1
          compaction_since_usage = true
        when "turn_context"
          next if replay_prefix

          unless payload.is_a?(Hash)
            @current_turn_segment = nil
            @current_turn_started_at = nil
            unknown_turn("invalid_turn_context", line: line_number)
            next
          end

          current_route = observed_route(payload)
          turn_started_at = parsed_timestamp(record["timestamp"])
          unless turn_started_at
            @current_turn_segment = nil
            @current_turn_started_at = nil
            unknown_turn("invalid_turn_timestamp", line: line_number)
            next
          end
          @next_turn_segment += 1
          @current_turn_segment = @next_turn_segment
          @current_turn_started_at = turn_started_at
        when "event_msg"
          next unless payload.is_a?(Hash) && payload["type"] == "token_count"

          usage_timestamp = parsed_timestamp(record["timestamp"])
          usage_timestamp_valid = !usage_timestamp.nil?
          unknown("invalid_usage_timestamp", line: line_number) unless usage_timestamp_valid
          next if usage_timestamp_valid && usage_timestamp >= @to_time

          @accounting["usage_samples"] += 1
          info = payload["info"]
          total = canonical_usage(info.is_a?(Hash) ? info["total_token_usage"] : nil)
          last = canonical_usage(info.is_a?(Hash) ? info["last_token_usage"] : nil)
          unless total
            if replay_prefix
              @accounting["replay_records_omitted"] += 1
              replay_prefix_deferred_reasons << ["missing_total_token_usage", { line: line_number }]
            else
              unknown("missing_total_token_usage", line: line_number)
            end
            next
          end

          invalid_sources = {
            "total_token_usage" => total,
            "last_token_usage" => last
          }.select { |_counter_source, usage| usage && invalid_known_usage_vector?(usage) }
          unless invalid_sources.empty?
            if replay_prefix
              @accounting["replay_records_omitted"] += 1
              invalid_sources.each_key do |counter_source|
                replay_prefix_deferred_reasons << [
                  "invalid_token_usage_vector", { line: line_number, counter_source: counter_source }
                ]
              end
            else
              invalid_sources.each_key do |counter_source|
                unknown("invalid_token_usage_vector", line: line_number, counter_source: counter_source)
              end
            end
            next
          end

          if replay_prefix
            @accounting["replay_records_omitted"] += 1
            replay_prefix_deferred_reasons.clear
            previous = total
            first_usage = false
            compaction_since_usage = false
            next
          end

          if same_known_vector?(total, previous)
            @accounting["duplicate_samples_omitted"] += 1
            next
          end

          explained_unknown_fields = []
          delta = if first_usage
                    value, inherited_seed, missing_fields = vector_for_first_sample(total, last)
                    @accounting["inherited_seeds_omitted"] += 1 if inherited_seed
                    unless missing_fields.empty?
                      unknown(
                        "missing_first_last_token_usage",
                        line: line_number,
                        fields: missing_fields,
                        affects_usage: false
                      )
                      explained_unknown_fields = missing_fields
                    end
                    value
                  elsif (decreased = decreased_fields(total, previous)).any?
                    if compaction_since_usage
                      @accounting["counter_resets"] += 1
                      vector_after_decrease(total, previous, reset: true)
                    else
                      unknown(
                        "ambiguous_counter_decrease", line: line_number, fields: decreased, affects_usage: false
                      )
                      explained_unknown_fields = decreased
                      vector_after_decrease(total, previous, reset: false)
                    end
                  else
                    vector_difference(total, previous)
                  end

          # Deliberately update the cumulative baseline before applying the
          # time window. This prevents a boundary-straddling sample from
          # importing all pre-window history.
          previous = total
          first_usage = false
          compaction_since_usage = false
          next unless usage_timestamp_valid
          next unless in_window?(record["timestamp"], @from_time, @to_time)

          record_turn_contribution(delta, usage_timestamp, line_number)
          add_route_usage(
            current_route, delta, line: line_number, explained_unknown_fields: explained_unknown_fields
          )
        end
      end

      if replay_prefix
        flush_replay_prefix_reasons(replay_prefix_deferred_reasons)
        unknown("copied_history_boundary_missing")
      end
      unknown("missing_first_session_meta") unless @first_session_id
      unknown("missing_usage_evidence") if @accounting["usage_samples"].zero?
      finalize_identity
      self
    rescue SystemCallError, EncodingError => e
      unknown("rollout_read_error", detail: e.class.name)
      finalize_identity
      self
    end

    def totals
      apply_global_unknowns(@route_usage.values.reduce(blank_usage) { |sum, usage| add_usage(sum, usage) })
    end

    def observed_routes
      @route_usage.keys.sort.map do |key|
        route = JSON.parse(key)
        route.merge("usage" => apply_global_unknowns(@route_usage.fetch(key)))
      end
    end

    def contributing_turn_count
      @turn_evidence_unknown ? UNKNOWN : @contributing_turn_segments.length
    end

    def validate_state_thread_id(state_thread_id)
      return if @first_session_id.nil? || @first_session_id == state_thread_id

      unknown("state_thread_first_session_mismatch")
    end

    private

    def state_route
      {
        "host" => "codex",
        "provider" => nonempty_string(@state_thread["model_provider"]) || UNKNOWN,
        "model" => nonempty_string(@state_thread["model"]) || UNKNOWN,
        "effort" => nonempty_string(@state_thread["reasoning_effort"]) || UNKNOWN
      }
    end

    def observed_route(payload)
      state_route.merge(
        "model" => nonempty_string(payload["model"]) || state_route["model"],
        "effort" => nonempty_string(payload["effort"]) || state_route["effort"]
      )
    end

    def nonempty_string(value)
      value if value.is_a?(String) && !value.strip.empty?
    end

    def add_route_usage(route, usage, line:, explained_unknown_fields: [])
      missing_route_fields = %w[provider model effort].select { |field| route[field] == UNKNOWN }
      unless missing_route_fields.empty?
        unknown(
          "route_metadata_missing", line: line, fields: missing_route_fields, affects_usage: false
        )
      end
      key = JSON.generate(route.sort.to_h)
      @route_usage[key] = add_usage(@route_usage.fetch(key, blank_usage), usage)
      missing_fields = TOKEN_FIELDS.reject { |field| usage[field].is_a?(Integer) } - explained_unknown_fields
      return if missing_fields.empty?

      unknown("usage_counter_missing", line: line, fields: missing_fields, affects_usage: false)
    end

    def record_turn_contribution(usage, usage_timestamp, line_number)
      total_tokens = usage["total_tokens"]
      if !total_tokens.is_a?(Integer)
        unknown_turn("ambiguous_turn_usage", line: line_number)
      elsif total_tokens.positive?
        if @current_turn_segment
          if usage_timestamp >= @current_turn_started_at
            @contributing_turn_segments.add(@current_turn_segment)
          else
            unknown_turn("ambiguous_turn_timestamp", line: line_number)
          end
        else
          unknown_turn("turn_context_missing_for_usage", line: line_number)
        end
      end
    end

    def apply_global_unknowns(usage)
      usage.merge(@global_unknown_usage_fields.to_h { |field| [field, UNKNOWN] })
    end

    def parsed_timestamp(value)
      parsed = Time.iso8601(value)
      parsed if value.match?(EXPLICIT_UTC_OFFSET)
    rescue ArgumentError, TypeError
      nil
    end

    def unknown(code, affects_usage: true, **extra)
      reason = { "status" => UNKNOWN, "code" => code }.merge(extra.transform_keys(&:to_s))
      @unknown_reasons << reason if @unknown_reason_keys.add?(reason)
      @global_unknown_usage_fields |= TOKEN_FIELDS if affects_usage
      @turn_evidence_unknown = true if affects_usage
      reason
    end

    def unknown_turn(code, **extra)
      @turn_evidence_unknown = true
      unknown(code, affects_usage: false, **extra)
    end

    def flush_replay_prefix_reasons(reasons)
      reasons.each { |code, details| unknown(code, **details) }
      reasons.clear
    end

    def finalize_identity
      identity_thread_id = if @first_session_id && @identity_thread_ids.include?(@first_session_id)
                             @first_session_id
                           else
                             @identity_thread_ids.fetch(0)
                           end
      seed = ["codex-rollout-v2", @first_session_id || identity_thread_id, identity_thread_id].join("\0")
      @physical_id = "sha256:#{Digest::SHA256.hexdigest(seed)}"
    end
  end

  class Reporter
    include BatchUsageReceipt

    def initialize(manifest:, database_path:, from_time:, to_time:, rate_card: nil)
      @manifest = manifest
      @database_path = database_path
      @from_time = from_time
      @to_time = to_time
      @rate_card = rate_card
      @unknown = []
      @threads = {}
      @children = Hash.new { |hash, key| hash[key] = [] }
      @readers_by_thread = {}
      @readers_by_rollout = {}
      @state_loaded = false
      @topology_unknown_lane_ids = Set.new
      @batch_reconciliation_topology_unknown = false
    end

    def build
      validate_manifest!
      load_state
      roots = manifest_roots
      batch_thread_ids = roots.flat_map { |root| closure(root) }.uniq.sort
      identity_validation_thread_ids = manifest_thread_ids.flat_map { |thread_id| closure(thread_id) }.uniq.sort
      record_scope_topology_unknowns
      identity_validation_thread_ids.each { |thread_id| reader_for(thread_id) }

      coordinator = scope_receipt(
        "coordinator", @manifest.fetch("coordinator").fetch("id"),
        @manifest.fetch("coordinator").fetch("root_thread_id"),
        @manifest.fetch("coordinator").fetch("requested_route")
      )
      lanes = @manifest.fetch("lanes").map { |lane| lane_receipt(lane) }
      batch_usage = aggregate(batch_thread_ids)
      batch_turns = aggregate_turns(batch_thread_ids)
      attributed_ids = [@manifest.dig("coordinator", "root_thread_id")]
      lanes.each { |lane| attributed_ids.concat(lane.fetch("_thread_ids")) }
      unattributed_ids = batch_thread_ids - attributed_ids.uniq

      receipt = {
        "schema" => SCHEMA,
        "batch" => {
          "scope" => "batch",
          "id" => @manifest.fetch("batch_id"),
          "usage" => {
            "descendant_inclusive" => batch_usage,
            "unattributed" => aggregate(unattributed_ids)
          },
          "turns" => {
            "descendant_inclusive" => batch_turns,
            "unattributed" => aggregate_turns(unattributed_ids)
          },
          "reconciliation" => {
            "status" => reconciliation_status(
              batch_usage, batch_turns, coordinator, lanes, unattributed_ids
            ),
            "equation" => "batch descendant-inclusive = coordinator self-only + lane descendant-inclusive + unattributed"
          }
        },
        "coordinator" => strip_internal(coordinator),
        "lanes" => lanes.map { |lane| strip_internal(lane) },
        "window" => {
          "from_inclusive" => @from_time.utc.iso8601(9),
          "to_exclusive" => @to_time.utc.iso8601(9),
          "differencing" => "full_history_before_window_filter"
        },
        "accounting" => aggregate_accounting(batch_thread_ids),
        "evidence" => {
          "status" => @unknown.empty? ? "complete" : UNKNOWN,
          "sources" => ["codex_rollout_jsonl", "state_5.sqlite"],
          "unknown" => @unknown.sort_by { |item| JSON.generate(item) }
        },
        "privacy" => {
          "mode" => "metadata_only",
          "emitted_or_persisted_content" => false,
          "excluded" => %w[prompt response tool_result auth secret environment]
        }
      }
      receipt["credit_equivalents"] = credit_equivalents(batch_usage) if @rate_card
      receipt
    end

    private

    def validate_manifest!
      raise InputError, "manifest must be an object" unless @manifest.is_a?(Hash)
      raise InputError, "manifest schema must be #{MANIFEST_SCHEMA}" unless @manifest["schema"] == MANIFEST_SCHEMA

      require_string!(@manifest["batch_id"], "batch_id")
      coordinator = @manifest["coordinator"]
      raise InputError, "coordinator must be an object" unless coordinator.is_a?(Hash)

      %w[id root_thread_id].each { |key| require_string!(coordinator[key], "coordinator.#{key}") }
      validate_route!(coordinator["requested_route"], "coordinator.requested_route")
      lanes = @manifest["lanes"]
      raise InputError, "lanes must be an array" unless lanes.is_a?(Array)

      lane_ids = {}
      worker_ids = {}
      root_ids = { coordinator.fetch("root_thread_id") => true }
      lanes.each_with_index do |lane, index|
        raise InputError, "lanes[#{index}] must be an object" unless lane.is_a?(Hash)

        %w[id root_thread_id].each { |key| require_string!(lane[key], "lanes[#{index}].#{key}") }
        raise InputError, "duplicate lane id #{lane['id']}" if lane_ids[lane["id"]]
        raise InputError, "scope roots must be unique: #{lane['root_thread_id']}" if root_ids[lane["root_thread_id"]]

        lane_ids[lane["id"]] = true
        root_ids[lane["root_thread_id"]] = true
        validate_route!(lane["requested_route"], "lanes[#{index}].requested_route")
        workers = lane["workers"] || []
        raise InputError, "lanes[#{index}].workers must be an array" unless workers.is_a?(Array)

        workers.each_with_index do |worker, worker_index|
          unless worker.is_a?(Hash)
            raise InputError, "lanes[#{index}].workers[#{worker_index}] must be an object"
          end

          %w[id thread_id].each do |key|
            require_string!(worker[key], "lanes[#{index}].workers[#{worker_index}].#{key}")
          end
          raise InputError, "duplicate worker id #{worker['id']}" if worker_ids[worker["id"]]

          worker_ids[worker["id"]] = true
          validate_route!(worker["requested_route"], "lanes[#{index}].workers[#{worker_index}].requested_route")
        end
      end
    end

    def require_string!(value, label)
      raise InputError, "#{label} must be a nonempty string" unless value.is_a?(String) && !value.strip.empty?
    end

    def validate_route!(route, label)
      raise InputError, "#{label} must be an object" unless route.is_a?(Hash)

      %w[host model effort].each { |key| require_string!(route[key], "#{label}.#{key}") }
    end

    def load_state
      unless File.file?(@database_path)
        @unknown << { "status" => UNKNOWN, "code" => "state_database_missing" }
        return
      end

      stdout, _, status = Open3.capture3(
        "sqlite3", "-readonly", "-batch", "-noheader", @database_path, state_query
      )
      unless status.success?
        @unknown << { "status" => UNKNOWN, "code" => "state_database_unsupported" }
        return
      end

      snapshot = JSON.parse(stdout)
      snapshot.fetch("threads").each do |row|
        @threads[row.fetch("id")] = row
      end
      snapshot.fetch("edges").each do |row|
        @children[row.fetch("parent_thread_id")] << row.fetch("child_thread_id")
      end
      @state_loaded = true
    rescue Errno::ENOENT
      @unknown << { "status" => UNKNOWN, "code" => "sqlite3_cli_unavailable" }
    rescue JSON::ParserError, KeyError
      @unknown << { "status" => UNKNOWN, "code" => "state_database_unsupported" }
    ensure
      @children.each_value(&:sort!)
    end

    def state_query
      roots = manifest_thread_ids.map { |thread_id| "(#{sql_text_literal(thread_id)})" }.join(",\n        ")
      <<~SQL
        WITH RECURSIVE
        roots(id) AS (
          VALUES #{roots}
        ),
        reachable(id) AS (
          SELECT id FROM roots
          UNION
          SELECT edge.child_thread_id
          FROM thread_spawn_edges AS edge
          JOIN reachable ON reachable.id = edge.parent_thread_id
        ),
        scoped_threads AS (
          SELECT thread.id, thread.rollout_path, thread.model_provider, thread.model, thread.reasoning_effort
          FROM threads AS thread
          JOIN reachable ON reachable.id = thread.id
          ORDER BY thread.id
        ),
        scoped_edges AS (
          SELECT edge.parent_thread_id, edge.child_thread_id
          FROM thread_spawn_edges AS edge
          JOIN reachable ON reachable.id = edge.parent_thread_id
          ORDER BY edge.parent_thread_id, edge.child_thread_id
        )
        SELECT json_object(
          'threads', (
            SELECT json_group_array(json_object(
              'id', id,
              'rollout_path', rollout_path,
              'model_provider', model_provider,
              'model', model,
              'reasoning_effort', reasoning_effort
            )) FROM scoped_threads
          ),
          'edges', (
            SELECT json_group_array(json_object(
              'parent_thread_id', parent_thread_id,
              'child_thread_id', child_thread_id
            )) FROM scoped_edges
          )
        );
      SQL
    end

    def manifest_thread_ids
      ids = [@manifest.dig("coordinator", "root_thread_id")]
      @manifest.fetch("lanes").each do |lane|
        ids << lane.fetch("root_thread_id")
        (lane["workers"] || []).each { |worker| ids << worker.fetch("thread_id") }
      end
      ids.uniq.sort
    end

    def sql_text_literal(value)
      "CAST(X'#{value.encode('UTF-8').b.unpack1('H*')}' AS TEXT)"
    end

    def manifest_roots
      [@manifest.dig("coordinator", "root_thread_id")] + @manifest.fetch("lanes").map { |lane| lane["root_thread_id"] }
    end

    def record_scope_topology_unknowns
      return unless @state_loaded

      lane_closures = @manifest.fetch("lanes").to_h do |lane|
        [lane.fetch("id"), closure(lane.fetch("root_thread_id"))]
      end
      coordinator_root = @manifest.dig("coordinator", "root_thread_id")
      lane_closures.each do |lane_id, lane_threads|
        next unless lane_threads.include?(coordinator_root)

        @unknown << {
          "status" => UNKNOWN,
          "code" => "coordinator_root_in_lane_scope",
          "lane_id" => lane_id,
          "thread_id" => coordinator_root
        }
        @topology_unknown_lane_ids << lane_id
        @batch_reconciliation_topology_unknown = true
      end
      lane_closures.to_a.combination(2) do |(left_id, left_threads), (right_id, right_threads)|
        overlap = left_threads & right_threads
        next if overlap.empty?

        @unknown << {
          "status" => UNKNOWN,
          "code" => "lane_scope_overlap",
          "lane_ids" => [left_id, right_id].sort,
          "thread_ids" => overlap.sort
        }
        @topology_unknown_lane_ids.merge([left_id, right_id])
        @batch_reconciliation_topology_unknown = true
      end

      @manifest.fetch("lanes").each do |lane|
        lane_threads = lane_closures.fetch(lane.fetch("id"))
        worker_closures = (lane["workers"] || []).to_h do |worker|
          [worker.fetch("id"), closure(worker.fetch("thread_id"))]
        end
        worker_closures.each do |worker_id, worker_threads|
          next if (worker_threads - lane_threads).empty?

          @unknown << {
            "status" => UNKNOWN,
            "code" => "worker_outside_lane_scope",
            "lane_id" => lane.fetch("id"),
            "worker_id" => worker_id
          }
          @topology_unknown_lane_ids << lane.fetch("id")
        end
        worker_closures.to_a.combination(2) do |(left_id, left_threads), (right_id, right_threads)|
          next if (left_threads & right_threads).empty?

          @unknown << {
            "status" => UNKNOWN,
            "code" => "worker_scope_overlap",
            "lane_id" => lane.fetch("id"),
            "worker_ids" => [left_id, right_id].sort
          }
          @topology_unknown_lane_ids << lane.fetch("id")
        end
      end
    end

    def closure(root)
      return [root] unless @threads.key?(root)

      seen = Set.new
      result = []
      stack = [root]
      until stack.empty?
        thread_id = stack.pop
        next unless seen.add?(thread_id)

        result << thread_id
        stack.concat(@children[thread_id].reverse)
      end
      result
    end

    def reader_for(thread_id)
      return @readers_by_thread[thread_id] if @readers_by_thread.key?(thread_id)

      state_thread = @threads[thread_id]
      unless state_thread
        @unknown << { "status" => UNKNOWN, "code" => "thread_missing", "thread_id" => thread_id }
        return @readers_by_thread[thread_id] = nil
      end

      rollout_path = state_thread["rollout_path"]
      unless rollout_path.is_a?(String) && !rollout_path.strip.empty?
        @unknown << { "status" => UNKNOWN, "code" => "rollout_path_missing", "thread_id" => thread_id }
        return @readers_by_thread[thread_id] = nil
      end

      rollout_key = canonical_rollout_key(rollout_path)
      existing = @readers_by_rollout[rollout_key]
      if existing
        reason = existing.validate_state_thread_id(thread_id)
        if reason
          @unknown << reason.merge("thread_id" => thread_id, "physical_rollout_id" => existing.physical_id)
        end
        return @readers_by_thread[thread_id] = existing
      end

      reader = RolloutReader.new(
        path: rollout_path,
        state_thread: state_thread,
        identity_thread_ids: identity_thread_ids_for(rollout_key),
        from_time: @from_time,
        to_time: @to_time
      ).read
      reader.unknown_reasons.each do |reason|
        @unknown << reason.merge("thread_id" => thread_id, "physical_rollout_id" => reader.physical_id)
      end
      @readers_by_rollout[rollout_key] = reader
      @readers_by_thread[thread_id] = reader
    end

    def canonical_rollout_key(path)
      File.realpath(path)
    rescue SystemCallError
      File.expand_path(path)
    end

    def identity_thread_ids_for(rollout_key)
      @identity_thread_ids_by_rollout ||= begin
        ids_by_rollout = @threads.values.each_with_object(Hash.new { |hash, key| hash[key] = [] }) do |thread, ids|
          rollout_path = thread["rollout_path"]
          next unless rollout_path.is_a?(String) && !rollout_path.strip.empty?

          ids[canonical_rollout_key(rollout_path)] << thread.fetch("id")
        end
        ids_by_rollout.each_value(&:sort!)
        ids_by_rollout
      end
      @identity_thread_ids_by_rollout.fetch(rollout_key)
    end

    def readers(thread_ids)
      thread_ids.filter_map { |thread_id| reader_for(thread_id) }.uniq
    end

    def aggregate(thread_ids)
      selected = readers(thread_ids)
      return unknown_usage if thread_ids.any? { |id| reader_for(id).nil? }

      selected.reduce(blank_usage) { |sum, reader| add_usage(sum, reader.totals) }
    end

    def aggregate_turns(thread_ids)
      selected = readers(thread_ids)
      return UNKNOWN if thread_ids.any? { |id| reader_for(id).nil? }

      counts = selected.map(&:contributing_turn_count)
      counts.all? { |count| count.is_a?(Integer) } ? counts.sum : UNKNOWN
    end

    def scope_receipt(scope, id, root_thread_id, requested_route)
      inclusive_ids = closure(root_thread_id)
      selected_readers = readers(inclusive_ids)
      {
        "scope" => scope,
        "id" => id,
        "root_thread_id" => root_thread_id,
        "requested_route" => requested_route.slice("host", "model", "effort"),
        "observed_routes" => merge_observed_routes(selected_readers),
        "usage" => {
          "self_only" => aggregate([root_thread_id]),
          "descendant_inclusive" => aggregate(inclusive_ids)
        },
        "turns" => {
          "self_only" => aggregate_turns([root_thread_id]),
          "descendant_inclusive" => aggregate_turns(inclusive_ids)
        },
        "evidence" => evidence_for(selected_readers, inclusive_ids),
        "_thread_ids" => inclusive_ids
      }
    end

    def lane_receipt(lane)
      receipt = scope_receipt("lane", lane.fetch("id"), lane.fetch("root_thread_id"), lane.fetch("requested_route"))
      workers = (lane["workers"] || []).map do |worker|
        scope_receipt("worker", worker.fetch("id"), worker.fetch("thread_id"), worker.fetch("requested_route"))
      end
      attributed = workers.flat_map { |worker| worker.fetch("_thread_ids") }.uniq
      receipt["usage"]["unattributed"] = aggregate(receipt.fetch("_thread_ids") - attributed)
      receipt["turns"]["unattributed"] = aggregate_turns(receipt.fetch("_thread_ids") - attributed)
      receipt["workers"] = workers
      worker_sum = workers.reduce(blank_usage) do |sum, worker|
        add_usage(sum, worker.dig("usage", "descendant_inclusive"))
      end
      reconciled = add_usage(worker_sum, receipt.dig("usage", "unattributed"))
      worker_turn_sum = workers.sum(0) do |worker|
        count = worker.dig("turns", "descendant_inclusive")
        count.is_a?(Integer) ? count : 0
      end
      reconciled_turns = if workers.all? { |worker| worker.dig("turns", "descendant_inclusive").is_a?(Integer) } &&
                            receipt.dig("turns", "unattributed").is_a?(Integer)
                           worker_turn_sum + receipt.dig("turns", "unattributed")
                         else
                           UNKNOWN
                         end
      receipt["reconciliation"] = {
        "status" => if !@topology_unknown_lane_ids.include?(lane.fetch("id")) &&
                       known_usage?(reconciled) && reconciled == receipt.dig("usage", "descendant_inclusive") &&
                       reconciled_turns == receipt.dig("turns", "descendant_inclusive")
                      "balanced"
                    else
                      UNKNOWN
                    end,
        "equation" => "lane descendant-inclusive = named worker descendant-inclusive union + unattributed"
      }
      receipt
    end

    def evidence_for(selected_readers, expected_thread_ids)
      evidence = {
        "status" => if expected_thread_ids.any? { |thread_id| reader_for(thread_id).nil? } ||
                       selected_readers.any? { |reader| !reader.unknown_reasons.empty? }
                      UNKNOWN
                    else
                      "complete"
                    end,
        "physical_rollout_ids" => selected_readers.map(&:physical_id).sort,
        "first_session_ids" => selected_readers.map(&:first_session_id).compact.sort
      }
      evidence["first_session_id"] = evidence["first_session_ids"].first if evidence["first_session_ids"].length == 1
      evidence
    end

    def merge_observed_routes(selected_readers)
      grouped = {}
      selected_readers.each do |reader|
        reader.observed_routes.each do |route|
          usage = route.fetch("usage")
          identity = route.reject { |key, _| key == "usage" }
          key = JSON.generate(identity.sort.to_h)
          grouped[key] = add_usage(grouped.fetch(key, blank_usage), usage)
        end
      end
      grouped.keys.sort.map { |key| JSON.parse(key).merge("usage" => grouped.fetch(key)) }
    end

    def strip_internal(value)
      case value
      when Hash
        value.each_with_object({}) do |(key, child), clean|
          clean[key] = strip_internal(child) unless key.start_with?("_")
        end
      when Array
        value.map { |child| strip_internal(child) }
      else
        value
      end
    end

    def aggregate_accounting(thread_ids)
      seed = ACCOUNTING_FIELDS.to_h { |field| [field, 0] }
      readers(thread_ids).each_with_object(seed) do |reader, totals|
        reader.accounting.each { |key, value| totals[key] += value }
      end.sort.to_h
    end

    def reconciliation_status(batch_usage, batch_turns, coordinator, lanes, unattributed_ids)
      return UNKNOWN if @batch_reconciliation_topology_unknown

      parts = coordinator.dig("usage", "self_only")
      lanes.each { |lane| parts = add_usage(parts, lane.dig("usage", "descendant_inclusive")) }
      parts = add_usage(parts, aggregate(unattributed_ids))
      turn_parts = [coordinator.dig("turns", "self_only"), aggregate_turns(unattributed_ids)] +
                   lanes.map { |lane| lane.dig("turns", "descendant_inclusive") }
      turn_sum = turn_parts.sum if turn_parts.all? { |count| count.is_a?(Integer) }
      return UNKNOWN unless known_usage?(batch_usage) && known_usage?(parts) && parts == batch_usage &&
                            batch_turns.is_a?(Integer) && turn_sum == batch_turns

      "balanced"
    end

    def credit_equivalents(batch_usage)
      validate_rate_card!
      mappings = @rate_card.fetch("model_mappings")
      route_totals = readers(manifest_roots.flat_map { |root| closure(root) }).flat_map(&:observed_routes)
      grouped = route_totals.group_by { |route| [route["host"], route["model"]] }
      values = grouped.sort_by { |key, _| key }.map do |(host, model), routes|
        if [host, model].include?(UNKNOWN)
          next({ "host" => host, "model" => model, "status" => UNKNOWN, "code" => "route_identity_unknown" })
        end

        mapping = mappings.find { |entry| entry["host"] == host && entry["model"] == model }
        unless mapping
          next({ "host" => host, "model" => model, "status" => UNKNOWN, "code" => "rate_mapping_missing" })
        end

        usage = routes.reduce(blank_usage) { |sum, route| add_usage(sum, route.fetch("usage")) }
        unless known_priced_usage?(usage)
          next({ "host" => host, "model" => model, "status" => UNKNOWN, "code" => "usage_unknown" })
        end

        credits = (usage["input_tokens"] * mapping.fetch("input_credits_per_million") +
                   usage["output_tokens"] * mapping.fetch("output_credits_per_million")) / 1_000_000.0
        raise InputError, "rate-card credit calculation must be finite" unless credits.finite?

        {
          "host" => host,
          "model" => model,
          "status" => "available",
          "credits" => credits.round(9)
        }
      end
      {
        "status" => if @topology_unknown_lane_ids.any? || !known_priced_usage?(batch_usage) ||
                       values.any? { |value| value["status"] == UNKNOWN }
                      UNKNOWN
                    else
                      "available"
                    end,
        "source" => @rate_card.fetch("source"),
        "effective_date" => @rate_card.fetch("effective_date"),
        "model_values" => values,
        "disclaimer" => "Analytical credit equivalents only; this is not a bill, invoice, charge, or authoritative provider cost."
      }
    end

    def validate_rate_card!
      raise InputError, "rate-card must be an object" unless @rate_card.is_a?(Hash)

      raise InputError, "rate-card schema must be #{RATE_CARD_SCHEMA}" unless @rate_card["schema"] == RATE_CARD_SCHEMA

      require_string!(@rate_card["source"], "rate-card.source")
      effective_date = @rate_card["effective_date"]
      unless effective_date.is_a?(String) && effective_date.match?(/\A\d{4}-\d{2}-\d{2}\z/) &&
             Date.iso8601(effective_date).iso8601 == effective_date
        raise InputError, "rate-card.effective_date must be an ISO 8601 date"
      end

      mappings = @rate_card["model_mappings"]
      raise InputError, "rate-card.model_mappings must be an array" unless mappings.is_a?(Array)

      mappings.each_with_index do |mapping, index|
        unless mapping.is_a?(Hash)
          raise InputError, "rate-card.model_mappings[#{index}] must be an object"
        end

        %w[host model].each { |key| require_string!(mapping[key], "rate-card.model_mappings[#{index}].#{key}") }
        %w[input_credits_per_million output_credits_per_million].each do |key|
          value = mapping[key]
          unless value.is_a?(Numeric) && value.finite? && value >= 0
            raise InputError, "rate-card.model_mappings[#{index}].#{key} must be finite and nonnegative"
          end
        end
      end
      identities = mappings.map { |mapping| [mapping["host"], mapping["model"]] }
      raise InputError, "rate-card host/model mappings must be unique" unless identities.uniq.length == identities.length
    rescue ArgumentError, KeyError
      raise InputError, "rate-card.effective_date must be an ISO 8601 date"
    end
  end

  def parse_time(value, label)
    unless value.is_a?(String) && value.match?(FOUR_DIGIT_YEAR)
      raise InputError, "#{label} must use a four-digit year representable after UTC normalization"
    end

    unless value.match?(EXPLICIT_UTC_OFFSET)
      raise InputError, "#{label} must include an explicit UTC offset or Z"
    end

    fractional_digits = value[/\.(\d+)/, 1]
    if fractional_digits && fractional_digits.length > 9
      raise InputError, "#{label} must use no more than 9 fractional-second digits"
    end

    timestamp_match = RFC3339_DATE_TIME.match(value)
    unless timestamp_match && Date.valid_date?(*timestamp_match.values_at(:year, :month, :day).map(&:to_i))
      raise InputError, "#{label} must be an ISO 8601 timestamp"
    end

    parsed = Time.iso8601(value)
    utc_time = parsed.getutc
    if timestamp_match[:second] == "60" && [utc_time.hour, utc_time.min, utc_time.sec] != [0, 0, 0]
      raise InputError, "#{label} must be an ISO 8601 timestamp"
    end

    unless utc_time.iso8601(9).match?(FOUR_DIGIT_YEAR)
      raise InputError, "#{label} must use a four-digit year representable after UTC normalization"
    end

    parsed
  rescue ArgumentError, TypeError
    raise InputError, "#{label} must be an ISO 8601 timestamp"
  end

  def read_json_input(path, label)
    JSON.parse(File.read(path, encoding: "UTF-8"))
  rescue SystemCallError
    raise InputError, "#{label} could not be read"
  end

  def run(argv)
    options = {}
    parser = OptionParser.new do |opts|
      opts.banner = "Usage: batch-usage-receipt --state-db PATH --manifest PATH --from TIME --to TIME [--rate-card PATH]"
      opts.on("--state-db PATH") { |value| options[:database] = value }
      opts.on("--manifest PATH") { |value| options[:manifest] = value }
      opts.on("--from TIME") { |value| options[:from] = value }
      opts.on("--to TIME") { |value| options[:to] = value }
      opts.on("--rate-card PATH") { |value| options[:rate_card] = value }
    end
    parser.parse!(argv)
    raise InputError, parser.banner unless argv.empty? && %i[database manifest from to].all? { |key| options[key] }

    manifest = read_json_input(options.fetch(:manifest), "manifest")
    rate_card = options[:rate_card] && read_json_input(options[:rate_card], "rate-card")
    if options[:rate_card] && !rate_card.is_a?(Hash)
      raise InputError, "rate-card must be an object"
    end

    from_time = parse_time(options.fetch(:from), "--from")
    to_time = parse_time(options.fetch(:to), "--to")
    raise InputError, "--to must be after --from" unless to_time > from_time

    receipt = Reporter.new(
      manifest: manifest,
      database_path: options.fetch(:database),
      from_time: from_time,
      to_time: to_time,
      rate_card: rate_card
    ).build
    puts JSON.pretty_generate(receipt)
    0
  rescue OptionParser::ParseError, JSON::ParserError, InputError => e
    warn "ERROR: #{e.message}"
    64
  end
end

exit BatchUsageReceipt.run(ARGV) if $PROGRAM_NAME == __FILE__
