#!/usr/bin/env ruby
# frozen_string_literal: true

# Submit one merge-assured PR against the reviewed GitHub host, base, base SHA,
# and head when GitHub may require a merge queue. Every run requires a fresh,
# integrity-bound eligible merge-assurance receipt before mutation.

require "json"
require "digest"
require "open3"
require "optparse"
require "tempfile"
require "tmpdir"
require "time"
require "uri"
require "yaml"

load File.expand_path("merge-assurance", __dir__) unless defined?(MergeAssurance)

module PrMergeSubmit
  class Error < StandardError; end
  class UnknownOutcome < Error; end

  class FailedStatus
    def success?
      false
    end
  end

  GRAPHQL_FEATURE_HEADER = "GraphQL-Features: merge_queue"
  METHODS = %w[merge rebase squash].freeze
  POLICY_CONFIG = ".agents/agent-workflow.yml"
  MERGE_SUBMISSION_MODES = %w[merge_queue_only merge_queue_or_guarded_direct].freeze
  MERGE_SUBMISSION_KEYS = %w[mode guarded_direct].freeze
  GUARDED_DIRECT_KEYS = %w[executable method non_atomic_base].freeze
  NON_ATOMIC_BASE_KEYS = %w[acknowledged rationale].freeze
  GUARDED_DIRECT_EXECUTABLE = %r{\A\.agents/bin/[A-Za-z0-9_.-]+\z}
  GIT_BLOB_OID = /\A(?:[0-9a-f]{40}|[0-9a-f]{64})\z/

  module_function

  def parse_json!(raw, context)
    payload = JSON.parse(raw)
    raise Error, "#{context} returned non-object JSON" unless payload.is_a?(Hash)

    payload
  rescue JSON::ParserError => e
    raise Error, "#{context} returned invalid JSON: #{e.message}"
  end

  def graphql_errors(raw)
    payload = JSON.parse(raw)
    return unless payload.is_a?(Hash)

    errors = Array(payload["errors"])
    errors unless errors.empty?
  rescue JSON::ParserError
    nil
  end

  class Runner
    PR_QUERY = <<~GRAPHQL
      query($owner: String!, $name: String!, $number: Int!) {
        repository(owner: $owner, name: $name) {
          pullRequest(number: $number) {
            id
            headRefOid
            baseRefName
            baseRefOid
            state
            isDraft
            url
            merged
            mergedAt
            mergeCommit { oid }
            isInMergeQueue
            isMergeQueueEnabled
            mergeQueueEntry {
              id
              position
              state
              estimatedTimeToMerge
            }
          }
        }
      }
    GRAPHQL

    ENQUEUE_MUTATION = <<~GRAPHQL
      mutation($pullRequestId: ID!, $expectedHeadOid: GitObjectID!) {
        enqueuePullRequest(input: {
          pullRequestId: $pullRequestId,
          expectedHeadOid: $expectedHeadOid
        }) {
          mergeQueueEntry {
            id
            position
            state
            estimatedTimeToMerge
          }
        }
      }
    GRAPHQL

    def run(argv)
      @pending_signal = nil
      @cancellation_signal = nil
      @mutation_attempted = false
      previous_handlers = install_signal_handlers do |signal|
        @pending_signal ||= signal
        @cancellation_signal ||= signal
      end
      options = parse_options(argv)
      return print_help if options[:help]

      validate_options!(options)
      @merge_assurance_receipt = load_merge_assurance_receipt!(options)
      @merge_submission = load_merge_submission_policy!
      pull_request = fetch_pr(options)
      result = if exact_merge?(pull_request, options)
                 already_merged_result(pull_request, options)
               else
                 validate_receipt_live_bindings!(pull_request, options)
                 validate_pr!(pull_request, options)
                 submit(pull_request, options)
               end

      puts JSON.pretty_generate(result)
      0
    rescue UnknownOutcome => e
      warn "UNKNOWN: #{e.message}"
      2
    rescue Error => e
      warn "Error: #{e.message}"
      1
    ensure
      restore_signal_handlers(previous_handlers) if previous_handlers
    end

    private

    def parse_options(argv)
      options = {
        method: nil, subject: nil, body: nil, repo: nil, host: nil,
        expected_head: nil, expected_base: nil, merge_assurance_receipt: nil,
        help: false, pr: nil
      }
      parser = OptionParser.new do |opts|
        opts.banner = "Usage: pr-merge-submit <pr-number> --repo OWNER/REPO --host HOST " \
                      "--expected-head SHA --expected-base BRANCH --method METHOD " \
                      "--merge-assurance-receipt FILE [options]"
        opts.on("--repo REPO", "GitHub repository in OWNER/REPO form") { |value| options[:repo] = value }
        opts.on("--host HOST", "Exact GitHub hostname, with an optional port") { |value| options[:host] = value }
        opts.on("--expected-head SHA", "Exact PR head SHA already cleared by readiness gates") do |value|
          options[:expected_head] = value
        end
        opts.on("--expected-base BRANCH", "Exact PR base branch already cleared by readiness gates") do |value|
          options[:expected_base] = value
        end
        opts.on("--merge-assurance-receipt FILE", "Fresh eligible merge-assurance receipt") do |value|
          options[:merge_assurance_receipt] = value
        end
        opts.on("--method METHOD", METHODS, "Guarded-direct method; merge queue configuration controls queued merges") do |value|
          options[:method] = value
        end
        opts.on("--subject SUBJECT", "Guarded-direct merge commit subject") { |value| options[:subject] = value }
        opts.on("--body BODY", "Guarded-direct merge commit body") { |value| options[:body] = value }
        opts.on("-h", "--help", "Show this help") { options[:help] = true }
      end
      remaining = parser.parse(argv)
      options[:pr] = remaining.shift
      raise Error, "unexpected arguments: #{remaining.join(' ')}" unless remaining.empty?

      options
    rescue OptionParser::ParseError => e
      raise Error, e.message
    end

    def print_help
      puts <<~HELP
        Submit one authorized, merge-ready PR at an exact head SHA.

        #{usage_parser}

        The helper reads GitHub's live isMergeQueueEnabled value for the target
        PR and uses enqueuePullRequest for a queue-controlled base. Queue-disabled
        submission fails closed by default. A trusted-base merge_submission seam
        may explicitly delegate to one repository-owned executable guard under
        .agents/bin. The helper invokes that guard with fixed argv and trusts only
        a subsequent exact live merged-state reconciliation. It never performs a
        generic direct merge, enables auto-merge, or enables a merge queue. Exit 2
        means a mutation outcome remains UNKNOWN and must not be retried blindly.
      HELP
      0
    end

    def usage_parser
      OptionParser.new do |opts|
        opts.banner = "Usage: pr-merge-submit <pr-number> --repo OWNER/REPO --host HOST " \
                      "--expected-head SHA --expected-base BRANCH --method METHOD " \
                      "--merge-assurance-receipt FILE [options]"
        opts.separator "        --subject SUBJECT  Guarded-direct merge commit subject"
        opts.separator "        --body BODY        Guarded-direct merge commit body"
        opts.separator "        --merge-assurance-receipt FILE  Fresh eligible v1 receipt"
      end
    end

    def validate_options!(options)
      raise Error, "PR number is required" unless options[:pr].to_s.match?(/\A[1-9]\d*\z/)
      # owner/name are passed to gh as `-f owner=` / `-f name=`, so a leading "@"
      # in either segment would make gh read a local file (same class as
      # reject_leading_at!). A real GitHub owner/repo never starts with "@".
      raise Error, "--repo must use OWNER/REPO form" unless options[:repo].to_s.match?(%r{\A[^@/\s][^/\s]*/[^@/\s][^/\s]*\z})

      options[:host] = normalize_host!(options[:host])
      raise Error, "--expected-head must be a full commit SHA" unless options[:expected_head].to_s.match?(/\A[0-9a-f]{40}\z/i)
      unless options[:expected_base].to_s.match?(/\A[^\s~^:?*\[\\]+\z/) && !options[:expected_base].include?("..")
        raise Error, "--expected-base must be a valid branch name"
      end
      raise Error, "--method is required" unless METHODS.include?(options[:method])
      raise Error, "--merge-assurance-receipt is required" if options[:merge_assurance_receipt].to_s.empty?

      reject_leading_at!(options, :subject)
      reject_leading_at!(options, :body)
    end

    RECEIPT_KEYS = %w[
      bindings contract eligible evidence evidence_digest follow_up_accounting
      freshness issued_at verdict version
    ].freeze
    RECEIPT_BINDING_KEYS = %w[
      authority base diff_identity head_sha host pr repo
    ].freeze
    RECEIPT_EVIDENCE_KEYS = %w[
      authenticated_tracker_reads autonomous_result ci_result context
    ].freeze
    AUTHENTICATED_TRACKER_READ_KEYS = %w[
      checked_at contract diff_identity head_sha host issue issue_metadata
      operation_digest provenance repo source_pr tracker version
    ].freeze
    AUTHENTICATED_TRACKER_METADATA_KEYS = %w[
      body_digest html_url id node_id state title updated_at url
    ].freeze

    def load_merge_assurance_receipt!(options)
      raw = File.read(options[:merge_assurance_receipt], encoding: "UTF-8")
      receipt = PrMergeSubmit.parse_json!(raw, "merge-assurance receipt")
      unless receipt.keys.sort == RECEIPT_KEYS.sort &&
             receipt["contract"] == "merge-assurance-receipt" &&
             receipt["version"] == 1 &&
             receipt["eligible"] == true &&
             receipt["verdict"] == "ELIGIBLE"
        raise Error, "merge-assurance receipt is not an eligible v1 receipt"
      end
      unless receipt["bindings"].is_a?(Hash) &&
             receipt["bindings"].keys.sort == RECEIPT_BINDING_KEYS.sort
        raise Error, "merge-assurance receipt bindings are malformed"
      end
      unless MergeAssurance.valid_evidence_digest?(receipt)
        raise Error, "merge-assurance receipt evidence digest mismatch"
      end

      evidence = receipt["evidence"]
      now = Time.now.utc
      validate_receipt_evidence!(receipt, evidence)
      validate_receipt_freshness!(receipt, now)
      reassessed = MergeAssurance.assess(
        ci_result: evidence["ci_result"],
        autonomous_result: evidence["autonomous_result"],
        context: evidence["context"],
        now:
      )
      unless reassessed["eligible"] == true
        raise Error, "merge-assurance receipt evidence does not currently qualify: " \
                     "#{Array(reassessed['failures']).join('; ')}"
      end
      unless receipt["bindings"] == reassessed["bindings"] &&
             receipt["follow_up_accounting"] == reassessed["follow_up_accounting"]
        raise Error, "merge-assurance receipt bindings or accounting do not match its evidence"
      end
      unless comparable_tracker_reads(evidence) == comparable_tracker_reads(reassessed["evidence"])
        raise Error, "merge-assurance receipt authenticated tracker read does not match the current issue"
      end

      expected_freshness = reassessed["freshness"]
      unless receipt["freshness"] == expected_freshness
        raise Error, "merge-assurance receipt freshness contract is malformed"
      end

      validate_receipt_option_bindings!(receipt, options)
      receipt
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "merge-assurance receipt is unavailable: #{e.message}"
    end

    def validate_receipt_evidence!(receipt, evidence)
      unless evidence.is_a?(Hash) && evidence.keys.sort == RECEIPT_EVIDENCE_KEYS.sort &&
             evidence["context"].is_a?(Hash) &&
             evidence["authenticated_tracker_reads"].is_a?(Array)
        raise Error, "merge-assurance receipt evidence is malformed"
      end
      if MergeAssurance.contains_unknown?(evidence["authenticated_tracker_reads"])
        raise Error, "merge-assurance receipt evidence contains UNKNOWN"
      end

      context = evidence["context"]
      semantic_trackers = Array(context["operations"]).select do |operation|
        operation.is_a?(Hash) && operation["type"] == "semantic-github-actions-tracker"
      end
      reads = evidence["authenticated_tracker_reads"]
      expected_read_count = context["semantic_github_actions_change"] == true ? 1 : 0
      unless semantic_trackers.length == expected_read_count && reads.length == expected_read_count
        raise Error, "merge-assurance receipt authenticated tracker read count is malformed"
      end
      return if expected_read_count.zero?

      validate_authenticated_tracker_read!(
        reads.first,
        tracker: semantic_trackers.first,
        context:,
        issued_at: receipt["issued_at"]
      )
    end

    def validate_authenticated_tracker_read!(read, tracker:, context:, issued_at:)
      issue_number = tracker["tracker"].to_s.match(%r{/issues/([1-9]\d*)\z})&.captures&.first&.to_i
      expected_api_url = if context["host"] == "github.com"
                           "https://api.github.com/repos/#{context['repo']}/issues/#{issue_number}"
                         else
                           "https://#{context['host']}/api/v3/repos/#{context['repo']}/issues/#{issue_number}"
                         end
      metadata = read["issue_metadata"] if read.is_a?(Hash)
      valid = read.is_a?(Hash) &&
              read.keys.sort == AUTHENTICATED_TRACKER_READ_KEYS.sort &&
              read["contract"] == "authenticated-semantic-tracker-read" &&
              read["version"] == 1 &&
              read["provenance"] == "gh-api" &&
              read["checked_at"] == issued_at &&
              read["host"] == context["host"] &&
              read["repo"] == context["repo"] &&
              read["issue"] == issue_number &&
              read["tracker"] == tracker["tracker"] &&
              read["source_pr"] == tracker["source_pr"] &&
              read["head_sha"] == context["head_sha"] &&
              read["diff_identity"] == context["diff_identity"] &&
              read["operation_digest"] == MergeAssurance.semantic_tracker_operation_digest(tracker) &&
              valid_authenticated_tracker_metadata?(
                metadata,
                api_url: expected_api_url,
                html_url: tracker["tracker"]
              )
      raise Error, "merge-assurance receipt authenticated tracker read is malformed or mismatched" unless valid
    end

    def valid_authenticated_tracker_metadata?(metadata, api_url:, html_url:)
      return false unless metadata.is_a?(Hash) &&
                          metadata.keys.sort == AUTHENTICATED_TRACKER_METADATA_KEYS.sort
      return false unless metadata["id"].is_a?(Integer) && metadata["id"].positive?
      return false unless metadata["node_id"].is_a?(String) && !metadata["node_id"].empty?
      return false unless metadata["url"] == api_url && metadata["html_url"] == html_url
      return false unless %w[open closed].include?(metadata["state"])
      return false unless metadata["title"].is_a?(String) && !metadata["title"].strip.empty?
      return false unless metadata["body_digest"].to_s.match?(/\Asha256:[0-9a-f]{64}\z/)

      Time.iso8601(metadata["updated_at"].to_s)
      true
    rescue ArgumentError
      false
    end

    def comparable_tracker_reads(evidence)
      Array(evidence["authenticated_tracker_reads"]).map do |read|
        read.reject { |key, _value| key == "checked_at" }
      end
    end

    def validate_receipt_freshness!(receipt, now = Time.now.utc)
      issued_at = Time.iso8601(receipt["issued_at"].to_s)
      age = now - issued_at
      raise Error, "merge-assurance receipt is stale (maximum age is exactly 300 seconds)" if
        age > MergeAssurance::MAX_EVIDENCE_AGE_SECONDS
      raise Error, "merge-assurance receipt is future-dated beyond exactly 30 seconds of clock skew" if
        age < -MergeAssurance::MAX_FUTURE_SKEW_SECONDS
    rescue ArgumentError
      raise Error, "merge-assurance receipt issued_at is invalid"
    end

    def validate_receipt_option_bindings!(receipt, options)
      bindings = receipt.fetch("bindings")
      raise Error, "merge-assurance receipt host mismatch" unless bindings["host"] == options[:host]
      raise Error, "merge-assurance receipt repo mismatch" unless bindings["repo"] == options[:repo]
      raise Error, "merge-assurance receipt PR mismatch" unless bindings["pr"] == options[:pr].to_i
      raise Error, "merge-assurance receipt head mismatch" unless
        bindings["head_sha"].to_s.casecmp?(options[:expected_head])
      raise Error, "merge-assurance receipt base ref mismatch" unless
        bindings.dig("base", "ref") == options[:expected_base]
    end

    def load_merge_submission_policy!
      base_sha = @merge_assurance_receipt.dig("bindings", "base", "sha").to_s
      @repo_root = trusted_repo_root!
      raw = trusted_blob!(
        base_sha, POLICY_CONFIG, "trusted-base merge-submission policy", allow_missing: true
      )
      return { "mode" => "merge_queue_only", "source" => "portable_default" } if raw.nil?

      config = YAML.safe_load(
        raw, permitted_classes: [], permitted_symbols: [], aliases: false
      ) || {}
      raise Error, "trusted-base policy is not a mapping" unless config.is_a?(Hash)

      seam = config["merge_submission"]
      return { "mode" => "merge_queue_only", "source" => "portable_default" } if seam.nil?

      validate_merge_submission_mapping!(seam)
      if seam["mode"] == "merge_queue_only"
        return { "mode" => seam["mode"], "source" => "trusted_base" }
      end

      guarded_direct = seam.fetch("guarded_direct")
      guard_identity, trusted_guard_bytes = validate_guard_identity!(base_sha, guarded_direct.fetch("executable"))
      {
        "mode" => seam["mode"],
        "source" => "trusted_base",
        "guarded_direct" => {
          "executable" => guarded_direct.fetch("executable"),
          "method" => guarded_direct.fetch("method"),
          "non_atomic_base" => guarded_direct.fetch("non_atomic_base").dup,
          "identity" => guard_identity,
          "trusted_bytes" => trusted_guard_bytes
        }
      }
    rescue Psych::Exception => e
      raise Error, "trusted-base merge-submission policy is invalid YAML: #{e.message.lines.first.to_s.strip}"
    end

    def validate_merge_submission_mapping!(seam)
      raise Error, "merge_submission must be a mapping" unless seam.is_a?(Hash)

      mode = seam["mode"]
      raise Error, "merge_submission.mode is invalid" unless MERGE_SUBMISSION_MODES.include?(mode)

      expected_keys = mode == "merge_queue_only" ? ["mode"] : MERGE_SUBMISSION_KEYS
      unless exact_string_keys?(seam, expected_keys)
        raise Error, "merge_submission keys must be exactly: #{expected_keys.sort.join(', ')}"
      end
      return if mode == "merge_queue_only"

      guarded_direct = seam["guarded_direct"]
      unless exact_string_keys?(guarded_direct, GUARDED_DIRECT_KEYS)
        raise Error, "merge_submission.guarded_direct keys must be exactly: #{GUARDED_DIRECT_KEYS.sort.join(', ')}"
      end

      executable = guarded_direct["executable"]
      unless valid_guard_executable?(executable)
        raise Error, "merge_submission.guarded_direct.executable must name one repository-root-relative file under .agents/bin"
      end
      unless METHODS.include?(guarded_direct["method"])
        raise Error, "merge_submission.guarded_direct.method must be merge, rebase, or squash"
      end

      acknowledgement = guarded_direct["non_atomic_base"]
      unless exact_string_keys?(acknowledgement, NON_ATOMIC_BASE_KEYS)
        raise Error, "merge_submission.guarded_direct.non_atomic_base keys must be exactly: " \
                     "#{NON_ATOMIC_BASE_KEYS.sort.join(', ')}"
      end
      unless acknowledgement["acknowledged"] == true
        raise Error, "merge_submission.guarded_direct.non_atomic_base.acknowledged must be true"
      end

      rationale = acknowledgement["rationale"]
      return if valid_non_atomic_rationale?(rationale)

      raise Error, "merge_submission.guarded_direct.non_atomic_base.rationale must be nonempty, resolved single-line prose"
    end

    def valid_guard_executable?(value)
      value.is_a?(String) && value.match?(GUARDED_DIRECT_EXECUTABLE) &&
        !%w[. ..].include?(File.basename(value))
    end

    def exact_string_keys?(mapping, expected_keys)
      mapping.is_a?(Hash) && mapping.keys.all?(String) && mapping.keys.sort == expected_keys.sort
    end

    def valid_non_atomic_rationale?(value)
      return false unless value.is_a?(String)

      rationale = value.strip
      !rationale.empty? && rationale.length <= 500 &&
        !rationale.match?(/[[:cntrl:]]/) &&
        !rationale.casecmp?("UNKNOWN") &&
        !rationale.match?(/<[^>]+>/)
    end

    def trusted_repo_root!
      stdout, stderr, status = git_capture("rev-parse", "--show-toplevel", chdir: Dir.pwd)
      raise Error, "could not resolve consumer repository root: #{failure_output(stdout, stderr)}" unless status.success?

      root = File.realpath(stdout.strip)
      raise Error, "consumer repository root is not a directory" unless File.directory?(root)

      root
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not resolve consumer repository root: #{e.message}"
    end

    def trusted_blob!(base_sha, relative_path, context, allow_missing: false)
      stdout, stderr, status = git_capture(
        "-C", @repo_root, "cat-file", "blob", "#{base_sha}:#{relative_path}", chdir: @repo_root
      )
      unless status.success?
        return nil if allow_missing && trusted_path_absent?(base_sha, relative_path)

        raise Error, "#{context} is unavailable: #{failure_output(stdout, stderr)}"
      end

      stdout.b
    end

    def trusted_path_absent?(base_sha, relative_path)
      _stdout, _stderr, commit_status = git_capture(
        "-C", @repo_root, "cat-file", "-e", "#{base_sha}^{commit}", chdir: @repo_root
      )
      return false unless commit_status.success?

      stdout, _stderr, tree_status = git_capture(
        "-C", @repo_root, "ls-tree", base_sha, "--", relative_path, chdir: @repo_root
      )
      tree_status.success? && stdout.empty?
    end

    def validate_guard_identity!(base_sha, relative_path)
      trusted_bytes = trusted_blob!(base_sha, relative_path, "trusted-base guarded-direct executable")
      stdout, stderr, status = git_capture(
        "-C", @repo_root, "ls-tree", base_sha, "--", relative_path, chdir: @repo_root
      )
      raise Error, "trusted-base guarded-direct executable metadata is unavailable: #{failure_output(stdout, stderr)}" unless status.success?

      match = stdout.match(/\A(?<mode>\d{6}) blob (?<oid>[0-9a-f]+)\t(?<path>[^\r\n]+)\n?\z/)
      unless match && valid_git_blob_oid?(match[:oid]) &&
             match[:mode] == "100755" && match[:path] == relative_path
        raise Error, "trusted-base guarded-direct executable must be one executable regular file"
      end

      live_path = File.join(@repo_root, relative_path)
      %w[.agents .agents/bin].each do |component|
        stat = File.lstat(File.join(@repo_root, component))
        raise Error, "guarded-direct executable path contains a symlink" if stat.symlink?
        raise Error, "guarded-direct executable parent is not a directory" unless stat.directory?
      end
      stat = File.lstat(live_path)
      if stat.symlink? || !stat.file? || !File.executable?(live_path) || File.realpath(live_path) != live_path
        raise Error, "guarded-direct executable is missing, unsafe, or not executable: #{relative_path}"
      end
      unless File.binread(live_path) == trusted_bytes
        raise Error, "guarded-direct executable does not match the trusted-base blob: #{relative_path}"
      end

      identity = {
        "path" => relative_path,
        "trusted_base_sha" => base_sha,
        "blob_oid" => match[:oid],
        "sha256" => Digest::SHA256.hexdigest(trusted_bytes)
      }
      [identity, trusted_bytes]
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "guarded-direct executable is unavailable: #{relative_path}: #{e.message}"
    end

    def valid_git_blob_oid?(value)
      value.is_a?(String) && value.match?(GIT_BLOB_OID)
    end

    def git_capture(*args, chdir:)
      environment = {
        "GIT_CONFIG_NOSYSTEM" => "1",
        "GIT_CONFIG_GLOBAL" => File::NULL,
        "GIT_NO_REPLACE_OBJECTS" => "1",
        "GIT_OPTIONAL_LOCKS" => "0",
        "GIT_TERMINAL_PROMPT" => "0"
      }
      Open3.capture3(environment, "git", *args, chdir:)
    rescue Errno::ENOENT
      raise Error, "git is not installed or not on PATH"
    end

    def validate_receipt_live_bindings!(pull_request, options)
      bindings = @merge_assurance_receipt.fetch("bindings")
      unless pull_request["headRefOid"].to_s.casecmp?(bindings["head_sha"])
        raise Error, "PR head moved: receipt binds #{bindings['head_sha']}, found #{pull_request['headRefOid']}"
      end
      unless pull_request["baseRefName"] == bindings.dig("base", "ref")
        raise Error, "PR base moved: receipt binds #{bindings.dig('base', 'ref')}, found #{pull_request['baseRefName']}"
      end
      unless pull_request["baseRefOid"].to_s.casecmp?(bindings.dig("base", "sha").to_s)
        raise Error, "merge-assurance receipt base SHA mismatch: expected " \
                     "#{bindings.dig('base', 'sha')}, found #{pull_request['baseRefOid']}"
      end
      validate_receipt_option_bindings!(@merge_assurance_receipt, options)
    end

    # gh treats a field value beginning with "@" as a file path to read, so a
    # merge subject/body derived from an untrusted PR title/body (e.g. "@/etc/passwd")
    # would silently read a local file into the merge commit. Fail closed instead.
    def reject_leading_at!(options, field)
      return unless options[field].to_s.start_with?("@")

      raise Error, "--#{field} must not begin with '@'; gh reads a leading @ value as a file path"
    end

    def normalize_host!(host)
      match = host.to_s.match(/\A(?<name>[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?::(?<port>\d+))?\z/i)
      raise Error, "--host must be a hostname with an optional port" unless match

      port = match[:port]&.to_i
      raise Error, "--host port must be between 1 and 65535" if port && !port.between?(1, 65_535)

      normalized = match[:name].downcase
      port && port != 443 ? "#{normalized}:#{port}" : normalized
    end

    def fetch_pr(options)
      owner, name = options[:repo].split("/", 2)
      stdout, stderr, status = run_gh(
        "api", "graphql",
        "-H", GRAPHQL_FEATURE_HEADER,
        "-f", "query=#{PR_QUERY}",
        "-f", "owner=#{owner}",
        "-f", "name=#{name}",
        "-F", "number=#{options[:pr]}",
        host: options[:host]
      )
      raise Error, "could not fetch PR metadata: #{failure_output(stdout, stderr)}" unless status.success?

      payload = PrMergeSubmit.parse_json!(stdout, "PR merge-queue query")
      errors = payload["errors"]
      raise Error, "PR merge-queue query returned errors: #{JSON.generate(errors)}" unless Array(errors).empty?

      pull_request = payload.dig("data", "repository", "pullRequest")
      raise Error, "PR merge-queue query returned no pull request" unless pull_request.is_a?(Hash)

      validate_url_host!(pull_request["url"], options[:host])

      pull_request
    end

    def submit(pull_request, options)
      if pull_request["isInMergeQueue"] == true
        return existing_queue_result(pull_request, options) if exact_queue?(pull_request, options)

        raise UnknownOutcome, "PR reports merge-queue membership but lacks strict proof"
      end
      unless pull_request["isInMergeQueue"] == false && pull_request["mergeQueueEntry"].nil?
        raise UnknownOutcome, "PR merge-queue membership is inconsistent or UNKNOWN"
      end

      return enqueue_result(pull_request, options) if pull_request["isMergeQueueEnabled"] == true
      unless pull_request["isMergeQueueEnabled"] == false
        raise Error, "PR merge-queue state is missing or UNKNOWN"
      end

      unless @merge_submission["mode"] == "merge_queue_or_guarded_direct"
        raise Error, "queue-disabled submission is unsupported by the trusted-base merge_submission " \
                     "policy; configure an explicit repository-owned guarded-direct exception or use a merge queue"
      end

      guarded_direct_result(options)
    end

    def validate_pr!(pull_request, options, require_open: true)
      allowed_states = require_open ? ["OPEN"] : %w[OPEN MERGED]
      raise Error, "PR state is not valid for submission: #{pull_request['state']}" unless allowed_states.include?(pull_request["state"])
      raise Error, "PR is still a draft" if pull_request["isDraft"]
      unless pull_request["baseRefName"] == options[:expected_base]
        raise Error, "PR base moved: expected #{options[:expected_base]}, found #{pull_request['baseRefName']}"
      end

      if pull_request["headRefOid"].to_s.casecmp?(options[:expected_head])
        validate_receipt_base_sha!(pull_request) if @merge_assurance_receipt
        return
      end

      raise Error, "PR head moved: expected #{options[:expected_head]}, found #{pull_request['headRefOid']}"
    end

    def validate_receipt_base_sha!(pull_request)
      expected = @merge_assurance_receipt.dig("bindings", "base", "sha")
      return if pull_request["baseRefOid"].to_s.casecmp?(expected.to_s)

      raise Error, "merge-assurance receipt base SHA mismatch: expected #{expected}, found #{pull_request['baseRefOid']}"
    end

    def guarded_direct_result(options)
      policy = @merge_submission.fetch("guarded_direct")
      unless options[:method] == policy["method"]
        raise Error, "--method #{options[:method]} does not match trusted-base guarded-direct method #{policy['method']}"
      end

      # Narrow the acknowledged non-atomic-base window immediately before the
      # repository guard. A queue enabled in the meantime remains canonical.
      refreshed = fetch_pr(options)
      validate_receipt_live_bindings!(refreshed, options)
      validate_pr!(refreshed, options)
      if refreshed["isInMergeQueue"] == true
        return existing_queue_result(refreshed, options) if exact_queue?(refreshed, options)

        raise UnknownOutcome, "PR reports merge-queue membership but lacks strict proof before guarded-direct submission"
      end
      unless refreshed["isInMergeQueue"] == false && refreshed["mergeQueueEntry"].nil?
        raise UnknownOutcome, "PR merge-queue membership became inconsistent or UNKNOWN before guarded-direct submission"
      end
      return enqueue_result(refreshed, options) if refreshed["isMergeQueueEnabled"] == true
      unless refreshed["isMergeQueueEnabled"] == false
        raise UnknownOutcome, "PR merge-queue state became missing or UNKNOWN before guarded-direct submission"
      end

      guard_stdout, guard_stderr, guard_status = run_guard(policy, options)
      diagnostics = failure_output(guard_stdout, guard_stderr)
      reconciled = fetch_pr_for_reconciliation!(options, "guarded-direct submission outcome")
      unless guard_status.success?
        state_detail = if exact_merge?(reconciled, options)
                         "live state appears merged but the guard failed"
                       else
                         "live state does not prove the authorized merge"
                       end
        raise UnknownOutcome, "guarded-direct submission is UNKNOWN after reconciliation (guard failed; " \
                              "#{state_detail}); do not retry blindly#{diagnostics.empty? ? '' : ": #{diagnostics}"}"
      end
      unless exact_merge?(reconciled, options)
        detail = begin
          validate_pr!(reconciled, options, require_open: false)
          "live PR is not an exact terminal merge of the authorized head"
        rescue Error => e
          e.message
        end
        raise UnknownOutcome, "guarded-direct submission is UNKNOWN after reconciliation (guard exited successfully; #{detail}); " \
                              "do not retry blindly#{diagnostics.empty? ? '' : ": #{diagnostics}"}"
      end

      {
        "pr" => options[:pr].to_i,
        "repo" => options[:repo],
        "url" => reconciled["url"],
        "expected_head" => options[:expected_head],
        "expected_base" => options[:expected_base],
        "submission" => "guarded_direct",
        "method" => policy["method"],
        "guard" => policy["identity"],
        "non_atomic_base" => policy["non_atomic_base"],
        "atomic_expected_base_oid" => false,
        "merged_at" => reconciled["mergedAt"],
        "merge_commit" => reconciled.dig("mergeCommit", "oid"),
        "reconciled_after_guard" => true
      }
    end

    def run_guard(policy, options)
      args = [
        "--repo", options[:repo],
        "--host", options[:host],
        "--pr", options[:pr].to_s,
        "--expected-head", options[:expected_head],
        "--expected-base", options[:expected_base],
        "--expected-base-sha", @merge_assurance_receipt.dig("bindings", "base", "sha"),
        "--method", policy.fetch("method"),
        "--merge-assurance-receipt", File.expand_path(options[:merge_assurance_receipt])
      ]
      args.concat(["--subject", options[:subject]]) if options[:subject]
      args.concat(["--body", options[:body]]) if options[:body]
      Dir.mktmpdir("pr-merge-submit-guard") do |directory|
        File.chmod(0o700, directory)
        executable = File.join(directory, "identity-bound-guard")
        File.open(executable, File::WRONLY | File::CREAT | File::EXCL, 0o700) do |file|
          file.binmode
          file.write(policy.fetch("trusted_bytes"))
          file.flush
          file.fsync
        end
        run_process(
          { "GH_HOST" => options[:host] }, executable, *args,
          timeout_seconds: guard_timeout_seconds,
          mutation: true,
          process_label: "guarded-direct executable",
          chdir: @repo_root
        )
      end
    end

    def already_merged_result(pull_request, options)
      {
        "pr" => options[:pr].to_i,
        "repo" => options[:repo],
        "url" => pull_request["url"],
        "expected_head" => options[:expected_head],
        "expected_base" => options[:expected_base],
        "submission" => "already_merged",
        "merge_provenance" => "UNKNOWN",
        "merged_at" => pull_request["mergedAt"],
        "merge_commit" => pull_request.dig("mergeCommit", "oid"),
        "already_complete" => true
      }.reject { |_key, value| value.nil? || value == "" }
    end

    def existing_queue_result(pull_request, options, reconciled: false)
      entry = pull_request["mergeQueueEntry"]
      unless entry.is_a?(Hash) && entry["id"]
        raise UnknownOutcome, "PR reports merge-queue membership without a complete queue entry"
      end

      queue_result(pull_request, entry, options, reconciled:)
    end

    def enqueue_result(pull_request, options)
      stdout, stderr, status = run_gh(
        "api", "graphql",
        "-H", GRAPHQL_FEATURE_HEADER,
        "-f", "query=#{ENQUEUE_MUTATION}",
        "-f", "pullRequestId=#{pull_request.fetch('id')}",
        "-f", "expectedHeadOid=#{options[:expected_head]}",
        host: options[:host],
        mutation: true
      )
      unless status.success?
        errors = PrMergeSubmit.graphql_errors(stdout)
        return reconcile_enqueue_graphql_errors!(options, errors) if errors

        return reconcile_mutation_outcome!(
          options,
          "merge-queue submission",
          failure_output(stdout, stderr),
          route: :merge_queue
        )
      end

      payload = begin
        PrMergeSubmit.parse_json!(stdout, "merge-queue submission")
      rescue Error => e
        return reconcile_mutation_outcome!(
          options,
          "merge-queue submission",
          failure_output(e.message, stderr),
          route: :merge_queue
        )
      end
      errors = payload["errors"]
      if Array(errors).any?
        return reconcile_enqueue_graphql_errors!(options, errors)
      end

      entry = payload.dig("data", "enqueuePullRequest", "mergeQueueEntry")
      unless entry.is_a?(Hash) && entry["id"]
        return reconcile_mutation_outcome!(
          options,
          "merge-queue submission",
          "response contained no queue entry",
          route: :merge_queue
        )
      end

      post_enqueue_pull_request = fetch_pr_for_reconciliation!(options, "merge-queue post-submission verification")
      if exact_merge?(post_enqueue_pull_request, options)
        return queue_result(post_enqueue_pull_request, entry, options)
      end

      begin
        validate_pr!(post_enqueue_pull_request, options, require_open: false)
      rescue Error => e
        raise UnknownOutcome, "#{e.message}; automatic queue cleanup is unsafe because GitHub cannot bind dequeue " \
                              "to the entry returned by this submission"
      end

      if exact_queue?(post_enqueue_pull_request, options)
        return existing_queue_result(post_enqueue_pull_request, options)
      end

      raise UnknownOutcome, "merge-queue submission returned an entry but live membership could not be confirmed"
    end

    def queue_result(pull_request, entry, options, reconciled: false)
      post_submission_state = pull_request["merged"] == true ? "MERGED" : pull_request["state"]

      result = {
        "pr" => options[:pr].to_i,
        "repo" => options[:repo],
        "url" => pull_request["url"],
        "base" => pull_request["baseRefName"],
        "expected_head" => options[:expected_head],
        "expected_base" => options[:expected_base],
        "submission" => "merge_queue",
        "direct_method_requested" => options[:method],
        "queue_method" => "repository_configured",
        "post_submission_state" => post_submission_state
      }
      result["merge_queue_entry"] = entry if entry
      result["merge_commit"] = pull_request.dig("mergeCommit", "oid") if pull_request["merged"] == true
      result["reconciled_after_failure"] = true if reconciled
      result
    end

    def reconcile_mutation_outcome!(options, context, diagnostics, route: :merge_queue)
      pull_request = fetch_pr_for_reconciliation!(options, "#{context} outcome")
      if exact_merge?(pull_request, options)
        return already_merged_result(pull_request, options).merge(
          "reconciled_after_failure" => true,
          "attempted_submission" => route.to_s,
          "diagnostics" => diagnostics
        )
      end
      if exact_queue?(pull_request, options)
        return existing_queue_result(pull_request, options, reconciled: true)
      end

      reject_mismatched_queue!(pull_request, options)

      raise UnknownOutcome, "#{context} outcome could not be proven after an ambiguous response; do not retry blindly: #{diagnostics}"
    end

    def reconcile_enqueue_graphql_errors!(options, errors)
      diagnostics = JSON.generate(errors)
      pull_request = fetch_pr_for_reconciliation!(options, "merge-queue submission returned errors")
      if exact_queue?(pull_request, options)
        return existing_queue_result(pull_request, options, reconciled: true)
      end

      if exact_merge?(pull_request, options)
        return already_merged_result(pull_request, options).merge(
          "reconciled_after_failure" => true,
          "attempted_submission" => "merge_queue",
          "diagnostics" => diagnostics
        )
      end

      reject_mismatched_queue!(pull_request, options)
      raise UnknownOutcome, "merge-queue submission outcome could not be proven after GraphQL errors; " \
                            "do not retry blindly: #{diagnostics}"
    end

    def fetch_pr_for_reconciliation!(options, context)
      fetch_pr(options)
    rescue Error => e
      raise UnknownOutcome, "#{context} is UNKNOWN because live PR state could not be read: #{e.message}"
    end

    def exact_merge?(pull_request, options)
      pull_request["state"] == "MERGED" &&
        pull_request["merged"] == true &&
        pull_request["url"] == "https://#{options[:host]}/#{options[:repo]}/pull/#{options[:pr]}" &&
        pull_request["baseRefName"] == options[:expected_base] &&
        pull_request["headRefOid"].to_s.casecmp?(options[:expected_head]) &&
        valid_merge_commit_oid?(pull_request.dig("mergeCommit", "oid"))
    end

    def valid_merge_commit_oid?(oid)
      oid.is_a?(String) && oid.match?(/\A[0-9a-f]{40}\z/i)
    end

    def exact_queue?(pull_request, options)
      pull_request["state"] == "OPEN" &&
        pull_request["merged"] == false &&
        pull_request["mergeCommit"].nil? &&
        pull_request["isInMergeQueue"] == true && exact_target?(pull_request, options) &&
        pull_request["mergeQueueEntry"].is_a?(Hash) && pull_request.dig("mergeQueueEntry", "id")
    end

    def exact_target?(pull_request, options)
      pull_request["baseRefName"] == options[:expected_base] &&
        pull_request["headRefOid"].to_s.casecmp?(options[:expected_head]) &&
        (!@merge_assurance_receipt ||
          pull_request["baseRefOid"].to_s.casecmp?(@merge_assurance_receipt.dig("bindings", "base", "sha").to_s))
    end

    def reject_mismatched_queue!(pull_request, options)
      return unless pull_request["isInMergeQueue"] == true && !exact_target?(pull_request, options)

      mismatch = begin
        validate_pr!(pull_request, options, require_open: false)
        "queued PR no longer matches the authorized target"
      rescue Error => e
        e.message
      end
      entry_id = pull_request.dig("mergeQueueEntry", "id") || "UNKNOWN"
      raise UnknownOutcome, "#{mismatch}; live queue entry #{entry_id} cannot be safely dequeued because GitHub " \
                            "does not accept an expected queue-entry ID"
    end

    def run_gh(*args, host:, mutation: false)
      run_process(
        { "GH_HOST" => host }, "gh", *args,
        timeout_seconds: gh_timeout_seconds,
        mutation:,
        process_label: "gh",
        chdir: Dir.pwd
      )
    rescue Errno::ENOENT
      raise Error, "gh is not installed or not on PATH"
    end

    def run_process(environment, command, *args, timeout_seconds:, mutation:, process_label:, chdir:)
      validate_receipt_freshness!(@merge_assurance_receipt) if mutation && @merge_assurance_receipt
      if @cancellation_signal && (mutation || !@mutation_attempted)
        cancellation_signal = @cancellation_signal
        @mutation_attempted ||= mutation
        @pending_signal = nil
        return [
          "",
          "#{process_label} was cancelled by SIG#{cancellation_signal} before it started",
          FailedStatus.new
        ]
      end
      @pending_signal = nil if @cancellation_signal
      @mutation_attempted ||= mutation

      stdout_file = Tempfile.new("pr-merge-submit-stdout")
      stderr_file = Tempfile.new("pr-merge-submit-stderr")
      interrupted_signal = nil
      pid = Process.spawn(
        environment, command, *args,
        out: stdout_file.path, err: stderr_file.path, pgroup: true, chdir:
      )
      deadline = monotonic_time + timeout_seconds
      status = nil
      timed_out = false
      termination_complete = true

      loop do
        if @pending_signal
          interrupted_signal = @pending_signal
          @pending_signal = nil
          status, termination_complete = terminate_process_group(pid, signal: interrupted_signal)
          break
        end

        waited = Process.waitpid2(pid, Process::WNOHANG)
        if waited
          status = waited[1]
          break
        end

        if monotonic_time >= deadline
          timed_out = true
          status, termination_complete = terminate_process_group(pid)
          break
        end

        sleep 0.05
      end

      stdout = read_capture(stdout_file)
      stderr = read_capture(stderr_file)
      unless termination_complete
        raise UnknownOutcome, "#{process_label} process group did not exit after forced termination; " \
                              "remote outcome is UNKNOWN"
      end

      diagnostic = if interrupted_signal
                     "#{process_label} was interrupted by SIG#{interrupted_signal} and its process group was terminated"
                   elsif timed_out
                     "#{process_label} timed out after #{timeout_seconds} seconds and its process group was terminated"
                   end
      stderr = failure_output(stderr, diagnostic) if diagnostic
      status = FailedStatus.new if interrupted_signal || timed_out
      [stdout, stderr, status || FailedStatus.new]
    ensure
      stdout_file&.close!
      stderr_file&.close!
    end

    def gh_timeout_seconds
      value = Float(ENV.fetch("PR_MERGE_SUBMIT_GH_TIMEOUT_SECONDS", "60"))
      raise ArgumentError unless value.positive? && value.finite?

      value
    rescue ArgumentError
      raise Error, "PR_MERGE_SUBMIT_GH_TIMEOUT_SECONDS must be a positive finite number"
    end

    def guard_timeout_seconds
      value = Float(ENV.fetch("PR_MERGE_SUBMIT_GUARD_TIMEOUT_SECONDS", "300"))
      raise ArgumentError unless value.positive? && value.finite?

      value
    rescue ArgumentError
      raise Error, "PR_MERGE_SUBMIT_GUARD_TIMEOUT_SECONDS must be a positive finite number"
    end

    def install_signal_handlers
      %w[INT TERM HUP].to_h do |signal|
        previous = Signal.trap(signal) { yield signal }
        [signal, previous]
      end
    end

    def restore_signal_handlers(previous_handlers)
      previous_handlers.each { |signal, handler| Signal.trap(signal, handler) }
    end

    def terminate_process_group(pid, signal: "TERM", grace_seconds: 1, kill_grace_seconds: 1)
      signal_process_group(signal, pid)
      deadline = monotonic_time + grace_seconds
      status = wait_for_child(pid, deadline)
      return [status, true] if wait_for_process_group_exit(pid, deadline)

      signal_process_group("KILL", pid)
      deadline = monotonic_time + kill_grace_seconds
      status ||= wait_for_child(pid, deadline)
      [status, wait_for_process_group_exit(pid, deadline)]
    end

    def signal_process_group(signal, pid)
      Process.kill(signal, -pid)
    rescue Errno::ESRCH
      nil
    end

    def wait_for_child(pid, deadline)
      while monotonic_time < deadline
        waited = Process.waitpid2(pid, Process::WNOHANG)
        return waited[1] if waited

        sleep 0.05
      end

      nil
    rescue Errno::ECHILD
      nil
    end

    def process_group_alive?(pid)
      Process.kill(0, -pid)
      true
    rescue Errno::ESRCH
      false
    rescue Errno::EPERM
      true
    end

    def wait_for_process_group_exit(pid, deadline)
      while monotonic_time < deadline
        return true unless process_group_alive?(pid)

        sleep 0.05
      end

      !process_group_alive?(pid)
    end

    def monotonic_time
      Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end

    def read_capture(file)
      file.rewind
      file.read
    end

    def failure_output(stdout, stderr)
      [stderr, stdout].reject(&:empty?).join("\n").strip
    end

    def validate_url_host!(url, expected_host)
      uri = URI.parse(url.to_s)
      raise Error, "PR URL is not HTTPS" unless uri.scheme == "https" && uri.host

      actual_host = uri.host.downcase
      actual_host = "#{actual_host}:#{uri.port}" unless uri.port == 443
      return if actual_host.casecmp?(expected_host)

      raise Error, "PR URL host mismatch: expected #{expected_host}, found #{actual_host}"
    rescue URI::InvalidURIError
      raise Error, "PR URL is invalid"
    end
  end
end

exit PrMergeSubmit::Runner.new.run(ARGV) if $PROGRAM_NAME == __FILE__
