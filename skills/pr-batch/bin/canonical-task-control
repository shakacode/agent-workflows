#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"

module CanonicalTaskControl
  class InvalidInput < StandardError; end

  module_function

  def run(input)
    operation = input["operation"]
    input_keys = %w[contract version operation task]
    input_keys.concat(%w[manifest lifecycle children]) if operation == "accept_child_receipt"
    input_keys.concat(%w[manifest lifecycle budget_gate delegation]) if operation == "delegation"
    input_keys << "pilot" if operation == "pilot_evaluation"
    input_keys.concat(%w[budget_action budget_gate]) if operation == "budget_action"
    require_exact_keys!(input, input_keys)
    raise InvalidInput, "unsupported contract" unless input["contract"] == "canonical-task-control"
    raise InvalidInput, "unsupported version" unless input["version"] == 1
    unless %w[launch accept_child_receipt delegation pilot_evaluation budget_action].include?(operation)
      raise InvalidInput, "unsupported operation"
    end

    task = input.fetch("task")
    task_keys = %w[id topology_mode targets lanes implementation_pr_limit]
    task_keys << "exception" if task.is_a?(Hash) && task["topology_mode"] == "multi_target_exception"
    require_exact_keys!(task, task_keys)
    raise InvalidInput, "task.id must be known" unless known_string?(task["id"])
    raise InvalidInput, "implementation_pr_limit must be 1 per lane" unless task["implementation_pr_limit"] == 1
    validate_topology!(task)

    unknowns = []
    accepted_child_receipts = []
    closed_children = []
    verdict = "allow"
    allowed_actions = [operation]
    wake_target = false
    pilot_result = {}
    if operation == "accept_child_receipt"
      validate_manifest!(input.fetch("manifest"))
      unknowns.concat(validate_lifecycle!(input.fetch("lifecycle"), required_boundary: "review_wave"))
      accepted_child_receipts, closed_children = validate_children!(input.fetch("children"), task)
    elsif operation == "delegation"
      validate_manifest!(input.fetch("manifest"))
      lifecycle = input.fetch("lifecycle")
      unknowns.concat(validate_lifecycle!(lifecycle, required_boundary: "cross_task_handoff"))
      validate_budget_gate!(input.fetch("budget_gate"))
      delegation_decision = validate_delegation!(input.fetch("delegation"), task, lifecycle["context_threshold"])
      verdict = delegation_decision.fetch("verdict")
      allowed_actions = delegation_decision.fetch("allowed_actions")
      wake_target = delegation_decision.fetch("wake_target")
      unknowns.concat(delegation_decision.fetch("unknowns"))
    elsif operation == "pilot_evaluation"
      pilot_result = validate_pilot!(input.fetch("pilot"))
      verdict = pilot_result.fetch("pilot_verdict") == "promote_ordinary_default" ? "allow" : "block"
      allowed_actions = ["publish_pilot_result"]
      unknowns.concat(pilot_result.fetch("unknowns"))
    elsif operation == "budget_action"
      action = input.fetch("budget_action")
      allowed_budget_actions = %w[delegation resume worker_spawn retry review_wave]
      raise InvalidInput, "unsupported budget action" unless allowed_budget_actions.include?(action)
      validate_budget_gate!(input.fetch("budget_gate"))
      allowed_actions = [action]
    end

    {
      "contract" => "canonical-task-control-decision",
      "version" => 1,
      "verdict" => verdict,
      "topology_mode" => task.fetch("topology_mode"),
      "allowed_actions" => allowed_actions,
      "wake_target" => wake_target,
      "blockers" => [],
      "unknowns" => unknowns.uniq.sort,
      "accepted_child_receipts" => accepted_child_receipts,
      "closed_children" => closed_children
    }.merge(pilot_result.reject { |key, _value| key == "unknowns" })
  end

  def validate_pilot!(pilot)
    keys = %w[contract version dependency pairs promotion rollback publication_ref]
    require_exact_keys!(pilot, keys)
    unless pilot["contract"] == "canonical-task-matched-pilot" && pilot["version"] == 1
      raise InvalidInput, "unsupported canonical task matched pilot"
    end
    dependency = pilot["dependency"]
    require_exact_keys!(dependency, %w[issue status evidence_ref])
    raise InvalidInput, "pilot dependency must bind issue #398" unless dependency["issue"] == 398
    unless %w[pending satisfied].include?(dependency["status"])
      raise InvalidInput, "pilot dependency status must be pending or satisfied"
    end
    if dependency["status"] == "satisfied"
      raise InvalidInput, "satisfied #398 dependency requires durable evidence" unless durable_ref?(dependency["evidence_ref"])
    elsif dependency["evidence_ref"] != "UNKNOWN"
      raise InvalidInput, "pending #398 dependency evidence must stay UNKNOWN"
    end
    raise InvalidInput, "pilot rollback must be known" unless known_string?(pilot["rollback"])
    raise InvalidInput, "pilot publication_ref must be durable HTTPS" unless durable_ref?(pilot["publication_ref"])

    promotion = pilot["promotion"]
    promotion_keys = %w[
      usage_reduction_policy material_reduction_percent
      require_zero_escaped_p0_p1_regression require_preserved_gate_compliance
    ]
    require_exact_keys!(promotion, promotion_keys)
    raise InvalidInput, "promotion usage policy must be materially_lower" unless promotion["usage_reduction_policy"] == "materially_lower"
    unless promotion["material_reduction_percent"].is_a?(Numeric) &&
           promotion["material_reduction_percent"].positive? &&
           promotion["material_reduction_percent"] <= 100
      raise InvalidInput, "material_reduction_percent must be in (0,100]"
    end
    unless promotion["require_zero_escaped_p0_p1_regression"] == true &&
           promotion["require_preserved_gate_compliance"] == true
      raise InvalidInput, "pilot promotion may not weaken defect or gate criteria"
    end

    pairs = pilot["pairs"]
    raise InvalidInput, "matched pilot requires at least ten pairs" unless pairs.is_a?(Array) && pairs.length >= 10
    pair_ids = []
    unknowns = []
    ordinary_tokens = 0
    multi_tokens = 0
    token_metrics_known = true
    escaped_defect_regression = false
    gate_regression = false
    pairs.each do |pair|
      require_exact_keys!(pair, %w[pair_id task_class context_topology ordinary multi_target])
      %w[pair_id task_class context_topology].each do |key|
        raise InvalidInput, "pilot pair #{key} must be known" unless known_string?(pair[key])
      end
      pair_ids << pair["pair_id"]
      ordinary = validate_pilot_arm!(pair["ordinary"])
      multi = validate_pilot_arm!(pair["multi_target"])
      if pair["ordinary"]["execution_receipt_ref"] == "UNKNOWN" ||
         pair["multi_target"]["execution_receipt_ref"] == "UNKNOWN"
        unknowns << "execution_provenance"
      end
      if ordinary["total_tokens"] == "UNKNOWN" || multi["total_tokens"] == "UNKNOWN"
        token_metrics_known = false
      else
        ordinary_tokens += ordinary.fetch("total_tokens")
        multi_tokens += multi.fetch("total_tokens")
      end
      escaped_defect_regression ||= ordinary.fetch("escaped_p0_p1_defects") > multi.fetch("escaped_p0_p1_defects")
      gate_regression ||= ordinary.fetch("gate_compliance") != "preserved" || multi.fetch("gate_compliance") != "preserved"
    end
    raise InvalidInput, "pilot pair ids must be unique" unless pair_ids.uniq.length == pair_ids.length

    reduction = if token_metrics_known && !multi_tokens.zero?
                  ((multi_tokens - ordinary_tokens) * 100.0 / multi_tokens)
                end
    promotable = dependency["status"] == "satisfied" && unknowns.empty? && reduction &&
                 reduction >= promotion["material_reduction_percent"] &&
                 !escaped_defect_regression && !gate_regression
    {
      "pilot_verdict" => promotable ? "promote_ordinary_default" : "retain_multi_target_rollback",
      "matched_pair_count" => pairs.length,
      "token_reduction_percent" => reduction&.round(3) || "UNKNOWN",
      "unknowns" => unknowns.uniq.sort
    }
  end

  def validate_pilot_arm!(arm)
    require_exact_keys!(arm, %w[execution_receipt_ref metrics])
    receipt = arm["execution_receipt_ref"]
    unless receipt == "UNKNOWN" || known_string?(receipt)
      raise InvalidInput, "execution receipt reference must be known or UNKNOWN"
    end
    metrics = arm["metrics"]
    keys = %w[
      total_tokens credit_equivalents elapsed_seconds human_coordination_seconds
      correction_turns first_pass_accepted escaped_p0_p1_defects gate_compliance
    ]
    require_exact_keys!(metrics, keys)
    if receipt == "UNKNOWN"
      %w[total_tokens credit_equivalents].each do |key|
        raise InvalidInput, "unsupported execution receipt requires #{key} UNKNOWN" unless metrics[key] == "UNKNOWN"
      end
    end
    %w[total_tokens credit_equivalents].each do |key|
      next if receipt == "UNKNOWN" && metrics[key] == "UNKNOWN"
      raise InvalidInput, "pilot metric #{key} must be nonnegative" unless nonnegative_number?(metrics[key])
    end
    %w[elapsed_seconds human_coordination_seconds correction_turns escaped_p0_p1_defects].each do |key|
      raise InvalidInput, "pilot metric #{key} must be nonnegative" unless nonnegative_number?(metrics[key])
    end
    unless [true, false].include?(metrics["first_pass_accepted"])
      raise InvalidInput, "first_pass_accepted must be boolean"
    end
    unless %w[preserved weakened UNKNOWN].include?(metrics["gate_compliance"])
      raise InvalidInput, "gate_compliance is unsupported"
    end
    metrics
  end

  def durable_ref?(value)
    value.to_s.match?(%r{\Ahttps://[^[:space:]]+\z})
  end

  def validate_budget_gate!(gate)
    require_exact_keys!(gate, %w[source status evidence_ref])
    raise InvalidInput, "budget gate source must be #399 or a durable policy reference" unless known_string?(gate["source"])
    raise InvalidInput, "budget gate must pass before this operation" unless gate["status"] == "passed"
    raise InvalidInput, "budget gate evidence must be known" unless known_string?(gate["evidence_ref"])
  end

  def validate_delegation!(delegation, task, configured_context_threshold)
    keys = %w[
      source target target_state estimated_rendered_context descendant_fanout
      context_policy_threshold message_class queued_messages coalesced
      deterministic_handoff_available human_approval usage
    ]
    require_exact_keys!(delegation, keys)
    source = validate_task_identity!(delegation["source"])
    target = validate_task_identity!(delegation["target"])
    raise InvalidInput, "source and target task identities must differ" if source["task_id"] == target["task_id"]
    canonical = task.fetch("targets").first
    unless target.values_at("repository", "target") == canonical.values_at("repository", "target") &&
           target["task_id"] == task["id"]
      raise InvalidInput, "delegation target must bind this task and canonical repository-qualified target"
    end

    states = %w[active idle paused stale terminal]
    raise InvalidInput, "unsupported target_state" unless states.include?(delegation["target_state"])
    message_classes = %w[new_evidence unchanged acknowledgement deterministic_handoff]
    raise InvalidInput, "unsupported message_class" unless message_classes.include?(delegation["message_class"])
    raise InvalidInput, "queued_messages must be a nonnegative integer" unless delegation["queued_messages"].is_a?(Integer) && !delegation["queued_messages"].negative?
    unless [true, false].include?(delegation["coalesced"]) && [true, false].include?(delegation["deterministic_handoff_available"])
      raise InvalidInput, "delegation booleans are malformed"
    end

    unknowns = []
    %w[estimated_rendered_context descendant_fanout context_policy_threshold].each do |key|
      value = delegation[key]
      if value == "UNKNOWN"
        unknowns << (key == "estimated_rendered_context" ? "target_context_estimate" : key)
      elsif !value.is_a?(Integer) || value.negative?
        raise InvalidInput, "#{key} must be a nonnegative integer or UNKNOWN"
      end
    end
    unknowns.concat(validate_usage!(delegation["usage"]))
    unless delegation["context_policy_threshold"] == configured_context_threshold
      raise InvalidInput, "delegation threshold must match the configured lifecycle threshold"
    end

    if delegation["target_state"] == "active"
      raise InvalidInput, "active-target delegation must coalesce queued messages" unless delegation["coalesced"] == true && delegation["queued_messages"].positive?
      return {
        "verdict" => "coalesce",
        "allowed_actions" => ["queue_coalesced_message"],
        "wake_target" => false,
        "unknowns" => unknowns
      }
    end


    suppress_wake = %w[unchanged acknowledgement deterministic_handoff].include?(delegation["message_class"]) ||
                    delegation["deterministic_handoff_available"]
    if delegation["target_state"] == "terminal" || suppress_wake
      return {
        "verdict" => "block",
        "allowed_actions" => [],
        "wake_target" => false,
        "unknowns" => unknowns
      }
    end

    approval = delegation["human_approval"].to_s.match?(%r{\Ahttps://[^[:space:]]+\z})
    context = delegation["estimated_rendered_context"]
    threshold = delegation["context_policy_threshold"]
    needs_approval = context == "UNKNOWN" || threshold == "UNKNOWN" ||
                     (context.is_a?(Integer) && threshold.is_a?(Integer) && context > threshold) ||
                     delegation["target_state"] == "stale"
    if needs_approval && !approval
      return {
        "verdict" => "block",
        "allowed_actions" => [],
        "wake_target" => false,
        "unknowns" => unknowns
      }
    end

    {
      "verdict" => "allow",
      "allowed_actions" => ["wake_target_task"],
      "wake_target" => true,
      "unknowns" => unknowns
    }
  end

  def validate_task_identity!(identity)
    require_exact_keys!(identity, %w[task_id repository target])
    raise InvalidInput, "task identity must be known" unless known_string?(identity["task_id"])
    validate_target!(identity.slice("repository", "target"))
    identity
  end

  def validate_usage!(usage)
    keys = %w[
      contract version support receipt_ref source_edge_delta target_self_delta
      target_descendant_delta aggregate_physical_delta reconciliation
    ]
    require_exact_keys!(usage, keys)
    unless usage["contract"] == "execution-provenance-evidence" && usage["version"] == 1
      raise InvalidInput, "unsupported execution provenance evidence contract"
    end
    delta_keys = %w[source_edge_delta target_self_delta target_descendant_delta aggregate_physical_delta]
    case usage["support"]
    when "unsupported", "UNKNOWN"
      unless usage["receipt_ref"] == "UNKNOWN" && usage["reconciliation"] == "UNKNOWN" &&
             delta_keys.all? { |key| usage[key] == "UNKNOWN" }
        raise InvalidInput, "unsupported execution provenance must stay field-granular UNKNOWN"
      end
      ["execution_provenance"]
    when "available"
      raise InvalidInput, "available execution provenance requires a receipt reference" unless known_string?(usage["receipt_ref"])
      raise InvalidInput, "available execution provenance must be reconciled" unless usage["reconciliation"] == "reconciled"
      unless delta_keys.all? { |key| nonnegative_number?(usage[key]) }
        raise InvalidInput, "execution provenance deltas must be nonnegative numbers"
      end
      []
    else
      raise InvalidInput, "unsupported execution provenance support state"
    end
  end

  def validate_manifest!(manifest)
    keys = %w[contract version requirements ownership current_heads gates budgets decisions]
    require_exact_keys!(manifest, keys)
    unless manifest["contract"] == "compact-coordinator-manifest" && manifest["version"] == 1
      raise InvalidInput, "unsupported compact coordinator manifest"
    end
    %w[requirements decisions].each do |key|
      values = manifest[key]
      raise InvalidInput, "manifest.#{key} must be a compact known array" unless known_string_array?(values)
    end
    %w[ownership current_heads gates budgets].each do |key|
      value = manifest[key]
      raise InvalidInput, "manifest.#{key} must be a nonempty object" unless value.is_a?(Hash) && !value.empty?
    end
  end

  def validate_lifecycle!(lifecycle, required_boundary:)
    require_exact_keys!(lifecycle, %w[context_threshold context_threshold_source checkpoints])
    threshold = lifecycle["context_threshold"]
    source = lifecycle["context_threshold_source"]
    unknowns = []
    if threshold == "UNKNOWN"
      raise InvalidInput, "unknown context threshold must keep source UNKNOWN" unless source == "UNKNOWN"
      unknowns << "context_threshold"
    else
      raise InvalidInput, "context_threshold must be positive or UNKNOWN" unless positive_integer?(threshold)
      raise InvalidInput, "configured context threshold requires a known source" unless known_string?(source)
    end

    checkpoints = lifecycle["checkpoints"]
    raise InvalidInput, "checkpoints must be a nonempty array" unless checkpoints.is_a?(Array) && !checkpoints.empty?
    boundaries = checkpoints.map do |checkpoint|
      require_exact_keys!(checkpoint, %w[contract version boundary status evidence_ref])
      unless checkpoint["contract"] == "coordinator-compaction-checkpoint" && checkpoint["version"] == 1
        raise InvalidInput, "unsupported compaction checkpoint"
      end
      allowed = %w[plan_settlement dispatch review_wave monitor cross_task_handoff context_threshold]
      raise InvalidInput, "unsupported compaction boundary" unless allowed.include?(checkpoint["boundary"])
      raise InvalidInput, "compaction checkpoint must be satisfied" unless checkpoint["status"] == "satisfied"
      raise InvalidInput, "compaction checkpoint evidence must be known" unless known_string?(checkpoint["evidence_ref"])
      checkpoint["boundary"]
    end
    raise InvalidInput, "compaction checkpoint boundaries must be unique" unless boundaries.uniq.length == boundaries.length
    raise InvalidInput, "missing #{required_boundary} compaction checkpoint" unless boundaries.include?(required_boundary)
    unknowns
  end

  def validate_children!(children, task)
    require_exact_keys!(children, %w[packets receipts states])
    packets = children["packets"]
    receipts = children["receipts"]
    states = children["states"]
    unless [packets, receipts, states].all? { |value| value.is_a?(Array) }
      raise InvalidInput, "children packets, receipts, and states must be arrays"
    end

    task_lanes = task.fetch("lanes").to_h { |lane| [lane.fetch("id"), lane] }
    packet_ids = packets.map do |packet|
      keys = %w[
        contract version child_id lane_id repository target role scope
        acceptance_criteria verification stop_conditions
      ]
      require_exact_keys!(packet, keys)
      unless packet["contract"] == "task-scoped-child-packet" && packet["version"] == 1
        raise InvalidInput, "unsupported task-scoped child packet"
      end
      %w[child_id lane_id role scope].each do |key|
        raise InvalidInput, "child packet #{key} must be known" unless known_string?(packet[key])
      end
      %w[acceptance_criteria verification stop_conditions].each do |key|
        raise InvalidInput, "child packet #{key} must be a known array" unless known_string_array?(packet[key])
      end
      validate_child_binding!(packet, task_lanes)
      packet["child_id"]
    end
    raise InvalidInput, "child packet ids must be unique" unless packet_ids.uniq.length == packet_ids.length

    receipt_ids = receipts.map do |receipt|
      keys = %w[
        contract version child_id lane_id repository target status head_sha
        summary findings verification open_decisions
      ]
      require_exact_keys!(receipt, keys)
      unless receipt["contract"] == "compact-child-receipt" && receipt["version"] == 1
        raise InvalidInput, "unsupported compact child receipt"
      end
      raise InvalidInput, "child receipt status must be completed" unless receipt["status"] == "completed"
      raise InvalidInput, "child receipt summary must be known" unless known_string?(receipt["summary"])
      raise InvalidInput, "child receipt head_sha must be full" unless receipt["head_sha"].to_s.match?(/\A[0-9a-fA-F]{40}\z/)
      %w[findings verification open_decisions].each do |key|
        raise InvalidInput, "child receipt #{key} must be an array" unless receipt[key].is_a?(Array)
      end
      validate_child_binding!(receipt, task_lanes)
      receipt["child_id"]
    end
    raise InvalidInput, "child receipt ids must be unique" unless receipt_ids.uniq.length == receipt_ids.length

    state_ids = states.map do |state|
      require_exact_keys!(state, %w[child_id status resumable])
      raise InvalidInput, "completed children must be closed" unless state["status"] == "closed"
      raise InvalidInput, "completed children are non-resumable by default" unless state["resumable"] == false
      state["child_id"]
    end
    raise InvalidInput, "child state ids must be unique" unless state_ids.uniq.length == state_ids.length
    unless packet_ids.sort == receipt_ids.sort && receipt_ids.sort == state_ids.sort
      raise InvalidInput, "every accepted child packet requires one receipt and closed state"
    end
    [receipt_ids.sort, state_ids.sort]
  end

  def validate_child_binding!(record, task_lanes)
    lane = task_lanes[record["lane_id"]]
    raise InvalidInput, "child record lane is outside the task" unless lane
    unless record.values_at("repository", "target") == lane.values_at("repository", "target")
      raise InvalidInput, "child record must bind the lane repository-qualified target"
    end
  end

  def validate_topology!(task)
    targets = task["targets"]
    lanes = task["lanes"]
    raise InvalidInput, "targets must be a nonempty array" unless targets.is_a?(Array) && !targets.empty?
    raise InvalidInput, "lanes must be a nonempty array" unless lanes.is_a?(Array) && !lanes.empty?

    targets.each { |target| validate_target!(target) }
    lanes.each { |lane| validate_lane!(lane) }
    target_keys = targets.map { |target| target.values_at("repository", "target") }
    lane_target_keys = lanes.map { |lane| lane.values_at("repository", "target") }
    raise InvalidInput, "canonical targets must be unique" unless target_keys.uniq.length == target_keys.length
    raise InvalidInput, "lane ids must be unique" unless lanes.map { |lane| lane["id"] }.uniq.length == lanes.length
    unless lane_target_keys.sort == target_keys.sort
      raise InvalidInput, "each canonical repository-qualified target requires exactly one execution lane"
    end

    case task["topology_mode"]
    when "ordinary"
      raise InvalidInput, "ordinary topology requires exactly one target and one lane" unless targets.length == 1 && lanes.length == 1
    when "multi_target_exception"
      raise InvalidInput, "multi-target exception requires at least two targets" unless targets.length > 1
      validate_exception!(task.fetch("exception"), targets, lanes)
    else
      raise InvalidInput, "unsupported topology_mode"
    end
  end

  def validate_exception!(exception, targets, lanes)
    keys = %w[
      contract version reason justification target_count concurrency aggregate_budget
      per_lane_budgets shared_context_justification expected_savings rollback human_approval
    ]
    require_exact_keys!(exception, keys)
    raise InvalidInput, "unsupported multi-target exception contract" unless exception["contract"] == "multi-target-supervision-exception" && exception["version"] == 1
    reasons = %w[independent_read_heavy atomic_cross_issue_migration tightly_coupled_dependency_wave]
    raise InvalidInput, "unsupported multi-target exception reason" unless reasons.include?(exception["reason"])
    %w[justification shared_context_justification expected_savings rollback].each do |key|
      raise InvalidInput, "exception.#{key} must be known" unless known_string?(exception[key])
    end
    raise InvalidInput, "target_count mismatch" unless exception["target_count"] == targets.length
    unless positive_integer?(exception["concurrency"]) && exception["concurrency"] <= targets.length
      raise InvalidInput, "concurrency must be between 1 and target_count"
    end
    unless exception["human_approval"].to_s.match?(%r{\Ahttps://[^[:space:]]+\z})
      raise InvalidInput, "human_approval must be a durable HTTPS reference"
    end

    aggregate = validate_budget!(exception["aggregate_budget"], require_source: true)
    per_lane = exception["per_lane_budgets"]
    raise InvalidInput, "per_lane_budgets must cover every lane" unless per_lane.is_a?(Array) && per_lane.length == lanes.length
    lane_ids = lanes.map { |lane| lane["id"] }
    budget_lane_ids = per_lane.map do |budget|
      require_exact_keys!(budget, %w[lane_id amount unit])
      raise InvalidInput, "budget amount must be a positive integer" unless positive_integer?(budget["amount"])
      raise InvalidInput, "budget unit must be known" unless known_string?(budget["unit"])
      budget["lane_id"]
    end
    raise InvalidInput, "per_lane_budgets lane ids must exactly match lanes" unless budget_lane_ids.sort == lane_ids.sort
    units = per_lane.map { |budget| budget["unit"] }.uniq
    raise InvalidInput, "aggregate and per-lane budget units must match" unless units == [aggregate.fetch("unit")]
    raise InvalidInput, "per-lane budgets exceed aggregate budget" if per_lane.sum { |budget| budget["amount"] } > aggregate.fetch("amount")
  end

  def validate_budget!(budget, require_source:)
    keys = %w[amount unit]
    keys << "source" if require_source
    require_exact_keys!(budget, keys)
    raise InvalidInput, "budget amount must be a positive integer" unless positive_integer?(budget["amount"])
    raise InvalidInput, "budget unit must be known" unless known_string?(budget["unit"])
    raise InvalidInput, "budget source must be known" if require_source && !known_string?(budget["source"])
    budget
  end

  def validate_target!(target)
    require_exact_keys!(target, %w[repository target])
    raise InvalidInput, "target repository must be OWNER/REPO" unless target["repository"].to_s.match?(%r{\A[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\z})
    raise InvalidInput, "target must be issue:N or pull_request:N" unless target["target"].to_s.match?(%r{\A(?:issue|pull_request):[1-9][0-9]*\z})
  end

  def validate_lane!(lane)
    require_exact_keys!(lane, %w[id repository target])
    raise InvalidInput, "lane.id must be known" unless known_string?(lane["id"])
    validate_target!(lane.slice("repository", "target"))
  end

  def require_exact_keys!(object, keys)
    raise InvalidInput, "expected object" unless object.is_a?(Hash)
    return if object.keys.sort == keys.sort

    raise InvalidInput, "keys must be exactly #{keys.sort.join(', ')}"
  end

  def known_string?(value)
    value.is_a?(String) && !value.strip.empty? && value.strip != "UNKNOWN"
  end

  def known_string_array?(value)
    value.is_a?(Array) && !value.empty? && value.all? { |item| known_string?(item) }
  end

  def positive_integer?(value)
    value.is_a?(Integer) && value.positive?
  end

  def nonnegative_number?(value)
    value.is_a?(Numeric) && value >= 0
  end
end

if ARGV == ["--help"]
  puts <<~HELP
    Usage: canonical-task-control < input.json

    Validate canonical-task-control v1 JSON and emit one deterministic decision.
    Operations: launch, accept_child_receipt, delegation, budget_action,
    pilot_evaluation. The helper is read-only and performs no external mutation.
  HELP
  exit 0
elsif !ARGV.empty?
  warn "INVALID_INPUT: unexpected arguments"
  exit 1
end

begin
  input = JSON.parse($stdin.read)
  puts JSON.generate(CanonicalTaskControl.run(input))
rescue JSON::ParserError, KeyError, CanonicalTaskControl::InvalidInput => e
  warn "INVALID_INPUT: #{e.message}"
  exit 1
end
