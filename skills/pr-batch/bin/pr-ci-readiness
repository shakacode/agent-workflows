#!/usr/bin/env ruby
# frozen_string_literal: true

# Decide whether a PR's CI is ready, without writing to git or GitHub.
#
# Encapsulates the repeated "is this PR's CI ready?" rule that is otherwise
# restated in prose across pr-batch, adversarial-pr-review, and pr-processing:
#
#   1. Run `gh pr checks <PR> --required`. If it reports no current required
#      checks -- either no JSON at all, or only cancelled rows -- fall back to
#      the full `gh pr checks <PR>` list while retaining required cancellations.
#   2. No current rows or retained required cancellations => UNKNOWN / not ready.
#   3. A required cancellation blocks as pending unless a non-cancel row with
#      the same workflow and name proves supersession. Ignore other cancelled
#      rows from the full advisory list.
#   4. Otherwise READY only when no failing (bucket "fail") and no pending
#      (bucket "pending") rows remain. Passing and skipping rows are fine.
#   5. Inventory current-head PENDING review drafts visible to the current
#      authenticated viewer. READY requires a complete viewer-scoped inventory
#      with no drafts; other reviewers' unsubmitted drafts are not observable
#      or covered, and an unavailable inventory is UNKNOWN.
#
# `gh pr checks` exits non-zero when checks are failing or pending, so this
# captures stdout and inspects the rows rather than trusting the exit status.
#
# Requires: gh (GitHub CLI). Ruby stdlib only.

require "json"
require "open3"
require "time"

# Pure verdict logic (no I/O) plus the gh-backed runner. The pure methods take
# the raw `gh pr checks --json` output string (or parsed rows) so they can be
# unit-tested directly without a subprocess.
module PrCiReadiness
  class Error < StandardError; end

  module_function

  # Parse a `gh pr checks --json name,state,bucket,link,workflow` payload into rows.
  # Blank or non-JSON input (e.g. gh's "no required checks" message) yields [].
  def parse_rows(raw)
    return [] if raw.nil? || raw.strip.empty?

    rows = JSON.parse(raw)
    rows.is_a?(Array) ? rows : []
  rescue JSON::ParserError
    []
  end

  def json_array_payload?(raw)
    JSON.parse(raw.to_s).is_a?(Array)
  rescue JSON::ParserError
    false
  end

  # True when the raw payload holds a JSON array with at least one current row.
  # A required-check list made up entirely of cancelled rows still falls back
  # so the full list can supply same-context supersession evidence.
  def usable_checks?(raw)
    !active_rows(parse_rows(raw)).empty?
  end

  # Current rows that count toward a full/advisory gate. Required cancellations
  # are reconciled separately so unrelated cancelled advisory noise stays out.
  def active_rows(rows)
    rows.reject { |row| row["bucket"].to_s == "cancel" }
  end

  def check_identity(row)
    [row["workflow"].to_s, row["name"].to_s]
  end

  # Preserve required cancellations unless a current row with the exact same
  # workflow/name identity supersedes them. Full-list cancellations are noise.
  def readiness_rows(rows, required_used:, required_cancellations: [])
    current_rows = active_rows(rows)
    gate_rows = required_used ? rows : current_rows + required_cancellations
    current_contexts = current_rows.map { |row| check_identity(row) }
    gate_rows.reject do |row|
      row["bucket"].to_s == "cancel" && current_contexts.include?(check_identity(row))
    end
  end

  def failing_names(rows)
    rows.select { |row| row["bucket"].to_s == "fail" }.map { |row| row["name"].to_s }
  end

  def pending_names(rows)
    rows.select { |row| %w[cancel pending].include?(row["bucket"].to_s) }.map { |row| row["name"].to_s }
  end

  def verdict_for(rows, failing, pending)
    if rows.empty?
      "UNKNOWN"
    elsif failing.empty? && pending.empty?
      "READY"
    else
      "NOT_READY"
    end
  end

  EVIDENCE_STATES = %w[READY NOT_READY NOT_APPLICABLE UNKNOWN].freeze
  SUCCESSFUL_CONCLUSIONS = %w[success neutral skipped].freeze

  def evidence_row_state(row)
    return "UNKNOWN" unless row.is_a?(Hash)

    bucket = row["bucket"].to_s
    return "READY" if %w[pass skipping].include?(bucket)
    return "NOT_READY" if %w[cancel fail pending].include?(bucket)

    state = row["state"].to_s.downcase
    return "READY" if state == "success"
    return "NOT_READY" if %w[error failure pending].include?(state)

    status = row["status"].to_s.downcase
    return "NOT_READY" unless status.empty? || status == "completed"
    return "UNKNOWN" if status.empty?

    conclusion = row["conclusion"].to_s.downcase
    return "READY" if SUCCESSFUL_CONCLUSIONS.include?(conclusion)
    return "NOT_READY" unless conclusion.empty?

    "UNKNOWN"
  end

  def evidence_scope(source:, head_sha:, complete:, rows:, checked_at:, error: nil)
    normalized_rows = rows.is_a?(Array) ? rows : []
    row_states = normalized_rows.map { |row| evidence_row_state(row) }
    state =
      if complete != true
        "UNKNOWN"
      elsif !rows.is_a?(Array) || row_states.include?("UNKNOWN")
        "UNKNOWN"
      elsif normalized_rows.empty?
        "NOT_APPLICABLE"
      elsif row_states.include?("NOT_READY")
        "NOT_READY"
      else
        "READY"
      end
    result = {
      "state" => state,
      "source" => source,
      "complete" => complete == true,
      "head_sha" => head_sha,
      "rows" => normalized_rows,
      "checked_at" => checked_at
    }
    result["error"] = error.to_s unless error.to_s.empty?
    result["error"] ||= "one or more rows had an unknown state" if state == "UNKNOWN" && complete == true
    result
  end

  def evidence_contract(repo:, pr_number:, head_sha:, checked_at:, scopes:)
    states = scopes.values.map { |scope| scope["state"] }
    verdict =
      if states.any? { |state| !EVIDENCE_STATES.include?(state) } || states.include?("UNKNOWN")
        "UNKNOWN"
      elsif states.include?("NOT_READY")
        "NOT_READY"
      else
        "READY"
      end
    {
      "contract" => "pr-ci-readiness",
      "version" => 2,
      "repo" => repo,
      "pr" => pr_number.to_i,
      "head_sha" => head_sha,
      "checked_at" => checked_at,
      "verdict" => verdict,
      "scopes" => scopes
    }
  end

  def inventory_scopes(
    head_sha:, checked_at:, required_rows:, required_complete:, actions_rows:,
    actions_complete:, check_runs:, check_runs_complete:, statuses:,
    statuses_complete:, errors: {}
  )
    required_identities = required_rows.filter_map do |row|
      producer = row["workflow"].to_s.strip
      name = row["name"].to_s
      next if producer.empty? || producer == "UNKNOWN" || name.empty?

      ["check_run", producer, name]
    end
    dependabot_rows = actions_rows.select { |row| row["dependabot"] == true }
    github_actions_rows = actions_rows.reject { |row| row["dependabot"] == true }
    other_rows = (check_runs + statuses).reject do |row|
      required_identities.include?([row["kind"].to_s, row["app_slug"].to_s.strip, row["name"].to_s]) ||
        row["app_slug"].to_s == "github-actions" ||
        row["dependabot"] == true
    end

    {
      "required_status_check_rollup" => evidence_scope(
        source: "github.pull_request.status_check_rollup.required",
        head_sha:, complete: required_complete, rows: required_rows, checked_at:,
        error: errors["required_status_check_rollup"]
      ),
      "github_actions" => evidence_scope(
        source: "github.actions.exact_head",
        head_sha:, complete: actions_complete && check_runs_complete,
        rows: github_actions_rows, checked_at:, error: errors["github_actions"]
      ),
      "dependabot" => evidence_scope(
        source: "github.dependabot.exact_head",
        head_sha:, complete: actions_complete && check_runs_complete,
        rows: dependabot_rows, checked_at:, error: errors["dependabot"]
      ),
      "other" => evidence_scope(
        source: "github.checks_and_statuses.exact_head.non_required",
        head_sha:, complete: check_runs_complete && statuses_complete,
        rows: other_rows, checked_at:, error: errors["other"]
      )
    }
  end

  # Build the normalized result hash from the captured check rows.
  def assess(pr_number:, required_used:, rows:, required_cancellations: [])
    rows = readiness_rows(rows, required_used:, required_cancellations:)
    failing = failing_names(rows)
    pending = pending_names(rows)

    {
      "pr" => pr_number.to_i,
      "verdict" => verdict_for(rows, failing, pending),
      "required_used" => required_used,
      "failing" => failing,
      "pending" => pending
    }
  end

  def text_summary(result)
    failing = result["failing"]
    pending = result["pending"]
    lines = [
      result["verdict"],
      "required_used: #{result['required_used']}",
      "failing: #{failing.empty? ? '(none)' : failing.join(', ')}",
      "pending: #{pending.empty? ? '(none)' : pending.join(', ')}"
    ]
    requested = result.fetch("requested_hosted", {})
    if requested_hosted_present?(requested)
      lines.concat([
                     "requested_hosted_pending: #{requested_names(requested, 'pending')}",
                     "requested_hosted_failing: #{requested_names(requested, 'failing')}",
                     "requested_hosted_stale: #{requested_names(requested, 'stale')}",
                     "requested_hosted_unknown: #{requested_unknown(requested)}"
                   ])
    end
    reviews = result.fetch("viewer_pending_review_drafts", [])
    lines << "viewer_pending_review_drafts: #{reviews.empty? ? '(none)' : reviews.map { |review| review['id'] }.join(', ')}" if result.key?("viewer_pending_review_drafts")
    inventory = result["viewer_review_inventory"]
    lines << "viewer_review_inventory: #{inventory['complete'] ? 'complete' : 'incomplete'} (scope: #{inventory['scope']})" if inventory
    lines.join("\n")
  end

  def requested_hosted_present?(requested)
    %w[run_ids pending failing stale unknown].any? { |bucket| requested.fetch(bucket, []).any? }
  end

  def requested_names(requested, bucket)
    rows = requested.fetch(bucket, [])
    return "(none)" if rows.empty?

    rows.map { |row| row.fetch("name", row.fetch("run_id", "unknown")).to_s }.join(", ")
  end

  def requested_unknown(requested)
    rows = requested.fetch("unknown", [])
    return "(none)" if rows.empty?

    rows.map { |row| "#{row.fetch('run_id', 'unknown')}: #{row.fetch('reason', 'unknown')}" }.join(", ")
  end

  USAGE = <<~USAGE
    Usage: pr-ci-readiness <pr-number> [options]

    Decide whether a PR's CI is ready to merge. Runs `gh pr checks <PR> --required`
    first; when no current required checks exist (no rows, or only cancelled rows),
    falls back to the full `gh pr checks <PR>` list. Required cancellations remain
    pending unless a current check with the same workflow and name supersedes them.
    Cancelled rows found only in the full advisory list are ignored. A truly empty
    required and full check list is UNKNOWN/not-ready. An unavailable check-query
    capability is also UNKNOWN and cannot be overridden by requested hosted runs.
    The PR is READY only when no failing or pending checks remain.
    Current-head PENDING review drafts visible to the current authenticated
    viewer also block readiness. The viewer-scoped inventory is paginated;
    complete means pagination completed only in that scope. Other reviewers'
    unsubmitted drafts are not observable or covered.

    Arguments:
      <pr-number>        PR number to inspect (integer).

    Options:
          --host HOST                         GitHub host. Defaults to GH_HOST, then github.com.
          --repo REPO                         GitHub repo in [HOST/]OWNER/REPO form. Defaults to gh repo view.
          --requested-hosted-run RUN_ID_OR_URL
                                              Require this explicit current-head hosted run to finish.
                                              Repeat for multiple maintainer-requested runs.
                                              With no usable required checks, requested runs replace
                                              the full advisory-list fallback gate.
          --json                              Print JSON (default).
          --text                              Print a human-readable verdict instead of JSON.
          --self-check                        Run parser checks plus a read-only gh smoke check.
      -h, --help                              Show this help.

    Output JSON shape:
      {
        "pr": 1234,
        "context": { "host": "github.com" },
        "verdict": "READY" | "NOT_READY" | "UNKNOWN",
        "required_used": true | false,
        "failing": [ "check name", ... ],
        "pending": [ "check name", ... ],
        "viewer_pending_review_drafts": [ { "id": "PRR_...", "commit_oid": "..." }, ... ],
        "viewer_review_inventory": {
          "scope": "authenticated_viewer",
          "complete": true | false,
          "pages": 1
        },
        "requested_hosted": {
          "run_ids": [ "1234567890", ... ],
          "pending": [ { "run_id": "1234567890", "name": "job", "url": "..." }, ... ],
          "failing": [ { "run_id": "1234567890", "name": "job", "url": "..." }, ... ],
          "stale": [ { "run_id": "1234567890", "head_sha": "old", "expected_head_sha": "new" }, ... ],
          "unknown": [ { "run_id": "1234567890", "reason": "..." }, ... ]
        }
      }

    verdict is UNKNOWN when neither check list supplies current rows or retained
    required cancellation evidence. required_used is true when current required
    rows were used directly; it remains false after full-list fallback even when a
    required cancellation remains blocking evidence.
    With --requested-hosted-run and no usable required checks, the requested
    current-head runs are the gate instead of the full advisory check list.

    Requires: gh (GitHub CLI)
  USAGE

  # gh-backed CLI: parses args, fetches the check rows, and prints the verdict.
  # All subprocess calls use array args (no shell).
  class Runner
    def run(argv)
      opts = parse_args(argv)
      if opts[:help]
        puts USAGE
        return 0
      end
      host = resolve_host!(opts[:host])
      @gh_env = { "GH_HOST" => host }
      return self_check if opts[:self_check]

      pr_number = validate_pr!(opts[:pr])
      repo = resolve_repo!(opts[:repo])
      result = assess(repo, pr_number, requested_hosted_runs: opts[:requested_hosted_runs])
      result["context"] = { "host" => host }
      print_result(result, opts[:format])
      0
    rescue Error => e
      warn "Error: #{e.message}"
      1
    end

    private

    def parse_args(argv)
      opts = {
        format: "json",
        help: false,
        self_check: false,
        pr: nil,
        repo: nil,
        host: nil,
        requested_hosted_runs: []
      }
      args = argv.dup
      until args.empty?
        arg = args.shift
        case arg
        when "--host" then opts[:host] = take_value!(args, "--host")
        when "--repo" then opts[:repo] = take_value!(args, "--repo")
        when "--requested-hosted-run" then opts[:requested_hosted_runs] << take_value!(args, "--requested-hosted-run")
        when "--json" then opts[:format] = "json"
        when "--text" then opts[:format] = "text"
        when "--self-check" then opts[:self_check] = true
        when "-h", "--help" then opts[:help] = true
        when "--" then nil
        else handle_positional(arg, opts)
        end
      end
      opts
    end

    def handle_positional(arg, opts)
      raise Error, "unknown option: #{arg}\n\n#{USAGE}" if arg.start_with?("-")
      raise Error, "unexpected extra argument: #{arg}" unless opts[:pr].nil?

      opts[:pr] = arg
    end

    def take_value!(args, flag)
      raise Error, "#{flag} requires a value" if args.empty?

      args.shift
    end

    def validate_pr!(pr_number)
      raise Error, "a positive integer PR number is required\n\n#{USAGE}" unless pr_number.to_s.match?(/\A[1-9]\d*\z/)

      pr_number
    end

    def resolve_host!(requested_host)
      raw_host =
        if requested_host.nil?
          ENV.key?("GH_HOST") ? ENV["GH_HOST"] : "github.com"
        else
          requested_host
        end
      host = raw_host.to_s.strip.downcase
      hostname = host
      port = nil
      if host.include?(":")
        hostname, _separator, port = host.rpartition(":")
      end
      labels = hostname.split(".", -1)
      valid_labels = labels.all? do |label|
        label.length <= 63 &&
          label.match?(/\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/)
      end
      valid_port = port.nil? || (port.match?(/\A[1-9]\d*\z/) && port.to_i <= 65_535)
      valid = !hostname.empty? && hostname.length <= 253 && valid_port && valid_labels
      raise Error, "invalid GitHub host: '#{raw_host}'" unless valid

      port == "443" ? hostname : host
    end

    # Strict [HOST/]OWNER/REPO: non-empty parts and no spaces.
    REPO_FORMAT = %r{\A[^/\s]+/[^/\s]+\z}

    def resolve_repo!(repo)
      repo ||= capture_required!("gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip
      parts = repo.split("/", -1)
      resolved_host = @gh_env.fetch("GH_HOST")
      host_qualified = parts.length == 3 &&
                       (parts.first.include?(".") || parts.first.include?(":") ||
                        parts.first.casecmp?(resolved_host))
      if host_qualified
        repo_host = resolve_host!(parts.shift)
        if repo_host != resolved_host
          raise Error, "repo host #{repo_host} conflicts with resolved GitHub host #{resolved_host}"
        end

        repo = parts.join("/")
      end
      unless parts.length == 2 && repo.match?(REPO_FORMAT)
        raise Error, "--repo must be in OWNER/REPO form (got: '#{repo}')"
      end

      repo
    end

    # Fetch the required-check list first; fall back to the full list when the
    # required form yields no current rows. required_used flips false on fallback.
    def assess(repo, pr_number, requested_hosted_runs:)
      checked_at = Time.now.utc.iso8601
      target_pr =
        begin
          fetch_target_pr_identity(repo, pr_number)
        rescue StandardError => e
          return unavailable_target_pr_result(repo, pr_number, checked_at, e)
        end
      exact_head_sha = target_pr.fetch(:head_sha)
      required_fetch = fetch_checks(repo, pr_number, required: true)
      required_raw = required_fetch.fetch(:raw)
      required_query_known = required_fetch.fetch(:known_good)
      full_query_known = nil
      required_rows = PrCiReadiness.parse_rows(required_raw)
      required_cancellations = required_rows.select { |row| row["bucket"].to_s == "cancel" }
      if PrCiReadiness.usable_checks?(required_raw)
        rows = required_rows
        required_used = true
        requested_hosted_only = false
      elsif requested_hosted_runs.any?
        rows = []
        required_used = false
        requested_hosted_only = true
        if required_cancellations.any?
          full_fetch = fetch_checks(repo, pr_number, required: false)
          full_rows = PrCiReadiness.parse_rows(full_fetch.fetch(:raw))
          full_query_known = full_fetch.fetch(:known_good)
          required_contexts = required_cancellations.map { |row| PrCiReadiness.check_identity(row) }
          rows = PrCiReadiness.active_rows(full_rows).select do |row|
            required_contexts.include?(PrCiReadiness.check_identity(row))
          end
        end
      else
        full_fetch = fetch_checks(repo, pr_number, required: false)
        rows = PrCiReadiness.parse_rows(full_fetch.fetch(:raw))
        full_query_known = full_fetch.fetch(:known_good)
        required_used = false
        requested_hosted_only = false
      end
      result =
        if requested_hosted_only && required_cancellations.empty?
          requested_hosted_base_result(pr_number)
        else
          PrCiReadiness.assess(pr_number:, required_used:, rows:, required_cancellations:)
        end
      query_evidence_known = required_query_known && full_query_known != false
      result["verdict"] = "UNKNOWN" if !query_evidence_known && result["verdict"] == "READY"
      result = apply_requested_hosted_runs(result, repo, pr_number, requested_hosted_runs)
      result = apply_viewer_review_inventory(result, repo, pr_number)
      required_evidence_rows =
        if required_used
          PrCiReadiness.readiness_rows(required_rows, required_used: true)
        else
          required_contexts = required_cancellations.map { |row| PrCiReadiness.check_identity(row) }
          matching_current_rows = PrCiReadiness.active_rows(rows).select do |row|
            required_contexts.include?(PrCiReadiness.check_identity(row))
          end
          PrCiReadiness.readiness_rows(
            matching_current_rows,
            required_used: false,
            required_cancellations:
          )
        end
      inventory = exact_head_inventory(repo, target_pr)
      target_identity_error =
        begin
          final_target_pr = fetch_target_pr_identity(repo, pr_number)
          unless same_target_pr_identity?(target_pr, final_target_pr)
            "target PR identity moved during exact-head inventory: " \
              "#{target_pr_identity_description(target_pr)} -> " \
              "#{target_pr_identity_description(final_target_pr)}"
          end
        rescue StandardError => e
          "target PR identity unavailable after exact-head inventory: #{e.message}"
        end
      if target_identity_error
        %w[required_status_check_rollup github_actions dependabot other].each do |scope|
          inventory[:errors][scope] =
            [inventory[:errors][scope], target_identity_error].compact.join("; ")
        end
        inventory[:required_complete] = false
        inventory[:actions_complete] = false
        inventory[:check_runs_complete] = false
        inventory[:statuses_complete] = false
      end
      scopes = PrCiReadiness.inventory_scopes(
        head_sha: exact_head_sha, checked_at:,
        required_rows: required_evidence_rows,
        required_complete: required_query_known && inventory.fetch(:required_complete),
        actions_rows: inventory.fetch(:actions_rows),
        actions_complete: inventory.fetch(:actions_complete),
        check_runs: inventory.fetch(:check_runs),
        check_runs_complete: inventory.fetch(:check_runs_complete),
        statuses: inventory.fetch(:statuses),
        statuses_complete: inventory.fetch(:statuses_complete),
        errors: inventory.fetch(:errors)
      )
      contract = PrCiReadiness.evidence_contract(
        repo:, pr_number:, head_sha: exact_head_sha, checked_at:, scopes:
      )
      ordinary_verdict = result.fetch("verdict")
      overall_verdict =
        if ordinary_verdict == "NOT_READY" || contract.fetch("verdict") == "NOT_READY"
          "NOT_READY"
        elsif ordinary_verdict == "UNKNOWN" || contract.fetch("verdict") == "UNKNOWN"
          "UNKNOWN"
        else
          "READY"
        end
      contract.merge(result).merge(
        "verdict" => overall_verdict,
        "ordinary_verdict" => ordinary_verdict,
        "scopes" => scopes
      )
    end

    def unavailable_target_pr_result(repo, pr_number, checked_at, error)
      head_sha = "UNKNOWN"
      message = "target PR identity unavailable before exact-head inventory: #{error.message}"
      errors = %w[
        required_status_check_rollup github_actions dependabot other
      ].to_h { |scope| [scope, message] }
      scopes = PrCiReadiness.inventory_scopes(
        head_sha:, checked_at:,
        required_rows: [], required_complete: false,
        actions_rows: [], actions_complete: false,
        check_runs: [], check_runs_complete: false,
        statuses: [], statuses_complete: false,
        errors:
      )
      ordinary = PrCiReadiness.assess(
        pr_number:, required_used: false, rows: [], required_cancellations: []
      )
      contract = PrCiReadiness.evidence_contract(
        repo:, pr_number:, head_sha:, checked_at:, scopes:
      )
      contract.merge(ordinary).merge(
        "verdict" => "UNKNOWN",
        "ordinary_verdict" => "UNKNOWN",
        "scopes" => scopes
      )
    end

    def exact_head_inventory(repo, target_pr)
      head_sha = target_pr.fetch(:head_sha)
      errors = {}
      actions_rows, actions_complete, actions_error = fetch_exact_head_actions(repo, target_pr)
      errors["github_actions"] = actions_error if actions_error
      errors["dependabot"] = actions_error if actions_error

      check_runs, check_runs_complete, check_runs_error = fetch_exact_head_check_runs(repo, head_sha)
      if check_runs_error
        errors["github_actions"] = [errors["github_actions"], check_runs_error].compact.join("; ")
        errors["dependabot"] = [errors["dependabot"], check_runs_error].compact.join("; ")
        errors["other"] = check_runs_error
      end
      actions_rows += check_runs.select do |row|
        row["app_slug"] == "github-actions" || row["dependabot"] == true
      end

      statuses, statuses_complete, statuses_error = fetch_exact_head_statuses(repo, head_sha)
      errors["other"] = [errors["other"], statuses_error].compact.join("; ") if statuses_error

      {
        actions_rows:, actions_complete:, check_runs:, check_runs_complete:,
        statuses:, statuses_complete:, errors:,
        required_complete: true
      }
    end

    def fetch_exact_head_actions(repo, target_pr)
      head_sha = target_pr.fetch(:head_sha)
      runs = fetch_paginated_collection(
        "repos/#{repo}/actions/runs?head_sha=#{head_sha}&per_page=100&page=%<page>s",
        "workflow_runs"
      )
      runs.each { |run| validate_actions_run_identity!(run, head_sha) }
      runs.select! { |run| actions_run_targets_pr?(run, target_pr) }
      rows = []
      current_runs = runs.group_by { |run| [run["workflow_id"], run["event"]] }
      current_runs = current_runs.values.map do |group|
        group.max_by { |run| [run["run_number"], run["run_attempt"], run["id"]] }
      end
      current_runs.sort_by! { |run| [run["workflow_id"], run["event"]] }
      current_runs.each do |run|
        dependabot = dependabot_attributed?(run)
        rows << normalize_actions_row(run, "run", dependabot:)
        fetch_actions_jobs(repo, run.fetch("id")).each do |job|
          rows << normalize_actions_row(job, "job", dependabot:, head_sha:)
        end
      end
      [rows, true, nil]
    rescue StandardError => e
      [[], false, "exact-head Actions inventory failed: #{e.message}"]
    end

    def fetch_exact_head_check_runs(repo, head_sha)
      rows = fetch_paginated_collection(
        "repos/#{repo}/commits/#{head_sha}/check-runs?per_page=100&page=%<page>s",
        "check_runs"
      ).map do |row|
        ensure_exact_head!(row, head_sha, "check run")
        {
          "kind" => "check_run",
          "id" => row["id"],
          "name" => row["name"].to_s,
          "status" => row["status"].to_s,
          "conclusion" => row["conclusion"],
          "url" => row["html_url"].to_s,
          "head_sha" => head_sha,
          "app_slug" => row.dig("app", "slug").to_s,
          "dependabot" => dependabot_attributed?(row)
        }
      end
      [rows, true, nil]
    rescue StandardError => e
      [[], false, "exact-head check-run inventory failed: #{e.message}"]
    end

    # Commit statuses are read from the combined status endpoint
    # (`/commits/{ref}/status`), not the status-history list endpoint
    # (`/commits/{ref}/statuses`). The list endpoint's rows carry no commit
    # SHA at all, so exact-head identity cannot be asserted per row. The
    # combined endpoint echoes the resolved commit as a top-level `sha`, which
    # is an independent confirmation from GitHub that the statuses returned
    # belong to the exact head we asked about -- a missing or mismatched `sha`
    # fails closed. The combined endpoint also returns only the most recent
    # status per context, matching the current-context scope the history-list
    # dedupe previously approximated. Duplicate case-insensitive contexts now
    # fail closed because they indicate an unstable or malformed inventory.
    # Status rows normally omit `sha`; if a server does include one, it must
    # agree with the exact-head envelope rather than introduce a contradiction.
    def fetch_exact_head_statuses(repo, head_sha)
      combined_state = nil
      bind_head = lambda do |payload|
        ensure_exact_head!(payload, head_sha, "combined commit status", sha_key: "sha")
        page_state = payload["state"]
        unless %w[failure pending success].include?(page_state)
          raise Error, "combined commit status response had invalid state #{page_state.inspect}"
        end

        combined_state ||= page_state
        unless page_state == combined_state
          raise Error,
                "combined commit status state changed during pagination: " \
                "expected #{combined_state}, found #{page_state}"
        end
      end
      status_rows = fetch_paginated_collection(
        "repos/#{repo}/commits/#{head_sha}/status?per_page=100&page=%<page>s",
        "statuses",
        validate_page: bind_head
      )
      states = status_rows.map { |row| row["state"] }
      unless states.all? { |state| %w[error failure pending success].include?(state) }
        raise Error, "combined commit status response had an invalid status state"
      end

      expected_combined_state =
        if states.any? { |state| %w[error failure].include?(state) }
          "failure"
        elsif states.empty? || states.include?("pending")
          "pending"
        else
          "success"
        end
      unless combined_state == expected_combined_state
        raise Error,
              "combined commit status state was inconsistent with its statuses: " \
              "expected #{expected_combined_state}, found #{combined_state}"
      end

      seen_contexts = {}
      rows = status_rows.map do |row|
        context = row["context"]
        unless context.is_a?(String) && !context.empty?
          raise Error, "combined commit status response had an invalid context"
        end

        if row.key?("sha") && row["sha"].to_s != head_sha
          actual = row["sha"].to_s
          raise Error,
                "status context contradicted exact head #{head_sha} " \
                "(found #{actual.empty? ? 'missing' : actual})"
        end

        # GitHub's commit-status API defines context identity as case-insensitive.
        context_identity = context.downcase
        if seen_contexts.key?(context_identity)
          raise Error,
                "combined commit status response repeated case-insensitive context " \
                "#{context.inspect} (first seen as #{seen_contexts.fetch(context_identity).inspect})"
        end
        seen_contexts[context_identity] = context

        {
          "kind" => "status",
          "id" => row["id"],
          "name" => context,
          "state" => row["state"].to_s,
          "url" => row["target_url"].to_s,
          "head_sha" => head_sha
        }
      end
      [rows, true, nil]
    rescue StandardError => e
      [[], false, "exact-head status-context inventory failed: #{e.message}"]
    end

    # `validate_page` runs against every raw page payload before its rows are
    # trusted, so envelope-level identity (such as the combined status
    # endpoint's top-level `sha`) is asserted on each page, not just the first.
    def fetch_paginated_collection(endpoint_template, key, validate_page: nil)
      page = 1
      rows = []
      expected_total = nil
      loop do
        payload = capture_json!("gh", "api", format(endpoint_template, page:))
        raise Error, "#{key} response was not an object" unless payload.is_a?(Hash)

        validate_page&.call(payload)
        page_rows = payload.fetch(key)
        raise Error, "#{key} response was not an array" unless page_rows.is_a?(Array)

        page_total = payload["total_count"]
        unless page_total.is_a?(Integer) && page_total >= 0
          raise Error, "#{key} response lacked a valid total_count"
        end

        expected_total ||= page_total
        raise Error, "#{key} total_count changed during pagination" unless page_total == expected_total

        rows.concat(page_rows)
        break if page_rows.length < 100

        page += 1
      end
      unless rows.length == expected_total
        raise Error, "#{key} pagination was incomplete: expected #{expected_total}, received #{rows.length}"
      end

      rows
    end

    def validate_actions_run_identity!(run, head_sha)
      raise Error, "Actions run was not an object" unless run.is_a?(Hash)

      %w[id workflow_id run_number run_attempt].each do |field|
        value = run[field]
        unless value.is_a?(Integer) && value.positive?
          raise Error, "Actions run #{field} was not a positive integer"
        end
      end
      event = run["event"]
      unless event.is_a?(String) && !event.strip.empty?
        raise Error, "Actions run event was not a nonblank string"
      end

      head_branch = run["head_branch"]
      unless head_branch.is_a?(String) && !head_branch.strip.empty?
        raise Error, "Actions run head_branch was not a nonblank string"
      end

      head_repository = run["head_repository"]
      unless head_repository.is_a?(Hash)
        raise Error, "Actions run head_repository was not an object"
      end

      head_repository_id = head_repository["id"]
      unless head_repository_id.is_a?(Integer) && head_repository_id.positive?
        raise Error, "Actions run head_repository id was not a positive integer"
      end
      unless run["pull_requests"].is_a?(Array)
        raise Error, "Actions run pull_requests was not an array"
      end

      run["pull_requests"].each { |association| validate_actions_pull_request_association!(association) }

      ensure_exact_head!(run, head_sha, "Actions run")
    end

    def validate_actions_pull_request_association!(association)
      unless association.is_a?(Hash)
        raise Error, "Actions run pull request association was not an object"
      end

      %w[id number].each do |field|
        value = association[field]
        unless value.is_a?(Integer) && value.positive?
          raise Error, "Actions run pull request #{field} was not a positive integer"
        end
      end
      url = association["url"]
      unless url.is_a?(String) && !url.strip.empty?
        raise Error, "Actions run pull request URL was not a nonblank string"
      end

      head = association["head"]
      unless head.is_a?(Hash)
        raise Error, "Actions run pull request head was not an object"
      end

      unless full_sha?(head["sha"])
        raise Error, "Actions run pull request head SHA was not a full hexadecimal commit SHA"
      end

      head_ref = head["ref"]
      unless head_ref.is_a?(String) && !head_ref.strip.empty?
        raise Error, "Actions run pull request head ref was not a nonblank string"
      end

      head_repo = head["repo"]
      unless head_repo.is_a?(Hash)
        raise Error, "Actions run pull request head repo was not an object"
      end

      head_repo_id = head_repo["id"]
      raise Error, "Actions run pull request head repo id was not a positive integer" unless
        head_repo_id.is_a?(Integer) && head_repo_id.positive?
    end

    def actions_run_targets_pr?(run, target_pr)
      associations = run["pull_requests"]
      if associations.empty?
        return run["head_branch"] == target_pr.fetch(:head_ref) &&
               run.dig("head_repository", "id") == target_pr.fetch(:head_repo_id)
      end

      targets_pr = false
      associations.each do |association|
        id_matches = association["id"] == target_pr.fetch(:id)
        number_matches = association["number"] == target_pr.fetch(:number)
        if id_matches != number_matches
          raise Error, "Actions run pull request association contradicted the target PR identity"
        end
        next unless id_matches

        head_matches =
          association.dig("head", "sha") == target_pr.fetch(:head_sha) &&
          association.dig("head", "ref") == target_pr.fetch(:head_ref) &&
          association.dig("head", "repo", "id") == target_pr.fetch(:head_repo_id)
        unless head_matches
          raise Error, "Actions run pull request association contradicted the target PR head identity"
        end

        targets_pr = true
      end
      targets_pr
    end

    def full_sha?(value)
      value.is_a?(String) && value.match?(/\A[0-9a-f]{40}\z/i)
    end

    def ensure_exact_head!(row, head_sha, context, sha_key: "head_sha")
      actual = row[sha_key].to_s
      return if actual == head_sha

      raise Error, "#{context} was not bound to exact head #{head_sha} (found #{actual.empty? ? 'missing' : actual})"
    end

    def normalize_actions_row(row, kind, dependabot:, head_sha: nil)
      {
        "kind" => kind,
        "id" => row["id"],
        "name" => row["name"].to_s,
        "status" => row["status"].to_s,
        "conclusion" => row["conclusion"],
        "url" => row["html_url"].to_s,
        "head_sha" => head_sha || row["head_sha"].to_s,
        "actor" => row.dig("actor", "login").to_s,
        "triggering_actor" => row.dig("triggering_actor", "login").to_s,
        "dependabot" => dependabot
      }
    end

    def dependabot_attributed?(row)
      candidates = [
        row.dig("actor", "login"),
        row.dig("triggering_actor", "login"),
        row.dig("check_suite", "creator", "login"),
        row.dig("app", "slug"),
        row.dig("check_suite", "head_branch")
      ].compact.map(&:to_s)
      candidates.any? do |value|
        value.casecmp?("dependabot") || value.casecmp?("dependabot[bot]") ||
          value.start_with?("dependabot/")
      end
    end

    # `gh pr checks` exits non-zero for ordinary failing/pending checks and when
    # no checks exist. JSON output and the established no-checks diagnostic are
    # therefore known-good; other command/query failures remain distinguishable.
    def fetch_checks(repo, pr_number, required:)
      cmd = ["gh", "pr", "checks", pr_number.to_s, "--repo", repo]
      cmd << "--required" if required
      cmd += ["--json", "name,state,bucket,link,workflow"]
      out, err, status = Open3.capture3(@gh_env, *cmd)
      raw = out.to_s.force_encoding("UTF-8")
      known_good = PrCiReadiness.json_array_payload?(raw) ||
                   status.success? && raw.strip.empty? || no_checks_diagnostic?(err)
      { raw:, known_good: }
    end

    def no_checks_diagnostic?(stderr)
      replacement_occurred = false
      normalized = stderr.to_s.dup.force_encoding(Encoding::UTF_8).scrub do
        replacement_occurred = true
        "\uFFFD"
      end
      return false if replacement_occurred

      normalized.match?(/\Ano (?:required )?checks reported on the '[^\r\n]+' branch(?:\r?\n)?\z/)
    end

    def apply_requested_hosted_runs(result, repo, pr_number, requested_hosted_runs)
      result["requested_hosted"] = empty_requested_hosted
      return result if requested_hosted_runs.empty?

      requested = requested_hosted_summary(repo, pr_number, requested_hosted_runs)
      result["requested_hosted"] = requested
      if requested["pending"].any? || requested["failing"].any?
        result["verdict"] = "NOT_READY"
      elsif result["verdict"] == "READY" && (requested["stale"].any? || requested["unknown"].any?)
        result["verdict"] = "UNKNOWN"
      end
      result
    end

    def empty_requested_hosted
      {
        "run_ids" => [],
        "pending" => [],
        "failing" => [],
        "stale" => [],
        "unknown" => []
      }
    end

    def requested_hosted_base_result(pr_number)
      {
        "pr" => pr_number.to_i,
        "verdict" => "READY",
        "required_used" => false,
        "failing" => [],
        "pending" => []
      }
    end

    def apply_viewer_review_inventory(result, repo, pr_number)
      inventory = viewer_pending_review_draft_inventory(repo, pr_number)
      result["viewer_pending_review_drafts"] = inventory.fetch("viewer_pending_review_drafts")
      result["viewer_review_inventory"] = inventory.reject { |key, _value| key == "viewer_pending_review_drafts" }
      if inventory.fetch("viewer_pending_review_drafts").any?
        result["verdict"] = "NOT_READY"
      elsif !inventory.fetch("complete") && result["verdict"] == "READY"
        result["verdict"] = "UNKNOWN"
      end
      result
    end

    REVIEW_DRAFTS_QUERY = <<~GRAPHQL
      query($owner:String!, $name:String!, $pr:Int!, $endCursor:String) {
        repository(owner:$owner, name:$name) {
          pullRequest(number:$pr) {
            reviews(first:100, after:$endCursor) {
              nodes { id state submittedAt commit { oid } }
              pageInfo { hasNextPage endCursor }
            }
          }
        }
      }
    GRAPHQL

    def viewer_pending_review_draft_inventory(repo, pr_number)
      owner, name = repo.split("/", 2)
      expected_head_sha = fetch_pr_head_oid(repo, pr_number)
      viewer_pending_review_drafts = []
      cursor = nil
      pages = 0

      loop do
        reviews = fetch_reviews_page(owner, name, pr_number, cursor)
        nodes = reviews.fetch("nodes")
        page_info = reviews.fetch("pageInfo")
        raise Error, "review inventory returned non-array nodes" unless nodes.is_a?(Array)
        raise Error, "review inventory returned incomplete page info" unless page_info.is_a?(Hash)

        pending_reviews = nodes.select do |review|
          review["state"] == "PENDING" && review["submittedAt"].nil? &&
            review.dig("commit", "oid") == expected_head_sha
        end
        viewer_pending_review_drafts.concat(pending_reviews.map do |review|
          { "id" => review.fetch("id"), "commit_oid" => expected_head_sha }
        end)
        pages += 1
        break unless page_info["hasNextPage"]

        cursor = page_info["endCursor"]
        raise Error, "review inventory pagination cursor was missing" if cursor.to_s.empty?
      end

      { "scope" => "authenticated_viewer", "complete" => true, "pages" => pages,
        "viewer_pending_review_drafts" => viewer_pending_review_drafts }
    rescue StandardError => e
      { "scope" => "authenticated_viewer", "complete" => false, "pages" => pages || 0,
        "viewer_pending_review_drafts" => viewer_pending_review_drafts || [], "error" => e.message }
    end

    def fetch_reviews_page(owner, name, pr_number, cursor)
      cmd = ["gh", "api", "graphql", "-f", "owner=#{owner}", "-f", "name=#{name}", "-F", "pr=#{pr_number}"]
      cmd += ["-f", "endCursor=#{cursor}"] unless cursor.nil?
      cmd += ["-f", "query=#{REVIEW_DRAFTS_QUERY}"]
      data = capture_json!(*cmd)
      data.dig("data", "repository", "pullRequest", "reviews") ||
        raise(Error, "review inventory response was incomplete")
    end

    def requested_hosted_summary(repo, pr_number, requested_hosted_runs)
      expected_head_sha = fetch_pr_head_oid(repo, pr_number)
      requested_hosted_runs.each_with_object(empty_requested_hosted) do |input, summary|
        run_id = requested_hosted_run_id(input)
        summary["run_ids"] << run_id
        run = fetch_actions_run(repo, run_id)
        classify_requested_run(summary, repo, run_id, run, expected_head_sha)
      rescue Error => e
        summary["unknown"] << { "run_id" => run_id || input.to_s, "reason" => e.message }
      end
    end

    def requested_hosted_run_id(input)
      value = input.to_s.strip
      run_id = value[%r{/actions/runs/(\d+)}, 1] || value[/\A\d+\z/]
      raise Error, "requested hosted run must be a run id or Actions run URL (got: '#{input}')" if run_id.nil?

      run_id
    end

    def classify_requested_run(summary, repo, run_id, run, expected_head_sha)
      actual_head_sha = run.fetch("head_sha", "").to_s
      if actual_head_sha.empty? || actual_head_sha != expected_head_sha
        summary["stale"] << run_record(run_id, run).merge(
          "head_sha" => actual_head_sha,
          "expected_head_sha" => expected_head_sha
        )
        return
      end

      classify_status_row(summary, "run", run_id, run_record(run_id, run))
      return if run.fetch("status", "").to_s == "completed" && successful_conclusion?(run.fetch("conclusion", "").to_s)

      fetch_actions_jobs(repo, run_id).each do |job|
        classify_status_row(summary, "job", run_id, run_record(run_id, job))
      end
    end

    def classify_status_row(summary, kind, run_id, row)
      status = row["status"].to_s
      conclusion = row["conclusion"].to_s
      record = row.merge("kind" => kind, "run_id" => run_id)
      if status != "completed"
        summary["pending"] << record
      elsif successful_conclusion?(conclusion)
        nil
      else
        summary["failing"] << record
      end
    end

    def successful_conclusion?(conclusion)
      %w[success neutral skipped].include?(conclusion)
    end

    def run_record(run_id, payload)
      {
        "run_id" => run_id,
        "name" => payload["name"].to_s.empty? ? "run #{run_id}" : payload["name"].to_s,
        "status" => payload["status"].to_s,
        "conclusion" => payload["conclusion"],
        "url" => payload["html_url"].to_s
      }
    end

    def fetch_pr_head_oid(repo, pr_number)
      data = capture_json!("gh", "pr", "view", pr_number.to_s, "--repo", repo, "--json", "headRefOid")
      head = data.fetch("headRefOid", "").to_s
      raise Error, "could not resolve PR headRefOid for ##{pr_number}" if head.empty?

      head
    end

    def fetch_target_pr_identity(repo, pr_number)
      data = capture_json!("gh", "api", "repos/#{repo}/pulls/#{pr_number}")
      raise Error, "target PR response was not an object" unless data.is_a?(Hash)

      id = data["id"]
      raise Error, "target PR id was not a positive integer" unless id.is_a?(Integer) && id.positive?

      number = data["number"]
      unless number.is_a?(Integer) && number.positive? && number == pr_number.to_i
        raise Error, "target PR number did not exactly match ##{pr_number}"
      end

      head = data["head"]
      raise Error, "target PR head was not an object" unless head.is_a?(Hash)

      head_sha = head["sha"]
      unless full_sha?(head_sha)
        raise Error, "target PR head SHA was not a full hexadecimal commit SHA"
      end

      head_ref = head["ref"]
      unless head_ref.is_a?(String) && !head_ref.strip.empty?
        raise Error, "target PR head ref was not a nonblank string"
      end

      head_repo = head["repo"]
      raise Error, "target PR head repo was not an object" unless head_repo.is_a?(Hash)

      head_repo_id = head_repo["id"]
      unless head_repo_id.is_a?(Integer) && head_repo_id.positive?
        raise Error, "target PR head repo id was not a positive integer"
      end

      {
        id:, number:, head_sha:, head_ref:, head_repo_id:,
        head_repo_full_name: head_repo["full_name"].to_s
      }
    end

    def same_target_pr_identity?(left, right)
      keys = %i[id number head_sha head_ref head_repo_id]
      left.values_at(*keys) == right.values_at(*keys)
    end

    def target_pr_identity_description(identity)
      repo_name = identity.fetch(:head_repo_full_name)
      repo_name = "unknown" if repo_name.empty?
      "id=#{identity.fetch(:id)} number=##{identity.fetch(:number)} " \
        "head=#{identity.fetch(:head_sha)} ref=#{identity.fetch(:head_ref)} " \
        "head_repo_id=#{identity.fetch(:head_repo_id)} head_repo=#{repo_name}"
    end

    def fetch_actions_run(repo, run_id)
      capture_json!("gh", "api", "repos/#{repo}/actions/runs/#{run_id}")
    end

    def fetch_actions_jobs(repo, run_id)
      per_page = 100
      jobs = []
      page = 1
      expected_total = nil
      loop do
        data = capture_json!("gh", "api", "repos/#{repo}/actions/runs/#{run_id}/jobs?per_page=#{per_page}&page=#{page}")
        page_jobs = data.fetch("jobs", [])
        page_total = data["total_count"]
        unless page_jobs.is_a?(Array) && page_total.is_a?(Integer) && page_total >= 0
          raise Error, "Actions jobs response was incomplete"
        end

        expected_total ||= page_total
        raise Error, "Actions jobs total_count changed during pagination" unless page_total == expected_total

        jobs.concat(page_jobs)
        break if page_jobs.length < per_page

        page += 1
      end
      unless jobs.length == expected_total
        raise Error, "Actions jobs pagination was incomplete: expected #{expected_total}, received #{jobs.length}"
      end

      jobs
    end

    def capture_json!(*cmd)
      raw = capture_required!(*cmd)
      JSON.parse(raw)
    rescue JSON::ParserError => e
      raise Error, "command returned invalid JSON: #{cmd.first(3).join(' ')} (#{e.message})"
    end

    # Run a command with no shell (array args) and return UTF-8 stdout, raising
    # when the command fails. Used only for commands whose exit status matters.
    def capture_required!(*cmd)
      out, status = Open3.capture2(@gh_env, *cmd)
      raise Error, "command failed: #{cmd.first(3).join(' ')}" unless status.success?

      out.force_encoding("UTF-8")
    end

    def print_result(result, format)
      if format == "text"
        puts PrCiReadiness.text_summary(result)
      else
        puts JSON.pretty_generate(result)
      end
    end

    def self_check
      errors = self_check_errors
      unless errors.empty?
        warn "self-check failed: #{errors.join('; ')}"
        return 1
      end
      puts "verdict parser: ok"
      puts gh_smoke
      puts "self-check passed"
      0
    end

    # Exercise the pure verdict logic against canned check arrays.
    def self_check_errors
      [
        check_all_passing,
        check_failing,
        check_required_cancellation,
        check_cancel_only,
        check_empty,
        check_parse_helpers
      ].flatten
    end

    def check_all_passing
      out = PrCiReadiness.assess(pr_number: 1, required_used: true, rows: [
                                   { "name" => "rspec", "bucket" => "pass" },
                                   { "name" => "examples", "bucket" => "skipping" }
                                 ])
      ok = out["verdict"] == "READY" && out["required_used"] == true &&
           out["failing"].empty? && out["pending"].empty?
      ok ? [] : ["all-passing did not yield READY"]
    end

    def check_failing
      out = PrCiReadiness.assess(pr_number: 1, required_used: false, rows: [
                                   { "name" => "rspec", "bucket" => "pass" },
                                   { "name" => "lint", "bucket" => "fail" },
                                   { "name" => "stale", "bucket" => "cancel" }
                                 ])
      ok = out["verdict"] == "NOT_READY" && out["failing"] == ["lint"] && out["pending"].empty?
      ok ? [] : ["failing did not yield NOT_READY (lint)"]
    end

    def check_required_cancellation
      out = PrCiReadiness.assess(pr_number: 1, required_used: true, rows: [
                                   { "workflow" => "CI", "name" => "unit", "bucket" => "pass" },
                                   { "workflow" => "Security", "name" => "security", "bucket" => "cancel" }
                                 ])
      ok = out["verdict"] == "NOT_READY" && out["pending"] == ["security"]
      ok ? [] : ["distinct required cancellation did not yield NOT_READY (security)"]
    end

    def check_cancel_only
      out = PrCiReadiness.assess(pr_number: 1, required_used: false,
                                 rows: [{ "name" => "stale", "bucket" => "cancel" }])
      out["verdict"] == "UNKNOWN" ? [] : ["cancel-only did not yield UNKNOWN"]
    end

    def check_empty
      out = PrCiReadiness.assess(pr_number: 1, required_used: false, rows: [])
      out["verdict"] == "UNKNOWN" ? [] : ["empty did not yield UNKNOWN"]
    end

    def check_parse_helpers
      errors = []
      active = PrCiReadiness.usable_checks?('[{"name":"a","bucket":"pass"}]')
      errors << "usable_checks? missed an active array" unless active
      errors << "usable_checks? treated [] as usable" if PrCiReadiness.usable_checks?("[]")
      errors << "usable_checks? treated blank as usable" if PrCiReadiness.usable_checks?("")
      errors << "usable_checks? treated non-JSON as usable" if PrCiReadiness.usable_checks?("no required checks")
      if PrCiReadiness.usable_checks?('[{"name":"stale","bucket":"cancel"}]')
        errors << "usable_checks? treated cancel-only as usable"
      end
      errors
    end

    def gh_smoke
      return "gh smoke: skipped (gh not installed)" unless system("command -v gh > /dev/null 2>&1")

      repo, status = Open3.capture2(
        @gh_env,
        "gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"
      )
      return "gh smoke: skipped (gh not authenticated)" unless status.success? && !repo.strip.empty?

      "gh smoke: ok for #{repo.strip}"
    end
  end
end

exit(PrCiReadiness::Runner.new.run(ARGV)) if $PROGRAM_NAME == __FILE__
