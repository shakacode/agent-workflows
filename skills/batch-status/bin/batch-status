#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require "tempfile"
require "time"

require_relative "../../pr-batch/lib/help_request_lifecycle"

UNKNOWN = "UNKNOWN"
DEFAULT_TIMEOUT_SECONDS = 20

def present_string(value)
  value.is_a?(String) && !value.strip.empty? ? value.strip : nil
end

def valid_repo?(value)
  value.is_a?(String) && value.match?(%r{\A[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\z})
end

def parse_batch_target(value)
  match = value.to_s.match(/\A(?:(pr|issue):)?([1-9][0-9]*)\z/)
  return unless match

  {
    number: Integer(match[2]),
    requested_kind: match[1],
    coordination_target: value.to_s
  }
end

def runner_for(record)
  host = present_string(record["host"])&.downcase
  source = present_string(record["session_source"])
  host_runner = if host == "codex"
                  "Codex"
                elsif host == "claude" || host == "claude-code" || host&.start_with?("claude-code/")
                  "Claude"
                end
  source_runner = "Codex" if source == "codex_thread_id"
  return UNKNOWN if host_runner && source_runner && host_runner != source_runner

  host_runner || source_runner || UNKNOWN
end

def codex_deep_link(record, runner)
  return UNKNOWN unless runner == "Codex"
  return UNKNOWN unless present_string(record["machine_id"])
  return UNKNOWN unless record["session_source"] == "codex_thread_id"

  thread_id = present_string(record["session_id"])
  return UNKNOWN unless thread_id&.match?(/\A[0-9A-Za-z-]+\z/)

  "codex://threads/#{thread_id}"
end

def bounded_helper
  candidates = []
  configured_skill_dir = present_string(ENV["PR_BATCH_SKILL_DIR"])
  candidates << File.join(configured_skill_dir, "bin", "agent-coord-bounded") if configured_skill_dir
  candidates << File.expand_path("../../pr-batch/bin/agent-coord-bounded", __dir__)
  candidates.find { |path| File.file?(path) && File.executable?(path) }
end

def wait_for_child(pid, deadline)
  loop do
    waited = Process.waitpid2(pid, Process::WNOHANG)
    return waited[1] if waited
    return nil if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.01
  end
rescue Errno::ECHILD
  nil
end

def process_group_alive?(pid)
  Process.kill(0, -pid)
  true
rescue Errno::ESRCH
  false
rescue Errno::EPERM
  true
end

def signal_process_group(pid, signal)
  Process.kill(signal, -pid)
rescue Errno::ESRCH
  nil
end

def wait_for_process_group_exit(pid, deadline)
  loop do
    return true unless process_group_alive?(pid)
    return false if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.01
  end
end

def terminate_process_group(pid)
  signal_process_group(pid, "TERM")
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 1
  wait_for_child(pid, deadline)
  return if wait_for_process_group_exit(pid, deadline)

  signal_process_group(pid, "KILL")
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 1
  wait_for_child(pid, deadline)
  wait_for_process_group_exit(pid, deadline)
end

def run_json(*argv, timeout: nil)
  stdout_file = Tempfile.new("batch-status-stdout")
  stderr_file = Tempfile.new("batch-status-stderr")
  pid = Process.spawn(*argv, out: stdout_file.path, err: stderr_file.path, pgroup: true)
  status = if timeout
             wait_for_child(pid, Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout)
           else
             Process.waitpid2(pid)[1]
           end
  if timeout && status.nil?
    terminate_process_group(pid)
    return [nil, "command timed out after #{timeout}s"]
  end

  stdout_file.rewind
  stderr_file.rewind
  stdout = stdout_file.read
  stderr = stderr_file.read
  return [JSON.parse(stdout), nil] if status.success?

  [nil, stderr.strip.empty? ? "command exited #{status.exitstatus}" : stderr.strip]
rescue JSON::ParserError => e
  [nil, "invalid JSON: #{e.message}"]
rescue SystemCallError => e
  [nil, e.message]
ensure
  stdout_file&.close!
  stderr_file&.close!
end

def help_request_lifecycle(batch_payload, now:, max_open_seconds:, lane: nil)
  unless batch_payload.is_a?(Hash) && batch_payload["events"].is_a?(Array)
    return { "status" => UNKNOWN, "error" => "batch event history unavailable" }
  end

  event_note = batch_payload["section_notes"].is_a?(Hash) && present_string(batch_payload["section_notes"]["events"])
  return { "status" => UNKNOWN, "error" => event_note } if event_note

  HelpRequestLifecycle.evaluate(
    { "events" => batch_payload.fetch("events") },
    now: now,
    max_open_seconds: max_open_seconds,
    lane: lane
  )
rescue HelpRequestLifecycle::InputError => e
  { "status" => UNKNOWN, "error" => e.message }
end

options = {
  batch_ids: [],
  prs: [],
  issues: [],
  targets: [],
  timeout: DEFAULT_TIMEOUT_SECONDS,
  now: Time.now.utc,
  help_request_max_open_seconds: HelpRequestLifecycle::DEFAULT_MAX_OPEN_SECONDS
}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: batch-status [--batch-id ID] [--repo OWNER/REPO] [--pr N | --issue N | --target OWNER/REPO#N] [--json]"
  opts.on("--batch-id ID", "Inspect a registered batch (repeatable)") { |value| options[:batch_ids] << value }
  opts.on("--repo OWNER/REPO", "Repository for --pr and --issue") { |value| options[:repo] = value }
  opts.on("--pr NUMBER", Integer, "Inspect a pull request number") { |value| options[:prs] << value }
  opts.on("--issue NUMBER", Integer, "Inspect an issue number") { |value| options[:issues] << value }
  opts.on("--target REF", "Inspect OWNER/REPO#N and detect PR versus issue") { |value| options[:targets] << value }
  opts.on("--timeout SECONDS", Float, "External probe deadline") { |value| options[:timeout] = value }
  opts.on("--now ISO8601", "Evaluation time for deterministic help-request age") do |value|
    options[:now] = Time.iso8601(value)
  end
  opts.on("--help-request-max-open-seconds N", Integer, "Age that requires blocked-user-input closeout") do |value|
    options[:help_request_max_open_seconds] = value
  end
  opts.on("--json", "Emit machine-readable JSON") { options[:json] = true }
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit 0
  end
end

begin
  parser.parse!(ARGV)
rescue OptionParser::ParseError, ArgumentError => e
  warn e.message
  warn parser
  exit 64
end

unless ARGV.empty?
  warn "unexpected arguments: #{ARGV.join(' ')}"
  warn parser
  exit 64
end

unless options[:timeout].positive? && options[:timeout].finite?
  warn "--timeout must be a positive finite number"
  exit 64
end

unless options[:help_request_max_open_seconds].positive?
  warn "--help-request-max-open-seconds must be a positive integer"
  exit 64
end

if (!options[:prs].empty? || !options[:issues].empty?) && options[:repo].to_s.empty?
  warn "--repo is required with --pr or --issue"
  exit 64
end

if options[:repo] && !valid_repo?(options[:repo])
  warn "invalid repository #{options[:repo].inspect}; expected OWNER/REPO"
  exit 64
end

unless (options[:prs] + options[:issues]).all?(&:positive?)
  warn "PR and issue numbers must be positive"
  exit 64
end

requests = []
options[:prs].each { |number| requests << { repo: options[:repo], number:, requested_kind: "pr" } }
options[:issues].each { |number| requests << { repo: options[:repo], number:, requested_kind: "issue" } }
options[:targets].each do |ref|
  match = ref.match(%r{\A([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([1-9][0-9]*)\z})
  unless match
    warn "invalid target #{ref.inspect}; expected OWNER/REPO#N"
    exit 64
  end
  requests << { repo: match[1], number: Integer(match[2]), requested_kind: nil }
end

if requests.empty? && options[:batch_ids].empty?
  warn parser
  exit 64
end

helper = bounded_helper
batch_unknowns = []
resolved_batch_ids = []
batch_payloads = {}
help_request_lifecycles = {}
lane_help_request_lifecycles = {}
options[:batch_ids].each do |batch_id|
  unless helper
    batch_unknowns << "batch #{batch_id}: bounded agent-coordination helper unavailable"
    next
  end

  batch_payload, batch_error = run_json(
    helper,
    "--timeout", options[:timeout].to_s,
    "status", "--batch-id", batch_id, "--json"
  )
  if batch_error
    batch_payloads[batch_id] = nil
    help_request_lifecycles[batch_id] = help_request_lifecycle(
      nil,
      now: options.fetch(:now),
      max_open_seconds: options.fetch(:help_request_max_open_seconds)
    )
    batch_unknowns << "batch #{batch_id}: #{batch_error}"
    next
  end

  unless batch_payload.is_a?(Hash)
    batch_payloads[batch_id] = nil
    help_request_lifecycles[batch_id] = help_request_lifecycle(
      nil,
      now: options.fetch(:now),
      max_open_seconds: options.fetch(:help_request_max_open_seconds)
    )
    batch_unknowns << "batch #{batch_id}: response was not an object"
    next
  end

  batch_payloads[batch_id] = batch_payload
  help_request_lifecycles[batch_id] = help_request_lifecycle(
    batch_payload,
    now: options.fetch(:now),
    max_open_seconds: options.fetch(:help_request_max_open_seconds)
  )

  batches = batch_payload["batches"].is_a?(Array) ? batch_payload["batches"].select { |item| item.is_a?(Hash) } : []
  batch = batches.find { |candidate| candidate["batch_id"] == batch_id }
  unless batch.is_a?(Hash)
    batch_unknowns << "batch #{batch_id}: exact registration not found"
    next
  end

  resolved_batch_id = present_string(batch["batch_id"]) || batch_id
  resolved_batch_ids << resolved_batch_id
  batch_payloads[resolved_batch_id] = batch_payload
  help_request_lifecycles[resolved_batch_id] = help_request_lifecycles.fetch(batch_id)
  repo = present_string(batch["repo"]) || options[:repo]
  unless repo
    batch_unknowns << "batch #{resolved_batch_id}: repository UNKNOWN"
    next
  end
  unless valid_repo?(repo)
    batch_unknowns << "batch #{resolved_batch_id}: invalid repository metadata"
    next
  end

  lanes = batch["lanes"].is_a?(Array) ? batch["lanes"] : []
  lanes.each do |lane|
    unless lane.is_a?(Hash)
      batch_unknowns << "batch #{resolved_batch_id}: non-object lane"
      next
    end

    owner = present_string(lane["owner"])
    targets = lane["targets"].is_a?(Array) ? lane["targets"] : []
    targets.each do |target|
      parsed_target = parse_batch_target(target)
      unless parsed_target
        batch_unknowns << "batch #{resolved_batch_id} lane #{lane['name'] || UNKNOWN}: invalid target #{target.inspect}"
        next
      end

      requests << {
        repo: repo,
        number: parsed_target.fetch(:number),
        requested_kind: parsed_target.fetch(:requested_kind),
        coordination_target: parsed_target.fetch(:coordination_target),
        expected_owner: owner,
        batch_id: resolved_batch_id,
        lane: present_string(lane["name"])
      }
    end
  end
end

items = requests.map do |request|
  repo = request.fetch(:repo)
  number = request.fetch(:number)
  unknowns = []

  github, github_error = run_json("gh", "api", "repos/#{repo}/issues/#{number}", timeout: options[:timeout])
  if github && !github.is_a?(Hash)
    github = nil
    github_error = "response was not an object"
  end
  github_kind = if github&.key?("pull_request")
                  "pr"
                elsif github
                  "issue"
                else
                  UNKNOWN
                end
  unknowns << "GitHub state: #{github_error}" if github_error
  if request[:requested_kind] && github_kind != UNKNOWN && request[:requested_kind] != github_kind
    unknowns << "target type mismatch: requested #{request[:requested_kind]}, GitHub reports #{github_kind}"
  end

  coordination = nil
  coordination_error = nil
  if helper
    coordination, coordination_error = run_json(
      helper,
      "--timeout", options[:timeout].to_s,
      "status", "--repo", repo, "--target", request.fetch(:coordination_target, number.to_s), "--json"
    )
  else
    coordination_error = "bounded agent-coordination helper unavailable"
  end
  unknowns << "coordination state: #{coordination_error}" if coordination_error

  claims = coordination.is_a?(Hash) && coordination["claims"].is_a?(Array) ? coordination["claims"] : []
  heartbeats = coordination.is_a?(Hash) && coordination["heartbeats"].is_a?(Array) ? coordination["heartbeats"] : []
  claim = claims.find { |candidate| candidate.is_a?(Hash) && candidate["status"] == "active" } || {}
  holder = present_string(claim["agent_id"])
  unknowns << "coordination holder: no active claim" unless holder
  expected_owner = request[:expected_owner]
  if holder && expected_owner && holder != expected_owner
    unknowns << "coordination holder divergence: batch owner #{expected_owner}, active claim #{holder}"
  end
  heartbeat = holder && heartbeats.find { |candidate| candidate.is_a?(Hash) && candidate["agent_id"] == holder }
  batch_id = request[:batch_id] || present_string(claim["batch_id"])
  lane = request[:lane] || present_string(claim["lane"])
  unknowns << "batch lane: registration and claim metadata unavailable" if batch_id && !lane
  lifecycle = { "status" => UNKNOWN, "error" => "batch id unavailable for target-scoped replay" }
  if batch_id
    unless batch_payloads.key?(batch_id)
      batch_payload, batch_error = run_json(
        helper,
        "--timeout", options[:timeout].to_s,
        "status", "--batch-id", batch_id, "--json"
      )
      if batch_error
        batch_payloads[batch_id] = nil
        message = "batch #{batch_id}: #{batch_error}"
        batch_unknowns << message unless batch_unknowns.include?(message)
      else
        batch_payloads[batch_id] = batch_payload
      end
    end
    help_request_lifecycles[batch_id] ||= help_request_lifecycle(
      batch_payloads[batch_id],
      now: options.fetch(:now),
      max_open_seconds: options.fetch(:help_request_max_open_seconds)
    )
    lifecycle = if lane
                  lane_cache_key = [batch_id, lane]
                  lane_help_request_lifecycles[lane_cache_key] ||= help_request_lifecycle(
                    batch_payloads[batch_id],
                    now: options.fetch(:now),
                    max_open_seconds: options.fetch(:help_request_max_open_seconds),
                    lane: lane
                  )
                else
                  { "status" => UNKNOWN, "error" => "lane unavailable for target-scoped replay" }
                end
  end
  unknowns << "help-request lifecycle: #{lifecycle['error']}" if lifecycle["status"] == UNKNOWN
  record = holder ? (heartbeat || claim) : {}
  runner = runner_for(record)
  machine_id = present_string(record["machine_id"]) || UNKNOWN
  thread_id = present_string(record["session_id"]) || UNKNOWN
  deep_link = codex_deep_link(record, runner)
  unknowns << "editor: host/session metadata missing or conflicting" if runner == UNKNOWN
  if runner == "Codex" && deep_link == UNKNOWN
    reason = if machine_id == UNKNOWN
               "machine_id missing"
             elsif record["session_source"] != "codex_thread_id"
               "session_source is not codex_thread_id"
             else
               "thread_id missing or invalid"
             end
    unknowns << "Codex deep link: #{reason}"
  end

  {
    "batch_id" => batch_id || UNKNOWN,
    "lane" => lane || (batch_id ? UNKNOWN : "#{repo}##{number}"),
    "target" => {
      "repo" => repo,
      "number" => number,
      "kind" => github_kind,
      "url" => github&.fetch("html_url", UNKNOWN) || UNKNOWN
    },
    "holder" => holder || UNKNOWN,
    "editor" => runner,
    "runner" => runner,
    "machine_id" => machine_id,
    "thread_id" => thread_id,
    "codex_deep_link" => deep_link,
    "codex_deep_link_machine_id" => deep_link == UNKNOWN ? UNKNOWN : machine_id,
    "heartbeat" => heartbeat || UNKNOWN,
    "help_request_lifecycle" => lifecycle,
    "github_state" => github&.fetch("state", UNKNOWN) || UNKNOWN,
    "unknowns" => unknowns
  }
end

payload = {
  "schema_version" => 1,
  "batch_id" => resolved_batch_ids.length == 1 ? resolved_batch_ids.first : UNKNOWN,
  "batch_ids" => resolved_batch_ids,
  "help_request_lifecycles" => help_request_lifecycles,
  "items" => items,
  "unknowns" => batch_unknowns
}
puts JSON.pretty_generate(payload)
