#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

require_relative "agent_workflows_entry_lease"

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: agent-workflows-run --operation HANDLE CAPABILITY -- ARGS..."
  opts.on("--operation HANDLE") { |value| options[:operation] = value }
end
parser.order!
capability = ARGV.shift
ARGV.shift if ARGV.first == "--"

abort "--operation is required" unless options[:operation]
abort "CAPABILITY is required" unless capability

target = File.expand_path("..", __dir__)
begin
  status = AgentWorkflowsEntryLease.with(target:, mode: :shared) do |lease|
    require_relative "agent_workflows_operation/runner"
    AgentWorkflowsOperation::Runner.new(target:, lease:).launch!(
      handle: options.fetch(:operation),
      capability: capability,
      arguments: ARGV
    )
  end
  exit(status.exitstatus || 128 + status.termsig)
rescue AgentWorkflowsEntryLease::Error => e
  warn e.message
  exit 1
rescue StandardError => e
  raise unless defined?(AgentWorkflowsOperation::Error) && e.is_a?(AgentWorkflowsOperation::Error)

  warn e.message
  exit 1
end
