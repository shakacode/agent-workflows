#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: upgrade-agent-workflows [--host codex|claude|auto] [--target DIR] [--source DIR] [--mode copy|symlink] [--delivery-mode flat|plugin-companion] [--provider-profile pinned|managed] [--gh-executable ABSOLUTE_PATH] [--consumer-root DIR] [--dry-run] [--no-fetch]

Updates the source clone, reinstalls this shared workflow pack into an agent
home, and optionally validates one or more consumer repository seams.

Network note: by default this command runs git fetch/pull in the source clone.
Use --no-fetch for an already-updated local clone.
With --host auto and an explicit unmarked target, Codex is the deterministic
backward-compatible default; pass --host claude for arbitrary Claude targets.
USAGE
}

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host="codex"
target=""
source=""
mode=""
delivery_mode=""
provider_profile=""
gh_executable=""
dry_run=false
fetch=true
consumer_roots=()
metadata_name=".agent-workflows-install.json"
declared_git_source=false
backup_dir=""
backup_target_dir=""
backup_identity=""
backup_ready=false
target_existed=false
completed=false

default_target_for_host() {
  case "$1" in
    codex)
      printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
      ;;
    claude)
      printf '%s\n' "${CLAUDE_HOME:-$HOME/.claude}"
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_auto_target() {
  local codex_home="${CODEX_HOME:-$HOME/.codex}"
  local claude_home="${CLAUDE_HOME:-$HOME/.claude}"
  local -a candidates=()

  if [[ -n "${CODEX_HOME:-}" || -d "$codex_home" ]]; then
    candidates+=("codex:$codex_home")
  fi
  if [[ -n "${CLAUDE_HOME:-}" || -d "$claude_home" ]]; then
    candidates+=("claude:$claude_home")
  fi

  case "${#candidates[@]}" in
    0)
      printf 'codex:%s\n' "$codex_home"
      ;;
    1)
      printf '%s\n' "${candidates[0]}"
      ;;
    *)
      echo "Auto host detection found both Codex and Claude homes; pass --host codex or --host claude." >&2
      return 64
      ;;
  esac
}

resolve_host_and_target() {
  if [[ -n "$target" ]]; then
    target="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "$target")"
    if [[ "$host" = "auto" ]]; then
      local codex_home claude_home
      codex_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CODEX_HOME:-$HOME/.codex}")"
      claude_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CLAUDE_HOME:-$HOME/.claude}")"
      local codex_marker=false claude_marker=false
      [[ "$target" = "$codex_home" || -f "$target/config.toml" ]] && codex_marker=true
      [[ "$target" = "$claude_home" || -f "$target/settings.json" || -f "$target/plugins/installed_plugins.json" ]] && claude_marker=true
      if [[ "$codex_marker" = true && "$claude_marker" = true ]]; then
        echo "Explicit target has both Codex and Claude markers; pass --host codex or --host claude." >&2
        return 64
      elif [[ "$claude_marker" = true ]]; then
        printf 'claude:%s\n' "$target"
      elif [[ "$codex_marker" = true ]]; then
        printf 'codex:%s\n' "$target"
      else
        printf 'codex:%s\n' "$target"
      fi
    else
      printf '%s:%s\n' "$host" "$target"
    fi
    return 0
  fi

  if [[ "$host" = "auto" ]]; then
    resolve_auto_target
  else
    printf '%s:%s\n' "$host" "$(default_target_for_host "$host")"
  fi
}

metadata_value() {
  local path="$1"
  local key="$2"
  [[ -f "$path" ]] || return 1
  ruby -rjson -e '
    metadata = JSON.parse(File.read(ARGV.fetch(0)))
    value = metadata[ARGV.fetch(1)]
    exit 1 if value.nil? || value.to_s.empty?
    puts value
  ' "$path" "$key"
}

short_revision() {
  local value="$1"
  printf '%s\n' "${value:0:12}"
}

validate_declared_git_source() {
  if [[ ! -e "$source/.git" && ! -L "$source/.git" ]]; then
    declared_git_source=false
    return 0
  fi
  declared_git_source=true

  local inside_work_tree top_level revision
  if ! inside_work_tree="$(git -C "$source" rev-parse --is-inside-work-tree 2>&1)" ||
     [[ "$inside_work_tree" != "true" ]]; then
    echo "CHECK_FAILED declared Git source is invalid: $inside_work_tree" >&2
    return 3
  fi
  if ! top_level="$(git -C "$source" rev-parse --show-toplevel 2>&1)"; then
    echo "CHECK_FAILED declared Git source root check failed: $top_level" >&2
    return 3
  fi
  if [[ "$(cd "$top_level" && pwd -P)" != "$(cd "$source" && pwd -P)" ]]; then
    echo "CHECK_FAILED declared Git source resolves to another worktree root: $top_level" >&2
    return 3
  fi
  if ! revision="$(git -C "$source" rev-parse --verify --quiet 'HEAD^{commit}' 2>&1)"; then
    echo "CHECK_FAILED declared Git source commit check failed: $revision" >&2
    return 3
  fi
}

update_source_clone() {
  git -C "$source" fetch --quiet --prune origin
  local branch upstream
  branch="$(git -C "$source" branch --show-current 2>/dev/null || true)"
  [[ -n "$branch" ]] || return 0

  upstream="$(git -C "$source" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" ]]; then
    git -C "$source" merge --ff-only --quiet "$upstream"
  elif git -C "$source" rev-parse --verify --quiet "origin/$branch" >/dev/null; then
    git -C "$source" merge --ff-only --quiet "origin/$branch"
  fi
}

read_directory_identity() {
  ruby -e '
    stat = File.lstat(ARGV.fetch(0))
    exit 1 unless stat.directory? && stat.uid == Process.euid
    puts [stat.dev, stat.ino, stat.uid].join(":")
  ' "$1"
}

backup_identity_matches() {
  local current_identity
  [[ -n "$backup_dir" && -n "$backup_identity" ]] || return 1
  current_identity="$(read_directory_identity "$backup_dir" 2>/dev/null)" || return 1
  [[ "$current_identity" = "$backup_identity" ]]
}

cleanup_backup() {
  [[ -n "$backup_dir" ]] || return 0
  if ! backup_identity_matches; then
    echo "CLEANUP_FAILED backup identity changed: $backup_dir" >&2
    return 1
  fi

  rm -rf -- "$backup_dir"
  if [[ -e "$backup_dir" || -L "$backup_dir" ]]; then
    echo "CLEANUP_FAILED backup remains: $backup_dir" >&2
    return 1
  fi
  backup_dir=""
  backup_target_dir=""
  backup_identity=""
}

backup_target() {
  trap 'finish_upgrade "$?"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  backup_dir="$(mktemp -d)"
  backup_identity="$(read_directory_identity "$backup_dir")"
  backup_target_dir="$backup_dir/target"
  mkdir -p "$backup_target_dir"
  if [[ -d "$target" ]]; then
    target_existed=true
    rsync -a --exclude='/.agent-workflows-operation-state' "$target/" "$backup_target_dir/"
  fi
  backup_ready=true
}

restore_target() {
  if [[ "$backup_ready" != "true" ]]; then
    return 0
  fi
  if ! backup_identity_matches; then
    echo "ROLLBACK_FAILED backup identity changed: $backup_dir" >&2
    return 1
  fi

  if [[ "${target_existed:-false}" = "true" ]]; then
    mkdir -p "$target"
  elif [[ ! -d "$target" ]]; then
    if [[ -e "$target" || -L "$target" ]]; then
      echo "ROLLBACK_FAILED target is not a directory: $target" >&2
      return 1
    fi
    mkdir -p "$target"
  fi
  rsync -a --delete --exclude='/.agent-workflows-operation-state' "$backup_target_dir/" "$target/"
  if [[ "$target_existed" != "true" ]]; then
    rmdir "$target" 2>/dev/null || true
  fi
  echo "ROLLBACK_COMPLETE target=$target"
}

finish_upgrade() {
  local original_status="$1"
  local final_status="$original_status"
  local restore_status cleanup_status

  trap - EXIT HUP INT TERM
  set +e
  if [[ "$completed" != "true" ]]; then
    restore_target
    restore_status=$?
    if [[ "$restore_status" -ne 0 && "$final_status" -eq 0 ]]; then
      final_status="$restore_status"
    fi
  fi
  cleanup_backup
  cleanup_status=$?
  if [[ "$cleanup_status" -ne 0 && "$final_status" -eq 0 ]]; then
    final_status="$cleanup_status"
  fi
  exit "$final_status"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      host="${2:?--host requires codex, claude, or auto}"
      shift 2
      ;;
    --target)
      target="${2:?--target requires a directory}"
      shift 2
      ;;
    --source)
      source="${2:?--source requires a directory}"
      shift 2
      ;;
    --mode)
      mode="${2:?--mode requires copy or symlink}"
      shift 2
      ;;
    --delivery-mode)
      delivery_mode="${2:?--delivery-mode requires flat or plugin-companion}"
      shift 2
      ;;
    --provider-profile)
      provider_profile="${2:?--provider-profile requires pinned or managed}"
      shift 2
      ;;
    --gh-executable)
      gh_executable="${2:?--gh-executable requires an absolute path}"
      shift 2
      ;;
    --consumer-root)
      consumer_roots+=("${2:?--consumer-root requires a directory}")
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --no-fetch)
      fetch=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

case "$host" in
  codex|claude|auto) ;;
  *)
    echo "--host must be codex, claude, or auto, got: $host" >&2
    exit 64
    ;;
esac

case "${mode:-copy}" in
  copy|symlink) ;;
  *)
    echo "--mode must be copy or symlink, got: $mode" >&2
    exit 64
    ;;
esac

case "${delivery_mode:-flat}" in
  flat|plugin-companion) ;;
  *)
    echo "--delivery-mode must be flat or plugin-companion, got: $delivery_mode" >&2
    exit 64
    ;;
esac

resolved="$(resolve_host_and_target)"
host="${resolved%%:*}"
target="${resolved#*:}"
metadata_path="$target/$metadata_name"

if [[ -z "$source" ]]; then
  source="$(metadata_value "$metadata_path" source 2>/dev/null || printf '%s\n' "$script_root")"
fi
if [[ ! -d "$source" ]]; then
  echo "CHECK_FAILED missing source root: $source" >&2
  exit 3
fi
source="$(cd "$source" && pwd)"

if [[ -z "$mode" ]]; then
  mode="$(metadata_value "$metadata_path" mode 2>/dev/null || printf 'copy\n')"
fi
if [[ -z "$delivery_mode" ]]; then
  delivery_mode="$(metadata_value "$metadata_path" delivery_mode 2>/dev/null || printf 'flat\n')"
fi
if [[ -z "$provider_profile" ]]; then
  provider_profile="$(metadata_value "$metadata_path" provider_profile 2>/dev/null || printf 'pinned\n')"
fi
if [[ -z "$gh_executable" ]]; then
  gh_executable="$(metadata_value "$metadata_path" gh_executable 2>/dev/null || true)"
fi
case "$provider_profile" in
  pinned|managed) ;;
  *)
    echo "--provider-profile must be pinned or managed, got: $provider_profile" >&2
    exit 64
    ;;
esac

status_script="$source/bin/agent-workflows-status"
install_script="$source/bin/install-agent-workflows"

if [[ ! -x "$status_script" || ! -x "$install_script" ]]; then
  echo "CHECK_FAILED missing agent-workflows scripts in source: $source" >&2
  exit 3
fi

if ! validate_declared_git_source; then
  exit 3
fi

if [[ "$dry_run" = "true" ]]; then
  status_args=(--host "$host" --target "$target" --source "$source" --delivery-mode "$delivery_mode")
  if [[ "$fetch" = "true" ]]; then
    status_args+=(--fetch)
  fi
  set +e
  "$status_script" "${status_args[@]}"
  status=$?
  set -e
  if [[ "$status" -eq 3 ]]; then
    exit 3
  fi
  exit 0
fi

old_revision="$(metadata_value "$metadata_path" source_revision 2>/dev/null || printf 'unknown\n')"

if [[ "$fetch" = "true" && "$declared_git_source" = "true" ]]; then
  update_source_clone
  if ! validate_declared_git_source; then
    exit 3
  fi
fi

backup_target

install_args=(
  --host "$host"
  --target "$target"
  --mode "$mode"
  --delivery-mode "$delivery_mode"
  --provider-profile "$provider_profile"
)
if [[ -n "$gh_executable" ]]; then
  install_args+=(--gh-executable "$gh_executable")
fi
"$install_script" "${install_args[@]}"

if [[ "${#consumer_roots[@]}" -gt 0 ]]; then
  for consumer_root in "${consumer_roots[@]}"; do
    "$target/bin/agent-workflow-seam-doctor" --root "$consumer_root" --shared "$source"
  done
fi

cleanup_backup
completed=true

new_revision="$(metadata_value "$metadata_path" source_revision 2>/dev/null || printf 'unknown\n')"
echo "UPGRADE_COMPLETE $(short_revision "$old_revision") $(short_revision "$new_revision") target=$target source=$source"
