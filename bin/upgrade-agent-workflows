#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: upgrade-agent-workflows [--host codex|claude|cursor|auto] [--target DIR] [--source DIR] [--mode copy|symlink] [--delivery-mode flat|plugin-companion] [--consumer-root DIR] [--dry-run] [--no-fetch]

Updates the source clone, reinstalls this shared workflow pack into an agent
home, and optionally validates one or more consumer repository seams.

Network note: by default this command runs git fetch/pull in the source clone.
Use --no-fetch for an already-updated local clone.
With --host auto and an explicit unmarked target, Codex is the deterministic
backward-compatible default; pass --host claude or --host cursor for those homes.
USAGE
}

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host="codex"
target=""
source=""
mode=""
delivery_mode=""
dry_run=false
fetch=true
consumer_roots=()
metadata_name=".agent-workflows-install.json"
managed_snapshot_roots=(
  bin
  bin/agent_doctor
  docs
  docs/solutions
  docs/schemas
  lib
  lib/agent-workflows
  rules
  skills
  workflows
)

default_target_for_host() {
  case "$1" in
    codex)
      printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
      ;;
    claude)
      printf '%s\n' "${CLAUDE_HOME:-$HOME/.claude}"
      ;;
    cursor)
      printf '%s\n' "${CURSOR_HOME:-$HOME/.cursor}"
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_auto_target() {
  local codex_home="${CODEX_HOME:-$HOME/.codex}"
  local claude_home="${CLAUDE_HOME:-$HOME/.claude}"
  local cursor_home="${CURSOR_HOME:-$HOME/.cursor}"
  local -a candidates=()

  if [[ -n "${CODEX_HOME:-}" || -d "$codex_home" ]]; then
    candidates+=("codex:$codex_home")
  fi
  if [[ -n "${CLAUDE_HOME:-}" || -d "$claude_home" ]]; then
    candidates+=("claude:$claude_home")
  fi
  if [[ -n "${CURSOR_HOME:-}" || -d "$cursor_home" ]]; then
    candidates+=("cursor:$cursor_home")
  fi

  case "${#candidates[@]}" in
    0)
      printf 'codex:%s\n' "$codex_home"
      ;;
    1)
      printf '%s\n' "${candidates[0]}"
      ;;
    *)
      echo "Auto host detection found multiple agent homes; pass --host codex, --host claude, or --host cursor." >&2
      return 64
      ;;
  esac
}

resolve_host_and_target() {
  if [[ -n "$target" ]]; then
    target="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "$target")"
    if [[ "$host" = "auto" ]]; then
      local codex_home claude_home cursor_home
      local -a matched=()
      codex_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CODEX_HOME:-$HOME/.codex}")"
      claude_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CLAUDE_HOME:-$HOME/.claude}")"
      cursor_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CURSOR_HOME:-$HOME/.cursor}")"
      local codex_marker=false claude_marker=false cursor_marker=false
      [[ "$target" = "$codex_home" || -f "$target/config.toml" ]] && codex_marker=true
      [[ "$target" = "$claude_home" || -f "$target/settings.json" || -f "$target/plugins/installed_plugins.json" ]] && claude_marker=true
      [[ "$target" = "$cursor_home" || -f "$target/cli-config.json" || -d "$target/skills-cursor" ]] && cursor_marker=true
      [[ "$codex_marker" = true ]] && matched+=("codex")
      [[ "$claude_marker" = true ]] && matched+=("claude")
      [[ "$cursor_marker" = true ]] && matched+=("cursor")
      if [[ "${#matched[@]}" -gt 1 ]]; then
        echo "Explicit target has markers for more than one host; pass --host codex, --host claude, or --host cursor." >&2
        return 64
      elif [[ "${#matched[@]}" -eq 1 ]]; then
        printf '%s:%s\n' "${matched[0]}" "$target"
      else
        printf 'codex:%s\n' "$target"
      fi
    else
      printf '%s:%s\n' "$host" "$target"
    fi
    return 0
  fi

  if [[ "$host" = "auto" ]]; then
    resolve_auto_target
  else
    printf '%s:%s\n' "$host" "$(default_target_for_host "$host")"
  fi
}

metadata_value() {
  local path="$1"
  local key="$2"
  [[ -f "$path" ]] || return 1
  ruby -rjson -e '
    metadata = JSON.parse(File.read(ARGV.fetch(0)))
    value = metadata[ARGV.fetch(1)]
    exit 1 if value.nil? || value.to_s.empty?
    puts value
  ' "$path" "$key"
}

short_revision() {
  local value="$1"
  printf '%s\n' "${value:0:12}"
}

update_source_clone() {
  [[ -d "$source/.git" ]] || return 0

  git -C "$source" fetch --quiet --prune origin
  local branch upstream
  branch="$(git -C "$source" branch --show-current 2>/dev/null || true)"
  [[ -n "$branch" ]] || return 0

  upstream="$(git -C "$source" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" ]]; then
    git -C "$source" merge --ff-only --quiet "$upstream"
  elif git -C "$source" rev-parse --verify --quiet "origin/$branch" >/dev/null; then
    git -C "$source" merge --ff-only --quiet "origin/$branch"
  fi
}

path_is_within_snapshot_symlink_root() {
  local path="$1"
  local root
  for root in "${snapshot_symlink_roots[@]}"; do
    [[ "$path" = "$root" || "$path" = "$root/"* ]] && return 0
  done
  return 1
}

path_is_snapshot_symlink_root() {
  local path="${1%/}"
  local root
  for root in "${snapshot_symlink_roots[@]}"; do
    [[ "$path" = "$root" ]] && return 0
  done
  return 1
}

path_is_within_traversed_snapshot_symlink_root() {
  local path="$1"
  local root
  for root in "${snapshot_symlink_roots[@]}"; do
    # Symlink mode writes children through these container roots. Other managed
    # directory symlinks are replaced as leaves before descendant writes.
    case "$root" in
      bin|skills)
        [[ "$mode" = "symlink" ]] &&
          [[ "$path" = "$root" || "$path" = "$root/"* ]] && return 0
        ;;
    esac
  done
  return 1
}

snapshot_root_is_active() {
  case "$1" in
    lib)
      [[ "${backup_includes_companion:-false}" = "true" ]] &&
        [[ ! -L "$target/lib" ]] &&
        [[ ! -e "$target/lib" || -d "$target/lib" ]]
      ;;
    lib/agent-workflows)
      [[ "${backup_includes_companion:-false}" = "true" ]] &&
        [[ ! -L "$target/lib" ]] &&
        [[ ! -e "$target/lib" || -d "$target/lib" ]] &&
        [[ ! -L "$target/lib/agent-workflows" ]] &&
        [[ ! -e "$target/lib/agent-workflows" || -d "$target/lib/agent-workflows" ]]
      ;;
    rules)
      [[ "$host" = "cursor" ]]
      ;;
    skills)
      [[ "${backup_includes_flat_skills:-false}" = "true" ]]
      ;;
    *)
      return 0
      ;;
  esac
}

source_managed_inventory_fingerprint() {
  local include_flat_skills="$1"
  ruby -rdigest -e '
    source, include_flat_skills, install_mode = ARGV
    paths = []
    Dir.glob(File.join(source, "docs/solutions", "*")).each do |path|
      paths << "docs/solutions/#{File.basename(path)}" if File.file?(path) && !File.symlink?(path)
    end
    Dir.glob(File.join(source, "workflows", "*")).each do |path|
      paths << "workflows/#{File.basename(path)}"
    end
    if include_flat_skills == "true"
      Dir.glob(File.join(source, "skills", "*")).each do |path|
        paths << "skills/#{File.basename(path)}" if install_mode == "copy" || File.directory?(path)
      end
    end
    print Digest::SHA256.hexdigest(paths.sort.join("\0"))
  ' "$source" "$include_flat_skills" "$mode"
}

recovery_artifact_inventory() {
  ruby -e '
    target = ARGV.fetch(0)
    patterns = [
      ".agent-workflows-install.json.recovery-*",
      ".agent-workflows-install.json.cleanup-complete-*"
    ]
    paths = patterns.flat_map { |pattern| Dir.glob(File.join(target, pattern), File::FNM_DOTMATCH) }
    paths.map! { |path| File.basename(path) }
    paths.uniq.sort.each do |path|
      STDOUT.write(path)
      STDOUT.write("\0")
    end
  ' "$target"
}

backup_target() {
  backup_dir="$(mktemp -d)"
  backup_target_dir="$backup_dir/target"
  backup_manifest="$backup_dir/managed-paths"
  backup_existing_manifest="$backup_dir/existing-managed-paths"
  backup_symlink_manifest="$backup_dir/managed-symlinks"
  backup_followed_dir="$backup_dir/followed-symlink-roots"
  backup_followed_manifest="$backup_dir/followed-symlink-paths"
  backup_absent_container_manifest="$backup_dir/absent-containers"
  backup_migration_receipt="$backup_dir/migration-staging-receipt"
  backup_migration_staging_dir="$backup_dir/migration-staging"
  backup_recovery_artifact_manifest="$backup_dir/recovery-artifacts"
  : > "$backup_absent_container_manifest"
  backup_migration_staging_path=""
  migration_receipt_existed=false
  target_existed=false
  if [[ -d "$target" ]]; then
    target_existed=true
    backup_canonical_target="$(ruby -e 'print File.realpath(ARGV.fetch(0))' "$target")"
    installed_delivery_mode="$(metadata_value "$metadata_path" delivery_mode 2>/dev/null || printf 'flat\n')"
    backup_includes_flat_skills=false
    if [[ "$delivery_mode" = "flat" || "$installed_delivery_mode" = "flat" ]]; then
      backup_includes_flat_skills=true
    fi
    backup_includes_companion=false
    if [[ "$delivery_mode" = "plugin-companion" || "$installed_delivery_mode" = "plugin-companion" ]]; then
      backup_includes_companion=true
    fi
    backup_source_inventory_fingerprint="$(source_managed_inventory_fingerprint "$backup_includes_flat_skills")"
    recovery_artifact_inventory > "$backup_recovery_artifact_manifest"
    if [[ -e "$target/.agent-workflows-migration-staging" ||
          -L "$target/.agent-workflows-migration-staging" ]]; then
      migration_receipt_existed=true
      local migration_receipt_status
      set +e
      backup_migration_staging_path="$(ruby -e '
        target, receipt = ARGV
        target = File.realpath(target)
        receipt_stat = File.lstat(receipt)
        abort unless receipt_stat.file? && !receipt_stat.symlink?
        lines = File.binread(receipt).lines(chomp: true)
        abort unless lines.length == 1
        staging = File.expand_path(lines.fetch(0))
        abort unless File.basename(staging).match?(/\A\.agent-workflows-flat-migration-.+\z/)
        staging_stat = File.lstat(staging)
        abort unless staging_stat.directory? && !staging_stat.symlink?
        canonical_staging = File.realpath(staging)
        canonical_stat = File.lstat(canonical_staging)
        abort unless File.dirname(canonical_staging) == target &&
                     canonical_stat.dev == staging_stat.dev && canonical_stat.ino == staging_stat.ino
        print canonical_staging
      ' "$target" "$target/.agent-workflows-migration-staging" 2>/dev/null)"
      migration_receipt_status=$?
      set -e
      if [[ "$migration_receipt_status" -ne 0 ]]; then
        echo "CHECK_FAILED invalid migration recovery receipt: $target/.agent-workflows-migration-staging" >&2
        return 3
      fi
      cp -a "$target/.agent-workflows-migration-staging" "$backup_migration_receipt"
      cp -a "$backup_migration_staging_path" "$backup_migration_staging_dir"
    fi
    mkdir -p "$backup_target_dir"
    for path in "${managed_snapshot_roots[@]}"; do
      snapshot_root_is_active "$path" || continue
      if [[ ! -e "$target/$path" && ! -L "$target/$path" ]]; then
        printf '%s\0' "$path" >> "$backup_absent_container_manifest"
      fi
    done
    # The agent home can contain hundreds of thousands of unrelated files
    # under worktrees/, tmp/, and sessions/. Snapshot only paths the installer
    # can replace so rollback remains bounded by the pack installation.
    ruby -rjson -rpathname -e '
      target, source, host, delivery_mode, metadata_path, mode = ARGV
      bin_helpers = %w[
        agent-workflow-seam-doctor
        agent-workflow-writing-style
        agent-workflows-delivery-state
        agent-workflows-doctor
        agent-workflows-refresh
        agent-workflows-status
        agent-workflows-trust-audit
        install-agent-workflows
        upgrade-agent-workflows
        validate-execution-provenance
        validate-review-findings
      ]
      pack_docs = %w[
        coordination-backend.md
        execution-provenance-schema.md
        review-finding-schema.md
        schemas/task-review-loop-v1.schema.json
        agent-workflows-model-routing.md
        user-facing-coordination.md
        writing-style.md
        writing-style-asd-ste100.md
      ]
      managed = [
        ".agent-workflows-install.json",
        ".agent-workflows-install.json.tmp",
        ".agent-workflows-install.lock/",
        "LICENSE",
        "THIRD_PARTY-NOTICES.md",
        "bin/agent_doctor/"
      ]
      managed.concat(bin_helpers.map { |name| "bin/#{name}" })
      managed.concat(pack_docs.map { |name| "docs/#{name}" })
      managed << "rules/agent-workflows.mdc" if host == "cursor"
      Dir.glob(File.join(source, "docs/solutions", "*")).each do |path|
        managed << "docs/solutions/#{File.basename(path)}" if File.file?(path) && !File.symlink?(path)
      end
      workflows_root = File.join(target, "workflows")
      managed << "workflows" unless File.directory?(workflows_root) && !File.symlink?(workflows_root)
      Dir.glob(File.join(source, "workflows", "*")).each do |path|
        managed << "workflows/#{File.basename(path)}"
      end
      metadata = begin
        JSON.parse(File.binread(metadata_path))
      rescue StandardError
        {}
      end
      if metadata["delivery_mode"] == "plugin-companion" || delivery_mode == "plugin-companion"
        managed << "lib/agent-workflows/secure_github_actions_scanner.rb"
      end
      revision = metadata["source_revision"]
      roots = [metadata["source"], source].compact.uniq
      recorded_git_root = roots.find do |root|
        File.directory?(root) && revision.to_s.match?(/\A[0-9a-f]{40}\z/i) &&
          system("git", "-C", root, "cat-file", "-e", "#{revision}^{commit}", out: File::NULL, err: File::NULL)
      end
      recorded_path = lambda do |path|
        next false unless recorded_git_root

        type = IO.popen(
          ["git", "-C", recorded_git_root, "cat-file", "-t", "#{revision}:#{path}"],
          err: File::NULL,
          &:read
        )
        $?.success? && type.strip == "blob"
      end
      legacy_guide = File.join(target, "docs/model-routing.md")
      legacy_guide_owned = if File.symlink?(legacy_guide)
        previous_source = metadata["source"]
        [source, previous_source].compact.map { |root| File.join(root, "docs/model-routing.md") }
          .include?(File.readlink(legacy_guide))
      elsif File.file?(legacy_guide)
        expected_contents = []
        if revision.to_s.match?(/\A[0-9a-f]{40}\z/i)
          roots.each do |root|
            next unless File.directory?(root)
            contents = IO.popen(
              ["git", "-C", root, "show", "#{revision}:docs/model-routing.md"],
              err: File::NULL,
              &:read
            )
            expected_contents << contents.b if $?.success?
          end
        end
        previous_source = metadata["source"]
        previous_guide = File.join(previous_source, "docs/model-routing.md") if previous_source.is_a?(String)
        expected_contents << File.binread(previous_guide) if previous_guide && File.file?(previous_guide)
        expected_contents.include?(File.binread(legacy_guide))
      else
        false
      end
      managed << "docs/model-routing.md" if legacy_guide_owned
      {
        "managed_skill_copy_fingerprints" => "skills/",
        "managed_pack_doc_copy_fingerprints" => "docs/",
        "managed_pack_helper_copy_fingerprints" => "bin/",
        "managed_pack_root_copy_fingerprints" => ""
      }.each do |field, prefix|
        names = metadata[field]
        next unless names.is_a?(Hash)
        names.each_key do |name|
          next unless name.is_a?(String) && !name.empty? && !name.start_with?("/") && !name.include?("\0")
          segments = name.split("/", -1)
          next if segments.any? { |segment| segment.empty? || segment == "." || segment == ".." }
          allowed = case field
                    when "managed_skill_copy_fingerprints"
                      segments.length == 1
                    when "managed_pack_doc_copy_fingerprints"
                      pack_docs.include?(name) || (segments.length == 2 && segments.first == "solutions") ||
                        recorded_path.call("docs/#{name}")
                    when "managed_pack_helper_copy_fingerprints"
                      bin_helpers.include?(name) || (segments.length == 1 && recorded_path.call("bin/#{name}"))
                    when "managed_pack_root_copy_fingerprints"
                      name == "THIRD_PARTY-NOTICES.md"
                    end
          next unless allowed
          managed << "#{prefix}#{name}"
        end
      end
      workflow_git_root = roots.find do |root|
        File.directory?(root) && revision.to_s.match?(/\A[0-9a-f]{40}\z/i) &&
          system("git", "-C", root, "cat-file", "-e", "#{revision}:workflows", out: File::NULL, err: File::NULL)
      end
      if workflow_git_root
        IO.popen(["git", "-C", workflow_git_root, "ls-tree", "--name-only", "#{revision}:workflows"], &:read).lines.each do |name|
          name = name.strip
          managed << "workflows/#{name}" unless name.empty? || name.start_with?(".") || name.include?("/") || [".", ".."].include?(name)
        end
      end
      if metadata["delivery_mode"] == "flat" || delivery_mode == "flat"
        Dir.glob(File.join(source, "skills", "*")).each do |path|
          managed << "skills/#{File.basename(path) }" if mode == "copy" || File.directory?(path)
        end
      end
      if metadata["delivery_mode"] == "flat"
        git_root = roots.find do |root|
          File.directory?(root) && revision.to_s.match?(/\A[0-9a-f]{40}\z/i) &&
            system("git", "-C", root, "cat-file", "-e", "#{revision}:skills", out: File::NULL, err: File::NULL)
        end
        if git_root
          recorded_directory = lambda do |path|
            current = Pathname.new(path)
            visited = {}
            loop do
              resolved = current.cleanpath.to_s
              break false if current.absolute? || resolved == ".." || resolved.start_with?("../") || visited[resolved]

              visited[resolved] = true
              entry = IO.popen(
                ["git", "-C", git_root, "ls-tree", "-z", revision, "--", resolved],
                err: File::NULL,
                &:read
              )
              break false unless $?.success?

              object, entry_name = entry.delete_suffix("\0").split("\t", 2)
              break false unless entry_name == resolved

              file_mode, object_type = object.split(" ", 3)
              break true if object_type == "tree"
              break false unless file_mode == "120000" && object_type == "blob"

              link_target = IO.popen(
                ["git", "-C", git_root, "cat-file", "-p", "#{revision}:#{resolved}"],
                err: File::NULL,
                &:read
              )
              break false unless $?.success?

              link_path = Pathname.new(link_target)
              break false if link_path.absolute?

              current = Pathname.new(resolved).dirname.join(link_path)
            end
          end
          tree = IO.popen(["git", "-C", git_root, "ls-tree", "-z", "#{revision}:skills"], &:read)
          tree.split("\0").each do |record|
            object, name = record.split("\t", 2)
            next unless name
            next if name.empty? || name.start_with?(".") || name.include?("/") || [".", ".."].include?(name)

            file_mode, object_type = object.split(" ", 3)
            managed_entry = metadata["mode"] == "copy" || object_type == "tree"
            if !managed_entry && file_mode == "120000"
              managed_entry = recorded_directory.call("skills/#{name}")
            end
            managed << "skills/#{name}" if managed_entry
          end
        end
      end
      managed.uniq.each do |path|
        path = path.delete_suffix("/")
        target_path = File.join(target, path)
        path = "#{path}/" if File.directory?(target_path) && !File.symlink?(target_path)
        STDOUT.write(path)
        STDOUT.write("\0")
      end
    ' "$target" "$source" "$host" "$delivery_mode" "$metadata_path" "$mode" > "$backup_manifest"
    cat "$backup_recovery_artifact_manifest" >> "$backup_manifest"
    : > "$backup_symlink_manifest"
    snapshot_symlink_roots=()
    for path in "${managed_snapshot_roots[@]}"; do
      snapshot_root_is_active "$path" || continue
      path_is_within_snapshot_symlink_root "$path" && continue
      if [[ -L "$target/$path" ]]; then
        printf '%s\0' "$path" >> "$backup_symlink_manifest"
        mkdir -p "$backup_target_dir/$(dirname "$path")"
        cp -a "$target/$path" "$backup_target_dir/$path"
        snapshot_symlink_roots+=("$path")
      fi
    done
    : > "$backup_existing_manifest"
    : > "$backup_followed_manifest"
    while IFS= read -r -d '' path; do
      path_is_snapshot_symlink_root "$path" && continue
      if path_is_within_snapshot_symlink_root "$path"; then
        path="${path%/}"
        if path_is_within_traversed_snapshot_symlink_root "$path"; then
          printf '%s\0' "$path" >> "$backup_followed_manifest"
          if [[ -e "$target/$path" || -L "$target/$path" ]]; then
            mkdir -p "$backup_followed_dir/$(dirname "$path")"
            cp -a "$target/$path" "$backup_followed_dir/$path"
          fi
        fi
        continue
      fi
      if [[ -e "$target/$path" || -L "$target/$path" ]]; then
        printf '%s\0' "$path" >> "$backup_existing_manifest"
      fi
    done < "$backup_manifest"
    # --files-from changes rsync's -a behavior: recursion must be explicit.
    rsync -a -r --exclude='/bin/agent_doctor/.agent-stack-managed' \
      --from0 --files-from="$backup_existing_manifest" "$target/" "$backup_target_dir/"
  fi
}

cleanup_new_migration_staging() {
  [[ "${migration_receipt_existed:-false}" != "true" ]] || return 0
  local cleanup_target="${backup_canonical_target:-$target}"
  local receipt="$cleanup_target/.agent-workflows-migration-staging"
  [[ -e "$receipt" || -L "$receipt" ]] || return 0

  ruby -rfileutils -e '
    target, receipt = ARGV
    target_stat = File.lstat(target)
    abort unless target_stat.directory? && !target_stat.symlink?
    receipt_stat = File.lstat(receipt)
    abort unless receipt_stat.file? && !receipt_stat.symlink?
    receipt_contents = File.binread(receipt)
    lines = receipt_contents.lines(chomp: true)
    abort unless lines.length == 1
    staging = File.expand_path(lines.fetch(0))
    abort unless File.dirname(staging) == File.realpath(target)
    abort unless File.basename(staging).match?(/\A\.agent-workflows-flat-migration-.+\z/)
    if File.exist?(staging) || File.symlink?(staging)
      staging_stat = File.lstat(staging)
      abort unless staging_stat.directory? && !staging_stat.symlink?
      FileUtils.remove_entry_secure(staging, true)
    end
    abort if File.exist?(staging) || File.symlink?(staging)
    current_receipt_stat = File.lstat(receipt)
    abort unless current_receipt_stat.dev == receipt_stat.dev &&
                 current_receipt_stat.ino == receipt_stat.ino &&
                 File.binread(receipt) == receipt_contents
    File.unlink(receipt)
  ' "$cleanup_target" "$receipt"
}

restore_target() {
  local path index current_source_inventory_fingerprint
  local -a absent_containers=()
  local rollback_complete=true
  # Rollback is best-effort across every managed path. Record individual I/O
  # failures and continue so the operator gets a reliable incomplete receipt.
  set +e
  trap 'rollback_complete=false' ERR
  if [[ "${target_existed:-false}" = "true" ]]; then
    cleanup_new_migration_staging || rollback_complete=false
    mkdir -p "$target"
    while IFS= read -r -d '' path; do
      if [[ -L "$target/$path" ]]; then
        rm -f "$target/$path"
      elif [[ -e "$target/$path" ]]; then
        rm -rf -- "${target:?}/$path"
      fi
      mkdir -p "$target/$(dirname "$path")"
      cp -a "$backup_target_dir/$path" "$target/$path"
    done < "$backup_symlink_manifest"
    while IFS= read -r -d '' path; do
      path_is_within_snapshot_symlink_root "$path" && continue
      if [[ -d "$backup_target_dir/$path" && ! -L "$backup_target_dir/$path" ]]; then
        if [[ -L "$target/$path" || ( -e "$target/$path" && ! -d "$target/$path" ) ]]; then
          rm -rf -- "${target:?}/$path"
        fi
        mkdir -p "$target/$path"
        if [[ ! -d "$target/$path" || -L "$target/$path" ]]; then
          rollback_complete=false
          continue
        fi
        if [[ "${path%/}" = "bin/agent_doctor" ]]; then
          rsync -a --delete --exclude='/.agent-stack-managed' "$backup_target_dir/$path"/ "$target/$path"/
        else
          rsync -a --delete "$backup_target_dir/$path"/ "$target/$path"/
        fi
      elif [[ -e "$backup_target_dir/$path" || -L "$backup_target_dir/$path" ]]; then
        if [[ -L "$target/$path" || -e "$target/$path" ]]; then
          rm -rf -- "${target:?}/$path"
        fi
        mkdir -p "$(dirname "$target/$path")"
        cp -a "$backup_target_dir/$path" "$target/$path"
      else
        rm -rf -- "${target:?}/$path"
      fi
    done < "$backup_manifest"
    while IFS= read -r -d '' path; do
      if [[ -L "$target/$path" || -e "$target/$path" ]]; then
        rm -rf -- "${target:?}/$path"
      fi
      if [[ -L "$backup_followed_dir/$path" || -e "$backup_followed_dir/$path" ]]; then
        mkdir -p "$(dirname "$target/$path")"
        cp -a "$backup_followed_dir/$path" "$target/$path"
      fi
    done < "$backup_followed_manifest"
    while IFS= read -r -d '' path; do
      absent_containers+=("$path")
    done < "$backup_absent_container_manifest"
    for ((index = ${#absent_containers[@]} - 1; index >= 0; index--)); do
      rmdir "$target/${absent_containers[index]}" 2>/dev/null || true
    done
    if [[ "${migration_receipt_existed:-false}" = "true" ]]; then
      if [[ -e "$backup_migration_staging_path" || -L "$backup_migration_staging_path" ]]; then
        rm -rf -- "${backup_migration_staging_path:?}"
      fi
      cp -a "$backup_migration_staging_dir" "$backup_migration_staging_path"
      rm -f -- "$target/.agent-workflows-migration-staging"
      cp -a "$backup_migration_receipt" "$target/.agent-workflows-migration-staging"
    fi
    current_source_inventory_fingerprint="$(source_managed_inventory_fingerprint "$backup_includes_flat_skills")"
    if [[ "$current_source_inventory_fingerprint" != "$backup_source_inventory_fingerprint" ]]; then
      echo "ROLLBACK_SOURCE_CHANGED: managed source inventory changed after the rollback snapshot." >&2
      rollback_complete=false
    fi
    current_recovery_artifact_manifest="$backup_dir/current-recovery-artifacts"
    if ! recovery_artifact_inventory > "$current_recovery_artifact_manifest"; then
      rollback_complete=false
    elif ! cmp -s "$backup_recovery_artifact_manifest" "$current_recovery_artifact_manifest"; then
      echo "ROLLBACK_RECOVERY_ARTIFACTS_CHANGED: installer recovery artifacts changed after the rollback snapshot." >&2
      rollback_complete=false
    fi
  else
    rm -rf "$target"
  fi
  trap - ERR
  if [[ "$rollback_complete" != "true" ]]; then
    echo "ROLLBACK_INCOMPLETE: managed state under $target could not be fully restored or verified." >&2
    return 1
  fi
  echo "ROLLBACK_COMPLETE target=$target"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      host="${2:?--host requires codex, claude, cursor, or auto}"
      shift 2
      ;;
    --target)
      target="${2:?--target requires a directory}"
      shift 2
      ;;
    --source)
      source="${2:?--source requires a directory}"
      shift 2
      ;;
    --mode)
      mode="${2:?--mode requires copy or symlink}"
      shift 2
      ;;
    --delivery-mode)
      delivery_mode="${2:?--delivery-mode requires flat or plugin-companion}"
      shift 2
      ;;
    --consumer-root)
      consumer_roots+=("${2:?--consumer-root requires a directory}")
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --no-fetch)
      fetch=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

case "$host" in
  codex|claude|cursor|auto) ;;
  *)
    echo "--host must be codex, claude, cursor, or auto, got: $host" >&2
    exit 64
    ;;
esac

case "${mode:-copy}" in
  copy|symlink) ;;
  *)
    echo "--mode must be copy or symlink, got: $mode" >&2
    exit 64
    ;;
esac

case "${delivery_mode:-flat}" in
  flat|plugin-companion) ;;
  *)
    echo "--delivery-mode must be flat or plugin-companion, got: $delivery_mode" >&2
    exit 64
    ;;
esac

resolved="$(resolve_host_and_target)"
host="${resolved%%:*}"
target="${resolved#*:}"
metadata_path="$target/$metadata_name"

if [[ -z "$source" ]]; then
  source="$(metadata_value "$metadata_path" source 2>/dev/null || printf '%s\n' "$script_root")"
fi
if [[ ! -d "$source" ]]; then
  echo "CHECK_FAILED missing source root: $source" >&2
  exit 3
fi
source="$(cd "$source" && pwd)"

if [[ -z "$mode" ]]; then
  mode="$(metadata_value "$metadata_path" mode 2>/dev/null || printf 'copy\n')"
fi
if [[ -z "$delivery_mode" ]]; then
  delivery_mode="$(metadata_value "$metadata_path" delivery_mode 2>/dev/null || printf 'flat\n')"
fi

status_script="$source/bin/agent-workflows-status"
install_script="$source/bin/install-agent-workflows"

if [[ ! -x "$status_script" || ! -x "$install_script" ]]; then
  echo "CHECK_FAILED missing agent-workflows scripts in source: $source" >&2
  exit 3
fi

if [[ "$dry_run" = "true" ]]; then
  status_args=(--host "$host" --target "$target" --source "$source" --delivery-mode "$delivery_mode")
  if [[ "$fetch" = "true" ]]; then
    status_args+=(--fetch)
  fi
  set +e
  "$status_script" "${status_args[@]}"
  status=$?
  set -e
  if [[ "$status" -eq 3 ]]; then
    exit 3
  fi
  exit 0
fi

old_revision="$(metadata_value "$metadata_path" source_revision 2>/dev/null || printf 'unknown\n')"

if [[ "$fetch" = "true" ]]; then
  update_source_clone
fi

backup_target
completed=false
trap 'status=$?; set +e; if [[ "$completed" != "true" ]]; then (restore_target); fi; exit "$status"' ERR

"$install_script" --host "$host" --target "$target" --mode "$mode" --delivery-mode "$delivery_mode"

if [[ "${#consumer_roots[@]}" -gt 0 ]]; then
  for consumer_root in "${consumer_roots[@]}"; do
    "$target/bin/agent-workflow-seam-doctor" --root "$consumer_root" --shared "$source"
  done
fi

completed=true
trap - ERR

new_revision="$(metadata_value "$metadata_path" source_revision 2>/dev/null || printf 'unknown\n')"
echo "UPGRADE_COMPLETE $(short_revision "$old_revision") $(short_revision "$new_revision") target=$target source=$source"
