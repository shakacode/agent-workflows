#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: install-agent-workflows [--host codex|claude|auto] [--target DIR] [--mode copy|symlink] [--delivery-mode flat|plugin-companion]

Installs this shared workflow pack into an agent home.

Default targets:
  --host codex   ${CODEX_HOME:-$HOME/.codex}
  --host claude  ${CLAUDE_HOME:-$HOME/.claude}
  --host auto    infer from an explicit target's host markers; an unmarked explicit target defaults to Codex

Installed paths:
  <target>/LICENSE
  <target>/skills/* (flat delivery mode only)
  <target>/workflows/*
  <target>/docs/coordination-backend.md
  <target>/docs/execution-provenance-schema.md
  <target>/docs/review-finding-schema.md
  <target>/docs/agent-workflows-model-routing.md
  <target>/docs/user-facing-coordination.md
  <target>/docs/solutions/*
  <target>/bin/agent-workflow-seam-doctor
  <target>/bin/validate-execution-provenance
  <target>/bin/agent-workflows-doctor
  <target>/bin/agent_doctor/*
  <target>/bin/agent-workflows-status
  <target>/bin/upgrade-agent-workflows
  <target>/lib/agent-workflows/secure_github_actions_scanner.rb (plugin-companion mode only)
  <target>/.agent-workflows-install.json
USAGE
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host="codex"
target=""
mode="copy"
delivery_mode=""
installed_metadata_was_absent=false
metadata_name=".agent-workflows-install.json"
doctor_managed_marker=".agent-workflows-managed"
doctor_ownership_helper="$repo_root/bin/agent_doctor/install_ownership.rb"
delivery_state_script="$repo_root/bin/agent-workflows-delivery-state"
bin_helpers=(
  agent-workflow-seam-doctor
  agent-workflows-delivery-state
  agent-workflows-doctor
  agent-workflows-status
  agent-workflows-trust-audit
  install-agent-workflows
  upgrade-agent-workflows
  validate-execution-provenance
)
pack_docs=(
  coordination-backend.md
  execution-provenance-schema.md
  review-finding-schema.md
  agent-workflows-model-routing.md
  user-facing-coordination.md
)
for solution_path in "$repo_root"/docs/solutions/*; do
  [[ -f "$solution_path" && ! -L "$solution_path" ]] || continue
  pack_docs+=("solutions/$(basename "$solution_path")")
done

default_target_for_host() {
  case "$1" in
    codex)
      printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
      ;;
    claude)
      printf '%s\n' "${CLAUDE_HOME:-$HOME/.claude}"
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_auto_target() {
  local codex_home="${CODEX_HOME:-$HOME/.codex}"
  local claude_home="${CLAUDE_HOME:-$HOME/.claude}"
  local -a candidates=()

  if [[ -n "${CODEX_HOME:-}" || -d "$codex_home" ]]; then
    candidates+=("codex:$codex_home")
  fi
  if [[ -n "${CLAUDE_HOME:-}" || -d "$claude_home" ]]; then
    candidates+=("claude:$claude_home")
  fi

  case "${#candidates[@]}" in
    0)
      printf 'codex:%s\n' "$codex_home"
      ;;
    1)
      printf '%s\n' "${candidates[0]}"
      ;;
    *)
      echo "Auto host detection found both Codex and Claude homes; pass --host codex or --host claude." >&2
      return 64
      ;;
  esac
}

resolve_host_and_target() {
  if [[ -n "$target" ]]; then
    target="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "$target")"
    if [[ "$host" = "auto" ]]; then
      local codex_home claude_home
      codex_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CODEX_HOME:-$HOME/.codex}")"
      claude_home="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "${CLAUDE_HOME:-$HOME/.claude}")"
      local codex_marker=false claude_marker=false
      [[ "$target" = "$codex_home" || -f "$target/config.toml" ]] && codex_marker=true
      [[ "$target" = "$claude_home" || -f "$target/settings.json" || -f "$target/plugins/installed_plugins.json" ]] && claude_marker=true
      if [[ "$codex_marker" = true && "$claude_marker" = true ]]; then
        echo "Explicit target has both Codex and Claude markers; pass --host codex or --host claude." >&2
        return 64
      elif [[ "$claude_marker" = true ]]; then
        printf 'claude:%s\n' "$target"
      elif [[ "$codex_marker" = true ]]; then
        printf 'codex:%s\n' "$target"
      else
        printf 'codex:%s\n' "$target"
      fi
    else
      printf '%s:%s\n' "$host" "$target"
    fi
    return 0
  fi

  if [[ "$host" = "auto" ]]; then
    resolve_auto_target
  else
    printf '%s:%s\n' "$host" "$(default_target_for_host "$host")"
  fi
}

metadata_value() {
  local key="$1"
  case "$key" in
    version)
      if [[ -f "$repo_root/VERSION" ]]; then
        tr -d '\r\n' < "$repo_root/VERSION"
      else
        printf 'unknown\n'
      fi
      ;;
    source_revision)
      git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf 'unknown\n'
      ;;
    source_branch)
      git -C "$repo_root" branch --show-current 2>/dev/null || true
      ;;
    source_remote)
      git -C "$repo_root" config --get remote.origin.url 2>/dev/null || true
      ;;
    *)
      return 1
      ;;
  esac
}

read_installed_metadata_value() {
  local key="$1"
  local metadata_path="${2:-$target/$metadata_name}"
  local protocol encoded_value decoded_value sentinel=$'\036'
  installed_metadata_state="corrupt"
  installed_metadata_value=""

  if ! protocol="$(ruby -rjson -e '
    begin
      path = ARGV.fetch(0)
      stat = File.lstat(path)
      unless stat.file? && !stat.symlink? && File.const_defined?(:NOFOLLOW)
        puts "corrupt"
        exit
      end
      file = File.open(path, File::RDONLY | File::NONBLOCK | File::NOFOLLOW)
      opened_stat = file.stat
      unless opened_stat.file? && opened_stat.dev == stat.dev && opened_stat.ino == stat.ino
        puts "corrupt"
        exit
      end
      source = file.read
      metadata = JSON.parse(source)
      path_stat = File.lstat(path)
      file.rewind
      reread_source = file.read
      final_stat = file.stat
      unless path_stat.file? && !path_stat.symlink? &&
             path_stat.dev == opened_stat.dev && path_stat.ino == opened_stat.ino &&
             final_stat.file? && final_stat.dev == opened_stat.dev && final_stat.ino == opened_stat.ino &&
             reread_source == source
        puts "corrupt"
        exit
      end
      unless metadata.is_a?(Hash)
        puts "corrupt"
        exit
      end
      key = ARGV.fetch(1)
      unless metadata.key?(key)
        puts "key_absent"
        exit
      end
      value = metadata[key]
      unless value.is_a?(String) && !value.empty? && !value.include?("\0")
        puts "corrupt"
        exit
      end
      if key == "delivery_mode"
        case value
        when "flat" then puts "delivery_mode:flat"
        when "plugin-companion" then puts "delivery_mode:plugin-companion"
        else puts "delivery_mode:invalid"
        end
        exit
      end
      puts "valid:#{[value].pack("m0")}"
    rescue Errno::ENOENT
      puts "corrupt"
    rescue StandardError
      puts "corrupt"
    ensure
      file&.close
    end
  ' "$metadata_path" "$key" 2>/dev/null)"; then
    return 0
  fi

  case "$protocol" in
    delivery_mode:flat)
      installed_metadata_state="valid"
      installed_metadata_value="flat"
      ;;
    delivery_mode:plugin-companion)
      installed_metadata_state="valid"
      installed_metadata_value="plugin-companion"
      ;;
    delivery_mode:invalid) installed_metadata_state="invalid" ;;
    valid:*)
      encoded_value="${protocol#valid:}"
      if decoded_value="$(ruby -e 'print ARGV.fetch(0).unpack1("m0")' "$encoded_value" 2>/dev/null && printf '\036')" &&
         [[ "$decoded_value" == *"$sentinel" ]]; then
        installed_metadata_value="${decoded_value%"$sentinel"}"
        installed_metadata_state="valid"
      fi
      ;;
    key_absent) installed_metadata_state="key_absent" ;;
    corrupt) ;;
  esac
  return 0
}

capture_installed_metadata_for_recovery() {
  local original_attestation current_attestation backup_attestation snapshot_attestation sentinel_attestation
  local original_identity backup_identity sentinel_identity
  recovery_metadata_path="$target/$metadata_name"
  recovery_metadata_quarantine=""
  recovery_metadata_snapshot=""
  recovery_metadata_backup=""
  recovery_metadata_sentinel_identity=""
  recovery_metadata_snapshot_identity=""
  recovery_metadata_backup_identity=""
  recovery_metadata_quarantine_identity=""
  recovery_metadata_cleanup_receipt=""
  recovery_metadata_digest=""
  recovery_metadata_captured=false

  if installed_metadata_blocking_recovery_residue_exists; then
    return 66
  fi
  if [[ ! -e "$recovery_metadata_path" && ! -L "$recovery_metadata_path" ]]; then
    [[ "$installed_metadata_was_absent" = "true" ]] && return 68
    return 1
  fi
  if ! original_attestation="$(regular_file_attestation "$recovery_metadata_path")"; then
    return 1
  fi
  original_identity="${original_attestation%%|*}"
  recovery_metadata_digest="${original_attestation#*|}"
  if [[ -z "$original_identity" || -z "$recovery_metadata_digest" ]]; then
    return 1
  fi

  if ! recovery_metadata_quarantine="$(mktemp -d "$target/$metadata_name.recovery-XXXXXX")"; then
    return 70
  fi
  if ! recovery_metadata_quarantine_identity="$(recovery_directory_identity "$recovery_metadata_quarantine")"; then
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 70
  fi
  recovery_metadata_cleanup_receipt="$target/$metadata_name.cleanup-complete-${recovery_metadata_quarantine##*.recovery-}"
  if [[ -e "$recovery_metadata_cleanup_receipt" || -L "$recovery_metadata_cleanup_receipt" ]]; then
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 70
  fi
  recovery_metadata_snapshot="$recovery_metadata_quarantine/metadata"
  recovery_metadata_backup="$recovery_metadata_quarantine/original-backup"
  recovery_metadata_sentinel="$recovery_metadata_quarantine/sentinel"
  if ! cp -pP "$recovery_metadata_path" "$recovery_metadata_backup"; then
    rm -f "$recovery_metadata_backup" 2>/dev/null || true
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 70
  fi
  if ! current_attestation="$(regular_file_attestation "$recovery_metadata_path")" ||
     [[ "$current_attestation" != "$original_attestation" ]] ||
     ! backup_attestation="$(regular_file_attestation "$recovery_metadata_backup")"; then
    rm -f "$recovery_metadata_backup" 2>/dev/null || true
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 1
  fi
  backup_identity="${backup_attestation%%|*}"
  if [[ "${backup_attestation#*|}" != "$recovery_metadata_digest" || -z "$backup_identity" ]]; then
    rm -f "$recovery_metadata_backup" 2>/dev/null || true
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 1
  fi
  if ! cp -pP "$recovery_metadata_backup" "$recovery_metadata_sentinel" ||
     ! sentinel_attestation="$(regular_file_attestation "$recovery_metadata_sentinel")" ||
     [[ "${sentinel_attestation#*|}" != "$recovery_metadata_digest" ]]; then
    rm -f "$recovery_metadata_backup" "$recovery_metadata_sentinel" 2>/dev/null || true
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 70
  fi
  sentinel_identity="${sentinel_attestation%%|*}"

  if ! ln "$recovery_metadata_path" "$recovery_metadata_snapshot" ||
     ! snapshot_attestation="$(regular_file_attestation "$recovery_metadata_snapshot")" ||
     [[ "$snapshot_attestation" != "$original_attestation" ]]; then
    rm -f "$recovery_metadata_snapshot" "$recovery_metadata_backup" "$recovery_metadata_sentinel" 2>/dev/null || true
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 70
  fi
  if ! current_attestation="$(regular_file_attestation "$recovery_metadata_path")" ||
     [[ "$current_attestation" != "$original_attestation" ]] ||
     ! mv "$recovery_metadata_sentinel" "$recovery_metadata_path"; then
    rm -f "$recovery_metadata_snapshot" "$recovery_metadata_backup" "$recovery_metadata_sentinel" 2>/dev/null || true
    rmdir "$recovery_metadata_quarantine" 2>/dev/null || true
    return 1
  fi
  recovery_metadata_sentinel_identity="$sentinel_identity"
  recovery_metadata_snapshot_identity="$original_identity"
  recovery_metadata_backup_identity="$backup_identity"
  recovery_metadata_captured=true
  if ! snapshot_attestation="$(regular_file_attestation "$recovery_metadata_snapshot")" ||
     [[ "$snapshot_attestation" != "$original_attestation" ]] ||
     ! current_attestation="$(regular_file_attestation "$recovery_metadata_path")" ||
     [[ "$current_attestation" != "$sentinel_attestation" ]]; then
    return 1
  fi
}

installed_metadata_blocking_recovery_residue_exists() {
  local cleanup_receipt residue
  for residue in "$target/$metadata_name".recovery-*; do
    [[ -e "$residue" || -L "$residue" ]] || continue
    cleanup_receipt="$target/$metadata_name.cleanup-complete-${residue##*.recovery-}"
    recovery_metadata_cleanup_receipt_valid "$residue" "$cleanup_receipt" && continue
    return 0
  done
  return 1
}

recovery_metadata_cleanup_receipt_valid() {
  ruby -e '
    receipt_file = nil
    begin
      residue = File.expand_path(ARGV.fetch(0))
      receipt = File.expand_path(ARGV.fetch(1))
      residue_stat = File.lstat(residue)
      abort unless residue_stat.directory? && !residue_stat.symlink?
      %w[metadata original-backup sentinel].each do |name|
        path = File.join(residue, name)
        begin
          File.lstat(path)
          abort
        rescue Errno::ENOENT
          nil
        end
      end
      receipt_stat = File.lstat(receipt)
      abort unless receipt_stat.file? && !receipt_stat.symlink? && File.const_defined?(:NOFOLLOW)
      receipt_file = File.open(receipt, File::RDONLY | File::NONBLOCK | File::NOFOLLOW)
      opened_stat = receipt_file.stat
      abort unless opened_stat.file? && opened_stat.dev == receipt_stat.dev && opened_stat.ino == receipt_stat.ino
      identity = receipt_file.read
      final_stat = receipt_file.stat
      named_stat = File.lstat(receipt)
      abort unless final_stat.dev == opened_stat.dev && final_stat.ino == opened_stat.ino &&
                   named_stat.file? && !named_stat.symlink? &&
                   named_stat.dev == opened_stat.dev && named_stat.ino == opened_stat.ino
      abort unless identity == "#{residue_stat.dev}:#{residue_stat.ino}"
    ensure
      receipt_file&.close
    end
  ' "$1" "$2" 2>/dev/null
}

write_recovery_metadata_cleanup_receipt() {
  ruby -e '
    file = nil
    begin
      path = File.expand_path(ARGV.fetch(0))
      identity = ARGV.fetch(1)
      file = File.open(path, File::WRONLY | File::CREAT | File::EXCL | File::NOFOLLOW, 0o600)
      file.write(identity)
      file.flush
      file.fsync
    ensure
      file&.close
    end
  ' "$recovery_metadata_cleanup_receipt" "$recovery_metadata_quarantine_identity" 2>/dev/null
}

regular_file_attestation() {
  ruby -rdigest -e '
    file = nil
    begin
      path = ARGV.fetch(0)
      path_stat = File.lstat(path)
      abort unless path_stat.file? && !path_stat.symlink? && File.const_defined?(:NOFOLLOW)
      file = File.open(path, File::RDONLY | File::NONBLOCK | File::NOFOLLOW)
      opened_stat = file.stat
      abort unless opened_stat.file? && opened_stat.dev == path_stat.dev && opened_stat.ino == path_stat.ino
      digest = Digest::SHA256.new
      while (chunk = file.read(64 * 1024))
        digest.update(chunk)
      end
      final_stat = file.stat
      path_stat = File.lstat(path)
      abort unless final_stat.file? && final_stat.dev == opened_stat.dev && final_stat.ino == opened_stat.ino &&
                   path_stat.file? && !path_stat.symlink? &&
                   path_stat.dev == opened_stat.dev && path_stat.ino == opened_stat.ino
      print "#{opened_stat.dev}:#{opened_stat.ino}|#{digest.hexdigest}"
    ensure
      file&.close
    end
  ' "$1" 2>/dev/null
}

recovery_metadata_binding_intact() {
  local sentinel_attestation snapshot_attestation backup_attestation
  [[ "$recovery_metadata_captured" = "true" ]] || return 1
  sentinel_attestation="$(regular_file_attestation "$recovery_metadata_path")" || return 1
  snapshot_attestation="$(regular_file_attestation "$recovery_metadata_snapshot")" || return 1
  backup_attestation="$(regular_file_attestation "$recovery_metadata_backup")" || return 1
  [[ "$sentinel_attestation" = "$recovery_metadata_sentinel_identity|$recovery_metadata_digest" &&
     "$snapshot_attestation" = "$recovery_metadata_snapshot_identity|$recovery_metadata_digest" &&
     "$backup_attestation" = "$recovery_metadata_backup_identity|$recovery_metadata_digest" ]]
}

recovery_metadata_restore_binding_intact() {
  local sentinel_attestation backup_attestation
  [[ "$recovery_metadata_captured" = "true" ]] || return 1
  sentinel_attestation="$(regular_file_attestation "$recovery_metadata_path")" || return 1
  backup_attestation="$(regular_file_attestation "$recovery_metadata_backup")" || return 1
  [[ "$sentinel_attestation" = "$recovery_metadata_sentinel_identity|$recovery_metadata_digest" &&
     "$backup_attestation" = "$recovery_metadata_backup_identity|$recovery_metadata_digest" ]]
}

recovery_metadata_sentinel_intact() {
  [[ "$recovery_metadata_captured" = "true" ]] || return 1
  [[ "$(regular_file_attestation "$recovery_metadata_path" 2>/dev/null || true)" = \
     "$recovery_metadata_sentinel_identity|$recovery_metadata_digest" ]]
}

restore_captured_recovery_metadata() {
  local expected_restore_attestation snapshot_attestation restored_attestation restore_source
  [[ "$recovery_metadata_captured" = "true" ]] || return 0
  recovery_metadata_restore_binding_intact || {
    recovery_metadata_sentinel_intact && return 67
    return 65
  }
  snapshot_attestation="$(regular_file_attestation "$recovery_metadata_snapshot")" || true
  if [[ "$snapshot_attestation" = "$recovery_metadata_snapshot_identity|$recovery_metadata_digest" ]]; then
    restore_source="$recovery_metadata_snapshot"
    expected_restore_attestation="$recovery_metadata_snapshot_identity|$recovery_metadata_digest"
  else
    restore_source="$recovery_metadata_backup"
    expected_restore_attestation="$recovery_metadata_backup_identity|$recovery_metadata_digest"
  fi
  if ! mv "$restore_source" "$recovery_metadata_path"; then
    recovery_metadata_sentinel_intact && return 67
    return 65
  fi
  restored_attestation="$(regular_file_attestation "$recovery_metadata_path")" || return 65
  [[ "$restored_attestation" = "$expected_restore_attestation" ]] || return 65
  if ! write_recovery_metadata_cleanup_receipt; then
    recovery_metadata_captured=false
    return 70
  fi
  recovery_metadata_captured=false
  rm -f "$recovery_metadata_snapshot" "$recovery_metadata_backup" 2>/dev/null || true
  if ! rmdir "$recovery_metadata_quarantine" 2>/dev/null; then
    echo "RECOVERY_METADATA_CLEANUP_PENDING: preserved $recovery_metadata_quarantine" >&2
  else
    rm -f "$recovery_metadata_cleanup_receipt" 2>/dev/null || true
  fi
}

report_corrupt_install_metadata() {
  local residue_may_explain="${1:-false}"
  local metadata_path="$target/$metadata_name"
  local residue
  local residue_present=false
  for residue in "$metadata_path".recovery-*; do
    [[ -e "$residue" || -L "$residue" ]] || continue
    residue_present=true
    if [[ ! -d "$residue" || -L "$residue" ]]; then
      echo "Unexpected recovery residue $residue blocks recovery; remove it only after confirming it holds no needed data." >&2
    fi
  done
  for residue in "$metadata_path".recovery-*; do
    [[ -d "$residue" && ! -L "$residue" ]] || continue
    echo "Preserved recovery metadata quarantine $residue; do not delete it while recovering the target." >&2
  done
  if [[ "$residue_present" = "true" && "$residue_may_explain" = "true" ]]; then
    return 0
  fi
  echo "CORRUPT_INSTALL_METADATA: cannot read valid install metadata from $metadata_path." >&2
  echo "Restore a valid backup of that file. If none exists, preserve the corrupt target and reinstall into a new empty target with the verified layout as --delivery-mode flat|plugin-companion." >&2
}

report_recovery_metadata_restore_failure() {
  recovery_metadata_restore_reported=true
  if recovery_metadata_sentinel_intact; then
    echo "RECOVERY_METADATA_RESTORE_FAILED: verified install metadata remains in place; preserved recovery metadata quarantine for retry." >&2
  else
    report_corrupt_install_metadata
    echo "RECOVERY_FAILED: install metadata could not be restored; preserved pending recovery state." >&2
  fi
}

report_invalid_install_delivery_mode() {
  echo "Installed metadata delivery_mode must be flat or plugin-companion." >&2
  echo "Restore a valid backup of $target/$metadata_name or reinstall into a new empty target with the verified layout as --delivery-mode flat|plugin-companion." >&2
}

resolve_delivery_mode() {
  local metadata_path="$target/$metadata_name"
  local recorded_mode

  if [[ ! -e "$metadata_path" && ! -L "$metadata_path" ]]; then
    installed_metadata_was_absent=true
    [[ -n "$delivery_mode" ]] || delivery_mode="flat"
    return 0
  fi
  read_installed_metadata_value delivery_mode

  case "$installed_metadata_state" in
    valid)
      recorded_mode="$installed_metadata_value"
      [[ -n "$delivery_mode" ]] || delivery_mode="$recorded_mode"
      ;;
    key_absent) [[ -n "$delivery_mode" ]] || delivery_mode="flat" ;;
    invalid)
      report_invalid_install_delivery_mode
      return 64
      ;;
    corrupt)
      report_corrupt_install_metadata
      return 65
      ;;
  esac
}

validate_delivery_mode() {
  local label="$1"
  case "$delivery_mode" in
    ""|flat|plugin-companion) ;;
    *)
      echo "$label must be flat or plugin-companion, got: $delivery_mode" >&2
      exit 64
      ;;
  esac
}

prepare_metadata() {
  local metadata_path="$target/$metadata_name"
  local metadata_tmp="$metadata_path.tmp"
  local version source_revision source_branch source_remote installed_at
  version="$(metadata_value version)"
  source_revision="$(metadata_value source_revision)"
  source_branch="$(metadata_value source_branch)"
  source_remote="$(metadata_value source_remote)"
  installed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

  ruby -rjson -rdigest -rfind -e '
    path, host, mode, delivery_mode, source, version, revision, branch, remote, installed_at, *pack_docs = ARGV
    directory_fingerprint = lambda do |root|
      entries = []
      Find.find(root) do |entry|
        next if entry == root

        relative = entry.delete_prefix("#{root}/")
        if File.symlink?(entry)
          entries << ["symlink", relative, File.readlink(entry)]
        elsif File.directory?(entry)
          entries << ["directory", relative]
        elsif File.file?(entry)
          entries << ["file", relative, (File.stat(entry).mode & 0o111).positive?, Digest::SHA256.file(entry).hexdigest]
        else
          abort "unsupported skill entry while preparing install metadata: #{entry}"
        end
      end
      Digest::SHA256.hexdigest(JSON.generate(entries.sort_by { |fingerprint_entry| fingerprint_entry.fetch(1) }))
    end
    skill_fingerprints = if mode == "copy" && delivery_mode == "flat"
                           Dir.children(File.join(source, "skills")).sort.filter_map do |name|
                             root = File.join(source, "skills", name)
                             next unless File.directory?(root) && !File.symlink?(root)

                             [name, directory_fingerprint.call(root)]
                           end.to_h
                         else
                           {}
                         end
    doc_fingerprints = if mode == "copy"
                         pack_docs.to_h do |name|
                           doc = File.join(source, "docs", name)
                           abort "missing pack document while preparing install metadata: #{doc}" unless File.file?(doc) && !File.symlink?(doc)

                           [name, Digest::SHA256.file(doc).hexdigest]
                         end
                       else
                         {}
                       end
    metadata = {
      "host" => host,
      "mode" => mode,
      "delivery_mode" => delivery_mode,
      "source" => File.expand_path(source),
      "version" => version,
      "source_revision" => revision,
      "source_branch" => branch,
      "source_remote" => remote,
      "installed_at" => installed_at,
      "managed_skill_copy_fingerprints" => skill_fingerprints,
      "managed_pack_doc_copy_fingerprints" => doc_fingerprints
    }
    File.write(path, JSON.pretty_generate(metadata) + "\n")
  ' "$metadata_tmp" "$host" "$mode" "$delivery_mode" "$repo_root" "$version" "$source_revision" "$source_branch" "$source_remote" "$installed_at" "${pack_docs[@]}"
}

commit_metadata() {
  local metadata_path="$target/$metadata_name"
  local metadata_tmp="$metadata_path.tmp"
  mv "$metadata_tmp" "$metadata_path"
}

recovery_directory_identity() {
  ruby -e '
    path = ARGV.fetch(0)
    stat = File.lstat(path)
    exit 1 unless stat.directory? && !stat.symlink?
    verified = File.lstat(path)
    exit 1 unless verified.directory? && !verified.symlink? &&
                  verified.dev == stat.dev && verified.ino == stat.ino
    print "#{stat.dev}:#{stat.ino}"
  ' "$1" 2>/dev/null
}

move_bound_recovery_path() {
  ruby -e '
    begin
      source = File.expand_path(ARGV.fetch(0))
      destination = File.expand_path(ARGV.fetch(1))
      bound_path = File.expand_path(ARGV.fetch(2))
      expected_identity = ARGV.fetch(3)
      other_bound_path = ARGV[4] && File.expand_path(ARGV[4])
      other_expected_identity = ARGV[5]
      unless source == bound_path || File.dirname(source) == bound_path ||
             File.dirname(destination) == bound_path
        exit 67
      end
      bound_stat = File.lstat(bound_path)
      unless bound_stat.directory? && !bound_stat.symlink? &&
             "#{bound_stat.dev}:#{bound_stat.ino}" == expected_identity
        exit 67
      end
      other_bound_stat = nil
      if other_bound_path
        unless source == other_bound_path || File.dirname(source) == other_bound_path ||
               destination == other_bound_path || File.dirname(destination) == other_bound_path
          exit 67
        end
        other_bound_stat = File.lstat(other_bound_path)
        unless other_bound_stat.directory? && !other_bound_stat.symlink? &&
               "#{other_bound_stat.dev}:#{other_bound_stat.ino}" == other_expected_identity
          exit 67
        end
      end
      begin
        File.lstat(destination)
        exit 67
      rescue Errno::ENOENT
        nil
      end
      File.lstat(source)
      verified_stat = File.lstat(bound_path)
      unless verified_stat.directory? && !verified_stat.symlink? &&
             verified_stat.dev == bound_stat.dev && verified_stat.ino == bound_stat.ino
        exit 67
      end
      if other_bound_path
        other_verified_stat = File.lstat(other_bound_path)
        unless other_verified_stat.directory? && !other_verified_stat.symlink? &&
               other_verified_stat.dev == other_bound_stat.dev &&
               other_verified_stat.ino == other_bound_stat.ino
          exit 67
        end
      end
      File.rename(source, destination)
    rescue SystemCallError
      exit 1
    rescue StandardError
      exit 67
    end
  ' "$@" 2>/dev/null
}

restore_recovery_staging_moves() {
  local staging="$1"
  local staging_identity="$2"
  local skills_root="$3"
  local skills_identity="$4"
  shift 4
  local destination staged_path index move_status
  local -a destinations=("$@")
  for ((index = ${#destinations[@]} - 1; index >= 0; index--)); do
    destination="${destinations[$index]}"
    staged_path="$staging/$(basename "$destination")"
    move_status=0
    if [[ -e "$staged_path" || -L "$staged_path" || ! -e "$destination" && ! -L "$destination" ]]; then
      move_status=1
    else
      move_bound_recovery_path "$destination" "$staged_path" "$staging" "$staging_identity" \
        "$skills_root" "$skills_identity" || move_status=$?
    fi
    if [[ "$move_status" -ne 0 ]]; then
      echo "RECOVERY_STAGING_RESTORE_FAILED: preserved all remaining recovery artifacts for manual recovery." >&2
      if [[ "$move_status" -eq 67 ]]; then
        if [[ "$(recovery_directory_identity "$staging" 2>/dev/null || true)" != "$staging_identity" ]]; then
          echo "RECOVERY_STAGING_BINDING_CHANGED: refused to restore through a replaced staging path." >&2
        elif [[ "$(recovery_directory_identity "$skills_root" 2>/dev/null || true)" != "$skills_identity" ]]; then
          echo "RECOVERY_SKILLS_BINDING_CHANGED: refused to restore through a replaced skills path." >&2
        else
          echo "RECOVERY_PATH_BINDING_CHANGED: refused an unbound recovery move." >&2
        fi
        return 67
      fi
      return 1
    fi
  done
}

rollback_migration_staging() {
  local staging="$1"
  local bind_recovery_metadata="${2:-false}"
  local staging_identity="${3:-}"
  local skills_root="$target/skills"
  local staged_path destination move_status restore_status reversal_status skills_identity
  local -a moved_destinations=()
  local moved_count=0
  [[ -n "$staging" ]] || return 0
  if [[ -z "$staging_identity" ]]; then
    [[ -d "$staging" ]] || return 0
    staging_identity="$(recovery_directory_identity "$staging")" || return 1
  elif [[ "$(recovery_directory_identity "$staging" 2>/dev/null || true)" != "$staging_identity" ]]; then
    echo "RECOVERY_STAGING_BINDING_CHANGED: preserved recovery artifacts without moving them." >&2
    return 67
  fi
  if [[ -L "$skills_root" || -e "$skills_root" && ! -d "$skills_root" ]]; then
    echo "ROLLBACK_FAILED: unsafe skills root: $skills_root" >&2
    return 1
  fi
  mkdir -p "$skills_root"
  if [[ -L "$skills_root" || ! -d "$skills_root" ]] || ! ruby -e '
    target = File.realpath(ARGV.fetch(0))
    skills = File.realpath(ARGV.fetch(1))
    exit 1 unless File.dirname(skills) == target
  ' "$target" "$skills_root"; then
    echo "ROLLBACK_FAILED: unsafe skills root: $skills_root" >&2
    return 1
  fi
  skills_identity="$(recovery_directory_identity "$skills_root")" || return 1
  for staged_path in "$staging"/*; do
    [[ -e "$staged_path" || -L "$staged_path" ]] || continue
    if [[ -L "$skills_root" || ! -d "$skills_root" ]]; then
      echo "ROLLBACK_FAILED: skills root changed during rollback: $skills_root" >&2
      if [[ "$bind_recovery_metadata" = "true" && "$moved_count" -gt 0 ]]; then
        restore_status=0
        restore_recovery_staging_moves "$staging" "$staging_identity" "$skills_root" "$skills_identity" \
          "${moved_destinations[@]}" || restore_status=$?
        [[ "$restore_status" -eq 0 ]] || return "$restore_status"
      fi
      return 1
    fi
    destination="$target/skills/$(basename "$staged_path")"
    if [[ -e "$destination" || -L "$destination" ]]; then
      echo "ROLLBACK_FAILED: destination appeared during migration: $destination" >&2
      if [[ "$bind_recovery_metadata" = "true" && "$moved_count" -gt 0 ]]; then
        restore_status=0
        restore_recovery_staging_moves "$staging" "$staging_identity" "$skills_root" "$skills_identity" \
          "${moved_destinations[@]}" || restore_status=$?
        [[ "$restore_status" -eq 0 ]] || return "$restore_status"
      fi
      return 1
    fi
    move_status=0
    move_bound_recovery_path "$staged_path" "$destination" "$staging" "$staging_identity" \
      "$skills_root" "$skills_identity" || move_status=$?
    if [[ "$move_status" -ne 0 ]]; then
      if [[ "$bind_recovery_metadata" = "true" && "$moved_count" -gt 0 ]]; then
        restore_status=0
        restore_recovery_staging_moves "$staging" "$staging_identity" "$skills_root" "$skills_identity" \
          "${moved_destinations[@]}" || restore_status=$?
        [[ "$restore_status" -eq 0 ]] || return "$restore_status"
      fi
      if [[ "$move_status" -eq 67 ]]; then
        if [[ "$(recovery_directory_identity "$staging" 2>/dev/null || true)" != "$staging_identity" ]]; then
          echo "RECOVERY_STAGING_BINDING_CHANGED: preserved recovery artifacts without following a replaced staging path." >&2
        elif [[ "$(recovery_directory_identity "$skills_root" 2>/dev/null || true)" != "$skills_identity" ]]; then
          echo "RECOVERY_SKILLS_BINDING_CHANGED: preserved recovery artifacts without following a replaced skills path." >&2
        else
          echo "RECOVERY_PATH_BINDING_CHANGED: refused an unbound recovery move." >&2
        fi
        return 67
      fi
      return 1
    fi
    if [[ "$bind_recovery_metadata" = "true" ]]; then
      moved_destinations[moved_count]="$destination"
      moved_count=$((moved_count + 1))
      if [[ "$recovery_metadata_captured" = "true" ]] && ! recovery_metadata_binding_intact; then
        restore_status=0
        restore_recovery_staging_moves "$staging" "$staging_identity" "$skills_root" "$skills_identity" \
          "${moved_destinations[@]}" || restore_status=$?
        [[ "$restore_status" -eq 0 ]] || return "$restore_status"
        return 65
      fi
    fi
  done
  restore_status=0
  if [[ "$bind_recovery_metadata" = "true" ]]; then
    restore_captured_recovery_metadata || restore_status=$?
  fi
  if [[ "$restore_status" -ne 0 ]]; then
    if [[ "$moved_count" -gt 0 ]]; then
      reversal_status=0
      restore_recovery_staging_moves "$staging" "$staging_identity" "$skills_root" "$skills_identity" \
        "${moved_destinations[@]}" || reversal_status=$?
      [[ "$reversal_status" -eq 0 ]] || return "$reversal_status"
    fi
    return "$restore_status"
  fi
  if ! rmdir "$staging"; then
    if [[ "$bind_recovery_metadata" = "true" && "$moved_count" -gt 0 ]]; then
      restore_status=0
      restore_recovery_staging_moves "$staging" "$staging_identity" "$skills_root" "$skills_identity" \
        "${moved_destinations[@]}" || restore_status=$?
      [[ "$restore_status" -eq 0 ]] || return "$restore_status"
    fi
    return 1
  fi
}

validate_recovery_cleanup_root() {
  ruby -e '
    target = File.realpath(ARGV.fetch(0))
    cleanup_root = File.expand_path(ARGV.fetch(1))
    require_empty = ARGV.fetch(2) == "true"
    abort unless File.basename(cleanup_root).match?(/\A\.agent-workflows-recovery-cleanup-[A-Za-z0-9]+\z/)
    abort unless File.realpath(File.dirname(cleanup_root)) == target
    cleanup_stat = File.lstat(cleanup_root)
    abort unless cleanup_stat.directory? && !cleanup_stat.symlink?
    cleanup_realpath = File.realpath(cleanup_root)
    abort unless File.dirname(cleanup_realpath) == target &&
                 File.basename(cleanup_realpath) == File.basename(cleanup_root)
    verified_stat = File.lstat(cleanup_root)
    abort unless verified_stat.dev == cleanup_stat.dev && verified_stat.ino == cleanup_stat.ino
    abort if require_empty && !Dir.empty?(cleanup_root)
  ' "$target" "$1" "${2:-false}" 2>/dev/null
}

remove_recovery_cleanup_root() {
  ruby -rfileutils -rsecurerandom -e '
    target_file = nil
    original_target_mode = nil
    captured = nil
    cleanup_captured = false
    begin
      target = File.realpath(ARGV.fetch(0))
      cleanup_root = File.expand_path(ARGV.fetch(1))
      target_parent = File.realpath(File.dirname(target))
      target_parent_stat = File.lstat(target_parent)
      abort unless target_parent_stat.directory? && !target_parent_stat.symlink?
      target_file = File.open(target, File::RDONLY | File::NONBLOCK | File::NOFOLLOW)
      target_stat = target_file.stat
      named_target_stat = File.lstat(target)
      abort unless target_stat.directory? &&
                   target_stat.dev == named_target_stat.dev && target_stat.ino == named_target_stat.ino
      parent_writable_by_others = (target_parent_stat.mode & 0o022) != 0
      abort if parent_writable_by_others &&
               (!target_parent_stat.sticky? || target_stat.uid != Process.euid)
      original_target_mode = target_stat.mode & 0o7777
      if (original_target_mode & 0o022) != 0
        abort unless target_stat.uid == Process.euid
        target_file.chmod(original_target_mode & ~0o022)
      end
      secured_target_stat = File.lstat(target)
      abort unless secured_target_stat.dev == target_stat.dev && secured_target_stat.ino == target_stat.ino
      abort unless File.basename(cleanup_root).match?(/\A\.agent-workflows-recovery-cleanup-[A-Za-z0-9]+\z/)
      abort unless File.realpath(File.dirname(cleanup_root)) == target
      cleanup_stat = File.lstat(cleanup_root)
      abort unless cleanup_stat.directory? && !cleanup_stat.symlink? && cleanup_stat.uid == Process.euid
      cleanup_realpath = File.realpath(cleanup_root)
      abort unless File.dirname(cleanup_realpath) == target &&
                   File.basename(cleanup_realpath) == File.basename(cleanup_root)
      verified_stat = File.lstat(cleanup_root)
      abort unless verified_stat.dev == cleanup_stat.dev && verified_stat.ino == cleanup_stat.ino
      10.times do
        candidate = File.join(target, ".agent-workflows-recovery-delete-#{SecureRandom.hex(16)}")
        begin
          File.lstat(candidate)
        rescue Errno::ENOENT
          captured = candidate
          break
        end
      end
      abort unless captured
      File.rename(cleanup_root, captured)
      cleanup_captured = true
      captured_stat = File.lstat(captured)
      unless captured_stat.dev == cleanup_stat.dev && captured_stat.ino == cleanup_stat.ino
        puts captured
        exit 67
      end
      FileUtils.remove_entry_secure(captured)
    rescue StandardError
      puts captured if cleanup_captured && captured
      exit(cleanup_captured ? 69 : 1)
    ensure
      if target_file
        begin
          target_file.chmod(original_target_mode) if original_target_mode
        rescue StandardError
          puts captured if cleanup_captured && captured
          exit 69
        ensure
          target_file.close
        end
      end
    end
  ' "$target" "$1" 2>/dev/null
}

cleanup_recovery_staging() {
  local staging="$1"
  local staging_identity="$2"
  local cleanup_root cleanup_staging move_status restore_status remove_status remove_artifact cleanup_root_identity target_identity
  target_identity="$(recovery_directory_identity "$target")" || return 1
  cleanup_root="$(mktemp -d "$target/.agent-workflows-recovery-cleanup-XXXXXX")" || return 1
  cleanup_staging="$cleanup_root/staging"
  if ! validate_recovery_cleanup_root "$cleanup_root" true; then
    echo "RECOVERY_CLEANUP_ROOT_REJECTED: preserved rejected cleanup path $cleanup_root without moving recovery staging." >&2
    return 1
  fi
  cleanup_root_identity="$(recovery_directory_identity "$cleanup_root")" || return 1
  move_status=0
  move_bound_recovery_path "$staging" "$cleanup_staging" "$staging" "$staging_identity" \
    "$cleanup_root" "$cleanup_root_identity" || move_status=$?
  if [[ "$move_status" -ne 0 ]]; then
    rmdir "$cleanup_root" 2>/dev/null || true
    if [[ "$move_status" -eq 67 ]]; then
      if [[ "$(recovery_directory_identity "$staging" 2>/dev/null || true)" != "$staging_identity" ]]; then
        echo "RECOVERY_STAGING_BINDING_CHANGED: preserved recovery artifacts without following a replaced staging path." >&2
      else
        echo "RECOVERY_CLEANUP_BINDING_CHANGED: preserved recovery artifacts without following a replaced cleanup path." >&2
      fi
      return 67
    fi
    return 1
  fi
  restore_status=0
  if ! recovery_metadata_binding_intact; then
    restore_status=65
  else
    restore_captured_recovery_metadata || restore_status=$?
  fi
  if [[ "$restore_status" -ne 0 ]]; then
    if ! move_bound_recovery_path "$cleanup_staging" "$staging" "$cleanup_staging" "$staging_identity" \
      "$target" "$target_identity"; then
      echo "RECOVERY_STAGING_RESTORE_FAILED: preserved $cleanup_root for manual recovery." >&2
    else
      rmdir "$cleanup_root" 2>/dev/null || true
    fi
    return "$restore_status"
  fi
  if [[ "$(recovery_directory_identity "$cleanup_staging" 2>/dev/null || true)" != "$staging_identity" ]]; then
    echo "RECOVERY_STAGING_BINDING_CHANGED: preserved $cleanup_root and recovery receipt for manual recovery." >&2
    return 67
  fi
  remove_status=0
  remove_artifact="$(remove_recovery_cleanup_root "$cleanup_root")" || remove_status=$?
  if [[ "$remove_status" -eq 67 ]]; then
    echo "RECOVERY_CLEANUP_BINDING_CHANGED: preserved ${remove_artifact:-$cleanup_root} and recovery receipt after cleanup path replacement." >&2
    return 67
  elif [[ "$remove_status" -eq 69 ]]; then
    echo "RECOVERY_CLEANUP_REMOVAL_INCOMPLETE: preserved ${remove_artifact:-$cleanup_root} and recovery receipt; recovery staging was not restored." >&2
    return 1
  elif [[ "$remove_status" -ne 0 ]]; then
    if ! move_bound_recovery_path "$cleanup_staging" "$staging" "$cleanup_staging" "$staging_identity" \
      "$target" "$target_identity"; then
      echo "RECOVERY_STAGING_RESTORE_FAILED: preserved $cleanup_root for manual recovery." >&2
    else
      rmdir "$cleanup_root" 2>/dev/null || true
    fi
    return 1
  fi
}

report_pending_recovery_corruption() {
  local migration_receipt="$1"
  local recovered_staging="$2"
  if ! restore_captured_recovery_metadata; then
    report_recovery_metadata_restore_failure
  fi
  if [[ "$recovery_metadata_restore_reported" != "true" ]]; then
    report_corrupt_install_metadata
  fi
  echo "RECOVERY_FAILED: preserved $migration_receipt for $recovered_staging" >&2
}

report_pending_recovery_integrity_failure() {
  local migration_receipt="$1"
  local recovered_staging="$2"
  if ! restore_captured_recovery_metadata; then
    report_recovery_metadata_restore_failure
  fi
  echo "RECOVERY_FAILED: recovery paths changed during the operation; preserved $migration_receipt for $recovered_staging and any named cleanup artifacts." >&2
}

valid_migration_staging_path() {
  ruby -e '
    target = File.expand_path(ARGV.fetch(0))
    staging = File.expand_path(ARGV.fetch(1))
    exit 1 unless File.dirname(staging) == target
    exit 1 unless File.basename(staging).match?(/\A\.agent-workflows-flat-migration-.+\z/)

    current = File::SEPARATOR
    target.split(File::SEPARATOR).reject(&:empty?).each_with_index do |component, index|
      current = File.join(current, component)
      next unless File.symlink?(current)

      platform_alias = index.zero? && {
        "/tmp" => "/private/tmp",
        "/var" => "/private/var"
      }[current] == File.expand_path(File.readlink(current), File.dirname(current))
      exit 1 unless platform_alias
    end

    stat = File.lstat(staging)
    exit 1 unless stat.directory? && !stat.symlink?
    exit 1 unless File.realpath(File.dirname(staging)) == File.realpath(target)
  ' "$1" "$2" 2>/dev/null
}

ensure_real_directory() {
  local directory="$1"

  if [[ -L "$directory" ]]; then
    rm -f "$directory"
  fi
  if [[ -e "$directory" && ! -d "$directory" ]]; then
    echo "Refusing to replace non-directory path: $directory" >&2
    exit 1
  fi
  mkdir -p "$directory"
}

validate_scanner_companion_ancestors() {
  local ancestor

  for ancestor in "$target/lib" "$target/lib/agent-workflows"; do
    if [[ -L "$ancestor" || -e "$ancestor" && ! -d "$ancestor" ]]; then
      echo "Refusing unsafe scanner companion ancestor: $ancestor" >&2
      return 1
    fi
  done
}

copy_children_preserving_unrelated() {
  local source_dir="$1"
  local target_dir="$2"
  local source_path destination
  ensure_real_directory "$target_dir"

  for source_path in "$source_dir"/*; do
    [[ -e "$source_path" ]] || continue
    destination="$target_dir/$(basename "$source_path")"
    rm -rf "$destination"
    rsync -a "$source_path" "$target_dir/"
  done
}

workflow_doctor_copy_matches_source() {
  ruby "$doctor_ownership_helper" compare "$repo_root/bin/agent_doctor" "$target/bin/agent_doctor"
}

workflow_doctor_symlink_matches_recorded_source() {
  local destination="$target/bin/agent_doctor"
  local link_target recorded_mode recorded_source
  link_target="$(readlink "$destination" 2>/dev/null)" || return 1
  read_installed_metadata_value mode
  case "$installed_metadata_state" in
    valid) recorded_mode="$installed_metadata_value" ;;
    key_absent|corrupt) return 1 ;;
  esac
  read_installed_metadata_value source
  case "$installed_metadata_state" in
    valid) recorded_source="$installed_metadata_value" ;;
    key_absent|corrupt) return 1 ;;
  esac
  [[ "$recorded_mode" = symlink && -n "$recorded_source" &&
     "$link_target" = "$recorded_source/bin/agent_doctor" ]]
}

prepare_workflow_doctor_copy_destination() {
  local destination="$target/bin/agent_doctor"
  local marker="$destination/$doctor_managed_marker"
  local stack_marker="$destination/.agent-stack-managed"
  local resolved_source resolved_destination

  if [[ -L "$destination" ]]; then
    resolved_source="$(cd "$repo_root/bin/agent_doctor" 2>/dev/null && pwd -P)" || return 1
    resolved_destination="$(cd "$destination" 2>/dev/null && pwd -P)" || true
    if workflow_doctor_symlink_matches_recorded_source; then
      :
    elif [[ -z "$resolved_destination" || "$resolved_source" != "$resolved_destination" ]]; then
      echo "Refusing unmanaged workflow doctor symlink: $destination" >&2
      exit 1
    fi
    rm -f "$destination"
  fi
  if [[ -e "$destination" && ! -d "$destination" ]]; then
    echo "Refusing workflow doctor non-directory path: $destination" >&2
    exit 1
  fi
  mkdir -p "$destination"
  [[ -z "$(find "$destination" -mindepth 1 -maxdepth 1 -print -quit)" ]] && return
  if [[ -L "$marker" || -e "$marker" && ! -f "$marker" ]]; then
    echo "Refusing invalid workflow doctor ownership marker: $marker" >&2
    exit 1
  fi
  if [[ -L "$stack_marker" || -e "$stack_marker" && ! -f "$stack_marker" ]]; then
    echo "Refusing invalid stack doctor ownership marker: $stack_marker" >&2
    exit 1
  fi
  if [[ -f "$marker" ]]; then
    if ruby "$doctor_ownership_helper" verify "$destination" "$marker"; then return; fi
    echo "Refusing invalid workflow doctor ownership marker: $marker" >&2
    exit 1
  fi
  if [[ -f "$stack_marker" ]]; then
    if grep -qxF "agent-stack-module-v1:agent_doctor" "$stack_marker"; then return; fi
    echo "Refusing invalid stack doctor ownership marker: $stack_marker" >&2
    exit 1
  fi
  if [[ ! -e "$marker" ]] && workflow_doctor_copy_matches_source; then return; fi

  echo "Refusing unmanaged workflow doctor directory: $destination" >&2
  exit 1
}

write_workflow_doctor_managed_marker() {
  local destination="$target/bin/agent_doctor"
  local marker="$destination/$doctor_managed_marker"
  local marker_value temporary_marker
  marker_value="$(ruby "$doctor_ownership_helper" marker "$destination")"
  temporary_marker="$(mktemp "$destination/$doctor_managed_marker.XXXXXX")"
  printf '%s\n' "$marker_value" > "$temporary_marker"
  chmod 0644 "$temporary_marker"
  mv -f "$temporary_marker" "$marker"
}

remove_legacy_managed_model_routing_path() {
  local docs_target="$1"
  local legacy_path="$docs_target/model-routing.md"
  local link_target previous_revision previous_source source_root

  read_installed_metadata_value source
  case "$installed_metadata_state" in
    valid) previous_source="$installed_metadata_value" ;;
    key_absent|corrupt) previous_source="" ;;
  esac
  if [[ -L "$legacy_path" ]]; then
    link_target="$(readlink "$legacy_path")"
    if [[ "$link_target" == "$repo_root/docs/model-routing.md" || \
          ( -n "$previous_source" && "$link_target" == "$previous_source/docs/model-routing.md" ) ]]; then
      rm -f "$legacy_path"
    fi
    return 0
  fi

  [[ -f "$legacy_path" ]] || return 0
  read_installed_metadata_value source_revision
  case "$installed_metadata_state" in
    valid) previous_revision="$installed_metadata_value" ;;
    key_absent|corrupt) previous_revision="" ;;
  esac
  [[ -n "$previous_revision" ]] || return 0

  for source_root in "$repo_root" "$previous_source"; do
    [[ -n "$source_root" ]] || continue
    git -C "$source_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
    git -C "$source_root" cat-file -e "$previous_revision:docs/model-routing.md" 2>/dev/null || continue
    if cmp -s "$legacy_path" <(git -C "$source_root" show "$previous_revision:docs/model-routing.md"); then
      rm -f "$legacy_path"
      return 0
    fi
  done

  if [[ -n "$previous_source" && -f "$previous_source/docs/model-routing.md" ]] &&
     cmp -s "$legacy_path" "$previous_source/docs/model-routing.md"; then
    rm -f "$legacy_path"
  fi
}

recorded_revision_pack_doc_matches() {
  local doc_name="$1"
  local destination="$2"
  local previous_revision previous_source source_root
  [[ -f "$destination" && ! -L "$destination" ]] || return 1
  previous_revision="$(installed_metadata_value source_revision 2>/dev/null || true)"
  [[ "$previous_revision" =~ ^[0-9a-fA-F]{40}$ ]] || return 1
  previous_source="$(installed_metadata_value source 2>/dev/null || true)"

  for source_root in "$repo_root" "$previous_source"; do
    [[ -n "$source_root" && -d "$source_root" ]] || continue
    if git -C "$source_root" cat-file -e "$previous_revision:docs/$doc_name" 2>/dev/null &&
       cmp -s "$destination" <(git -C "$source_root" show "$previous_revision:docs/$doc_name"); then
      return 0
    fi
  done
  return 1
}

pack_doc_symlink_matches_recorded_source() {
  local doc_name="$1"
  local destination="$2"
  local previous_source resolved source_root expected
  [[ -L "$destination" ]] || return 1
  resolved="$(ruby -e 'puts File.expand_path(File.readlink(ARGV.fetch(0)), File.dirname(ARGV.fetch(0)))' "$destination")"
  previous_source="$(installed_metadata_value source 2>/dev/null || true)"

  for source_root in "$repo_root" "$previous_source"; do
    [[ -n "$source_root" ]] || continue
    expected="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "$source_root/docs/$doc_name")"
    [[ "$resolved" = "$expected" ]] && return 0
  done
  return 1
}

pack_doc_destination_owned() {
  local doc_name="$1"
  local destination="$2"
  local source_path="$3"

  if [[ "$mode" = "copy" ]]; then
    recorded_pack_doc_copy_fingerprint_matches "$doc_name" "$destination" ||
      recorded_revision_pack_doc_matches "$doc_name" "$destination" ||
      { [[ -f "$destination" && ! -L "$destination" ]] && cmp -s "$destination" "$source_path"; } ||
      pack_doc_symlink_matches_recorded_source "$doc_name" "$destination"
  else
    pack_doc_symlink_matches_recorded_source "$doc_name" "$destination"
  fi
}

recorded_pack_doc_copy_fingerprint_matches() {
  local doc_name="$1"
  local destination="$2"
  local metadata_path="$target/$metadata_name"
  [[ -f "$metadata_path" && ! -L "$metadata_path" ]] || return 1
  [[ -f "$destination" && ! -L "$destination" ]] || return 1

  ruby -rjson -rdigest -e '
    metadata_path, doc_name, destination = ARGV
    metadata = JSON.parse(File.binread(metadata_path))
    exit 1 unless metadata.is_a?(Hash) && metadata["mode"] == "copy"
    fingerprints = metadata["managed_pack_doc_copy_fingerprints"]
    exit 1 unless fingerprints.is_a?(Hash)
    expected = fingerprints[doc_name]
    exit 1 unless expected.is_a?(String) && expected.match?(/\A[0-9a-f]{64}\z/i)
    exit(Digest::SHA256.file(destination).hexdigest == expected ? 0 : 1)
  ' "$metadata_path" "$doc_name" "$destination"
}

verify_pack_doc_destinations() {
  local doc_name destination source_path
  [[ ! -L "$target/docs" ]] || return 0

  for doc_name in "${pack_docs[@]}"; do
    # Both delivery modes replace a solutions-directory symlink without following it.
    [[ "$doc_name" == solutions/* && -L "$target/docs/solutions" ]] && continue
    destination="$target/docs/$doc_name"
    source_path="$repo_root/docs/$doc_name"
    [[ -e "$destination" || -L "$destination" ]] || continue
    if [[ "$mode" = "copy" && ! -f "$destination" && ! -L "$destination" ]]; then
      echo "Refusing to replace non-file path: $destination" >&2
      exit 1
    fi
    pack_doc_destination_owned "$doc_name" "$destination" "$source_path" && continue

    echo "Refusing to replace unowned pack document: $destination" >&2
    exit 1
  done
}

verify_install_destinations() {
  local destination helper skill source_path

  if [[ "$mode" = "copy" ]]; then
    for destination in "$target/bin" "$target/workflows" "$target/docs" "$target/docs/solutions"; do
      if [[ -e "$destination" && ! -d "$destination" && ! -L "$destination" ]]; then
        echo "Refusing to replace non-directory path: $destination" >&2
        exit 1
      fi
    done
    if [[ "$delivery_mode" = "flat" ]]; then
      destination="$target/skills"
      if [[ -e "$destination" && ! -d "$destination" && ! -L "$destination" ]]; then
        echo "Refusing to replace non-directory path: $destination" >&2
        exit 1
      fi
    fi
    destination="$target/LICENSE"
    if [[ -e "$destination" && ! -f "$destination" && ! -L "$destination" ]]; then
      echo "Refusing to replace non-file path: $destination" >&2
      exit 1
    fi
    for helper in "${bin_helpers[@]}"; do
      destination="$target/bin/$helper"
      if [[ -e "$destination" && ! -f "$destination" && ! -L "$destination" ]]; then
        echo "Refusing to replace non-file path: $destination" >&2
        exit 1
      fi
    done
  else
    for destination in "$target/bin" "$target/skills"; do
      if [[ ( -e "$destination" || -L "$destination" ) && ! -d "$destination" ]]; then
        echo "Refusing to use non-directory path: $destination" >&2
        exit 1
      fi
    done
    for destination in "$target/docs" "$target/docs/solutions"; do
      if [[ -e "$destination" && ! -d "$destination" && ! -L "$destination" ]]; then
        echo "Refusing to replace non-directory path: $destination" >&2
        exit 1
      fi
    done
    for destination in "$target/LICENSE" "$target/workflows"; do
      if [[ ( -e "$destination" || -L "$destination" ) && ! -L "$destination" ]]; then
        echo "Refusing to replace non-symlink path: $destination" >&2
        exit 1
      fi
    done
    if [[ "$delivery_mode" = "flat" ]]; then
      for skill in "$repo_root"/skills/*; do
        [[ -d "$skill" ]] || continue
        destination="$target/skills/$(basename "$skill")"
        if [[ ( -e "$destination" || -L "$destination" ) && ! -L "$destination" ]]; then
          echo "Refusing to replace non-symlink path: $destination" >&2
          exit 1
        fi
      done
    fi
    if [[ ! -L "$target/docs/solutions" ]]; then
      for source_path in "$repo_root"/docs/solutions/*; do
        [[ -e "$source_path" ]] || continue
        destination="$target/docs/solutions/$(basename "$source_path")"
        if [[ ( -e "$destination" || -L "$destination" ) && ! -L "$destination" ]]; then
          echo "Refusing to replace non-symlink path: $destination" >&2
          exit 1
        fi
      done
    fi
    for helper in "${bin_helpers[@]}"; do
      destination="$target/bin/$helper"
      if [[ ( -e "$destination" || -L "$destination" ) && ! -L "$destination" ]]; then
        echo "Refusing to replace non-symlink path: $destination" >&2
        exit 1
      fi
    done
  fi
}

copy_pack_docs() {
  local docs_target="$1"
  local doc_name destination
  ensure_real_directory "$docs_target"
  ensure_real_directory "$docs_target/solutions"
  remove_legacy_managed_model_routing_path "$docs_target"

  for doc_name in "${pack_docs[@]}"; do
    destination="$docs_target/$doc_name"
    if [[ -L "$destination" ]]; then
      rm -f "$destination"
    fi
    if [[ -e "$destination" && ! -f "$destination" ]]; then
      echo "Refusing to replace non-file path: $destination" >&2
      exit 1
    fi
    install -m 0644 "$repo_root/docs/$doc_name" "$destination"
  done
}

link_pack_docs() {
  local docs_target="$1"
  local destination doc_name
  ensure_real_directory "$docs_target"
  ensure_real_directory "$docs_target/solutions"
  remove_legacy_managed_model_routing_path "$docs_target"

  for doc_name in "${pack_docs[@]}"; do
    destination="$docs_target/$doc_name"
    if [[ -e "$destination" && ! -L "$destination" ]]; then
      echo "Refusing to replace non-symlink path: $destination" >&2
      exit 1
    fi
    ln -sfn "$repo_root/docs/$doc_name" "$destination"
  done
}

copy_pack_license() {
  local destination="$target/LICENSE"
  mkdir -p "$target"
  if [[ -L "$destination" ]]; then
    rm -f "$destination"
  fi
  if [[ -e "$destination" && ! -f "$destination" ]]; then
    echo "Refusing to replace non-file path: $destination" >&2
    exit 1
  fi
  install -m 0644 "$repo_root/LICENSE" "$destination"
}

link_pack_license() {
  local destination="$target/LICENSE"
  mkdir -p "$target"
  if [[ -e "$destination" && ! -L "$destination" ]]; then
    echo "Refusing to replace non-symlink path: $destination" >&2
    exit 1
  fi
  ln -sfn "$repo_root/LICENSE" "$destination"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      host="${2:?--host requires codex, claude, or auto}"
      shift 2
      ;;
    --target)
      target="${2:?--target requires a directory}"
      shift 2
      ;;
    --mode)
      mode="${2:?--mode requires copy or symlink}"
      shift 2
      ;;
    --delivery-mode)
      delivery_mode="${2:?--delivery-mode requires flat or plugin-companion}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

case "$host" in
  codex|claude|auto) ;;
  *)
    echo "--host must be codex, claude, or auto, got: $host" >&2
    exit 64
    ;;
esac

case "$mode" in
  copy|symlink) ;;
  *)
    echo "--mode must be copy or symlink, got: $mode" >&2
    exit 64
    ;;
esac

validate_delivery_mode "--delivery-mode"

resolved="$(resolve_host_and_target)"
host="${resolved%%:*}"
target="${resolved#*:}"
resolve_delivery_mode
validate_delivery_mode "Installed metadata delivery_mode"

if [[ "$delivery_mode" = "plugin-companion" ]]; then
  validate_scanner_companion_ancestors || exit 1
fi

pending_migration_receipt="$target/.agent-workflows-migration-staging"
if [[ ! -f "$pending_migration_receipt" ]]; then
  set +e
  delivery_state="$(ruby "$delivery_state_script" check --host "$host" --target "$target" --source "$repo_root" --delivery-mode "$delivery_mode" --json 2>&1)"
  delivery_status=$?
  set -e
  if [[ "$delivery_status" -ne 0 ]]; then
    printf '%s' "$delivery_state" | ruby -rjson -e '
      payload = JSON.parse(STDIN.read)
      warn "DELIVERY_MODE_CONFLICT: #{payload.fetch("reason")}"
      warn payload.fetch("guidance")
    '
    exit 1
  fi
fi

mkdir -p "$target"
install_lock="$target/.agent-workflows-install.lock"
if ! mkdir "$install_lock" 2>/dev/null; then
  echo "DELIVERY_MODE_CONFLICT: another agent-workflows install or migration holds $install_lock" >&2
  exit 1
fi
release_install_lock() {
  local status=$?
  trap - EXIT
  if [[ "${recovery_metadata_captured:-false}" = "true" &&
        "${recovery_metadata_restore_reported:-false}" != "true" ]] &&
     ! restore_captured_recovery_metadata; then
    report_recovery_metadata_restore_failure
    status=65
  fi
  rmdir "$install_lock" 2>/dev/null || true
  exit "$status"
}
trap release_install_lock EXIT
migration_staging=""
migration_receipt="$target/.agent-workflows-migration-staging"
recovery_metadata_captured=false
recovery_metadata_restore_reported=false
recovery_staging_identity=""
if [[ -f "$migration_receipt" ]]; then
  IFS= read -r recovered_staging < "$migration_receipt" || recovered_staging=""
  recovered_staging="$(ruby -e 'puts File.expand_path(ARGV.fetch(0))' "$recovered_staging")"
  if ! valid_migration_staging_path "$target" "$recovered_staging"; then
    echo "RECOVERY_FAILED: unsafe migration staging receipt; preserved $migration_receipt" >&2
    exit 1
  fi
  if ! recovery_staging_identity="$(recovery_directory_identity "$recovered_staging")" ||
     [[ -z "$recovery_staging_identity" ]]; then
    echo "RECOVERY_STAGING_BINDING_CHANGED: preserved $migration_receipt and recovery artifacts without moving them." >&2
    exit 65
  fi
  set +e
  capture_installed_metadata_for_recovery
  capture_status=$?
  set -e
  case "$capture_status" in
    0) ;;
    68) prior_delivery_mode="flat" ;;
    66)
      report_corrupt_install_metadata true
      echo "Preserved pending recovery receipt $migration_receipt for staging directory $recovered_staging." >&2
      exit 65
      ;;
    70)
      echo "RECOVERY_METADATA_CAPTURE_UNAVAILABLE: this filesystem could not create a bound metadata snapshot; preserved $migration_receipt and $recovered_staging." >&2
      exit 1
      ;;
    *)
      if [[ "$recovery_metadata_captured" = "true" ]] && ! restore_captured_recovery_metadata; then
        report_recovery_metadata_restore_failure
      fi
      if [[ "$recovery_metadata_restore_reported" != "true" ]]; then
        report_corrupt_install_metadata
      fi
      echo "Preserved pending recovery receipt $migration_receipt for staging directory $recovered_staging." >&2
      exit 65
      ;;
  esac
  if [[ "$capture_status" -ne 68 ]]; then
    read_installed_metadata_value delivery_mode "$recovery_metadata_snapshot"
    if ! recovery_metadata_binding_intact; then
      installed_metadata_state="corrupt"
      installed_metadata_value=""
    fi
  else
    installed_metadata_state="absent"
  fi
  case "$installed_metadata_state" in
    valid)
      prior_delivery_mode="$installed_metadata_value"
      case "$prior_delivery_mode" in
        flat|plugin-companion) ;;
        *)
          echo "Installed metadata delivery_mode must be flat or plugin-companion, got: $prior_delivery_mode" >&2
          exit 64
          ;;
      esac
      ;;
    key_absent) prior_delivery_mode="flat" ;;
    absent) prior_delivery_mode="flat" ;;
    invalid)
      if ! restore_captured_recovery_metadata; then
        report_recovery_metadata_restore_failure
        echo "Preserved pending recovery receipt $migration_receipt for staging directory $recovered_staging." >&2
        exit 65
      fi
      report_invalid_install_delivery_mode
      echo "Preserved pending recovery receipt $migration_receipt for staging directory $recovered_staging." >&2
      exit 64
      ;;
    corrupt)
      if ! restore_captured_recovery_metadata; then
        report_recovery_metadata_restore_failure
      fi
      if [[ "$recovery_metadata_restore_reported" != "true" ]]; then
        report_corrupt_install_metadata
      fi
      echo "Preserved pending recovery receipt $migration_receipt for staging directory $recovered_staging." >&2
      exit 65
      ;;
  esac
  if [[ "$prior_delivery_mode" = "plugin-companion" ]]; then
    set +e
    cleanup_recovery_staging "$recovered_staging" "$recovery_staging_identity"
    recovery_status=$?
    set -e
    if [[ "$recovery_status" -eq 65 ]]; then
      report_pending_recovery_corruption "$migration_receipt" "$recovered_staging"
      exit 65
    elif [[ "$recovery_status" -eq 67 ]]; then
      report_pending_recovery_integrity_failure "$migration_receipt" "$recovered_staging"
      exit 65
    elif [[ "$recovery_status" -ne 0 ]]; then
      echo "CLEANUP_PENDING: committed plugin-companion mode; preserved $migration_receipt for $recovered_staging" >&2
      exit 1
    fi
  elif [[ "$(recovery_directory_identity "$recovered_staging" 2>/dev/null || true)" != "$recovery_staging_identity" ]]; then
    echo "RECOVERY_STAGING_BINDING_CHANGED: preserved recovery artifacts without moving them." >&2
    report_pending_recovery_integrity_failure "$migration_receipt" "$recovered_staging"
    exit 65
  else
    set +e
    rollback_migration_staging "$recovered_staging" true "$recovery_staging_identity"
    recovery_status=$?
    set -e
    if [[ "$recovery_status" -eq 65 ]]; then
      report_pending_recovery_corruption "$migration_receipt" "$recovered_staging"
      exit 65
    elif [[ "$recovery_status" -eq 67 ]]; then
      report_pending_recovery_integrity_failure "$migration_receipt" "$recovered_staging"
      exit 65
    elif [[ "$recovery_status" -ne 0 ]]; then
      echo "RECOVERY_FAILED: preserved $migration_receipt for $recovered_staging" >&2
      exit 1
    fi
  fi
  if ! restore_captured_recovery_metadata; then
    report_recovery_metadata_restore_failure
    echo "RECOVERY_FAILED: preserved $migration_receipt for $recovered_staging" >&2
    exit 65
  fi
  rm -f "$migration_receipt"
fi
metadata_committed=false
release_install_transaction() {
  local status=$?
  trap - EXIT
  if [[ -z "$migration_staging" && -f "$migration_receipt" ]]; then
    IFS= read -r migration_staging < "$migration_receipt" || true
  fi
  if [[ "$metadata_committed" != "true" && -n "$migration_staging" ]]; then
    if rollback_migration_staging "$migration_staging"; then
      rm -f "$migration_receipt"
    else
      echo "RECOVERY_FAILED: rollback incomplete; preserved $migration_receipt for $migration_staging" >&2
      status=1
    fi
  fi
  if [[ "$metadata_committed" != "true" && -f "$target/$metadata_name.tmp" ]]; then
    rm -f "$target/$metadata_name.tmp"
  fi
  rmdir "$install_lock" 2>/dev/null || true
  exit "$status"
}
trap release_install_transaction EXIT

# The pre-lock check avoids mutating an obviously unsafe target. This second
# check is authoritative and holds the advisory install lock through commit.
set +e
delivery_state="$(ruby "$delivery_state_script" check --host "$host" --target "$target" --source "$repo_root" --delivery-mode "$delivery_mode" --json 2>&1)"
delivery_status=$?
set -e
if [[ "$delivery_status" -ne 0 ]]; then
  printf '%s' "$delivery_state" | ruby -rjson -e '
    payload = JSON.parse(STDIN.read)
    warn "DELIVERY_MODE_CONFLICT: #{payload.fetch("reason")}"
    warn payload.fetch("guidance")
  '
  exit 1
fi
verify_pack_doc_destinations
verify_install_destinations
prepare_metadata

if [[ "$mode" = "copy" ]]; then
  ensure_real_directory "$target/bin"
  prepare_workflow_doctor_copy_destination
  copy_pack_license
  if [[ "$delivery_mode" = "flat" ]]; then
    ensure_real_directory "$target/skills"
    copy_children_preserving_unrelated "$repo_root/skills" "$target/skills"
  fi
  ensure_real_directory "$target/workflows"
  ensure_real_directory "$target/docs"
  copy_children_preserving_unrelated "$repo_root/workflows" "$target/workflows"
  copy_pack_docs "$target/docs"
  rsync -a --delete --exclude="/$doctor_managed_marker" --exclude='/.agent-stack-managed' \
    "$repo_root/bin/agent_doctor/" "$target/bin/agent_doctor/"
  ruby -e 'File.chmod(File.stat(ARGV.fetch(0)).mode & 0o7777, ARGV.fetch(1))' "$repo_root/bin/agent_doctor" "$target/bin/agent_doctor"
  write_workflow_doctor_managed_marker
  for helper in "${bin_helpers[@]}"; do
    destination="$target/bin/$helper"
    if [[ -L "$destination" ]]; then
      rm -f "$destination"
    fi
    if [[ -e "$destination" && ! -f "$destination" ]]; then
      echo "Refusing to replace non-file path: $destination" >&2
      exit 1
    fi
    install -m 0755 "$repo_root/bin/$helper" "$destination"
  done
else
  if [[ -L "$target/bin/agent_doctor" ]] &&
     [[ "$(readlink "$target/bin/agent_doctor")" != "$repo_root/bin/agent_doctor" ]] &&
     ! workflow_doctor_symlink_matches_recorded_source; then
    echo "Refusing unmanaged workflow doctor symlink: $target/bin/agent_doctor" >&2
    exit 1
  fi
  if [[ -e "$target/bin/agent_doctor" && ! -L "$target/bin/agent_doctor" ]]; then
    echo "Refusing to replace non-symlink path: $target/bin/agent_doctor" >&2
    exit 1
  fi
  link_pack_license
  mkdir -p "$target/bin"
  if [[ -e "$target/workflows" && ! -L "$target/workflows" ]]; then
    echo "Refusing to replace non-symlink path: $target/workflows" >&2
    exit 1
  fi
  if [[ "$delivery_mode" = "flat" ]]; then
    mkdir -p "$target/skills"
    for skill in "$repo_root"/skills/*; do
      [[ -d "$skill" ]] || continue
      destination="$target/skills/$(basename "$skill")"
      if [[ -e "$destination" && ! -L "$destination" ]]; then
        echo "Refusing to replace non-symlink path: $destination" >&2
        exit 1
      fi
      ln -sfn "$skill" "$destination"
    done
  fi
  rm -f "$target/workflows"
  ln -sfn "$repo_root/workflows" "$target/workflows"
  link_pack_docs "$target/docs"
  ln -sfn "$repo_root/bin/agent_doctor" "$target/bin/agent_doctor"
  for helper in "${bin_helpers[@]}"; do
    destination="$target/bin/$helper"
    if [[ -e "$destination" && ! -L "$destination" ]]; then
      echo "Refusing to replace non-symlink path: $destination" >&2
      exit 1
    fi
    ln -sfn "$repo_root/bin/$helper" "$destination"
  done
fi

if [[ "$delivery_mode" = "plugin-companion" ]]; then
  scanner_companion_dir="$target/lib/agent-workflows"
  scanner_companion="$scanner_companion_dir/secure_github_actions_scanner.rb"
  validate_scanner_companion_ancestors || exit 1
  mkdir -p "$scanner_companion_dir"
  validate_scanner_companion_ancestors || exit 1
  if [[ -L "$scanner_companion" ]]; then
    rm -f "$scanner_companion"
  fi
  if [[ -e "$scanner_companion" && ! -f "$scanner_companion" ]]; then
    echo "Refusing to replace non-file path: $scanner_companion" >&2
    exit 1
  fi
  install -m 0644 \
    "$repo_root/skills/secure-github-actions/lib/secure_github_actions_scanner.rb" \
    "$scanner_companion"

  set +e
  delivery_state="$(ruby "$delivery_state_script" migrate --host "$host" --target "$target" --source "$repo_root" --delivery-mode "$delivery_mode" --retain-staging --staging-receipt "$migration_receipt" --json 2>&1)"
  delivery_status=$?
  set -e
  if [[ "$delivery_status" -ne 0 ]]; then
    printf '%s' "$delivery_state" | ruby -rjson -e '
      payload = JSON.parse(STDIN.read)
      warn "DELIVERY_MODE_CONFLICT: #{payload.fetch("reason")}"
      warn payload.fetch("guidance")
    '
    exit 1
  fi
  migration_staging="$(
    printf '%s' "$delivery_state" |
      ruby -rjson -e 'payload = JSON.parse(STDIN.read); puts payload.dig("flat", "staging")'
  )"

  set +e
  delivery_state="$(ruby "$delivery_state_script" check --host "$host" --target "$target" --source "$repo_root" --delivery-mode "$delivery_mode" --json 2>&1)"
  delivery_status=$?
  set -e
  if [[ "$delivery_status" -ne 0 ]]; then
    printf '%s' "$delivery_state" | ruby -rjson -e '
      payload = JSON.parse(STDIN.read)
      warn "DELIVERY_MODE_CONFLICT: final delivery verification failed: #{payload.fetch("reason")}"
      warn payload.fetch("guidance")
    '
    exit 1
  fi
fi

commit_metadata
metadata_committed=true
if [[ -n "$migration_staging" ]]; then
  if rm -rf "$migration_staging"; then
    rm -f "$migration_receipt"
  else
    echo "CLEANUP_PENDING: committed plugin-companion mode; preserved $migration_receipt for $migration_staging" >&2
  fi
fi

printf '%s\n' \
  "Installed ShakaCode agent workflows into:" \
  "  $target" \
  "" \
  "Host:" \
  "  $host" \
  "" \
  "Add this to PATH if needed:" \
  "  export PATH=\"$target/bin:\$PATH\"" \
