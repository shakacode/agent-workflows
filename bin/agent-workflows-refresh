#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: agent-workflows-refresh [--host codex|claude|cursor|auto]

Refreshes the Agent Workflows plugin through the selected host's native CLI.
USAGE
}

usage_error() {
  echo "$1" >&2
  usage >&2
  exit 64
}

host="auto"

while (($#)); do
  case "$1" in
    --host)
      (($# >= 2)) || usage_error "--host requires codex, claude, cursor, or auto"
      host="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage_error "Unknown option: $1"
      ;;
  esac
done

case "$host" in
  codex|claude|cursor|auto) ;;
  *) usage_error "--host must be codex, claude, cursor, or auto; got: $host" ;;
esac

if [[ "$host" == "auto" ]]; then
  codex_home="${CODEX_HOME:-$HOME/.codex}"
  claude_home="${CLAUDE_HOME:-$HOME/.claude}"
  cursor_home="${CURSOR_HOME:-$HOME/.cursor}"
  detected=()
  [[ -n "${CODEX_HOME:-}" || -d "$codex_home" ]] && detected+=("codex")
  [[ -n "${CLAUDE_HOME:-}" || -d "$claude_home" ]] && detected+=("claude")
  [[ -n "${CURSOR_HOME:-}" || -d "$cursor_home" ]] && detected+=("cursor")

  if [[ "${#detected[@]}" -gt 1 ]]; then
    echo "Auto host detection found multiple agent homes; pass --host codex, --host claude, or --host cursor." >&2
    exit 64
  elif [[ "${#detected[@]}" -eq 1 ]]; then
    host="${detected[0]}"
  else
    host="codex"
  fi
fi

case "$host" in
  codex)
    if ! command -v codex >/dev/null 2>&1; then
      echo "codex was not found on PATH. Install or configure the Codex CLI, then retry." >&2
      exit 127
    fi
    codex plugin marketplace upgrade agent-workflows
    ;;
  claude)
    if ! command -v claude >/dev/null 2>&1; then
      echo "claude was not found on PATH. Install or configure the Claude CLI, then retry." >&2
      exit 127
    fi
    claude plugin marketplace update agent-workflows
    claude plugin update scw@agent-workflows
    ;;
  cursor)
    echo "Cursor does not expose a non-interactive plugin refresh CLI. Reinstall with upgrade-agent-workflows --host cursor for flat installs, or reload the Cursor window after updating a local plugin." >&2
    exit 2
    ;;
esac

echo "REFRESH_COMPLETE host=$host"
