#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "optparse"
require "time"

class ReleaseError < StandardError; end

def read_json(path)
  value = JSON.parse(File.read(path, encoding: "UTF-8"))
  raise ReleaseError, "#{path} must contain a JSON object" unless value.is_a?(Hash)

  value
rescue Errno::ENOENT
  raise ReleaseError, "missing release metadata: #{path}"
rescue JSON::ParserError => e
  raise ReleaseError, "invalid JSON in #{path}: #{e.message}"
end

def checked_version_values(version:, claude:, codex:)
  raise ReleaseError, "VERSION must be a stable semantic version" unless version.match?(/\A\d+\.\d+\.\d+\z/)
  unless [claude, codex].all?(version)
    raise ReleaseError, "release metadata versions do not match VERSION #{version}"
  end

  {
    "status" => "VERSION_OK",
    "version" => version,
    "metadata" => { "claude" => claude, "codex" => codex }
  }
end

def checked_versions(root)
  version_path = File.join(root, "VERSION")
  version = File.read(version_path, encoding: "UTF-8").strip
  claude = read_json(File.join(root, ".claude-plugin", "plugin.json"))["version"]
  codex = read_json(File.join(root, ".codex-plugin", "plugin.json"))["version"]
  checked_version_values(version:, claude:, codex:)
rescue Errno::ENOENT
  raise ReleaseError, "missing release metadata: #{version_path}"
end

def run_git(root, *args)
  stdout, stderr, status = Open3.capture3("git", "-C", root, *args)
  return stdout.force_encoding("UTF-8").scrub.strip if status.success?

  detail = stderr.force_encoding("UTF-8").scrub.strip
  raise ReleaseError, "git #{args.join(' ')} failed#{detail.empty? ? '' : ": #{detail}"}"
rescue Errno::ENOENT
  raise ReleaseError, "git is required for release verification"
end

def json_from_git(root, commit, path)
  value = JSON.parse(run_git(root, "show", "#{commit}:#{path}"))
  raise ReleaseError, "#{path} at #{commit} must contain a JSON object" unless value.is_a?(Hash)

  value
rescue JSON::ParserError => e
  raise ReleaseError, "invalid JSON in #{path} at #{commit}: #{e.message}"
end

def checked_versions_at_commit(root, commit)
  checked_version_values(
    version: run_git(root, "show", "#{commit}:VERSION").strip,
    claude: json_from_git(root, commit, ".claude-plugin/plugin.json")["version"],
    codex: json_from_git(root, commit, ".codex-plugin/plugin.json")["version"]
  )
end

def verify_tag(root:, release:, approved_commit:, expected_tag_object:)
  match = release.match(/\Av(\d+\.\d+\.\d+)\z/)
  raise ReleaseError, "release must be an exact vX.Y.Z tag" unless match
  unless approved_commit.match?(/\A[0-9a-f]{40}(?:[0-9a-f]{24})?\z/)
    raise ReleaseError, "approved commit must be a full object ID"
  end
  unless expected_tag_object.match?(/\A[0-9a-f]{40}(?:[0-9a-f]{24})?\z/)
    raise ReleaseError, "expected tag object must be a full object ID"
  end

  tag_ref = "refs/tags/#{release}"
  tag_object = run_git(root, "rev-parse", "--verify", tag_ref)
  raise ReleaseError, "tag moved: expected #{expected_tag_object}, found #{tag_object}" unless tag_object == expected_tag_object

  object_type = run_git(root, "cat-file", "-t", tag_object)
  raise ReleaseError, "#{release} must be an annotated tag, found #{object_type}" unless object_type == "tag"

  peeled_commit = run_git(root, "rev-parse", "--verify", "#{tag_ref}^{commit}")
  unless peeled_commit == approved_commit
    raise ReleaseError, "#{release} peels to #{peeled_commit}, not approved commit #{approved_commit}"
  end

  versions = checked_versions_at_commit(root, peeled_commit)
  unless versions.fetch("version") == match[1]
    raise ReleaseError, "#{release} does not match VERSION #{versions.fetch('version')} at #{peeled_commit}"
  end

  {
    "status" => "TAG_VERIFIED",
    "release_ref" => release,
    "version" => versions.fetch("version"),
    "tag_object" => tag_object,
    "peeled_commit" => peeled_commit
  }
end

def required_option(options, name)
  options.fetch(name) { raise ReleaseError, "--#{name.to_s.tr('_', '-')} is required" }
end

def github_login!(label, login)
  return if login.match?(/\A[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\z/) && !login.downcase.end_with?("[bot]")

  raise ReleaseError, "#{label} must identify a human GitHub user"
end

def record_receipt(options)
  environment = required_option(options, :environment)
  raise ReleaseError, "stable releases require the stable-release protected environment" unless environment == "stable-release"

  change_author = required_option(options, :change_author)
  release_actor = required_option(options, :release_actor)
  approval_reviewer = required_option(options, :approval_reviewer)
  github_login!("change author", change_author)
  github_login!("release actor", release_actor)
  github_login!("approval reviewer", approval_reviewer)
  if approval_reviewer.casecmp?(change_author) || approval_reviewer.casecmp?(release_actor)
    raise ReleaseError, "approval reviewer must be a non-author human who did not initiate the release"
  end

  workflow_run_url = required_option(options, :workflow_run_url)
  unless workflow_run_url.match?(%r{\Ahttps://github\.com/[^/]+/[^/]+/actions/runs/\d+\z})
    raise ReleaseError, "workflow run URL must identify a GitHub Actions run"
  end

  recorded_at = required_option(options, :recorded_at)
  Time.iso8601(recorded_at)

  verified = verify_tag(
    root: options.fetch(:root),
    release: required_option(options, :release),
    approved_commit: required_option(options, :approved_commit),
    expected_tag_object: required_option(options, :expected_tag_object)
  )
  receipt = {
    "schema" => "agent-workflows-stable-release-v1",
    "channel" => "stable",
    "release_ref" => verified.fetch("release_ref"),
    "version" => verified.fetch("version"),
    "tag_object" => verified.fetch("tag_object"),
    "peeled_commit" => verified.fetch("peeled_commit"),
    "recorded_at" => recorded_at,
    "approval" => {
      "environment" => environment,
      "reviewer" => approval_reviewer,
      "change_author" => change_author,
      "exact_commit" => verified.fetch("peeled_commit"),
      "human_non_author" => true
    },
    "workflow" => { "actor" => release_actor, "run_url" => workflow_run_url }
  }
  receipt_path = File.expand_path(required_option(options, :receipt))
  File.write(receipt_path, "#{JSON.pretty_generate(receipt)}\n", encoding: "UTF-8")
  { "status" => "RECEIPT_WRITTEN", "receipt" => receipt_path, "release" => receipt }
rescue ArgumentError
  raise ReleaseError, "--recorded-at must be an ISO 8601 timestamp"
end

def verify_receipt(options)
  receipt_path = File.expand_path(required_option(options, :receipt))
  receipt = read_json(receipt_path)
  unless receipt["schema"] == "agent-workflows-stable-release-v1" && receipt["channel"] == "stable"
    raise ReleaseError, "receipt must use the stable release receipt schema"
  end

  approval = receipt["approval"]
  workflow = receipt["workflow"]
  unless approval.is_a?(Hash) && workflow.is_a?(Hash)
    raise ReleaseError, "receipt approval and workflow evidence must be JSON objects"
  end
  unless approval["environment"] == "stable-release" && approval["human_non_author"] == true
    raise ReleaseError, "receipt lacks qualifying protected-environment approval"
  end

  begin
    Time.iso8601(receipt.fetch("recorded_at"))
  rescue ArgumentError, KeyError
    raise ReleaseError, "receipt lacks a valid recording timestamp"
  end
  github_login!("change author", approval.fetch("change_author", ""))
  github_login!("approval reviewer", approval.fetch("reviewer", ""))
  github_login!("release actor", workflow.fetch("actor", ""))
  if approval.fetch("reviewer").casecmp?(approval.fetch("change_author")) ||
     approval.fetch("reviewer").casecmp?(workflow.fetch("actor"))
    raise ReleaseError, "receipt reviewer is not independent of the author and release actor"
  end

  verified = verify_tag(
    root: options.fetch(:root),
    release: receipt.fetch("release_ref") { raise ReleaseError, "receipt is missing release_ref" },
    approved_commit: receipt.fetch("peeled_commit") { raise ReleaseError, "receipt is missing peeled_commit" },
    expected_tag_object: receipt.fetch("tag_object") { raise ReleaseError, "receipt is missing tag_object" }
  )
  unless approval["exact_commit"] == verified.fetch("peeled_commit") &&
         receipt["version"] == verified.fetch("version") &&
         workflow["run_url"].to_s.match?(%r{\Ahttps://github\.com/[^/]+/[^/]+/actions/runs/\d+\z})
    raise ReleaseError, "receipt evidence does not bind the verified release"
  end

  { "status" => "RECEIPT_VERIFIED", "receipt" => receipt_path, "release" => receipt }
rescue KeyError => e
  raise ReleaseError, "receipt is incomplete: #{e.message}"
end

command = ARGV.shift
options = { root: Dir.pwd, json: ARGV.delete("--json") ? true : false }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: agent-workflows-release COMMAND [options]"
  opts.on("--root DIR", "Source-pack root") { |value| options[:root] = File.expand_path(value) }
  opts.on("--json", "Emit JSON") { options[:json] = true }
  opts.on("--release TAG", "Exact stable release tag") { |value| options[:release] = value }
  opts.on("--approved-commit SHA", "Approved exact commit") { |value| options[:approved_commit] = value }
  opts.on("--expected-tag-object SHA", "Expected immutable annotated-tag object") do |value|
    options[:expected_tag_object] = value
  end
  opts.on("--environment NAME", "Protected release environment") { |value| options[:environment] = value }
  opts.on("--change-author LOGIN", "Author of the approved change") { |value| options[:change_author] = value }
  opts.on("--release-actor LOGIN", "Actor who initiated the release") { |value| options[:release_actor] = value }
  opts.on("--approval-reviewer LOGIN", "Protected-environment reviewer") do |value|
    options[:approval_reviewer] = value
  end
  opts.on("--workflow-run-url URL", "Durable GitHub Actions run URL") { |value| options[:workflow_run_url] = value }
  opts.on("--recorded-at TIMESTAMP", "Receipt recording timestamp") { |value| options[:recorded_at] = value }
  opts.on("--receipt PATH", "Release receipt path") { |value| options[:receipt] = value }
end

begin
  parser.parse!(ARGV)
  raise ReleaseError, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?

  payload = case command
            when "check-version"
              checked_versions(options.fetch(:root))
            when "verify-tag"
              verify_tag(
                root: options.fetch(:root),
                release: options.fetch(:release) { raise ReleaseError, "--release is required" },
                approved_commit: options.fetch(:approved_commit) { raise ReleaseError, "--approved-commit is required" },
                expected_tag_object: options.fetch(:expected_tag_object) do
                  raise ReleaseError, "--expected-tag-object is required"
                end
              )
            when "record-receipt"
              record_receipt(options)
            when "verify-receipt"
              verify_receipt(options)
            else
              raise ReleaseError, "unknown command: #{command.inspect}"
            end
  puts(options[:json] ? JSON.generate(payload) : payload.values_at("status", "release_ref", "version").compact.join(" "))
rescue OptionParser::ParseError, ReleaseError => e
  payload = { "status" => "RELEASE_CHECK_FAILED", "reason" => e.message }
  warn(options[:json] ? JSON.generate(payload) : "#{payload.fetch('status')}: #{e.message}")
  exit 2
end
