#!/usr/bin/env ruby
# frozen_string_literal: true

# Sync the agent-workflow binstub contract into downstream consumer
# repositories listed in downstream.yml.

require "fileutils"
require "json"
require "open3"
require "optparse"
require "tmpdir"
require "yaml"

load File.expand_path("agent-workflow-seam-doctor", __dir__)
require_relative "../skills/secure-github-actions/lib/secure_github_actions_scanner"

module PushDownstream
  module_function

  COMMIT_TITLE = "Add agent workflow binstub contract"
  POLICY_COMMIT_TITLE = "Configure agent workflow repo policy"
  POLICY_PR_LIST_LIMIT = 100
  POLICY_KEY_PATTERN = /\A[A-Za-z][A-Za-z0-9_]*\z/
  SECURITY_AUDIT_ROLLOUT = {
    "mode" => "coordinator-owned-targeted-pr",
    "trusted_actions" => "maintainer-decision-required",
    "dependabot" => "explicit-repository-decision-required",
    "gate_activation" => "after-remediation-and-validation"
  }.freeze
  DISABLED_HOOKS_PATH = File::NULL
  AUDIT_GIT_ENVIRONMENT = {
    "GIT_CONFIG_NOSYSTEM" => "1",
    "GIT_CONFIG_SYSTEM" => File::NULL,
    "GIT_CONFIG_GLOBAL" => File::NULL,
    "GIT_CONFIG_PARAMETERS" => nil,
    "GIT_CONFIG_COUNT" => "0",
    "GIT_CONFIG_KEY_0" => nil,
    "GIT_CONFIG_VALUE_0" => nil,
    "GIT_ALLOW_PROTOCOL" => nil,
    "GIT_PROTOCOL_FROM_USER" => nil
  }.freeze
  AUDIT_GIT_PREFIX = [
    "git", "-c", "protocol.ext.allow=never", "-c", "core.hooksPath=#{DISABLED_HOOKS_PATH}"
  ].freeze
  AUDIT_GIT_CLONE_ARGUMENTS = ["clone", "--depth", "1", "--no-tags"].freeze
  FALLBACK_GIT_USER_NAME = "Agent Workflows"
  FALLBACK_GIT_USER_EMAIL = "agent-workflows@users.noreply.github.com"
  NEW_AGENTS_HEADER = "# AGENTS.md\n"
  THIN_CLAUDE = "# CLAUDE.md\n\nSee @AGENTS.md for canonical agent instructions, commands, and policy.\n"
  CLAUDE_CONSOLIDATION_FOLLOW_UP = "existing CLAUDE.md preserved; consolidate it to import @AGENTS.md"
  # Claude follows an explicit `@AGENTS.md` import. A bare textual mention of
  # AGENTS.md does not route Claude to the canonical rulebook, so only the
  # import form clears the consolidation follow-up.
  CLAUDE_AGENTS_IMPORT = /(?<![\w.-])@AGENTS\.md\b/
  AUDIT_SCHEMA = "agent-workflows/downstream-seam-audit/v1"
  AUDIT_UNKNOWN = "UNKNOWN"
  AUDIT_CLEAN = "clean"
  AUDIT_STATUSES = [AUDIT_CLEAN, "drifted", "blocked"].freeze
  AUDIT_DOCTOR_READ_TREES = %w[.agents/skills .agents/workflows].freeze
  # The audit covers repo-local seam drift only. Shared skills and workflows are
  # installed per host and are intentionally never copied into consumer repos,
  # so a drifted consumer must not be read as "every upstream commit needs a
  # downstream PR", and a clean consumer says nothing about host skill freshness.
  AUDIT_POLYMORPHIC_FIELDS = %w[seam_doctor_issues changed_managed_paths follow_ups].freeze
  # Consumers of the report must type-check these fields. They are deliberately
  # polymorphic: a blocked consumer must never present an empty Array, which
  # would read as "no issues, nothing to change" for a repo we could not inspect.
  AUDIT_CONTRACT = {
    "statuses" => %w[clean drifted blocked],
    "polymorphic_fields" => AUDIT_POLYMORPHIC_FIELDS,
    "polymorphic_note" => "For a clean or drifted consumer, #{AUDIT_POLYMORPHIC_FIELDS.join(', ')} are " \
                          "each an Array. For a blocked consumer they are the string \"UNKNOWN\", because " \
                          "the value could not be established. Type-check before iterating; an empty Array " \
                          "is never used to represent an unknown value.",
    "exit_codes" => {
      "0" => "every selected consumer is clean",
      "1" => "at least one consumer is drifted or blocked, or no consumers were selected"
    }
  }.freeze
  AUDIT_SCOPE = {
    "audited" => "repo-local agent-workflow seam and scaffold drift",
    "not_audited" => "host-installed shared skills and workflows",
    "note" => "Shared skills and workflows are installed per host and are intentionally not " \
              "copied into consumer repos. A drifted consumer indicates repo-local seam drift " \
              "only; it does not imply that every upstream commit requires a downstream PR."
  }.freeze
  COMMAND_PURPOSES = {
    "setup" => "Install dependencies",
    "validate" => "Pre-push gate",
    "test" => "Run tests",
    "lint" => "Lint / format",
    "build" => "Build / type-check",
    "docs" => "Docs checks",
    "ci-detect" => "CI change detector"
  }.freeze
  COMMAND_ORDER = AgentWorkflowSeamDoctor::STANDARD_SCRIPTS
  TRUST_CONFIG = ".agents/trusted-github-actors.yml"
  TRUST_KEYS = %w[
    trusted_users
    trusted_bots
    trusted_metadata_bots
    trusted_teams
  ].freeze
  MANAGED_SCRIPT_MARKER = "# Generated by shakacode/agent-workflows bin/push-downstream."
  LEGACY_POLICY_KEYS = {
    "Base branch" => "base_branch",
    "CI change detector" => "ci_change_detector",
    "Hosted-CI trigger" => "hosted_ci_trigger",
    "CI parity environment" => "ci_parity_environment",
    "Secret redaction patterns" => "secret_redaction_patterns",
    "Benchmark labels" => "benchmark_labels",
    "Follow-up issue prefix" => "follow_up_prefix",
    "Changelog" => "changelog",
    "Merge ledger" => "merge_ledger",
    "Review gate" => "review_gate",
    "Approval-exempt change categories" => "approval_exempt",
    "Coordination backend" => "coordination_backend"
  }.freeze
  LEGACY_COMMAND_KEYS = {
    "Pre-push local validation" => "validate",
    "CI change detector" => "ci-detect",
    "Lint / format" => "lint",
    "Docs checks" => "docs",
    "Tests" => "test",
    "Build / type checks" => "build"
  }.freeze
  LEGACY_KEY_BULLET = /^-\s+\*\*(.+?)\*\*:\s*(.*)$/

  Result = Struct.new(:changed, :follow_ups, keyword_init: true) do
    def changed?
      changed
    end
  end

  def load_config(path)
    data = YAML.safe_load(File.read(path), aliases: false) || {}
    defaults = data["defaults"] || {}
    (data["repos"] || []).map do |entry|
      merged = defaults.merge(entry)
      owner = merged.fetch("owner")
      repo = merged.fetch("repo")
      {
        owner: owner,
        repo: repo,
        nwo: "#{owner}/#{repo}",
        base_branch: merged.fetch("base_branch"),
        pr_branch: merged.fetch("pr_branch"),
        enabled: merged.fetch("enabled", true),
        tier: merged["tier"],
        preset: merged["preset"],
        overrides: merged["overrides"] || {}
      }
    end
  end

  def load_policy_fleet(config_path, fleet_name)
    data = YAML.safe_load(File.read(config_path), aliases: false) || {}
    raise "invalid downstream registry: expected a mapping" unless data.is_a?(Hash)

    fleets = data["policy_fleets"]
    raise "missing policy_fleets registry" unless fleets.is_a?(Hash)

    fleet = fleets[fleet_name]
    raise "unknown policy fleet: #{fleet_name}" unless fleet.is_a?(Hash)

    defaults = data["defaults"] || {}
    keys = fleet["policy_keys"]
    raise "policy fleet #{fleet_name} must declare policy_keys" unless keys.is_a?(Array) && !keys.empty?
    unless keys.all? { |key| key.is_a?(String) && key.match?(POLICY_KEY_PATTERN) } && keys.uniq.length == keys.length
      raise "policy fleet #{fleet_name} policy_keys must be unique top-level YAML key names"
    end

    pr_branch = fleet["pr_branch"]
    raise "policy fleet #{fleet_name} must declare pr_branch" unless pr_branch.is_a?(String) && !pr_branch.empty?

    entries = fleet["repos"]
    raise "policy fleet #{fleet_name} must declare repos" unless entries.is_a?(Array) && !entries.empty?

    repos = entries.map do |entry|
      raise "policy fleet #{fleet_name} repo entry must be a mapping" unless entry.is_a?(Hash)

      merged = defaults.merge("pr_branch" => pr_branch).merge(entry)
      owner = merged.fetch("owner")
      repo = merged.fetch("repo")
      base_branch = merged.fetch("base_branch")
      repo_pr_branch = merged.fetch("pr_branch")
      policy = merged.fetch("policy")
      unless owner.is_a?(String) && !owner.empty? && repo.is_a?(String) && !repo.empty? &&
             base_branch.is_a?(String) && !base_branch.empty? &&
             repo_pr_branch.is_a?(String) && !repo_pr_branch.empty? && policy.is_a?(Hash)
        raise "invalid policy fleet entry for #{repo || '<unknown>'}"
      end
      if repo_pr_branch == base_branch
        raise "policy fleet #{fleet_name} #{owner}/#{repo} pr_branch must differ from base_branch (#{base_branch})"
      end
      unless policy.keys.sort == keys.sort
        raise "policy fleet #{fleet_name} #{owner}/#{repo} must set exactly: #{keys.join(', ')}"
      end

      {
        owner: owner,
        repo: repo,
        nwo: "#{owner}/#{repo}",
        base_branch: base_branch,
        pr_branch: repo_pr_branch,
        policy: stringify_keys(policy)
      }
    end

    duplicate_repos = repos.group_by { |repo| repo.fetch(:nwo) }.select { |_nwo, matches| matches.length > 1 }.keys
    raise "policy fleet #{fleet_name} has duplicate repos: #{duplicate_repos.join(', ')}" unless duplicate_repos.empty?

    validate_policy_fleet_values!(fleet_name, repos, keys)
    { name: fleet_name, policy_keys: keys, repos: repos }
  rescue KeyError => e
    raise "policy fleet #{fleet_name} is missing #{e.key}"
  end

  def load_security_audit_fleet(config_path, fleet_name)
    data = YAML.safe_load(File.read(config_path), aliases: false)
    unless data.is_a?(Hash)
      raise "invalid downstream registry: top level must be a mapping"
    end

    fleets = data["security_audit_fleets"]
    raise "missing security_audit_fleets registry" unless fleets.is_a?(Hash)

    fleet = fleets[fleet_name]
    raise "unknown security audit fleet: #{fleet_name}" unless fleet.is_a?(Hash)

    entries = fleet["repos"]
    raise "security audit fleet #{fleet_name} must declare repos" unless entries.is_a?(Array) && !entries.empty?

    repos = entries.map do |entry|
      raise "security audit fleet #{fleet_name} repo entry must be a mapping" unless entry.is_a?(Hash)

      owner = entry["owner"]
      repo = entry["repo"]
      base_branch = entry["base_branch"]
      remote_url = entry["remote_url"]
      unless base_branch.is_a?(String) && !base_branch.empty? && !base_branch.match?(/[\0\r\n]/)
        raise "invalid security audit fleet entry"
      end
      raise "invalid security audit fleet owner" unless valid_github_owner?(owner)
      raise "invalid security audit fleet repo" unless valid_github_repo?(repo)
      if !remote_url.nil? && !valid_security_audit_remote_url?(remote_url)
        raise "invalid security audit fleet remote_url for #{owner}/#{repo}"
      end

      {
        owner: owner,
        repo: repo,
        nwo: "#{owner}/#{repo}",
        base_branch: base_branch,
        remote_url: remote_url
      }
    end
    duplicates = repos.group_by { |repo| repo.fetch(:nwo) }.select { |_nwo, matches| matches.length > 1 }.keys
    raise "security audit fleet #{fleet_name} has duplicate repos: #{duplicates.join(', ')}" unless duplicates.empty?

    { name: fleet_name, repos: repos }
  rescue Psych::Exception => e
    raise "invalid downstream registry: #{e.message.lines.first.to_s.strip}"
  end

  def valid_security_audit_remote_url?(remote_url)
    remote_url.is_a?(String) &&
      remote_url.match?(/\A[^\s\0]+\z/) &&
      !remote_url.start_with?("-") &&
      !remote_url.match?(/\A[A-Za-z][A-Za-z0-9+.-]*::/)
  end

  def valid_github_owner?(owner)
    owner.is_a?(String) && owner.bytesize <= 39 &&
      owner.match?(/\A(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\z/)
  end

  def valid_github_repo?(repo)
    repo.is_a?(String) && repo.bytesize <= 100 &&
      repo.match?(/\A(?!-)[A-Za-z0-9_.-]+\z/) && !%w[. ..].include?(repo)
  end

  def validate_policy_fleet_values!(fleet_name, repos, keys)
    repos.each do |repo|
      keys.each do |key|
        value = repo.fetch(:policy).fetch(key)
        begin
          policy_scalar_yaml(value)
        rescue RuntimeError
          raise "policy fleet #{fleet_name} has unsupported scalar #{key} for #{repo.fetch(:nwo)}"
        end
      end
    end

    return unless keys.include?(AgentWorkflowSeamDoctor::REPO_PREFIX_POLICY_KEY)

    prefixes = repos.map { |repo| repo.fetch(:policy).fetch(AgentWorkflowSeamDoctor::REPO_PREFIX_POLICY_KEY) }
    unless prefixes.all? { |prefix| prefix.is_a?(String) && prefix.match?(AgentWorkflowSeamDoctor::REPO_PREFIX_PATTERN) }
      raise "policy fleet #{fleet_name} has an invalid repo_prefix"
    end

    duplicates = prefixes.group_by(&:itself).select { |_prefix, matches| matches.length > 1 }.keys
    raise "policy fleet #{fleet_name} has duplicate repo_prefix values: #{duplicates.join(', ')}" unless duplicates.empty?
  end

  def load_presets(path)
    YAML.safe_load(File.read(path), aliases: false) || {}
  end

  def resolve_contract(repo, presets)
    contract = { commands: {}, policy: {}, trust: empty_trust_config, trust_configured: false }
    merge_contract!(contract, (presets || {})["defaults"] || {})

    if repo[:preset]
      named = (presets || {})["presets"] || {}
      preset = named[repo[:preset]]
      raise "unknown preset: #{repo[:preset]}" if preset.nil?

      merge_contract!(contract, preset)
    end

    merge_contract!(contract, repo[:overrides] || {})
    contract[:policy]["base_branch"] ||= repo[:base_branch]
    contract
  end

  def merge_contract!(contract, layer)
    layer = stringify_keys(layer || {})
    commands = layer.delete("commands") || {}
    trust_configured = layer.key?("trust")
    trust = layer.delete("trust") || {}
    policy = layer.delete("policy") || layer
    contract[:commands].merge!(commands)
    contract[:policy].merge!(policy)
    contract[:trust_configured] ||= trust_configured
    merge_trust_config!(contract[:trust], trust)
  end

  def stringify_keys(value)
    case value
    when Hash
      value.to_h { |key, inner| [key.to_s, stringify_keys(inner)] }
    when Array
      value.map { |inner| stringify_keys(inner) }
    else
      value
    end
  end

  def select_repos(repos, only: nil, include_disabled: false)
    if only && !only.empty?
      repos.select { |repo| only.include?(repo[:repo]) || only.include?(repo[:nwo]) }
    elsif include_disabled
      repos
    else
      repos.select { |repo| repo[:enabled] }
    end
  end

  def select_policy_fleet_repos(repos, only: nil)
    return repos if only.nil?

    normalized_only = only.map(&:strip)
    if normalized_only.empty? || normalized_only.any?(&:empty?)
      raise "policy fleet selection must include at least one non-blank repository"
    end

    available = repos.flat_map { |repo| [repo.fetch(:repo), repo.fetch(:nwo)] }
    missing = normalized_only - available
    raise "unknown policy fleet selection: #{missing.join(', ')}" unless missing.empty?

    repos.select { |repo| normalized_only.include?(repo.fetch(:repo)) || normalized_only.include?(repo.fetch(:nwo)) }
  end

  def reconcile_agents_pointer(text)
    lines = text.lines
    start = lines.index { |line| line.match?(AgentWorkflowSeamDoctor::SECTION_HEADING) }
    return append_pointer_section(text) if start.nil?

    finish = ((start + 1)...lines.length).find { |index| lines[index].match?(/^##\s+/) } || lines.length
    before = lines[0...start].join
    after = lines[finish..].join

    "#{before}#{AgentWorkflowSeamDoctor::POINTER_SECTION}\n#{after}"
  end

  def append_pointer_section(text)
    separator =
      if text.empty? || text.end_with?("\n\n")
        ""
      elsif text.end_with?("\n")
        "\n"
      else
        "\n\n"
      end
    "#{text}#{separator}#{AgentWorkflowSeamDoctor::POINTER_SECTION}\n"
  end

  def reconcile_scaffold(root, contract)
    validate_managed_scaffold_paths!(root)
    changed = false
    follow_ups = []
    preexisting_scripts = repo_owned_standard_scripts(root)
    commands = contract.fetch(:commands).merge(legacy_agents_commands(root))

    FileUtils.mkdir_p(File.join(root, ".agents/bin"))
    changed = true if write_managed_scripts(root, commands, preexisting_scripts)
    changed = true if write_commands_readme(root, commands, preexisting_scripts)
    changed = true if write_policy(root, contract.fetch(:policy))
    trust = contract.fetch(:trust, empty_trust_config)
    trust_configured = contract.fetch(:trust_configured, false)
    if trust_configured || !trust_config_empty?(trust)
      trust_changed = write_trust_config(root, trust, write_empty: trust_configured)
      changed ||= trust_changed
    end
    changed = true if write_agents(root)
    claude_changed, claude_follow_up = reconcile_claude(root)
    changed ||= claude_changed
    follow_ups << claude_follow_up if claude_follow_up

    Result.new(changed:, follow_ups:)
  end

  def repo_owned_standard_scripts(root)
    COMMAND_ORDER.select do |name|
      path = File.join(root, ".agents/bin", name)
      File.file?(path) && !File.read(path, encoding: "UTF-8").include?(MANAGED_SCRIPT_MARKER)
    end
  end

  def write_managed_scripts(root, commands, repo_owned_scripts)
    changed = false
    COMMAND_ORDER.each do |name|
      path = File.join(root, ".agents/bin", name)
      next if repo_owned_scripts.include?(name)
      next unless File.file?(path)
      next if commands.key?(name)

      FileUtils.rm_f(path)
      changed = true
    end

    commands.each do |name, command|
      next unless COMMAND_ORDER.include?(name)
      next if repo_owned_scripts.include?(name)

      path = File.join(root, ".agents/bin", name)
      changed = true if write_if_changed(path, script_content(name, command))
      unless File.executable?(path)
        File.chmod(0o755, path)
        changed = true
      end
    end
    changed
  end

  def script_content(name, command)
    command = normalize_command(command)
    lines = [
      "#!/usr/bin/env bash",
      MANAGED_SCRIPT_MARKER,
      "# #{COMMAND_PURPOSES.fetch(name, 'Agent workflow command')}.",
      "set -euo pipefail"
    ]

    if command.key?("compose")
      lines << 'root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"'
      lines << 'cd "$root"'
      command.fetch("compose").each do |script|
        lines << %("$root/.agents/bin/#{script}")
      end
    else
      lines << 'cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"'
      lines.concat(run_lines(command.fetch("run")))
    end

    "#{lines.join("\n")}\n"
  end

  def normalize_command(command)
    if command.is_a?(Hash)
      stringify_keys(command)
    else
      { "run" => command.to_s }
    end
  end

  def run_lines(command)
    command = command.to_s
    lines = command.lines.map(&:chomp).reject(&:empty?)
    return lines if lines.length > 1
    return [command] if command.match?(/[|&;<>]/)
    return [command] if command.start_with?("(", "{")
    return [command] if command.match?(/\A[A-Za-z_][A-Za-z0-9_]*=/)

    ["exec #{command}"]
  end

  def write_commands_readme(root, commands, preexisting_scripts)
    rows = COMMAND_ORDER.map do |name|
      "| `#{name}` | #{COMMAND_PURPOSES.fetch(name)} | #{command_summary(root, name, commands[name], preexisting_scripts)} |"
    end
    content = <<~MARKDOWN
      # Agent Workflow Scripts

      Standard entry points that portable agent-workflow skills call, so a skill can
      run `.agents/bin/<name>` in any repo without knowing this repo's specific
      commands. Each script is a thin, repo-owned wrapper. A script that is **absent**
      means that capability is n/a here.

      | Script | Purpose | This repo runs |
      | --- | --- | --- |
      #{rows.join("\n")}

      Non-command policy lives in [`../agent-workflow.yml`](../agent-workflow.yml).
    MARKDOWN
    write_if_changed(File.join(root, ".agents/bin/README.md"), content)
  end

  def command_summary(root, name, command, preexisting_scripts)
    if preexisting_scripts.include?(name)
      return "`#{script_run_summary(File.join(root, '.agents/bin', name))}`"
    end

    return "n/a" if command.nil?

    normalized = normalize_command(command)
    if normalized.key?("compose")
      normalized.fetch("compose").map { |script| "`.agents/bin/#{script}`" }.join(" + ")
    else
      "`#{normalized.fetch('run').lines.map(&:strip).reject(&:empty?).join(' + ')}`"
    end
  end

  def script_run_summary(path)
    File.readlines(path, chomp: true).filter_map do |line|
      stripped = line.strip
      next if stripped.empty?
      next if stripped.start_with?("#")
      next if stripped == "set -euo pipefail"
      next if stripped.start_with?("cd ")
      next if stripped.start_with?("root=")

      stripped
    end.join(" + ")
  end

  def write_policy(root, policy)
    path = File.join(root, ".agents/agent-workflow.yml")
    existing = File.file?(path) ? AgentWorkflowSeamDoctor.load_policy_config(path) : {}
    legacy = legacy_agents_policy(root)
    merged = minimum_policy(policy.fetch("base_branch", "main")).merge(policy).merge(legacy).merge(existing)
    write_if_changed(path, "#{merged.to_yaml}\n")
  end

  def write_trust_config(root, trust, write_empty: false)
    desired = normalize_trust_config(trust)
    return false if trust_config_empty?(desired) && !write_empty

    path = File.join(root, TRUST_CONFIG)
    existing = File.file?(path) ? load_trust_config(path) : empty_trust_config
    return false if File.file?(path) && trust_config_includes?(existing, desired)

    merged = merge_trust_configs(existing, desired)
    write_if_changed(path, "#{merged.to_yaml}\n")
  end

  def load_trust_config(path)
    data = YAML.safe_load(File.read(path, encoding: "UTF-8"), aliases: false) || {}
    raise "invalid trust config: #{path}" unless data.is_a?(Hash)

    validate_trust_config!(normalize_trust_config(data), source: path)
  end

  def empty_trust_config
    TRUST_KEYS.to_h { |key| [key, []] }
  end

  def normalize_trust_config(trust)
    trust = stringify_keys(trust || {})
    TRUST_KEYS.to_h do |key|
      values = Array(trust[key]).map { |value| normalize_trust_value(key, value) }.reject(&:empty?)
      [key, values.uniq]
    end
  end

  def normalize_trust_value(key, value)
    case key
    when "trusted_users"
      value.to_s.strip.delete_prefix("@").downcase
    when "trusted_bots", "trusted_metadata_bots"
      normalized_bot_login(value)
    when "trusted_teams"
      value.to_s.strip.downcase
    else
      value.to_s.strip
    end
  end

  def merge_trust_config!(target, trust)
    merge_trust_configs(target, trust).each { |key, values| target[key] = values }
  end

  def merge_trust_configs(existing, desired)
    existing = normalize_trust_config(existing)
    desired = normalize_trust_config(desired)
    merged = TRUST_KEYS.to_h do |key|
      [key, (existing.fetch(key) + desired.fetch(key)).uniq]
    end
    validate_trust_config!(merged)
  end

  def validate_trust_config!(trust, source: nil)
    overlap = normalized_bot_logins(trust.fetch("trusted_bots")) & normalized_bot_logins(trust.fetch("trusted_metadata_bots"))
    return trust if overlap.empty?

    prefix = source ? "invalid trust config #{source}" : "invalid trust config"
    raise "#{prefix}: bot(s) listed in both trusted_bots and trusted_metadata_bots: #{overlap.sort.join(', ')}"
  end

  def normalized_bot_logins(logins)
    logins.map { |login| normalized_bot_login(login) }.reject(&:empty?).uniq
  end

  def normalized_bot_login(login)
    login.to_s.strip.delete_prefix("@").downcase.delete_suffix("[bot]")
  end

  def trust_config_empty?(trust)
    normalize_trust_config(trust).values.all?(&:empty?)
  end

  def trust_config_includes?(existing, desired)
    existing = normalize_trust_config(existing)
    desired = normalize_trust_config(desired)
    TRUST_KEYS.all? do |key|
      (desired.fetch(key) - existing.fetch(key)).empty?
    end
  end

  def legacy_agents_policy(root)
    legacy_agents_values(root).each_with_object({}) do |(key, value), values|
      policy_key = LEGACY_POLICY_KEYS[key]
      next if policy_key.nil?

      values[policy_key] = legacy_policy_value(policy_key, value)
    end
  end

  def legacy_agents_commands(root)
    legacy_agents_values(root).each_with_object({}) do |(key, value), commands|
      command_name = LEGACY_COMMAND_KEYS[key]
      command = legacy_command_value(value)
      next if command_name.nil? || command.nil?

      commands[command_name] = command
    end
  end

  def legacy_agents_values(root)
    agents_path = File.join(root, "AGENTS.md")
    return {} unless File.file?(agents_path)

    section = AgentWorkflowSeamDoctor.extract_section(File.binread(agents_path).force_encoding("UTF-8").scrub)
    return {} if section.nil?

    legacy_config_values(section)
  end

  def legacy_config_values(section)
    values = {}
    current_key = nil
    buffer = +""

    section.each_line do |line|
      match = line.match(LEGACY_KEY_BULLET)
      if match
        values[current_key] = normalize_legacy_value(buffer) if current_key
        current_key = match[1].strip
        buffer = +match[2].strip
        next
      end

      if current_key && line.match?(/^\s{2,}\S/)
        buffer << " " << line.strip
      elsif current_key
        values[current_key] = normalize_legacy_value(buffer)
        current_key = nil
        buffer = +""
      end
    end
    values[current_key] = normalize_legacy_value(buffer) if current_key
    values
  end

  def normalize_legacy_value(value)
    value.split.join(" ")
  end

  def legacy_policy_value(policy_key, value)
    return value unless policy_key == "base_branch"

    value.delete_prefix("`").sub(/`\s*\.?\z/, "").sub(/\.\z/, "")
  end

  def legacy_command_value(value)
    value = value.to_s.strip
    return nil if value.match?(%r{\A(?:n/a|none|not applicable)(?:\b|[.;-]|\z)}i)

    command = value[/`([^`]+)`/, 1] || value
    command = command.sub(/\.\z/, "").strip
    command.empty? ? nil : command
  end

  def minimum_policy(base_branch)
    AgentWorkflowSeamDoctor::REQUIRED_POLICY_KEYS.to_h do |key|
      [key, key == "base_branch" ? base_branch : "n/a"]
    end.merge("follow_up_prefix" => "Follow-up:")
  end

  def write_agents(root)
    path = File.join(root, "AGENTS.md")
    current = File.file?(path) ? File.binread(path).force_encoding("UTF-8").scrub : NEW_AGENTS_HEADER
    write_if_changed(path, reconcile_agents_pointer(current))
  end

  def reconcile_claude(root)
    path = File.join(root, "CLAUDE.md")
    return [write_if_changed(path, THIN_CLAUDE), nil] unless File.exist?(path)

    [false, claude_consolidation_follow_up(root)]
  end

  # Read-only compatibility audit of a consumer-owned CLAUDE.md. Returns a
  # follow-up when the file neither matches the thin template nor routes Claude
  # to canonical AGENTS.md, and nil otherwise. Never reads as a reason to
  # rewrite or delete consumer-owned instruction content.
  def claude_consolidation_follow_up(root)
    path = File.join(root, "CLAUDE.md")
    return nil unless File.file?(path)

    content = File.binread(path).force_encoding("UTF-8").scrub
    return nil if content == THIN_CLAUDE
    return nil if content.match?(CLAUDE_AGENTS_IMPORT)

    CLAUDE_CONSOLIDATION_FOLLOW_UP
  end

  def write_if_changed(path, content)
    current = File.file?(path) ? File.binread(path).force_encoding("UTF-8").scrub : nil
    return false if current == content

    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, content)
    true
  end

  def default_local_contract(base_branch, trust: empty_trust_config)
    {
      commands: {
        "validate" => 'echo "Configure this repo full local validation in .agents/bin/validate" >&2; exit 1',
        "test" => 'echo "Configure this repo test command in .agents/bin/test" >&2; exit 1'
      },
      policy: minimum_policy(base_branch),
      trust: normalize_trust_config(trust),
      trust_configured: !trust_config_empty?(trust)
    }
  end

  def run_local(root, base_branch:, trust:, apply:)
    unless File.directory?(root)
      warn "missing directory: #{root}"
      return 1
    end

    contract = default_local_contract(base_branch, trust:)
    unless apply
      puts "would reconcile binstub scaffold: #{root} (re-run with --apply to write)"
      return 0
    end

    begin
      result = reconcile_scaffold(root, contract)
    rescue RuntimeError => e
      warn "FAIL #{root}: #{e.message}"
      return 1
    end
    issues = AgentWorkflowSeamDoctor.check(root)
    print AgentWorkflowSeamDoctor.format_text(issues)
    result.follow_ups.each { |follow_up| puts "FOLLOW_UP #{follow_up}" }
    puts(result.changed? ? "reconciled binstub scaffold: #{root}" : "already current: #{root}")
    issues.empty? ? 0 : 1
  end

  def run_registry(config_path, presets_path, only:, include_disabled:, apply:)
    repos = select_repos(load_config(config_path), only: only, include_disabled: include_disabled)
    if repos.empty?
      puts "no downstream repos selected"
      return 0
    end

    presets = File.file?(presets_path) ? load_presets(presets_path) : {}
    contracts = {}
    contract_failures = 0
    repos.each do |repo|
      contracts[repo[:nwo]] = resolve_contract(repo, presets)
    rescue RuntimeError => e
      warn "FAIL #{repo[:nwo]}: #{e.message}"
      contract_failures += 1
    end
    valid_repos = repos.select { |repo| contracts.key?(repo[:nwo]) }

    unless apply
      puts "Planned downstream binstub sync (#{repos.length} repo(s)); " \
           "re-run with --apply to clone, reconcile, validate, and open PRs:"
      valid_repos.each do |repo|
        label = repo[:preset] ? " [#{repo[:preset]}]" : ""
        puts "- #{repo[:nwo]}#{label} (base #{repo[:base_branch]} -> branch #{repo[:pr_branch]})"
      end
      return contract_failures.zero? ? 0 : 1
    end

    failures = contract_failures + valid_repos.count { |repo| !sync_repo(repo, contracts.fetch(repo[:nwo])) }
    failures.zero? ? 0 : 1
  end

  # Read-only fleet seam-drift audit. Clones each selected consumer, runs the
  # seam doctor, and computes the desired-state diff in the disposable clone.
  # It never writes to a consumer, never pushes, and never opens a PR.
  def run_audit(config_path, presets_path, only:, include_disabled:)
    repos = select_repos(load_config(config_path), only: only, include_disabled: include_disabled)
    presets = File.file?(presets_path) ? load_presets(presets_path) : {}
    consumers = repos.map { |repo| audit_repo(repo, presets) }
    puts JSON.pretty_generate(audit_report(consumers))
    return 1 if consumers.empty?

    consumers.all? { |consumer| consumer.fetch("status") == AUDIT_CLEAN } ? 0 : 1
  end

  def audit_report(consumers)
    counts = AUDIT_STATUSES.to_h do |status|
      [status, consumers.count { |consumer| consumer.fetch("status") == status }]
    end
    {
      "schema" => AUDIT_SCHEMA,
      "source" => audit_source_provenance,
      "contract" => AUDIT_CONTRACT,
      "scope" => AUDIT_SCOPE,
      "summary" => { "total" => consumers.length }.merge(counts),
      "consumers" => consumers
    }
  end

  # Binds the report to the exact agent-workflows source state that produced it.
  # This runs after every consumer has been audited, so a failure here must not
  # discard a completed report: each field degrades to UNKNOWN on its own.
  def audit_source_provenance(root = File.expand_path("..", __dir__))
    {
      "repo" => "shakacode/agent-workflows",
      "sha" => audit_source_sha(root),
      "worktree_clean" => audit_source_worktree_clean(root)
    }
  end

  def audit_source_sha(root)
    sha, status = Open3.capture2(AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, "-C", root, "rev-parse", "HEAD")
    status.success? && !sha.strip.empty? ? sha.strip : AUDIT_UNKNOWN
  rescue RuntimeError, SystemCallError
    AUDIT_UNKNOWN
  end

  def audit_source_worktree_clean(root)
    porcelain, status = Open3.capture2(
      AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, "-C", root, "status", "--porcelain"
    )
    status.success? ? porcelain.strip.empty? : AUDIT_UNKNOWN
  rescue RuntimeError, SystemCallError
    AUDIT_UNKNOWN
  end

  def managed_scaffold_paths
    fixed_paths = [
      "AGENTS.md",
      "CLAUDE.md",
      AgentWorkflowSeamDoctor::POLICY_CONFIG,
      TRUST_CONFIG,
      ".agents/bin/README.md"
    ]
    fixed_paths + COMMAND_ORDER.map { |command| ".agents/bin/#{command}" }
  end

  # Reconciliation is confined to a disposable clone, but it must not follow a
  # consumer-controlled symlink out of that clone. Treat an unsafe managed path
  # as uninterpretable so the audit reports blocked/UNKNOWN without writing it.
  def validate_managed_scaffold_paths!(root)
    clone_root = File.expand_path(root)
    root_stat = File.lstat(clone_root)
    unless root_stat.directory? && !root_stat.symlink?
      raise "managed scaffold clone root is not a safe directory"
    end

    managed_scaffold_paths.each do |relative_path|
      target = File.expand_path(relative_path, clone_root)
      unless target.start_with?("#{clone_root}#{File::SEPARATOR}")
        raise "managed scaffold path escapes the clone root: #{relative_path}"
      end

      current = clone_root
      relative_path.split(File::SEPARATOR).each do |component|
        current = File.join(current, component)
        begin
          stat = File.lstat(current)
        rescue Errno::ENOENT
          break
        end
        raise "managed scaffold path contains a symlink: #{relative_path}" if stat.symlink?
      end
    end
    true
  rescue Errno::EACCES, Errno::ENOTDIR => e
    raise "managed scaffold path could not be safely inspected: #{e.message}"
  end

  # The seam doctor discovers repo-local Markdown below these trees. Reject
  # symlinks before discovery so a consumer cannot make the read-only audit
  # follow an unbounded device or any other target outside the disposable clone.
  def validate_audit_read_paths!(root)
    validate_managed_scaffold_paths!(root)
    clone_root = File.expand_path(root)

    AUDIT_DOCTOR_READ_TREES.each do |relative_path|
      pending = [File.join(clone_root, relative_path)]
      until pending.empty?
        current = pending.pop
        begin
          stat = File.lstat(current)
        rescue Errno::ENOENT
          next
        end
        if stat.symlink?
          displayed = current.delete_prefix("#{clone_root}#{File::SEPARATOR}")
          raise "audit read path contains a symlink: #{displayed}"
        end
        next unless stat.directory?

        Dir.each_child(current) { |entry| pending << File.join(current, entry) }
      end
    end
    true
  rescue Errno::EACCES, Errno::ENOTDIR => e
    raise "audit read path could not be safely inspected: #{e.message}"
  end

  def audit_repo(repo, presets)
    begin
      contract = resolve_contract(repo, presets)
    rescue RuntimeError => e
      return audit_blocked(repo, "contract could not be resolved: #{e.message}")
    end

    Dir.mktmpdir("push-downstream-audit") do |dir|
      clone = File.join(dir, repo.fetch(:repo))

      # Every shell-out below is guarded so one consumer degrades to a blocked
      # entry instead of aborting the fleet audit. Open3.capture2 raises when the
      # child cannot be spawned. Kernel#system returns nil when exec fails in the
      # forked child, but still raises when fork itself fails (Errno::EAGAIN,
      # Errno::ENOMEM), so it needs the same guard under resource pressure.
      begin
        cloned = system(
          AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, *AUDIT_GIT_CLONE_ARGUMENTS,
          "--branch", repo.fetch(:base_branch), repo_url(repo), clone,
          out: File::NULL, err: File::NULL
        )
      rescue RuntimeError, SystemCallError => e
        return audit_blocked(repo, "clone of #{repo.fetch(:base_branch)} could not be started: #{e.message}")
      end
      unless cloned
        return audit_blocked(repo, "clone of #{repo.fetch(:base_branch)} failed")
      end

      begin
        base_sha = audit_local_ref_head(clone, "HEAD^{commit}")
        tracked_base_sha = audit_local_ref_head(
          clone, "refs/remotes/origin/#{repo.fetch(:base_branch)}^{commit}"
        )
      rescue RuntimeError, SystemCallError => e
        return audit_blocked(repo, "consumer base commit could not be resolved: #{e.message}")
      end
      unless base_sha && tracked_base_sha == base_sha
        return audit_blocked(repo, "configured base branch is not the tracked remote branch")
      end

      begin
        validate_audit_read_paths!(clone)
        issues = AgentWorkflowSeamDoctor.check(clone)
      rescue RuntimeError, SystemCallError => e
        # The doctor reads consumer files and shells out (bash -n), so a single
        # consumer can fail under resource pressure. Record it as blocked rather
        # than aborting the whole fleet audit.
        return audit_blocked(repo, "consumer seam could not be interpreted: #{e.message}", base_sha: base_sha)
      end

      begin
        result = reconcile_scaffold(clone, contract)
      rescue RuntimeError, SystemCallError => e
        return audit_blocked(repo, "desired state could not be computed: #{e.message}", base_sha: base_sha)
      end

      begin
        changed_paths = audit_changed_paths(clone)
      rescue RuntimeError, SystemCallError => e
        return audit_blocked(repo, "reconciled clone could not be inspected: #{e.message}", base_sha: base_sha)
      end
      # A non-success or uninterpretable status is a separate, already-handled
      # case: audit_changed_paths returns nil and the consumer is still blocked.
      if changed_paths.nil?
        return audit_blocked(repo, "reconciled clone could not be compared with its base", base_sha: base_sha)
      end

      audit_entry(
        repo,
        status: issues.empty? && changed_paths.empty? ? AUDIT_CLEAN : "drifted",
        base_sha: base_sha,
        issues: issues,
        changed_paths: changed_paths,
        follow_ups: result.follow_ups
      )
    end
  end

  # A consumer we could not fetch, authenticate, or interpret is never reported
  # clean; the values we could not establish stay literally UNKNOWN.
  def audit_blocked(repo, reason, base_sha: AUDIT_UNKNOWN)
    audit_entry(
      repo,
      status: "blocked",
      base_sha: base_sha,
      issues: AUDIT_UNKNOWN,
      changed_paths: AUDIT_UNKNOWN,
      follow_ups: AUDIT_UNKNOWN,
      reason: reason
    )
  end

  def audit_entry(repo, status:, base_sha:, issues:, changed_paths:, follow_ups:, reason: nil)
    entry = {
      "repo" => repo.fetch(:nwo),
      "preset" => repo[:preset],
      "base_branch" => repo.fetch(:base_branch),
      "base_sha" => base_sha,
      "status" => status,
      "seam_doctor_issues" => issues,
      "changed_managed_paths" => changed_paths,
      "follow_ups" => follow_ups
    }
    entry["reason"] = reason if reason
    entry
  end

  def audit_local_ref_head(clone, ref)
    output, status = Open3.capture2(
      AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, "-C", clone, "rev-parse", "--verify", ref
    )
    status.success? ? output.strip : nil
  end

  def audit_changed_paths(clone)
    output, status = Open3.capture2(
      AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, "-C", clone,
      "status", "--porcelain=v1", "--untracked-files=all", "-z"
    )
    return nil unless status.success?

    parse_porcelain_z_paths(output)&.sort
  end

  # `git status --porcelain=v1 -z` emits one NUL-terminated field per entry as
  # "XY <path>", except that a rename or copy entry is followed by a second
  # field holding the origin path with NO "XY " prefix. Slicing every field at
  # [3..] would turn an origin path like "old.txt" into ".txt", so consume the
  # paired field explicitly. Returns nil on any field we cannot interpret, so an
  # unparseable status is reported blocked rather than as a corrupted path list.
  def parse_porcelain_z_paths(output)
    fields = output.split("\0")
    paths = []
    index = 0
    while index < fields.length
      field = fields[index]
      index += 1
      next if field.empty?
      return nil unless field.length > 3 && field[2] == " "

      codes = field[0, 2]
      paths << field[3..]
      renamed = codes.include?("R")
      next unless renamed || codes.include?("C")

      origin = fields[index]
      index += 1
      return nil if origin.nil? || origin.empty?

      # A rename also removes its origin path; a copy leaves the origin intact.
      paths << origin if renamed
    end
    paths.reject(&:empty?).uniq
  end

  def run_policy_fleet(config_path, fleet_name:, only:, apply:)
    fleet = load_policy_fleet(config_path, fleet_name)
    repos = select_policy_fleet_repos(fleet.fetch(:repos), only: only)

    unless apply
      puts "Planned policy-only fleet #{fleet.fetch(:name)} (#{repos.length} repo(s)); " \
           "re-run with --apply to update only #{fleet.fetch(:policy_keys).join(', ')} in .agents/agent-workflow.yml:"
      repos.each do |repo|
        values = fleet.fetch(:policy_keys).map { |key| "#{key}=#{repo.fetch(:policy).fetch(key)}" }.join(", ")
        puts "- #{repo.fetch(:nwo)} (base #{repo.fetch(:base_branch)} -> branch #{repo.fetch(:pr_branch)}; #{values})"
      end
      return 0
    end

    repos.count { |repo| !sync_policy_repo(repo, fleet.fetch(:policy_keys)) }.zero? ? 0 : 1
  rescue RuntimeError => e
    warn "FAIL policy fleet #{fleet_name}: #{e.message}"
    1
  end

  def run_security_audit_fleet(config_path, fleet_name:, only:)
    fleet = load_security_audit_fleet(config_path, fleet_name)
    repos = select_security_audit_repos(fleet.fetch(:repos), only: only)
    reports = repos.map { |repo| audit_security_repo(repo) }
    document = {
      "contract" => "github-actions-fleet-audit",
      "version" => 1,
      "fleet" => fleet.fetch(:name),
      "read_only" => true,
      "repositories" => reports
    }
    puts JSON.pretty_generate(document)
    reports.all? { |report| report.fetch("status") == "clean" } ? 0 : 1
  rescue RuntimeError => e
    warn "FAIL security audit fleet #{fleet_name}: #{e.message}"
    1
  end

  def select_security_audit_repos(repos, only:)
    return repos if only.nil?

    normalized = only.map(&:strip)
    raise "security audit fleet selection must not be empty" if normalized.empty? || normalized.any?(&:empty?)

    available = repos.flat_map { |repo| [repo.fetch(:repo), repo.fetch(:nwo)] }
    missing = normalized - available
    raise "unknown security audit fleet selection: #{missing.join(', ')}" unless missing.empty?

    repos.select { |repo| normalized.include?(repo.fetch(:repo)) || normalized.include?(repo.fetch(:nwo)) }
  end

  def audit_security_repo(repo)
    Dir.mktmpdir("push-downstream-security-audit") do |dir|
      clone = File.join(dir, repo.fetch(:repo))
      cloned = system(
        AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, *AUDIT_GIT_CLONE_ARGUMENTS,
        "--branch", repo.fetch(:base_branch), repo_url(repo), clone,
        out: File::NULL, err: File::NULL
      )
      return unknown_security_audit(repo, "clone-or-base-resolution-failed") unless cloned

      head, head_status = Open3.capture2(
        AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, "-C", clone, "rev-parse", "HEAD"
      )
      return unknown_security_audit(repo, "head-resolution-failed") unless head_status.success?

      base_ref = "refs/remotes/origin/#{repo.fetch(:base_branch)}"
      base_head, _base_err, base_status = Open3.capture3(
        AUDIT_GIT_ENVIRONMENT, *AUDIT_GIT_PREFIX, "-C", clone,
        "rev-parse", "--verify", "#{base_ref}^{commit}"
      )
      unless base_status.success? && base_head.strip == head.strip
        return unknown_security_audit(repo, "base-branch-ref-missing-or-head-mismatch")
      end

      result = SecureGitHubActions::Scanner.new(clone).scan
      findings = result.findings.map do |finding|
        location = finding.fetch("location")
        {
          "rule_id" => finding.fetch("rule_id"),
          "file" => location.fetch("file"),
          "line" => location.fetch("line"),
          "symbol" => location.fetch("symbol"),
          "title" => finding.fetch("title")
        }
      end
      {
        "repository" => repo.fetch(:nwo),
        "base_branch" => repo.fetch(:base_branch),
        "head_sha" => head.strip,
        "status" => findings.empty? ? "clean" : "noncompliant",
        "files_scanned" => result.files,
        "rule_ids" => findings.map { |finding| finding.fetch("rule_id") }.uniq.sort,
        "findings" => findings,
        "rollout" => SECURITY_AUDIT_ROLLOUT
      }
    end
  rescue ArgumentError, SystemCallError
    unknown_security_audit(repo, "local-audit-failed")
  end

  def unknown_security_audit(repo, reason)
    {
      "repository" => repo.fetch(:nwo),
      "base_branch" => repo.fetch(:base_branch),
      "head_sha" => "UNKNOWN",
      "status" => "UNKNOWN",
      "reason" => reason,
      "files_scanned" => [],
      "rule_ids" => [],
      "findings" => [],
      "rollout" => SECURITY_AUDIT_ROLLOUT
    }
  end

  def sync_repo(repo, contract)
    Dir.mktmpdir("push-downstream-sync") do |dir|
      clone = File.join(dir, repo[:repo])
      unless system("git", "-c", "core.hooksPath=#{DISABLED_HOOKS_PATH}",
                    "clone", "--depth", "1", "--branch", repo[:base_branch],
                    repo_url(repo), clone, out: File::NULL, err: File::NULL)
        warn "FAIL #{repo[:nwo]}: clone of #{repo[:base_branch]} failed"
        return false
      end

      branch_state = checkout_sync_branch(repo, clone)
      unless branch_state
        warn "FAIL #{repo[:nwo]}: could not prepare branch #{repo[:pr_branch]}"
        return false
      end

      begin
        result = reconcile_scaffold(clone, contract)
      rescue RuntimeError => e
        warn "FAIL #{repo[:nwo]}: #{e.message}"
        return false
      end
      issues = AgentWorkflowSeamDoctor.check(clone)
      unless result.changed?
        unless issues.empty?
          warn "FAIL #{repo[:nwo]}: seam doctor: #{issues.join('; ')}"
          return false
        end

        return ensure_pull_request(repo, result.follow_ups) if branch_state == :existing_remote

        puts "UP_TO_DATE #{repo[:nwo]}"
        return true
      end

      unless issues.empty?
        warn "FAIL #{repo[:nwo]}: seam doctor: #{issues.join('; ')}"
        return false
      end

      open_pull_request(repo, clone, result.follow_ups)
    end
  end

  def reconcile_policy_keys(root, selected_policy)
    path = File.join(root, AgentWorkflowSeamDoctor::POLICY_CONFIG)
    policy_config_path_must_be_safe_regular_file!(root, path)

    content = File.binread(path).force_encoding("UTF-8").scrub
    unless policy_config_has_exactly_one_document?(content)
      raise "policy config must contain exactly one YAML document; policy-only reconciliation is unsafe"
    end

    selected_policy.each do |key, value|
      raise "invalid selected policy key: #{key}" unless key.is_a?(String) && !key.empty?
      unless value.is_a?(String) || value.is_a?(Numeric) || value == true || value == false
        raise "invalid selected policy value for key: #{key} (expected a scalar)"
      end
    end

    top_level_key_counts = policy_top_level_string_key_counts(content)
    unless top_level_key_counts
      raise "policy config has ambiguous or non-scalar top-level keys; policy-only reconciliation is unsafe"
    end

    duplicate_selected_keys = selected_policy.keys.select do |key|
      top_level_key_counts.fetch(key, 0) > 1
    end
    unless duplicate_selected_keys.empty?
      raise "selected policy key is ambiguous or not a top-level scalar: #{duplicate_selected_keys.join(', ')}"
    end

    entries = policy_top_level_entries(content)
    unless entries
      raise "policy config has ambiguous or non-scalar top-level policy keys; policy-only reconciliation is unsafe"
    end

    unsupported_selected_keys = policy_selected_keys_with_unsupported_entries(entries, selected_policy.keys)
    unless unsupported_selected_keys.empty?
      raise "selected policy key is not a supported single-line top-level scalar: #{unsupported_selected_keys.join(', ')}"
    end

    existing = AgentWorkflowSeamDoctor.load_policy_config(path)
    raise "invalid policy config: #{AgentWorkflowSeamDoctor::POLICY_CONFIG}" unless existing.is_a?(Hash)

    changes = selected_policy.reject { |key, value| policy_values_equal?(existing[key], value) }
    return false if changes.empty?

    appended_policy = {}
    updated = content.dup
    changes.each do |key, value|
      if existing.key?(key)
        raise "selected policy key is not a scalar: #{key}" unless existing[key].is_a?(String) || existing[key].is_a?(Numeric) || existing[key] == true || existing[key] == false

        updated_entries = policy_top_level_entries(updated)
        entry = updated_entries && updated_entries[key]
        raise "selected policy key is ambiguous or not a top-level scalar: #{key}" unless entry

        existing_line = entry.fetch(:raw)
        unless policy_line_represents_single_line_scalar?(existing_line, key, existing[key])
          raise "selected policy key is not a supported single-line top-level scalar: #{key}"
        end

        prefix = existing_line.match(policy_key_prefix_pattern(key))[1]
        leading_whitespace, suffix = policy_scalar_line_layout(existing_line, prefix)
        replacement = "#{prefix}#{leading_whitespace}#{policy_scalar_yaml(value)}#{suffix}"
        updated = replace_policy_entry(updated, entry, replacement)
      else
        unless policy_allows_top_level_append?(content)
          raise "cannot append selected policy key outside a top-level block mapping"
        end

        updated << "\n" unless updated.empty? || updated.end_with?("\n")
        updated << "#{policy_key_yaml(key)}: #{policy_scalar_yaml(value)}\n"
        appended_policy[key] = value
      end
    end

    unless appended_policy.empty? || policy_appended_keys_round_trip?(updated, appended_policy)
      raise "appended policy keys do not round-trip exactly"
    end

    write_if_changed(path, updated)
  rescue Psych::Exception
    raise "invalid policy config: #{AgentWorkflowSeamDoctor::POLICY_CONFIG}"
  end

  def policy_config_path_must_be_safe_regular_file!(root, path)
    root_path = File.expand_path(root)
    policy_path = File.expand_path(path)
    policy_parent = File.dirname(policy_path)
    unless policy_path == File.join(root_path, AgentWorkflowSeamDoctor::POLICY_CONFIG)
      raise "policy config path escapes root: #{AgentWorkflowSeamDoctor::POLICY_CONFIG}"
    end

    begin
      [root_path, policy_parent].each do |ancestor|
        stat = File.lstat(ancestor)
        unless stat.directory? && !stat.symlink?
          raise "policy config path has a symlink or non-directory ancestor: #{ancestor}"
        end
      end

      policy_config_stat = File.lstat(path)
    rescue Errno::ENOENT
      raise "missing policy config: #{AgentWorkflowSeamDoctor::POLICY_CONFIG}"
    end
    unless policy_config_stat.file? && !policy_config_stat.symlink?
      raise "policy config must be a regular non-symlink file: #{AgentWorkflowSeamDoctor::POLICY_CONFIG}"
    end

    resolved_root = File.realpath(root_path)
    resolved_policy_path = File.realpath(policy_path)
    return if resolved_policy_path.start_with?("#{resolved_root}#{File::SEPARATOR}")

    raise "policy config path escapes root: #{AgentWorkflowSeamDoctor::POLICY_CONFIG}"
  end

  def policy_scalar_yaml(value)
    unless valid_policy_scalar?(value)
      raise "invalid policy scalar"
    end

    serialized = YAML.dump(value)
    scalar = serialized.sub(/\A---[\t ]?/, "").delete_suffix("\n")
    if scalar.match?(/[\r\n]/)
      raise "policy scalar cannot be represented on one YAML line"
    end

    unless serialized.start_with?("--- ") && serialized.end_with?("\n")
      raise "policy scalar cannot be represented on one YAML line"
    end

    round_trip = YAML.safe_load(scalar, aliases: false)
    unless round_trip.instance_of?(value.class) && round_trip == value
      raise "policy scalar does not round-trip exactly"
    end

    scalar
  rescue Psych::Exception
    raise "invalid policy scalar"
  end

  def policy_key_yaml(key)
    raise "invalid selected policy key: #{key}" unless key.is_a?(String) && key.match?(POLICY_KEY_PATTERN)

    serialized = YAML.dump(key)
    scalar = serialized.sub(/\A---[\t ]?/, "").delete_suffix("\n")
    unless serialized.start_with?("--- ") && serialized.end_with?("\n") && !scalar.match?(/[\r\n]/)
      raise "policy key cannot be represented on one YAML line"
    end

    parsed = YAML.safe_load("#{scalar}: marker\n", aliases: false)
    unless parsed.is_a?(Hash) && parsed.keys == [key] && parsed[key] == "marker"
      raise "policy key does not round-trip exactly"
    end

    scalar
  rescue Psych::Exception
    raise "invalid selected policy key: #{key}"
  end

  def valid_policy_scalar?(value)
    case value
    when String
      true
    when true, false
      true
    when Integer
      true
    when Float
      value.finite? && !(value.zero? && (1.0 / value).negative?)
    else
      false
    end
  end

  def policy_values_equal?(actual, desired)
    actual.instance_of?(desired.class) && actual == desired
  end

  def policy_line_represents_single_line_scalar?(line, key, value)
    match = line.match(policy_key_prefix_pattern(key))
    return false if match.nil? || line.delete_prefix(match[0]).lstrip.start_with?("|", ">")

    parsed = YAML.safe_load(line, aliases: false)
    parsed.is_a?(Hash) && parsed.keys == [key] && policy_values_equal?(parsed[key], value)
  rescue Psych::Exception
    false
  end

  def policy_scalar_line_layout(line, prefix)
    remainder = line.delete_prefix(prefix)
    terminal_newline =
      if remainder.end_with?("\r\n")
        "\r\n"
      elsif remainder.end_with?("\n")
        "\n"
      else
        ""
      end
    remainder = remainder.delete_suffix(terminal_newline)
    comment_index = nil
    quote = nil
    escaped = false
    remainder.each_char.with_index do |character, index|
      if quote == '"' && escaped
        escaped = false
      elsif quote == '"' && character == "\\"
        escaped = true
      elsif quote
        quote = nil if character == quote
      elsif ['"', "'"].include?(character)
        quote = character
      elsif character == "#" && index.positive? && remainder[index - 1].match?(/[\t ]/)
        comment_index = index
        break
      end
    end

    suffix_start = comment_index || remainder.length
    suffix_start -= 1 while suffix_start.positive? && remainder[suffix_start - 1].match?(/[\t ]/)
    scalar_portion = remainder[0...suffix_start]
    leading_whitespace = scalar_portion[/\A[\t ]*/]
    suffix = "#{remainder[suffix_start..]}#{terminal_newline}"
    [leading_whitespace, suffix]
  end

  def policy_appended_keys_round_trip?(content, appended_policy)
    parsed = YAML.safe_load(content, aliases: false)
    parsed.is_a?(Hash) && appended_policy.all? do |key, value|
      parsed.key?(key) && policy_values_equal?(parsed[key], value)
    end
  rescue Psych::Exception
    false
  end

  def policy_allows_top_level_append?(content)
    return false if content.match?(/^\.\.\.[\t ]*(?:#[^\r\n]*)?\r?$/)

    first_content_line = content.lines.find do |line|
      stripped = line.strip
      !stripped.empty? && !stripped.start_with?("#") && stripped != "---"
    end
    return false if first_content_line.nil?

    first_content_line.match?(/\A(?:[A-Za-z][A-Za-z0-9_]*|'[^']*'|"[^"]*")[\t ]*:/)
  end

  def policy_key_prefix_pattern(key)
    /^((?:#{policy_key_name_pattern(key)})[\t ]*:)/
  end

  def policy_key_name_pattern(key)
    escaped = Regexp.escape(key)
    "(?:#{escaped}|'#{escaped}'|\"#{escaped}\")"
  end

  def policy_key_line_pattern(key)
    /^#{policy_key_name_pattern(key)}[\t ]*:[^\n]*(?:\n|\z)/
  end

  def policy_patch_line_pattern(key)
    /\A[+-]#{policy_key_name_pattern(key)}[\t ]*:[^\n]*\n?\z/
  end

  def sync_policy_repo(repo, policy_keys)
    Dir.mktmpdir("push-downstream-policy") do |dir|
      clone = File.join(dir, repo.fetch(:repo))
      unless system("git", "-c", "core.hooksPath=#{DISABLED_HOOKS_PATH}",
                    "clone", "--depth", "1", "--branch", repo.fetch(:base_branch),
                    repo_url(repo), clone, out: File::NULL, err: File::NULL)
        warn "FAIL #{repo.fetch(:nwo)}: clone of #{repo.fetch(:base_branch)} failed"
        return false
      end

      base_preflight_issues = AgentWorkflowSeamDoctor.check(clone)
      unless base_preflight_issues.empty?
        warn "FAIL #{repo.fetch(:nwo)}: seam doctor on current base before policy update: #{base_preflight_issues.join('; ')}"
        return false
      end

      # Advisory, read-only: policy-only sync never rewrites a consumer-owned
      # CLAUDE.md, but it must still surface the same consolidation follow-up
      # the full scaffold path reports, on stdout and in any PR it creates.
      follow_ups = Array(claude_consolidation_follow_up(clone))
      follow_ups.each { |follow_up| puts "FOLLOW_UP #{repo.fetch(:nwo)} #{follow_up}" }

      selected_policy = repo.fetch(:policy).slice(*policy_keys)
      unless selected_policy.keys.sort == policy_keys.sort
        warn "FAIL #{repo.fetch(:nwo)}: policy fleet selection is incomplete"
        return false
      end

      unless policy_base_selected_keys_are_unambiguous?(repo, clone, policy_keys)
        return false
      end

      branch_state = checkout_sync_branch(repo, clone)
      unless branch_state
        warn "FAIL #{repo.fetch(:nwo)}: could not prepare branch #{repo.fetch(:pr_branch)}"
        return false
      end

      if branch_state == :existing_remote && !policy_branch_isolated?(repo, clone, policy_keys)
        return false
      end

      if branch_state == :existing_remote && policy_base_has_desired_values?(repo, clone, selected_policy)
        unless policy_base_ref_matches_remote?(repo, clone)
          warn "FAIL #{repo.fetch(:nwo)}: current base moved while checking retained policy branch; rerun from fresh state"
          return false
        end

        open_pr_url, pr_query_succeeded = policy_open_pr_state(repo, any_base: true)
        unless pr_query_succeeded
          warn "FAIL #{repo.fetch(:nwo)}: could not prove whether the retained policy branch has an open PR on any base before reporting up to date; rerun after GitHub is available"
          return false
        end
        unless open_pr_url.nil?
          warn "FAIL #{repo.fetch(:nwo)}: retained policy branch has open PR on any base #{open_pr_url}; close it before reporting up to date"
          return false
        end

        puts "UP_TO_DATE #{repo.fetch(:nwo)}"
        return true
      end

      expected_remote_branch_head = nil
      if branch_state == :existing_remote
        open_pr_url, pr_query_succeeded, pr_base, open_pr_matches = policy_open_pr_state(repo, any_base: true)
        open_pr_matches ||= open_pr_url ? [{ "url" => open_pr_url, "baseRefName" => pr_base }] : []
        alternate_base_pr = open_pr_matches.find do |pull_request|
          pull_request.fetch("baseRefName", nil) != repo.fetch(:base_branch)
        end
        if alternate_base_pr
          alternate_url = normalize_url(alternate_base_pr.fetch("url", nil))
          alternate_base = alternate_base_pr.fetch("baseRefName", nil) || "unknown"
          warn "FAIL #{repo.fetch(:nwo)}: retained policy branch has open PR on alternate base #{alternate_base} #{alternate_url}; rebase or close it before policy update"
          return false
        end
        unless pr_query_succeeded
          warn "FAIL #{repo.fetch(:nwo)}: could not prove whether the retained policy branch has an open PR on any base before policy update; rerun after GitHub is available"
          return false
        end

        expected_remote_branch_head = local_ref_head(clone, "refs/remotes/origin/#{repo.fetch(:pr_branch)}")
        if expected_remote_branch_head.nil?
          warn "FAIL #{repo.fetch(:nwo)}: could not resolve retained policy branch head before policy update"
          return false
        end
      end

      preflight_issues = AgentWorkflowSeamDoctor.check(clone)
      unless preflight_issues.empty?
        warn "FAIL #{repo.fetch(:nwo)}: seam doctor before policy update: #{preflight_issues.join('; ')}"
        return false
      end

      begin
        changed = reconcile_policy_keys(clone, selected_policy)
      rescue RuntimeError => e
        warn "FAIL #{repo.fetch(:nwo)}: #{e.message}"
        return false
      end

      issues = AgentWorkflowSeamDoctor.check(clone)
      unless issues.empty?
        warn "FAIL #{repo.fetch(:nwo)}: seam doctor after policy update: #{issues.join('; ')}"
        return false
      end

      unless changed
        if branch_state == :existing_remote
          open_pr_url, pr_query_succeeded = policy_open_pr_state(repo)
          unless pr_query_succeeded
            warn "FAIL #{repo.fetch(:nwo)}: could not prove whether the retained policy branch has an open PR; rerun after GitHub is available"
            return false
          end
          unless open_pr_url.nil?
            return report_retained_policy_pr(repo, clone, open_pr_url)
          end

          return refresh_policy_branch_from_base(repo, clone, selected_policy, follow_ups)
        end

        puts "UP_TO_DATE #{repo.fetch(:nwo)}"
        return true
      end

      open_policy_pull_request(
        repo,
        clone,
        policy_keys: policy_keys,
        follow_ups: follow_ups,
        expected_remote_branch_head: expected_remote_branch_head,
        require_new_remote_branch: branch_state == :new_local
      )
    end
  end

  def policy_branch_isolated?(repo, clone, policy_keys)
    merge_base = policy_branch_merge_base(repo, clone)
    return false if merge_base.nil?

    base_content = policy_config_content_at_ref(clone, merge_base)
    head_content = policy_config_content_at_ref(clone, "HEAD")
    unless base_content && head_content && policy_config_has_exactly_one_document?(base_content) &&
           policy_config_has_exactly_one_document?(head_content)
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch does not have exactly one YAML document; policy-only isolation is unsafe"
      return false
    end
    base_policy = policy_config_raw_from_content(base_content)
    head_policy = policy_config_raw_from_content(head_content)
    unless base_policy && head_policy && policy_unselected_values_match?(base_policy, head_policy, policy_keys)
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch changes parsed unselected policy values"
      return false
    end
    unless policy_selected_keys_are_supported_in_contents?(base_content, head_content, policy_keys)
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch has an unsupported selected top-level policy scalar; policy-only isolation is unsafe"
      return false
    end
    unless policy_unselected_entries_are_unchanged?(base_content, head_content, policy_keys)
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch changes content outside selected top-level policy lines"
      return false
    end

    unless policy_branch_commits_are_isolated?(repo, clone, merge_base, policy_keys)
      return false
    end

    changed_paths, status = Open3.capture2("git", "-C", clone, "diff", "--name-only", merge_base, "HEAD")
    unless status.success?
      warn "FAIL #{repo.fetch(:nwo)}: could not compare existing policy branch with its merge base"
      return false
    end

    paths = changed_paths.lines.map(&:strip).reject(&:empty?)
    unexpected_paths = paths - [AgentWorkflowSeamDoctor::POLICY_CONFIG]
    unless unexpected_paths.empty?
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch includes non-policy paths: #{unexpected_paths.join(', ')}"
      return false
    end

    unless paths.empty?
      patch, patch_status = Open3.capture2(
        "git", "-C", clone, "diff", "--no-ext-diff", "--unified=0", merge_base, "HEAD", "--",
        AgentWorkflowSeamDoctor::POLICY_CONFIG
      )
      unless patch_status.success? && policy_patch_allows_only_selected_lines?(patch, policy_keys)
        warn "FAIL #{repo.fetch(:nwo)}: existing policy branch changes content outside selected top-level policy lines"
        return false
      end
    end

    head_key_counts = policy_top_level_string_key_counts(head_content)
    unless head_key_counts
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch has ambiguous or non-scalar top-level policy keys; policy-only isolation is unsafe"
      return false
    end
    duplicate_keys = policy_keys.select { |key| head_key_counts.fetch(key, 0) > 1 }
    unless duplicate_keys.empty?
      warn "FAIL #{repo.fetch(:nwo)}: existing policy branch has ambiguous selected policy keys: #{duplicate_keys.join(', ')}"
      return false
    end

    true
  end

  def policy_branch_commits_are_isolated?(repo, clone, merge_base, policy_keys)
    commits, status = Open3.capture2("git", "-C", clone, "rev-list", "#{merge_base}..HEAD")
    unless status.success?
      warn "FAIL #{repo.fetch(:nwo)}: could not enumerate commits on existing policy branch"
      return false
    end

    commits.lines.map(&:strip).reject(&:empty?).each do |commit|
      parents, parent_status = Open3.capture2("git", "-C", clone, "show", "-s", "--format=%P", commit)
      unless parent_status.success?
        warn "FAIL #{repo.fetch(:nwo)}: could not inspect parents for existing policy branch commit #{commit}"
        return false
      end

      parent_refs = parents.split
      if parent_refs.empty?
        warn "FAIL #{repo.fetch(:nwo)}: existing policy branch commit #{commit} has no parent; policy-only isolation is unsafe"
        return false
      end

      parent_refs.each do |parent|
        changed_paths, changed_paths_status = Open3.capture2("git", "-C", clone, "diff", "--name-only", parent, commit)
        unless changed_paths_status.success?
          warn "FAIL #{repo.fetch(:nwo)}: could not inspect existing policy branch commit #{commit}"
          return false
        end

        paths = changed_paths.lines.map(&:strip).reject(&:empty?)
        unexpected_paths = paths - [AgentWorkflowSeamDoctor::POLICY_CONFIG]
        unless unexpected_paths.empty?
          warn "FAIL #{repo.fetch(:nwo)}: existing policy branch includes non-policy paths: #{unexpected_paths.join(', ')} (commit #{commit})"
          return false
        end

        next if paths.empty?

        parent_content = policy_config_content_at_ref(clone, parent)
        commit_content = policy_config_content_at_ref(clone, commit)
        unless policy_unselected_entries_are_unchanged?(parent_content, commit_content, policy_keys)
          warn "FAIL #{repo.fetch(:nwo)}: existing policy branch changes content outside selected top-level policy lines (commit #{commit})"
          return false
        end

        patch, patch_status = Open3.capture2(
          "git", "-C", clone, "diff", "--no-ext-diff", "--unified=0", parent, commit, "--",
          AgentWorkflowSeamDoctor::POLICY_CONFIG
        )
        unless patch_status.success? && policy_patch_allows_only_selected_lines?(patch, policy_keys)
          warn "FAIL #{repo.fetch(:nwo)}: existing policy branch changes content outside selected top-level policy lines (commit #{commit})"
          return false
        end
      end
    end

    true
  end

  def policy_commit_snapshot(repo, clone)
    expected_parent = local_ref_head(clone, "HEAD")
    expected_merge_base = policy_branch_merge_base(repo, clone)
    policy_path = File.join(clone, AgentWorkflowSeamDoctor::POLICY_CONFIG)
    validated_content = File.binread(policy_path)
    if expected_parent && expected_merge_base
      return { expected_parent: expected_parent, expected_merge_base: expected_merge_base,
               validated_content: validated_content }
    end

    warn "FAIL #{repo.fetch(:nwo)}: could not snapshot the validated policy update before commit"
    nil
  rescue SystemCallError => e
    warn "FAIL #{repo.fetch(:nwo)}: could not snapshot the validated policy update before commit: #{e.message}"
    nil
  end

  def policy_committed_head_is_isolated?(repo, clone, policy_keys, snapshot)
    expected_parent = snapshot.fetch(:expected_parent)
    expected_merge_base = snapshot.fetch(:expected_merge_base)
    validated_content = snapshot.fetch(:validated_content)
    head = local_ref_head(clone, "HEAD")
    parents, parent_status = Open3.capture2("git", "-C", clone, "show", "-s", "--format=%P", "HEAD")
    unless head && parent_status.success? && parents.split == [expected_parent]
      return policy_commit_isolation_failure(repo, "committed HEAD does not have the expected single parent")
    end

    merge_base = policy_branch_merge_base(repo, clone)
    unless merge_base == expected_merge_base
      return policy_commit_isolation_failure(repo, "committed HEAD changed the validated merge base")
    end

    changed_paths, changed_paths_status = Open3.capture2(
      "git", "-C", clone, "diff", "--no-ext-diff", "--no-renames", "--name-only", expected_parent, head
    )
    paths = changed_paths.lines.map(&:strip).reject(&:empty?)
    unless changed_paths_status.success? && paths == [AgentWorkflowSeamDoctor::POLICY_CONFIG]
      return policy_commit_isolation_failure(repo, "committed HEAD changes paths other than the policy config")
    end

    parent_content = policy_config_content_at_ref(clone, expected_parent)
    head_content = policy_config_content_at_ref(clone, head)
    unless head_content && head_content.bytes == validated_content.bytes
      return policy_commit_isolation_failure(repo, "committed policy blob differs from the validated worktree content")
    end
    unless parent_content && policy_config_has_exactly_one_document?(parent_content) &&
           policy_config_has_exactly_one_document?(head_content)
      return policy_commit_isolation_failure(repo, "committed policy update does not preserve one YAML document")
    end

    parent_policy = policy_config_raw_from_content(parent_content)
    head_policy = policy_config_raw_from_content(head_content)
    unless parent_policy && head_policy && policy_unselected_values_match?(parent_policy, head_policy, policy_keys) &&
           policy_selected_keys_are_supported_in_contents?(parent_content, head_content, policy_keys) &&
           policy_unselected_entries_are_unchanged?(parent_content, head_content, policy_keys)
      return policy_commit_isolation_failure(repo, "committed policy update changes unselected policy content")
    end

    patch, patch_status = Open3.capture2(
      "git", "-C", clone, "diff", "--no-ext-diff", "--unified=0", expected_parent, head, "--",
      AgentWorkflowSeamDoctor::POLICY_CONFIG
    )
    unless patch_status.success? && policy_patch_allows_only_selected_lines?(patch, policy_keys)
      return policy_commit_isolation_failure(repo, "committed policy patch changes content outside selected top-level policy lines")
    end

    true
  end

  def policy_commit_isolation_failure(repo, reason)
    warn "FAIL #{repo.fetch(:nwo)}: committed policy update failed policy-only isolation: #{reason}"
    false
  end

  def policy_branch_merge_base(repo, clone)
    base_ref = "origin/#{repo.fetch(:base_branch)}"
    merge_base, status = Open3.capture2("git", "-C", clone, "merge-base", base_ref, "HEAD")
    return merge_base.strip if status.success? && !merge_base.strip.empty?

    unless shallow_git_repository?(clone)
      warn "FAIL #{repo.fetch(:nwo)}: could not find merge base for existing policy branch"
      return nil
    end

    unless system("git", "-c", "core.hooksPath=#{DISABLED_HOOKS_PATH}",
                  "-C", clone, "fetch", "--unshallow", "origin", out: File::NULL, err: File::NULL)
      warn "FAIL #{repo.fetch(:nwo)}: could not deepen history for existing policy branch"
      return nil
    end

    merge_base, status = Open3.capture2("git", "-C", clone, "merge-base", base_ref, "HEAD")
    if status.success? && !merge_base.strip.empty?
      merge_base.strip
    else
      warn "FAIL #{repo.fetch(:nwo)}: could not find merge base for existing policy branch"
      nil
    end
  end

  def shallow_git_repository?(clone)
    output, status = Open3.capture2("git", "-C", clone, "rev-parse", "--is-shallow-repository")
    status.success? && output.strip == "true"
  end

  def policy_patch_allows_only_selected_lines?(patch, policy_keys)
    previous_was_selected_policy_line = false
    lines = patch.each_line.to_a
    index = 0
    while index < lines.length
      line = lines.fetch(index)
      if line.start_with?("diff --git ", "index ", "--- ", "+++ ", "@@ ")
        previous_was_selected_policy_line = false
        index += 1
        next
      end
      if line.start_with?("\\ No newline at end of file")
        return false unless previous_was_selected_policy_line

        index += 1
        next
      end
      unless line.start_with?("+", "-")
        return false
      end

      if eof_newline_normalization_before_selected_insertion?(lines, index, policy_keys)
        previous_was_selected_policy_line = true
        index += 4
        next
      end

      previous_was_selected_policy_line = policy_keys.any? { |key| line.match?(policy_patch_line_pattern(key)) }
      return false unless previous_was_selected_policy_line

      index += 1
    end

    true
  end

  def eof_newline_normalization_before_selected_insertion?(lines, index, policy_keys)
    removed = lines[index]
    marker = lines[index + 1]
    restored = lines[index + 2]
    inserted = lines[index + 3]
    return false unless removed&.start_with?("-") && marker == "\\ No newline at end of file\n"
    return false unless restored == "+#{removed.delete_prefix('-')}"
    return false unless inserted&.start_with?("+")
    return false if policy_keys.any? { |key| removed.match?(policy_patch_line_pattern(key)) }

    policy_keys.any? { |key| inserted.match?(policy_patch_line_pattern(key)) }
  end

  def policy_top_level_string_key_counts(content)
    document = Psych.parse(content)
    mapping = document.children.first
    return nil unless mapping.is_a?(Psych::Nodes::Mapping) && mapping.children.length.even?

    mapping.children.each_slice(2).each_with_object(Hash.new(0)) do |(key_node, _value_node), counts|
      key = policy_top_level_string_key_value(key_node)
      return nil if key.nil?

      counts[key] += 1
    end
  rescue Psych::Exception
    nil
  end

  def policy_top_level_entries(content)
    return nil unless content.is_a?(String)

    document = Psych.parse(content)
    mapping = document.children.first
    return nil unless mapping.is_a?(Psych::Nodes::Mapping) && mapping.children.length.even?

    line_starts = [0]
    offset = 0
    content.each_line do |line|
      offset += line.bytesize
      line_starts << offset
    end

    pairs = mapping.children.each_slice(2).to_a
    pairs.each_with_index.each_with_object({}) do |((key_node, value_node), index), entries|
      key = policy_top_level_string_key_value(key_node)
      return nil if key.nil? || entries.key?(key)

      start_offset = line_starts.fetch(key_node.start_line, content.bytesize)
      value_end_offset = line_starts.fetch(value_node.end_line + 1, content.bytesize)
      next_key_node = pairs[index + 1]&.first
      next_key_offset = next_key_node ? line_starts.fetch(next_key_node.start_line, content.bytesize) : content.bytesize
      end_offset = [value_end_offset, next_key_offset].min
      entries[key] = {
        value_node: value_node,
        raw: content.byteslice(start_offset...end_offset),
        start_offset: start_offset,
        end_offset: end_offset
      }
    end
  rescue Psych::Exception
    nil
  end

  def replace_policy_entry(content, entry, replacement)
    start_offset = entry.fetch(:start_offset)
    end_offset = entry.fetch(:end_offset)
    "#{content.byteslice(0...start_offset)}#{replacement}#{content.byteslice(end_offset..)}"
  end

  def policy_selected_keys_with_unsupported_entries(entries, policy_keys)
    policy_keys.select do |key|
      entry = entries[key]
      entry && !policy_entry_is_single_line_scalar?(entry)
    end
  end

  def policy_entry_is_single_line_scalar?(entry)
    value_node = entry.fetch(:value_node)
    value_node.is_a?(Psych::Nodes::Scalar) && value_node.start_line == value_node.end_line &&
      ![Psych::Nodes::Scalar::LITERAL, Psych::Nodes::Scalar::FOLDED].include?(value_node.style)
  end

  def policy_selected_keys_are_supported_in_contents?(base_content, head_content, policy_keys)
    [base_content, head_content].all? do |content|
      entries = policy_top_level_entries(content)
      entries && policy_selected_keys_with_unsupported_entries(entries, policy_keys).empty?
    end
  end

  def policy_unselected_entries_are_unchanged?(base_content, head_content, policy_keys)
    base_entries = policy_top_level_entries(base_content)
    head_entries = policy_top_level_entries(head_content)
    return false unless base_entries && head_entries

    (base_entries.keys | head_entries.keys).all? do |key|
      next true if policy_keys.include?(key)

      base_entry = base_entries[key]
      head_entry = head_entries[key]
      base_entry && head_entry && policy_unselected_entry_bytes_match?(base_entries, head_entries, key, policy_keys)
    end
  end

  def policy_unselected_entry_bytes_match?(base_entries, head_entries, key, policy_keys)
    base_raw = base_entries.fetch(key).fetch(:raw)
    head_raw = head_entries.fetch(key).fetch(:raw)
    return true if base_raw == head_raw
    return false unless base_entries.keys.last == key
    return false unless head_entries.keys.drop_while { |entry_key| entry_key != key }.drop(1).all? { |entry_key| policy_keys.include?(entry_key) }

    ["\n", "\r\n"].any? { |newline| "#{base_raw}#{newline}" == head_raw }
  end

  def policy_top_level_string_key_value(key_node)
    return nil unless key_node.is_a?(Psych::Nodes::Scalar)
    return key_node.value if key_node.tag == "tag:yaml.org,2002:str"
    return nil unless key_node.tag.nil?
    return key_node.value unless key_node.style == Psych::Nodes::Scalar::PLAIN

    scalar = Psych::ScalarScanner.new(Psych::ClassLoader::Restricted.new([], [])).tokenize(key_node.value)
    scalar.is_a?(String) ? scalar : nil
  end

  def policy_base_has_desired_values?(repo, clone, selected_policy)
    base_ref = "origin/#{repo.fetch(:base_branch)}"
    base_policy = policy_config_at_ref(clone, base_ref)
    base_policy && selected_policy.all? { |key, value| policy_values_equal?(base_policy[key], value) }
  end

  def policy_base_selected_keys_are_unambiguous?(repo, clone, policy_keys)
    content = policy_config_content_at_ref(clone, "HEAD")
    if content.nil?
      warn "FAIL #{repo.fetch(:nwo)}: could not read current base policy config before policy update"
      return false
    end

    key_counts = policy_top_level_string_key_counts(content)
    unless key_counts
      warn "FAIL #{repo.fetch(:nwo)}: current base policy config has ambiguous or non-scalar top-level policy keys; policy-only reconciliation is unsafe"
      return false
    end

    duplicate_keys = policy_keys.select { |key| key_counts.fetch(key, 0) > 1 }
    unless duplicate_keys.empty?
      warn "FAIL #{repo.fetch(:nwo)}: current base policy config has ambiguous selected policy keys: #{duplicate_keys.join(', ')}"
      return false
    end

    true
  end

  def policy_base_ref_matches_remote?(repo, clone)
    base_branch = repo.fetch(:base_branch)
    remote_head = remote_ref_head(clone, "refs/heads/#{base_branch}")
    local_head = local_ref_head(clone, "refs/remotes/origin/#{base_branch}")
    !remote_head.nil? && remote_head == local_head
  end

  def policy_branch_ref_matches_remote?(repo, clone)
    branch = repo.fetch(:pr_branch)
    remote_head = remote_ref_head(clone, "refs/heads/#{branch}")
    local_head = local_ref_head(clone, "HEAD")
    !remote_head.nil? && remote_head == local_head
  end

  def report_retained_policy_pr(repo, clone, url)
    unless policy_branch_ref_matches_remote?(repo, clone)
      warn "FAIL #{repo.fetch(:nwo)}: retained policy branch moved while confirming its open PR; rerun from fresh state"
      return false
    end

    puts "PR #{repo.fetch(:nwo)} #{url}"
    true
  end

  def refresh_policy_branch_from_base(repo, clone, selected_policy, follow_ups = [])
    open_pr_url, pr_query_succeeded = policy_open_pr_state(repo, any_base: true)
    unless pr_query_succeeded
      warn "FAIL #{repo.fetch(:nwo)}: could not prove whether the retained policy branch has an open PR on any base; rerun after GitHub is available"
      return false
    end
    unless open_pr_url.nil?
      warn "FAIL #{repo.fetch(:nwo)}: retained policy branch has open PR on any base #{open_pr_url}; rebase or close it before refresh"
      return false
    end

    branch = repo.fetch(:pr_branch)
    base_ref = "origin/#{repo.fetch(:base_branch)}"
    remote_branch_head = remote_ref_head(clone, "refs/heads/#{branch}")
    remote_base_head = remote_ref_head(clone, "refs/heads/#{repo.fetch(:base_branch)}")
    local_branch_head = local_ref_head(clone, "refs/remotes/origin/#{branch}")
    local_base_head = local_ref_head(clone, base_ref)
    if remote_branch_head.nil? || remote_base_head.nil? || local_branch_head.nil? || local_base_head.nil?
      warn "FAIL #{repo.fetch(:nwo)}: could not resolve exact remote heads for safe policy-branch refresh"
      return false
    end
    if remote_branch_head != local_branch_head || remote_base_head != local_base_head
      warn "FAIL #{repo.fetch(:nwo)}: remote branch or base moved during refresh preparation; rerun from fresh state"
      return false
    end

    unless git(clone, "checkout", "-B", branch, base_ref)
      warn "FAIL #{repo.fetch(:nwo)}: could not reset retained policy branch to current base"
      return false
    end

    preflight_issues = AgentWorkflowSeamDoctor.check(clone)
    unless preflight_issues.empty?
      warn "FAIL #{repo.fetch(:nwo)}: seam doctor before policy-branch refresh: #{preflight_issues.join('; ')}"
      return false
    end

    begin
      changed = reconcile_policy_keys(clone, selected_policy)
    rescue RuntimeError => e
      warn "FAIL #{repo.fetch(:nwo)}: #{e.message}"
      return false
    end
    unless changed
      warn "FAIL #{repo.fetch(:nwo)}: policy branch refresh found no change after base values differed; rerun from fresh state"
      return false
    end

    issues = AgentWorkflowSeamDoctor.check(clone)
    unless issues.empty?
      warn "FAIL #{repo.fetch(:nwo)}: seam doctor after policy-branch refresh: #{issues.join('; ')}"
      return false
    end

    commit_snapshot = policy_commit_snapshot(repo, clone)
    return false unless commit_snapshot

    policy_path = AgentWorkflowSeamDoctor::POLICY_CONFIG
    git(clone, "add", "--", policy_path)
    unless git(clone, *git_commit_identity_args(clone), "-c", "commit.gpgsign=false",
               "commit", "-m", POLICY_COMMIT_TITLE)
      warn "FAIL #{repo.fetch(:nwo)}: refreshed policy commit failed"
      return false
    end
    unless policy_committed_head_is_isolated?(repo, clone, selected_policy.keys, commit_snapshot)
      return false
    end

    lease = "refs/heads/#{branch}:#{remote_branch_head}"
    open_pr_url, pr_query_succeeded = policy_open_pr_state(repo, any_base: true)
    unless pr_query_succeeded
      warn "FAIL #{repo.fetch(:nwo)}: could not re-check open PR state on any base before leased refresh push; rerun after GitHub is available"
      return false
    end
    unless open_pr_url.nil?
      warn "FAIL #{repo.fetch(:nwo)}: retained policy branch gained open PR on any base #{open_pr_url}; refresh push cancelled"
      return false
    end

    unless remote_ref_head(clone, "refs/heads/#{repo.fetch(:base_branch)}") == remote_base_head
      warn "FAIL #{repo.fetch(:nwo)}: current base moved before leased policy refresh push; rerun from fresh state"
      return false
    end

    unless git(clone, "push", "--force-with-lease=#{lease}", "origin", "HEAD:#{branch}")
      warn "FAIL #{repo.fetch(:nwo)}: retained policy branch changed before leased refresh push; rerun from fresh state"
      return false
    end

    url = create_policy_pr(repo, branch, follow_ups)
    if url.to_s.empty?
      warn "FAIL #{repo.fetch(:nwo)}: refreshed policy PR create failed"
      return false
    end

    report_policy_pull_request(repo, clone, url)
  end

  def policy_open_pr_state(repo, any_base: false)
    command = ["gh", "pr", "list", "--repo", repo.fetch(:nwo), "--head", repo.fetch(:pr_branch)]
    command += ["--base", repo.fetch(:base_branch)] unless any_base
    command += ["--state", "open", "--limit", POLICY_PR_LIST_LIMIT.to_s,
                "--json", "url,baseRefName,headRepository,headRepositoryOwner,headRefName"]
    out, status = Open3.capture2(*command)
    return [nil, false] unless status.success?

    pull_requests = JSON.parse(out)
    return [nil, false] unless pull_requests.is_a?(Array)

    authoritative_pull_requests = pull_requests.select { |entry| policy_pr_head_matches_repo?(entry, repo) }
    if authoritative_pull_requests.length > 1
      return [nil, false, nil, authoritative_pull_requests]
    end

    if any_base && pull_requests.length >= POLICY_PR_LIST_LIMIT
      return [nil, false, nil, authoritative_pull_requests]
    end

    pull_request = authoritative_pull_requests.first
    unless pull_request.nil?
      return [normalize_url(pull_request.fetch("url", nil)), true, pull_request.fetch("baseRefName", nil), authoritative_pull_requests]
    end

    return [nil, false, nil, []] if pull_requests.length >= POLICY_PR_LIST_LIMIT

    [nil, true, nil, []]
  rescue JSON::ParserError
    [nil, false]
  end

  def policy_pr_head_matches_repo?(pull_request, repo)
    return false unless pull_request.is_a?(Hash) && pull_request["headRefName"] == repo.fetch(:pr_branch)

    owner, name = repo.fetch(:nwo).split("/", 2)
    head_repository = pull_request["headRepository"]
    head_owner = pull_request["headRepositoryOwner"]
    return false unless head_repository.is_a?(Hash) && head_owner.is_a?(Hash)

    head_repository["nameWithOwner"] == repo.fetch(:nwo) ||
      (head_repository["name"] == name && head_owner["login"] == owner)
  end

  def remote_ref_head(clone, ref)
    output, status = Open3.capture2("git", "-C", clone, "ls-remote", "--heads", "origin", ref)
    return nil unless status.success?

    output.split.first
  end

  def local_ref_head(clone, ref)
    output, status = Open3.capture2("git", "-C", clone, "rev-parse", "--verify", ref)
    status.success? ? output.strip : nil
  end

  def policy_config_content_at_ref(clone, ref)
    content, status = Open3.capture2("git", "-C", clone, "show", "#{ref}:#{AgentWorkflowSeamDoctor::POLICY_CONFIG}")
    status.success? ? content : nil
  end

  def policy_config_at_ref(clone, ref)
    content = policy_config_content_at_ref(clone, ref)
    return nil if content.nil?

    policy_config_from_content(content)
  end

  def policy_config_from_content(content)
    config = policy_config_raw_from_content(content)
    config.is_a?(Hash) ? stringify_keys(config) : nil
  end

  def policy_config_raw_from_content(content)
    config = YAML.safe_load(content, aliases: false)
    config.is_a?(Hash) ? config : nil
  rescue Psych::Exception
    nil
  end

  def policy_config_contains_multiline_scalar?(content)
    yaml_node_contains_multiline_scalar?(Psych.parse(content))
  rescue Psych::Exception
    true
  end

  def policy_config_has_exactly_one_document?(content)
    stream = Psych.parse_stream(content)
    stream.children.length == 1
  rescue Psych::Exception
    false
  end

  def yaml_node_contains_multiline_scalar?(node)
    return true if node.is_a?(Psych::Nodes::Scalar) && node.start_line != node.end_line

    children = node.respond_to?(:children) ? node.children : nil
    children&.any? { |child| yaml_node_contains_multiline_scalar?(child) } || false
  end

  def policy_unselected_values_match?(base_policy, head_policy, policy_keys)
    base_unselected = base_policy.reject { |key, _value| policy_keys.include?(key) }
    head_unselected = head_policy.reject { |key, _value| policy_keys.include?(key) }
    policy_values_exactly_equal?(base_unselected, head_unselected)
  end

  def policy_values_exactly_equal?(left, right)
    return false unless left.instance_of?(right.class)

    case left
    when Hash
      return false unless left.length == right.length

      unmatched = right.to_a
      left.all? do |key, value|
        index = unmatched.index { |other_key, _other_value| policy_values_exactly_equal?(key, other_key) }
        next false if index.nil?

        _other_key, other_value = unmatched.delete_at(index)
        policy_values_exactly_equal?(value, other_value)
      end
    when Array
      left.length == right.length && left.zip(right).all? { |value, other| policy_values_exactly_equal?(value, other) }
    else
      left == right
    end
  end

  def open_pull_request(repo, clone, follow_ups)
    branch = repo[:pr_branch]
    git(clone, "add", ".agents", "AGENTS.md", "CLAUDE.md")
    unless git(clone, "-c", "commit.gpgsign=false", "commit", "-m", COMMIT_TITLE)
      warn "FAIL #{repo[:nwo]}: commit failed"
      return false
    end

    unless git(clone, "push", "origin", "HEAD:#{branch}")
      warn "FAIL #{repo[:nwo]}: push failed"
      return false
    end

    ensure_pull_request(repo, follow_ups)
  end

  def open_policy_pull_request(repo, clone, policy_keys:, follow_ups: [], expected_remote_branch_head: nil,
                               require_new_remote_branch: false)
    commit_snapshot = policy_commit_snapshot(repo, clone)
    return false unless commit_snapshot

    policy_path = AgentWorkflowSeamDoctor::POLICY_CONFIG
    git(clone, "add", "--", policy_path)
    unless git(clone, *git_commit_identity_args(clone), "-c", "commit.gpgsign=false",
               "commit", "-m", POLICY_COMMIT_TITLE)
      warn "FAIL #{repo.fetch(:nwo)}: policy commit failed"
      return false
    end
    unless policy_committed_head_is_isolated?(repo, clone, policy_keys, commit_snapshot)
      return false
    end

    branch = repo.fetch(:pr_branch)
    push_args = ["push"]
    if expected_remote_branch_head
      push_args << "--force-with-lease=refs/heads/#{branch}:#{expected_remote_branch_head}"
    elsif require_new_remote_branch
      push_args << "--force-with-lease=refs/heads/#{branch}:"
    end
    push_args += ["origin", "HEAD:#{branch}"]

    if expected_remote_branch_head
      open_pr_url, pr_query_succeeded, pr_base, open_pr_matches = policy_open_pr_state(repo, any_base: true)
      unless pr_query_succeeded
        warn "FAIL #{repo.fetch(:nwo)}: could not re-check open PR state on any base before leased policy push; rerun after GitHub is available"
        return false
      end

      open_pr_matches ||= open_pr_url ? [{ "url" => open_pr_url, "baseRefName" => pr_base }] : []
      alternate_base_pr = open_pr_matches.find do |pull_request|
        pull_request.fetch("baseRefName", nil) != repo.fetch(:base_branch)
      end
      if alternate_base_pr
        alternate_url = normalize_url(alternate_base_pr.fetch("url", nil))
        alternate_base = alternate_base_pr.fetch("baseRefName", nil) || "unknown"
        warn "FAIL #{repo.fetch(:nwo)}: retained policy branch gained open PR on alternate base #{alternate_base} #{alternate_url}; policy push cancelled"
        return false
      end
    end

    unless policy_base_ref_matches_remote?(repo, clone)
      warn "FAIL #{repo.fetch(:nwo)}: current base moved before policy push; rerun from fresh state"
      return false
    end
    unless git(clone, *push_args)
      warn "FAIL #{repo.fetch(:nwo)}: policy push failed"
      return false
    end

    ensure_policy_pull_request(repo, clone, follow_ups)
  end

  def ensure_pull_request(repo, follow_ups)
    branch = repo[:pr_branch]
    url = existing_pr_url(repo, branch) || create_pr(repo, branch, follow_ups)
    if url.to_s.empty?
      warn "FAIL #{repo[:nwo]}: PR create failed"
      return false
    end

    puts "PR #{repo[:nwo]} #{url}"
    true
  end

  def ensure_policy_pull_request(repo, clone = nil, follow_ups = [])
    url, query_succeeded = policy_open_pr_state(repo)
    unless query_succeeded
      warn "FAIL #{repo.fetch(:nwo)}: could not prove whether the policy branch has an open PR; rerun after GitHub is available"
      return false
    end

    url ||= create_policy_pr(repo, repo.fetch(:pr_branch), follow_ups)
    if url.to_s.empty?
      warn "FAIL #{repo.fetch(:nwo)}: policy PR create failed"
      return false
    end

    return report_policy_pull_request(repo, clone, url) unless clone.nil?

    puts "PR #{repo.fetch(:nwo)} #{url}"
    true
  end

  def report_policy_pull_request(repo, clone, url)
    unless policy_branch_ref_matches_remote?(repo, clone)
      warn "FAIL #{repo.fetch(:nwo)}: policy branch moved while confirming its PR; rerun from fresh state"
      return false
    end

    puts "PR #{repo.fetch(:nwo)} #{url}"
    true
  end

  def checkout_sync_branch(repo, clone)
    branch = repo.fetch(:pr_branch)
    case remote_branch_state(clone, branch)
    when :present
      if git(clone, "fetch", "origin", "#{branch}:refs/remotes/origin/#{branch}") &&
         git(clone, "checkout", "-B", branch, "origin/#{branch}")
        :existing_remote
      end
    when :absent
      git(clone, "checkout", "-b", branch) && :new_local
    end
  end

  def remote_branch_state(clone, branch)
    _output, status = Open3.capture2("git", "-C", clone, "ls-remote", "--exit-code", "--heads", "origin", branch)
    return :present if status.success?
    return :absent if status.exitstatus == 2

    :error
  end

  def repo_url(repo)
    repo[:remote_url] || "https://github.com/#{repo[:nwo]}.git"
  end

  def git(dir, *)
    system("git", "-c", "core.hooksPath=#{DISABLED_HOOKS_PATH}", "-C", dir, *, out: File::NULL, err: File::NULL)
  end

  def git_commit_identity_args(dir)
    {
      "user.name" => FALLBACK_GIT_USER_NAME,
      "user.email" => FALLBACK_GIT_USER_EMAIL
    }.each_with_object([]) do |(key, fallback), args|
      value, status = Open3.capture2("git", "-C", dir, "config", "--get", key)
      args.concat(["-c", "#{key}=#{fallback}"]) unless status.success? && !value.strip.empty?
    end
  end

  def existing_pr_url(repo, branch)
    out, status = Open3.capture2(
      "gh", "pr", "list", "--repo", repo[:nwo], "--head", branch,
      "--base", repo[:base_branch], "--state", "open", "--json", "url", "--jq", ".[0].url"
    )
    normalize_url(status.success? ? out.strip : nil)
  end

  def create_pr(repo, branch, follow_ups)
    out, status = Open3.capture2(
      "gh", "pr", "create", "--repo", repo[:nwo], "--base", repo[:base_branch],
      "--head", branch, "--title", COMMIT_TITLE, "--body", pr_body(follow_ups)
    )
    normalize_url(status.success? ? out.strip.lines.last.to_s.strip : nil)
  end

  def create_policy_pr(repo, branch, follow_ups = [])
    out, status = Open3.capture2(
      "gh", "pr", "create", "--repo", repo.fetch(:nwo), "--base", repo.fetch(:base_branch),
      "--head", branch, "--title", POLICY_COMMIT_TITLE, "--body", policy_pr_body(follow_ups)
    )
    normalize_url(status.success? ? out.strip.lines.last.to_s.strip : nil)
  end

  def normalize_url(value)
    value = value.to_s.strip
    value.empty? || value == "null" ? nil : value
  end

  def follow_up_section(follow_ups)
    lines = Array(follow_ups).map { |follow_up| "- #{follow_up}" }
    return "" if lines.empty?

    "\n## Follow-ups\n\n#{lines.join("\n")}\n"
  end

  def pr_body(follow_ups = [])
    follow_up_section = follow_up_section(follow_ups)

    <<~BODY
      ## Summary

      - add standard `.agents/bin/*` command wrappers for portable shared skills
      - add non-command policy in `.agents/agent-workflow.yml`
      - add repo-local trust policy in `.agents/trusted-github-actors.yml` when configured
      - point `AGENTS.md` at the command and policy contract

      Generated by `bin/push-downstream` from
      [`shakacode/agent-workflows`](https://github.com/shakacode/agent-workflows).
      #{follow_up_section}
      ## Validation

      - `agent-workflow-seam-doctor --root . --shared <agent-workflows-root>`
    BODY
  end

  def policy_pr_body(follow_ups = [])
    <<~BODY
      ## Summary

      - reconcile the explicitly registered policy key(s) in `.agents/agent-workflow.yml`
      - preserve all command wrappers, `AGENTS.md`, `CLAUDE.md`, trust configuration, and unrelated policy keys

      Generated by the policy-only fleet mode of `bin/push-downstream` from
      [`shakacode/agent-workflows`](https://github.com/shakacode/agent-workflows).
      #{follow_up_section(follow_ups)}
      ## Validation

      - `agent-workflow-seam-doctor --root . --shared <agent-workflows-root>`
    BODY
  end
end

if $PROGRAM_NAME == __FILE__
  options = {
    config: File.expand_path("../downstream.yml", __dir__),
    presets: File.expand_path("../seam-presets.yml", __dir__),
    root: nil,
    policy_fleet: nil,
    security_audit_fleet: nil,
    only: nil,
    include_disabled: false,
    apply: false,
    audit: false,
    base_branch: "main",
    trust: PushDownstream.empty_trust_config
  }

  OptionParser.new do |opts|
    opts.banner = "Usage: push-downstream [--root DIR | --policy-fleet NAME | --security-audit-fleet NAME | --config FILE] [--only a,b] [--all] [--apply] [--trusted-user LOGIN]"
    opts.on("--root DIR", "Reconcile one local checkout instead of the registry") { |value| options[:root] = value }
    opts.on("--policy-fleet NAME", "Apply only explicitly registered policy keys for a named fleet") { |value| options[:policy_fleet] = value }
    opts.on("--security-audit-fleet NAME", "Read-only GitHub Actions audit for a named fleet") do |value|
      options[:security_audit_fleet] = value
    end
    opts.on("--config FILE", "Downstream registry YAML (default: downstream.yml)") { |value| options[:config] = value }
    opts.on("--presets FILE", "Seam preset YAML (default: seam-presets.yml)") { |value| options[:presets] = value }
    opts.on("--only a,b", Array, "Restrict to these repo names") { |value| options[:only] = value }
    opts.on("--all", "Include repos marked enabled: false") { options[:include_disabled] = true }
    opts.on("--apply", "Apply changes (write files; push branches and open PRs)") { options[:apply] = true }
    opts.on("--audit",
            "Read-only fleet seam-drift report as JSON; never writes, pushes, or opens PRs.",
            "Exit 0 when every selected consumer is clean; 1 when any is drifted or blocked, or none are selected.",
            "Per consumer, seam_doctor_issues, changed_managed_paths, and follow_ups are",
            "each an Array, or the string \"UNKNOWN\" when the consumer is blocked and the",
            "value could not be established. Type-check these fields before iterating.") do
      options[:audit] = true
    end
    opts.on("--base-branch NAME", "Base branch for --root mode (default: main)") { |value| options[:base_branch] = value }
    opts.on("--trusted-user LOGIN", "Seed repo-local trusted user in --root mode; repeatable") do |value|
      options[:trust]["trusted_users"] << value
    end
    opts.on("--trusted-bot LOGIN", "Seed repo-local trusted bot base login in --root mode; repeatable") do |value|
      options[:trust]["trusted_bots"] << value
    end
    opts.on("--trusted-metadata-bot LOGIN", "Seed metadata-only bot base login in --root mode; repeatable") do |value|
      options[:trust]["trusted_metadata_bots"] << value
    end
    opts.on("--trusted-team SLUG", "Seed repo-local trusted team slug in --root mode; repeatable") do |value|
      options[:trust]["trusted_teams"] << value
    end
    opts.on("-h", "--help", "Show help") do
      puts opts
      exit 0
    end
  end.parse!

  code =
    if options[:audit]
      if options[:root] || options[:policy_fleet]
        warn "--audit cannot be combined with --root or --policy-fleet"
        1
      elsif options[:security_audit_fleet]
        warn "--audit cannot be combined with --security-audit-fleet"
        1
      elsif options[:apply]
        warn "--audit is read-only and cannot be combined with --apply"
        1
      elsif !PushDownstream.trust_config_empty?(options[:trust])
        warn "--trusted-* flags require --root; --audit never writes to a consumer"
        1
      else
        PushDownstream.run_audit(
          options[:config],
          options[:presets],
          only: options[:only],
          include_disabled: options[:include_disabled]
        )
      end
    elsif options[:root]
      if options[:policy_fleet] || options[:security_audit_fleet]
        warn "--policy-fleet and --security-audit-fleet cannot be combined with --root"
        1
      else
        PushDownstream.run_local(
          options[:root],
          base_branch: options[:base_branch],
          trust: options[:trust],
          apply: options[:apply]
        )
      end
    elsif options[:security_audit_fleet]
      if options[:apply]
        warn "--apply cannot be combined with --security-audit-fleet"
        1
      elsif options[:policy_fleet]
        warn "--policy-fleet cannot be combined with --security-audit-fleet"
        1
      elsif options[:include_disabled]
        warn "--all cannot be combined with --security-audit-fleet; fleet membership is explicit"
        1
      elsif !PushDownstream.trust_config_empty?(options[:trust])
        warn "--trusted-* flags cannot be combined with --security-audit-fleet"
        1
      else
        PushDownstream.run_security_audit_fleet(
          options[:config],
          fleet_name: options[:security_audit_fleet],
          only: options[:only]
        )
      end
    elsif options[:policy_fleet]
      if options[:include_disabled]
        warn "--all cannot be combined with --policy-fleet; fleet membership is explicit"
        1
      elsif !PushDownstream.trust_config_empty?(options[:trust])
        warn "--trusted-* flags require --root; policy fleets read only their registered policy values"
        1
      else
        PushDownstream.run_policy_fleet(
          options[:config],
          fleet_name: options[:policy_fleet],
          only: options[:only],
          apply: options[:apply]
        )
      end
    else
      unless PushDownstream.trust_config_empty?(options[:trust])
        warn "--trusted-* flags require --root; use downstream.yml or seam-presets.yml trust blocks in registry mode"
        exit 1
      end

      PushDownstream.run_registry(
        options[:config],
        options[:presets],
        only: options[:only],
        include_disabled: options[:include_disabled],
        apply: options[:apply]
      )
    end

  exit code
end
