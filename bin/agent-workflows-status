#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "digest"
require "optparse"
require "open3"
require "rbconfig"
require "tmpdir"

load File.expand_path("agent-workflows-delivery-state", __dir__)

module AgentWorkflowsStatus
  METADATA_NAME = ".agent-workflows-install.json"
  STATUS_EXIT = {
    "UP_TO_DATE" => 0,
    "UPGRADE_AVAILABLE" => 1,
    "NOT_INSTALLED" => 2,
    "CHECK_FAILED" => 3
  }.freeze

  module_function

  def default_target_for_host(host)
    case host
    when "codex"
      ENV.fetch("CODEX_HOME", File.join(Dir.home, ".codex"))
    when "claude"
      ENV.fetch("CLAUDE_HOME", File.join(Dir.home, ".claude"))
    else
      raise ArgumentError, "unsupported host: #{host}"
    end
  end

  def resolve_auto_target
    codex_home = ENV.fetch("CODEX_HOME", File.join(Dir.home, ".codex"))
    claude_home = ENV.fetch("CLAUDE_HOME", File.join(Dir.home, ".claude"))
    candidates = []
    candidates << ["codex", codex_home] if ENV.key?("CODEX_HOME") || Dir.directory?(codex_home)
    candidates << ["claude", claude_home] if ENV.key?("CLAUDE_HOME") || Dir.directory?(claude_home)

    case candidates.length
    when 0
      ["codex", codex_home]
    when 1
      candidates.first
    else
      raise ArgumentError, "auto host detection found both Codex and Claude homes"
    end
  end

  def resolve_host_and_target(host, target)
    if target
      expanded = File.expand_path(target)
      if host == "auto"
        codex_home = File.expand_path(default_target_for_host("codex"))
        claude_home = File.expand_path(default_target_for_host("claude"))
        codex_marker = expanded == codex_home || File.file?(File.join(expanded, "config.toml"))
        claude_marker = expanded == claude_home || File.file?(File.join(expanded, "settings.json")) ||
                        File.file?(File.join(expanded, "plugins/installed_plugins.json"))
        raise ArgumentError, "explicit target has both Codex and Claude markers; pass --host" if codex_marker && claude_marker

        resolved_host = if claude_marker
                          "claude"
                        else
                          "codex"
                        end
        return [resolved_host, expanded]
      end
      return [host, expanded]
    end
    return resolve_auto_target if host == "auto"

    [host, default_target_for_host(host)]
  end

  def metadata_path(target)
    File.join(target, METADATA_NAME)
  end

  def read_metadata(target)
    path = metadata_path(target)
    return nil unless File.file?(path)

    metadata = JSON.parse(File.binread(path).force_encoding("UTF-8").scrub)
    raise "invalid metadata #{path}: expected a JSON object" unless metadata.is_a?(Hash)

    metadata
  rescue JSON::ParserError => e
    raise "invalid metadata #{path}: #{e.message}"
  end

  def version_for(source)
    path = File.join(source, "VERSION")
    return "unknown" unless File.file?(path)

    File.binread(path).force_encoding("UTF-8").scrub.strip
  end

  def git_output(source, *args)
    stdout, stderr, status = Open3.capture3("git", "-C", source, *args)
    # Force UTF-8 so non-ASCII git output (branch/error text) survives LANG=C.
    # Keep the channels apart: git can write incidental stderr (a tool-manager
    # shim warning, an advice line) while succeeding, and callers read the
    # success value as a ref. Failures still report git diagnostics, falling
    # back to stdout when git left stderr empty.
    stdout = stdout.force_encoding("UTF-8").scrub.strip
    stderr = stderr.force_encoding("UTF-8").scrub.strip
    return [stdout, nil] if status.success?

    [nil, stderr.empty? ? stdout : stderr]
  end

  def remote_ref_for(source, metadata)
    head, = git_output(source, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    return head if head && !head.empty?

    branch = metadata["source_branch"].to_s
    branch.empty? ? "origin/main" : "origin/#{branch}"
  end

  def verify_stable_release(source, metadata, release_ref, fetch:)
    unless release_ref.is_a?(String) && release_ref.match?(/\Av\d+\.\d+\.\d+\z/)
      return [nil, nil, nil, "stable status requires an exact vX.Y.Z release"]
    end

    if fetch
      _, fetch_error = git_output(source, "fetch", "--quiet", "--prune", "--tags", "origin")
      return [nil, nil, nil, "git fetch failed: #{fetch_error}"] if fetch_error
    end

    tag_ref = "refs/tags/#{release_ref}"
    tag_object, tag_error = git_output(source, "rev-parse", "--verify", tag_ref)
    return [nil, nil, nil, "missing stable release tag #{release_ref}: #{tag_error}"] if tag_error

    expected_tag_object = release_ref == metadata["release_ref"] ? metadata["tag_object"].to_s : tag_object
    if expected_tag_object.empty?
      return [nil, nil, nil, "installed stable metadata is missing tag_object"]
    end
    if tag_object != expected_tag_object
      return [nil, nil, nil, "tag moved: expected #{expected_tag_object}, found #{tag_object}"]
    end

    helper = File.expand_path("agent-workflows-release", __dir__)
    output, status = Open3.capture2e(
      RbConfig.ruby, helper, "verify-tag", "--root", source, "--release", release_ref,
      "--approved-commit", git_output(source, "rev-parse", "--verify", "#{tag_ref}^{commit}").first.to_s,
      "--expected-tag-object", expected_tag_object, "--json"
    )
    unless status.success?
      reason = JSON.parse(output).fetch("reason")
      return [nil, nil, nil, reason]
    end

    verified = JSON.parse(output)
    if release_ref != metadata["release_ref"]
      output, status = Open3.capture2e(
        RbConfig.ruby, helper, "verify-published", "--root", source, "--release", release_ref,
        "--approved-commit", verified.fetch("peeled_commit"), "--expected-tag-object", tag_object,
        "--repository", "shakacode/agent-workflows", "--json"
      )
      return [nil, nil, nil, JSON.parse(output).fetch("reason")] unless status.success?
    end
    [verified.fetch("peeled_commit"), verified.fetch("version"), tag_object, nil]
  rescue JSON::ParserError, SystemCallError => e
    [nil, nil, nil, "stable release verification failed: #{e.message}"]
  end

  def available_revision(source, metadata, fetch:, channel:, release_ref:)
    return [nil, "missing source root: #{source}"] unless File.directory?(source)

    if channel == "stable"
      revision, version, tag_object, error = verify_stable_release(source, metadata, release_ref, fetch:)
      return [nil, error, nil, nil] if error

      return [revision, nil, version, tag_object]
    end

    unless File.directory?(File.join(source, ".git"))
      version = version_for(source)
      return ["version:#{version}", nil, version, nil]
    end

    ref =
      if fetch
        _, fetch_error = git_output(source, "fetch", "--quiet", "--prune", "origin")
        return [nil, "git fetch failed: #{fetch_error}", nil, nil] if fetch_error

        remote_ref_for(source, metadata)
      else
        "HEAD"
      end

    revision, error = git_output(source, "rev-parse", ref)
    return [nil, "git rev-parse #{ref} failed: #{error}", nil, nil] if error

    [revision, nil, version_for(source), nil]
  end

  def short_revision(value)
    value.to_s.start_with?("version:") ? value : value.to_s[0, 12]
  end

  def delivery_state(host:, target:, source:, delivery_mode:)
    helper = File.expand_path("agent-workflows-delivery-state", __dir__)
    output, error, status = Open3.capture3(
      RbConfig.ruby,
      helper,
      "check",
      "--host", host,
      "--target", target,
      "--source", source,
      "--delivery-mode", delivery_mode,
      "--json"
    )
    payload = JSON.parse(output)
    [payload, status.success? ? nil : payload["reason"]]
  rescue SystemCallError, JSON::ParserError, TypeError => e
    [nil, "delivery-state check failed: #{error}#{e.message}"]
  end

  def superpowers_delivery_state(host, target)
    return nil unless host == "codex"

    { "superpowers" => AgentWorkflowsDeliveryState.superpowers_state(host, target) }
  end

  def with_superpowers_delivery_state(delivery, host, target)
    return delivery if delivery&.key?("superpowers")

    superpowers = superpowers_delivery_state(host, target)
    superpowers ? (delivery || {}).merge(superpowers) : delivery
  end

  def stable_delivery_state(host:, target:, source:, revision:, delivery_mode:, metadata:)
    Dir.mktmpdir("agent-workflows-stable-status") do |materialized|
      archive = File.join(materialized, "release.tar")
      output, status = Open3.capture2e("git", "-C", source, "archive", "--format=tar", "--output", archive, revision)
      raise "git archive failed: #{output.force_encoding('UTF-8').scrub.strip}" unless status.success?

      output, status = Open3.capture2e("tar", "-xf", archive, "-C", materialized)
      raise "release extraction failed: #{output.force_encoding('UTF-8').scrub.strip}" unless status.success?

      File.delete(archive)
      inventory_error = stable_release_inventory_error(materialized, metadata)
      return [nil, inventory_error] if inventory_error

      workflows = AgentWorkflowsDeliveryState.filesystem_entries(File.join(materialized, "workflows")) || {}
      fingerprints = workflows.filter_map do |name, path|
        next if File.directory?(path) && !File.symlink?(path)
        unless File.file?(path) && !File.symlink?(path)
          return [nil, "release workflow is not a regular file: #{name}"]
        end

        [name, Digest::SHA256.file(path).hexdigest]
      end.to_h
      unless fingerprints.empty?
        installed = File.join(target, "workflows")
        unless File.directory?(installed) && !File.symlink?(installed)
          return [nil, "installed workflow directory is missing or is a symlink"]
        end
      end
      workflow_error = stable_managed_surface_error(
        target, { "release_workflows" => fingerprints },
        fields: { "managed workflow" => %w[release_workflows workflows] }
      )
      return [nil, workflow_error] if workflow_error

      delivery_state(host:, target:, source: materialized, delivery_mode:)
    end
  end

  def stable_release_inventory_error(release_root, metadata)
    installer = File.join(release_root, "bin/install-agent-workflows")
    return "release inventory provider is missing or unsafe" unless File.file?(installer) && !File.symlink?(installer)

    output, error, status = Open3.capture3(
      { "BASH_ENV" => nil, "ENV" => nil, "RUBYOPT" => nil },
      "bash", "--noprofile", "--norc", installer, "--print-install-inventory"
    )
    return "release inventory provider failed: #{error.force_encoding('UTF-8').scrub.strip}" unless status.success?

    inventory = JSON.parse(output.force_encoding("UTF-8").scrub)
    unless inventory.is_a?(Hash) && inventory["version"] == 1
      return "release inventory is invalid"
    end

    expected = {
      "managed_bin_helper_copy_fingerprints" => inventory["bin_helpers"],
      "managed_pack_doc_copy_fingerprints" => inventory["pack_docs"],
      "managed_pack_root_copy_fingerprints" => ["THIRD_PARTY-NOTICES.md"]
    }
    expected.each do |field, names|
      unless names.is_a?(Array) && names.all? { |name| name.is_a?(String) } && names.uniq == names &&
             metadata[field].is_a?(Hash) && metadata[field].keys.sort == names.sort
        return "installed stable metadata inventory does not match release: #{field}"
      end
    end
    error = stable_managed_surface_error(release_root, metadata)
    error && "release inventory fingerprint mismatch: #{error}"
  rescue JSON::ParserError, SystemCallError => e
    "release inventory could not be checked: #{e.message}"
  end

  def managed_surface_stat_identity(stat)
    [
      stat.ftype,
      stat.dev,
      stat.ino,
      stat.mode,
      stat.size,
      stat.mtime.to_i,
      stat.mtime.nsec,
      stat.ctime.to_i,
      stat.ctime.nsec
    ]
  end

  def stable_managed_surface_error(target, metadata, fields: nil)
    fields ||= {
      "managed helper" => %w[managed_bin_helper_copy_fingerprints bin],
      "managed pack root file" => %w[managed_pack_root_copy_fingerprints .],
      "managed pack document" => %w[managed_pack_doc_copy_fingerprints docs]
    }
    fields.each do |label, (field, directory)|
      fingerprints = metadata[field]
      return "installed stable metadata is missing #{field}" unless fingerprints.is_a?(Hash)

      fingerprints.each do |name, expected|
        valid_name = if %w[bin .].include?(directory)
                       name.is_a?(String) && name.match?(/\A[A-Za-z0-9][A-Za-z0-9._-]*\z/)
                     else
                       segments = name.is_a?(String) ? name.split("/", -1) : []
                       name.is_a?(String) && !name.empty? && !name.start_with?("/") &&
                         !name.match?(/[\x00-\x1f\x7f]/) &&
                         segments.none? { |segment| segment.empty? || segment == "." || segment == ".." }
                     end
        return "installed stable metadata has invalid #{label} path" unless valid_name
        unless expected.is_a?(String) && expected.match?(/\A[0-9a-f]{64}\z/i)
          return "installed stable metadata has invalid fingerprint for #{name}"
        end

        path = File.join(target, directory, name)
        ancestor = target
        ancestors = ([directory] + name.split("/")[0...-1]).reject { |part| part == "." }.map do |part|
          ancestor = File.join(ancestor, part)
          stat = File.lstat(ancestor)
          return "installed #{label} ancestor is not a regular directory: #{name}" unless stat.directory? && !stat.symlink?

          [ancestor, stat.dev, stat.ino]
        end
        file = nil
        begin
          stat = File.lstat(path)
        rescue Errno::ENOENT, Errno::ENOTDIR
          return "installed #{label} is missing: #{name}"
        end
        unless stat.file? && !stat.symlink? && File.const_defined?(:NOFOLLOW)
          return "installed #{label} is not a safely readable regular file: #{name}"
        end

        begin
          file = File.open(path, File::RDONLY | File::NONBLOCK | File::NOFOLLOW)
          opened_stat = file.stat
          opened_identity = managed_surface_stat_identity(opened_stat)
          unless opened_stat.file? && opened_identity == managed_surface_stat_identity(stat)
            return "installed #{label} changed during check: #{name}"
          end
          if directory == "bin" && (opened_stat.mode & 0o111).zero?
            return "installed #{label} executable mode is missing: #{name}"
          end

          digest = Digest::SHA256.new
          while (chunk = file.read(64 * 1024))
            digest.update(chunk)
          end
          post_hash_stat = file.stat
          final_path_stat = File.lstat(path)
          unless post_hash_stat.file? && managed_surface_stat_identity(post_hash_stat) == opened_identity &&
                 final_path_stat.file? && !final_path_stat.symlink? &&
                 managed_surface_stat_identity(final_path_stat) == opened_identity
            return "installed #{label} changed during check: #{name}"
          end
          if directory == "bin" && ((post_hash_stat.mode & 0o111).zero? || (final_path_stat.mode & 0o111).zero?)
            return "installed #{label} executable mode is missing: #{name}"
          end
          unless ancestors.all? { |parent, dev, ino| (current = File.lstat(parent)).directory? && !current.symlink? && current.dev == dev && current.ino == ino }
            return "installed #{label} ancestor changed during check: #{name}"
          end
          return "installed #{label} fingerprint changed: #{name}" unless digest.hexdigest == expected.downcase
        ensure
          file&.close
        end
      end
    end
    nil
  rescue SystemCallError => e
    "installed stable managed-surface check failed: #{e.message}"
  end

  def status_payload(status, target:, source:, host:, metadata: {}, available_revision: nil, available_version: nil, available_release_ref: nil, checked_remote: false, reason: nil, delivery_state: nil)
    payload = {
      "status" => status,
      "host" => host,
      "target" => target,
      "source" => source,
      "installed_version" => metadata["version"],
      "installed_revision" => metadata["source_revision"],
      "available_version" => available_version || (source && File.directory?(source) ? version_for(source) : nil),
      "available_revision" => available_revision,
      "channel" => metadata["channel"] || "development",
      "release_ref" => metadata["release_ref"],
      "available_release_ref" => available_release_ref,
      "exact_commit" => metadata["source_revision"],
      "checked_remote" => checked_remote,
      "reason" => reason,
      "guidance" => delivery_state&.fetch("guidance", nil),
      "delivery_mode" => delivery_state&.fetch("delivery_mode", nil) || metadata.fetch("delivery_mode", "flat"),
      "native" => delivery_state&.fetch("native", nil),
      "flat" => delivery_state&.fetch("flat", nil)
    }
    payload["superpowers"] = delivery_state.fetch("superpowers") if delivery_state&.key?("superpowers")
    payload
  end

  def text_for(payload)
    line = case payload.fetch("status")
           when "UP_TO_DATE"
             "UP_TO_DATE channel=#{payload['channel']} release_ref=#{payload['release_ref'] || 'none'} version=#{payload['installed_version']} exact_commit=#{payload['exact_commit']} delivery_mode=#{payload['delivery_mode']} target=#{payload['target']}"
           when "UPGRADE_AVAILABLE"
             installed = "#{payload['installed_version']}@#{short_revision(payload['installed_revision'])}"
             available = "#{payload['available_version']}@#{short_revision(payload['available_revision'])}"
             "UPGRADE_AVAILABLE channel=#{payload['channel']} release_ref=#{payload['release_ref'] || 'none'} #{installed} #{available} exact_commit=#{payload['exact_commit']} delivery_mode=#{payload['delivery_mode']} target=#{payload['target']}"
           when "NOT_INSTALLED"
             "NOT_INSTALLED target=#{payload['target']}"
           when "CHECK_FAILED"
             guidance = payload["guidance"] ? " #{payload['guidance']}" : ""
             "CHECK_FAILED #{payload['reason']}#{guidance}"
           else
             raise "unknown status: #{payload.fetch('status')}"
           end

    superpowers_state = payload.dig("superpowers", "state")
    if superpowers_state
      line = "#{line} superpowers=#{superpowers_state}"
      catalog_versions = Array(payload.dig("superpowers", "catalog_entries"))
                         .filter_map { |entry| entry["catalog_version"] }
                         .uniq
                         .sort
      catalog_versions_text = catalog_versions.empty? ? "UNKNOWN" : catalog_versions.join(",")
      upstream_version = payload.dig("superpowers", "upstream_version") ||
                         payload.dig("superpowers", "upstream_version_source") || "UNKNOWN"
      line = "#{line} superpowers_catalog_versions=#{catalog_versions_text} superpowers_upstream_version=#{upstream_version}"
    end
    warning = if superpowers_state == "active"
                "WARNING Agent Workflows remains the sole delivery orchestrator; do not run Superpowers as a peer orchestrator.\n"
              else
                ""
              end
    "#{line}\n#{warning}"
  end

  def build_payload(options)
    requested_delivery_mode = options[:delivery_mode]
    if requested_delivery_mode && !%w[flat plugin-companion].include?(requested_delivery_mode)
      raise ArgumentError, "--delivery-mode must be flat or plugin-companion, got: #{requested_delivery_mode}"
    end

    host, target = resolve_host_and_target(options.fetch(:host), options[:target])
    begin
      metadata = read_metadata(target)
    rescue RuntimeError, SystemCallError, JSON::ParserError, TypeError => e
      return status_payload(
        "CHECK_FAILED",
        target:,
        source: options[:source],
        host:,
        reason: e.message,
        delivery_state: superpowers_delivery_state(host, target)
      )
    end
    unless metadata
      delivery = superpowers_delivery_state(host, target)
      return status_payload(
        "NOT_INSTALLED",
        target:,
        source: options[:source],
        host:,
        delivery_state: delivery
      )
    end

    installed_channel = metadata.fetch("channel", "development")
    requested_channel = options[:channel] || installed_channel
    unless %w[stable development].include?(requested_channel)
      raise ArgumentError, "--channel must be stable or development, got: #{requested_channel}"
    end
    if requested_channel != installed_channel
      raise ArgumentError, "refusing channel change from #{installed_channel} to #{requested_channel}"
    end

    requested_release = options[:release] || metadata["release_ref"]
    if requested_channel == "stable" && requested_release.to_s.empty?
      raise ArgumentError, "stable status requires --release or installed release_ref metadata"
    end
    if requested_channel == "development" && options[:release]
      raise ArgumentError, "development channel cannot use --release"
    end

    source = File.expand_path(options[:source] || metadata["source"].to_s)
    delivery_mode = requested_delivery_mode || metadata.fetch("delivery_mode", "flat")
    revision, error, available_version, = available_revision(
      source, metadata, fetch: options.fetch(:fetch), channel: requested_channel, release_ref: requested_release
    )
    if error
      return status_payload(
        "CHECK_FAILED",
        target:,
        source:,
        host:,
        metadata:,
        checked_remote: options.fetch(:fetch),
        reason: error,
        delivery_state: superpowers_delivery_state(host, target)
      )
    end
    integrity_revision = revision
    if requested_channel == "stable"
      if requested_release != metadata["release_ref"]
        integrity_revision, _, _, integrity_error = verify_stable_release(source, metadata, metadata["release_ref"], fetch: false)
        raise ArgumentError, integrity_error if integrity_error
      end
      unless metadata["source_revision"] == integrity_revision
        raise ArgumentError, "installed stable metadata revision does not match its release tag"
      end
    end
    delivery, delivery_error = if requested_channel == "stable"
                                 stable_delivery_state(host:, target:, source:, revision: integrity_revision, delivery_mode:, metadata:)
                               else
                                 delivery_state(host:, target:, source:, delivery_mode:)
                               end
    delivery = with_superpowers_delivery_state(delivery, host, target)
    if delivery_error
      delivery ||= {}
      delivery.merge!(superpowers_delivery_state(host, target) || {}) unless delivery.key?("superpowers")
      return status_payload(
        "CHECK_FAILED",
        target:,
        source:,
        host:,
        metadata:,
        reason: delivery_error,
        delivery_state: delivery
      )
    end
    if requested_channel == "stable" && (surface_error = stable_managed_surface_error(target, metadata))
      return status_payload(
        "CHECK_FAILED",
        target:,
        source:,
        host:,
        metadata:,
        reason: surface_error,
        delivery_state: delivery
      )
    end

    installed_revision = metadata["source_revision"].to_s
    installed_version = metadata["version"].to_s
    status = if !installed_revision.empty? && installed_revision == revision
               "UP_TO_DATE"
             elsif revision.to_s.start_with?("version:") && installed_version == available_version
               "UP_TO_DATE"
             else
               "UPGRADE_AVAILABLE"
             end

    status_payload(
      status,
      target:,
      source:,
      host:,
      metadata:,
      available_revision: revision,
      available_version:,
      available_release_ref: requested_release,
      checked_remote: options.fetch(:fetch),
      delivery_state: delivery
    )
  rescue ArgumentError, RuntimeError, SystemCallError, JSON::ParserError, TypeError => e
    status_payload("CHECK_FAILED", target: options[:target], source: options[:source], host: options[:host], reason: e.message)
  end
end

if $PROGRAM_NAME == __FILE__
  options = { host: "codex", target: nil, source: nil, delivery_mode: nil, channel: nil, release: nil, fetch: false, json: false }
  parser = OptionParser.new do |opts|
    opts.banner = "Usage: agent-workflows-status [--host codex|claude|auto] [--target DIR] [--source DIR] [--delivery-mode flat|plugin-companion] [--channel stable|development] [--release vX.Y.Z] [--fetch] [--json]"
    opts.on(
      "--host HOST",
      "Agent host: codex, claude, or auto (unmarked explicit targets default to codex)"
    ) { |value| options[:host] = value }
    opts.on("--target DIR", "Installed agent home to inspect") { |value| options[:target] = value }
    opts.on("--source DIR", "Source shakacode/agent-workflows clone") { |value| options[:source] = value }
    opts.on("--delivery-mode MODE", "Evaluate compatibility for flat or plugin-companion") do |value|
      options[:delivery_mode] = value
    end
    opts.on("--channel CHANNEL", "Installed release channel: stable or development") { |value| options[:channel] = value }
    opts.on("--release TAG", "Exact stable release to inspect") { |value| options[:release] = value }
    opts.on("--fetch", "Fetch origin before checking the source revision") { options[:fetch] = true }
    opts.on("--json", "Print JSON output") { options[:json] = true }
    opts.on("-h", "--help", "Show help") do
      puts opts
      exit 0
    end
  end
  parser.parse!

  unless %w[codex claude auto].include?(options.fetch(:host))
    warn "--host must be codex, claude, or auto, got: #{options.fetch(:host)}"
    exit AgentWorkflowsStatus::STATUS_EXIT.fetch("CHECK_FAILED")
  end
  if options[:delivery_mode] && !%w[flat plugin-companion].include?(options[:delivery_mode])
    warn "--delivery-mode must be flat or plugin-companion, got: #{options[:delivery_mode]}"
    exit AgentWorkflowsStatus::STATUS_EXIT.fetch("CHECK_FAILED")
  end

  payload = AgentWorkflowsStatus.build_payload(options)
  print(options.fetch(:json) ? "#{JSON.pretty_generate(payload)}\n" : AgentWorkflowsStatus.text_for(payload))
  exit AgentWorkflowsStatus::STATUS_EXIT.fetch(payload.fetch("status"))
end
