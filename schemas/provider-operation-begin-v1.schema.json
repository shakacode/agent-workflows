{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shakacode/agent-workflows/schemas/provider-operation-begin-v1.schema.json",
  "title": "Agent Workflows provider operation begin result",
  "type": "object",
  "required": [
    "schema_version",
    "operation",
    "revision",
    "freshness",
    "provider_profile",
    "assets",
    "capabilities",
    "runner",
    "release"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "freshness": { "enum": ["current", "degraded"] },
    "provider_profile": { "const": "managed" },
    "assets": {
      "type": "object",
      "required": ["root", "skill", "workflow", "skills", "related_workflows", "docs"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" },
        "skill": { "type": "string", "pattern": "^/" },
        "workflow": { "type": "string", "pattern": "^/" },
        "skills": { "$ref": "#/$defs/namedPaths" },
        "related_workflows": { "$ref": "#/$defs/namedPaths" },
        "docs": { "$ref": "#/$defs/namedPaths" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "runner": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "release": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "type": "string", "pattern": "^/" },
        { "const": "release" },
        { "const": "--host" },
        { "enum": ["codex", "claude"] },
        { "const": "--target" },
        { "type": "string", "pattern": "^/" },
        { "const": "--operation" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "const": "--json" }
      ],
      "items": false
    }
  },
  "$defs": {
    "namedPaths": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "pattern": "^/" }
    }
  },
  "additionalProperties": false
}
